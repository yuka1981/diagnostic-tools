<% if message.present? %>
  <div class="mb-4 rounded-lg bg-error-1 p-4">
    <div class="flex items-start gap-3">
      <%= lucide_icon("alert-circle", class: "h-5 w-5 flex-shrink-0 text-error-5") %>
      <div>
        <p class="text-sm font-medium text-error-8">Import failed</p>
        <p class="mt-1 text-sm text-error-7"><%= message %></p>
      </div>
    </div>
  </div>
<% end %>

