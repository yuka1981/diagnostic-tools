<%= turbo_frame_tag "import_modal" do %>
  <div class="fixed inset-0 z-50 overflow-y-auto" data-controller="modal">
    <%# Backdrop %>
    <div class="fixed inset-0 bg-gray-900/60 backdrop-blur-sm"></div>

    <%# Modal container %>
    <div class="flex min-h-full items-center justify-center p-4">
      <div class="relative w-full max-w-lg transform rounded-2xl bg-white shadow-2xl transition-all dark:bg-slate-800">
        <%# Header %>
        <div class="flex items-center justify-between border-b border-gray-200 px-6 py-4 dark:border-white/10">
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-emerald-500 to-green-600 shadow-lg shadow-emerald-500/20">
              <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                  d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Import Nodes</h3>
              <p class="text-sm text-gray-500 dark:text-slate-400">Upload a CSV file to import nodes</p>
            </div>
          </div>
          <%= link_to nodes_path, class: "rounded-lg p-2 text-gray-400 hover:bg-gray-100 hover:text-gray-500 dark:hover:bg-white/5 dark:hover:text-white", data: { turbo_frame: "import_modal" } do %>
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          <% end %>
        </div>

        <%# Body %>
        <div class="px-6 py-4">
          <%# Error display area %>
          <div id="import_errors"></div>

          <%= form_with url: node_import_index_path, method: :post, multipart: true do |f| %>
            <%# File drop zone %>
            <div class="relative" data-controller="file-drop" data-file-drop-target="zone">
              <input type="file" 
                     name="file" 
                     accept=".csv,text/csv" 
                     class="sr-only" 
                     id="csv_file"
                     data-file-drop-target="input"
                     data-action="change->file-drop#fileSelected">
              
              <label for="csv_file" 
                     class="flex cursor-pointer flex-col items-center justify-center rounded-xl border-2 border-dashed border-gray-300 bg-gray-50 p-8 transition-colors hover:border-emerald-400 hover:bg-emerald-50 dark:border-white/10 dark:bg-white/5 dark:hover:border-emerald-500/50 dark:hover:bg-emerald-500/10"
                     data-action="dragover->file-drop#dragOver dragenter->file-drop#dragEnter dragleave->file-drop#dragLeave drop->file-drop#drop">
                <div class="flex h-12 w-12 items-center justify-center rounded-full bg-gray-100 dark:bg-white/10">
                  <svg class="h-6 w-6 text-gray-400 dark:text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                      d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                  </svg>
                </div>
                <p class="mt-4 text-sm font-medium text-gray-700 dark:text-slate-300" data-file-drop-target="label">
                  Drop your CSV file here or click to browse
                </p>
                <p class="mt-1 text-xs text-gray-500 dark:text-slate-400">CSV format: hostname, ip (optional), role, arch (optional)</p>
              </label>
            </div>

            <%# CSV format info %>
            <div class="mt-4 rounded-lg bg-blue-50 p-4 dark:bg-blue-500/10">
              <div class="flex gap-3">
                <svg class="h-5 w-5 flex-shrink-0 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                    d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <div class="text-sm">
                  <p class="font-medium text-blue-800 dark:text-blue-300">Expected CSV format</p>
                  <p class="mt-1 text-blue-700 dark:text-blue-400">
                    Required column: <code class="rounded-none bg-blue-100 px-1 dark:bg-blue-500/20">hostname</code><br>
                    Optional columns: <code class="rounded-none bg-blue-100 px-1 dark:bg-blue-500/20">ip</code>, 
                    <code class="rounded-none bg-blue-100 px-1 dark:bg-blue-500/20">role</code> (compute/login/admin), 
                    <code class="rounded-none bg-blue-100 px-1 dark:bg-blue-500/20">arch</code>
                  </p>
                </div>
              </div>
            </div>

            <%# Actions %>
            <div class="mt-6 flex items-center justify-end gap-3">
              <%= link_to "Cancel", nodes_path, 
                  class: "rounded-none px-4 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:text-slate-300 dark:hover:bg-white/5",
                  data: { turbo_frame: "import_modal" } %>
              <button type="submit" 
                      class="inline-flex items-center gap-2 rounded-none bg-gradient-to-r from-emerald-500 to-green-600 px-4 py-2.5 text-sm font-medium text-white shadow-lg shadow-emerald-500/20 transition-all hover:from-emerald-600 hover:to-green-700 disabled:cursor-not-allowed disabled:opacity-50">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
                </svg>
                Import
              </button>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>

