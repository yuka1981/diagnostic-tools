<%= turbo_frame_tag "import_modal" do %>
  <%= render "shared/modal", title: "Import Nodes from CSV" do %>
    <div class="space-y-6">
      <div class="rounded-md bg-blue-50 p-4 border border-blue-200">
        <div class="flex">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-blue-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="ml-3">
            <h3 class="text-sm font-bold text-blue-800">CSV Requirements</h3>
            <div class="mt-2 text-xs text-blue-700 space-y-1">
              <p>Your CSV file should include the following headers:</p>
              <ul class="list-disc list-inside font-mono">
                <li>hostname (required)</li>
                <li>ip (optional)</li>
                <li>role (compute, login, admin)</li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <div id="import_errors"></div>

      <%= form_with(url: node_import_index_path, method: :post, class: "space-y-4") do |f| %>
        <div data-controller="file-drop"
             data-action="dragover->file-drop#dragOver dragenter->file-drop#dragEnter dragleave->file-drop#dragLeave drop->file-drop#drop"
             class="group relative">
          <label for="file" class="block text-xs font-bold text-slate-700 uppercase mb-1">Select CSV File</label>
          
          <div data-file-drop-target="zone"
               class="relative flex flex-col items-center justify-center rounded border-2 border-dashed border-slate-300 bg-slate-50 p-8 text-center transition-all hover:border-teal-400 hover:bg-teal-50">
            
            <div class="flex h-12 w-12 items-center justify-center rounded bg-white text-slate-400 shadow-sm border border-slate-200 mb-4 group-hover:text-teal-500 group-hover:border-teal-200 transition-colors">
  <%= lucide_icon("cloud-upload", class: "h-6 w-6") %>
            </div>

            <div class="space-y-1">
              <p class="text-xs font-bold text-slate-700 uppercase tracking-tight" data-file-drop-target="label">
                Click to upload or drag and drop
              </p>
              <p class="text-[10px] text-slate-500 italic">CSV file only (hostname, ip, role)</p>
            </div>

            <%= f.file_field :file, 
                required: true,
                accept: ".csv",
                data: { 
                  file_drop_target: "input",
                  action: "change->file-drop#fileSelected"
                },
                class: "absolute inset-0 h-full w-full cursor-pointer opacity-0" %>
          </div>
        </div>

        <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
          <button type="button" class="btn-secondary" data-action="modal#close">Cancel</button>
          <%= f.submit "Import Nodes", class: "btn-primary" %>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>