<%= turbo_frame_tag "import_modal" do %>
  <%= render "shared/modal", title: "Import Nodes", max_width: "max-w-lg" do %>
    <%# Error display area %>
    <div id="import_errors"></div>

    <%= form_with url: node_import_index_path, method: :post, multipart: true, id: "import_nodes_form" do |f| %>
      <%# File drop zone %>
      <div class="relative" data-controller="file-drop" data-file-drop-target="zone">
        <input type="file" 
               name="file" 
               accept=".csv,text/csv" 
               class="sr-only" 
               id="csv_file"
               data-file-drop-target="input"
               data-action="change->file-drop#fileSelected">
        
        <label for="csv_file" 
               class="flex cursor-pointer flex-col items-center justify-center rounded border-2 border-dashed border-slate-300 bg-slate-50 p-8 transition-colors hover:border-teal-400 hover:bg-teal-50"
               data-action="dragover->file-drop#dragOver dragenter->file-drop#dragEnter dragleave->file-drop#dragLeave drop->file-drop#drop">
          <div class="flex h-12 w-12 items-center justify-center rounded-full bg-white border border-slate-200 shadow-sm">
            <svg class="h-6 w-6 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
            </svg>
          </div>
          <p class="mt-4 text-sm font-bold text-slate-700 uppercase tracking-wider" data-file-drop-target="label">
            Drop CSV or click to browse
          </p>
          <p class="mt-1 text-xs text-slate-500 font-medium tracking-wide">hostname, ip, role, arch</p>
        </label>
      </div>

      <%# CSV format info %>
      <div class="mt-4 rounded border border-blue-200 bg-blue-50 p-4">
        <div class="flex gap-3">
          <svg class="h-5 w-5 flex-shrink-0 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
              d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <div class="text-xs">
            <p class="font-bold text-blue-800 uppercase tracking-tight">Expected Format</p>
            <p class="mt-1 text-blue-700 font-medium">
              Required: <code class="rounded bg-blue-100 px-1 border border-blue-200">hostname</code><br>
              Optional: <code class="rounded bg-blue-100 px-1 border border-blue-200">ip</code>, 
              <code class="rounded bg-blue-100 px-1 border border-blue-200">role</code>, 
              <code class="rounded bg-blue-100 px-1 border border-blue-200">arch</code>
            </p>
          </div>
        </div>
      </div>
    <% end %>

    <% content_for :modal_footer do %>
      <button type="button" class="btn-secondary" data-action="click->modal#close">Cancel</button>
      <button type="submit" form="import_nodes_form" class="btn-success">
        <svg class="h-4 w-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
        </svg>
        Import Nodes
      </button>
    <% end %>
  <% end %>
<% end %>