<%= turbo_frame_tag "node_modal" do %>
  <%= render "shared/modal", title: "Add New Node", max_width: "max-w-2xl" do %>
    <%= render(NodeFormComponent.new(node: @node, show_actions: false)) %>

    <% content_for :modal_footer do %>
      <button type="button" class="btn-secondary" data-action="click->modal#close">Cancel</button>
      <button type="submit" form="<%= dom_id(@node, :form) %>" class="btn-primary">Save Node</button>
    <% end %>
  <% end %>
<% end %>