<%= turbo_frame_tag "node_overview", data: { turbo_frame: "_top" } do %>
<%# Discrepancy Panel - shown prominently at top when discrepancies exist %>
<div class="mb-6">
  <%= render Bmc::DiscrepancyPanelComponent.new(node: node) %>
</div>

<div class="grid grid-cols-12 gap-6 mb-6">
  <!-- Left Column: Info Panel -->
  <div class="col-span-12 lg:col-span-4">
    <div class="card-netbox h-full" data-testid="nodes-overview-details">
      <div class="card-header">
        <h3 class="card-title text-xs font-bold text-neutral-45 uppercase">Node Details</h3>
      </div>
      <div class="p-0">
        <table class="w-full text-sm text-left table-striped">
          <tbody class="divide-y divide-neutral-4">
            <tr class="hover:bg-neutral-2">
              <th class="px-4 py-2 font-bold text-neutral-85 w-1/3 border-r border-neutral-8">Status</th>
              <td class="px-4 py-2"><%= node_status_badge(node.status) %></td>
            </tr>
            <tr class="hover:bg-neutral-2">
              <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Role</th>
              <td class="px-4 py-2 text-neutral-85"><%= node.role.humanize %></td>
            </tr>
            <tr class="hover:bg-neutral-2">
              <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">IP Address</th>
              <td class="px-4 py-2 font-mono text-neutral-85"><%= node.ip || "—" %></td>
            </tr>
            <tr class="hover:bg-neutral-2">
              <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Architecture</th>
              <td class="px-4 py-2 text-neutral-85"><%= node.arch || "—" %></td>
            </tr>
            <tr class="hover:bg-neutral-2">
              <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Last Seen</th>
              <td class="px-4 py-2 text-neutral-85"><%= node.last_seen_at ? time_ago_in_words(node.last_seen_at) + " ago" : "Never" %></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Middle Column: Operating System -->
  <div class="col-span-12 lg:col-span-4">
    <div class="card-netbox h-full" data-testid="nodes-overview-os">
      <div class="card-header">
        <h3 class="card-title text-xs font-bold text-neutral-45 uppercase">Operating System</h3>
      </div>
      <% state = node.current_state %>
      <% if state %>
        <div class="p-0">
          <table class="w-full text-sm text-left">
            <tbody class="divide-y divide-neutral-4">
              <tr class="hover:bg-neutral-2">
                <th class="px-4 py-2 font-bold text-neutral-85 w-1/3 border-r border-neutral-8">OS</th>
                <td class="px-4 py-2 text-neutral-85"><%= state.host_info["os"] || "—" %></td>
              </tr>
              <tr class="hover:bg-neutral-2">
                <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Kernel</th>
                <td class="px-4 py-2 font-mono text-neutral-85 text-xs"><%= state.host_info["kernel"] || "—" %></td>
              </tr>
              <tr class="hover:bg-neutral-2">
                <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Platform</th>
                <td class="px-4 py-2 text-neutral-85"><%= state.host_info["platform"] %> <%= state.host_info["platform_version"] %></td>
              </tr>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="p-4 text-center text-sm text-neutral-45">No system information available.</div>
      <% end %>
    </div>
  </div>

  <!-- Right Column: BMC Status -->
  <div class="col-span-12 lg:col-span-4">
    <%= render Bmc::StatusCardComponent.new(node: node) %>
  </div>
</div>

<!-- Server Product Card -->
<div class="mb-6" data-testid="nodes-overview-product">
  <%= render "nodes/server_product_card", node: node %>
</div>

<!-- Bottom Section: Recent Benchmarks -->
    <div class="card-netbox" data-testid="nodes-overview-runs">
  <div class="card-header">
    <h3 class="card-title text-xs font-bold text-neutral-45 uppercase">Recent Benchmark Runs</h3>
    <%= link_to "View All", node_benchmark_runs_path(node), class: "text-xs font-bold text-primary-6 hover:underline", data: { testid: "nodes-overview-runs-link" } %>
  </div>
  <div class="overflow-x-auto">
     <% if node.benchmark_runs.any? %>
       <table class="min-w-full divide-y divide-neutral-8 text-sm">
         <thead class="bg-neutral-2">
           <tr>
             <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">ID</th>
             <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Recipe</th>
             <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Status</th>
             <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Gflops</th>
             <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Duration</th>
             <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Created At</th>
             <th scope="col" class="relative px-3 py-2 border-b"><span class="sr-only">Actions</span></th>
           </tr>
         </thead>
         <tbody id="node_recent_runs_tbody" class="divide-y divide-neutral-4" data-testid="nodes-overview-runs-tbody">
           <% node.benchmark_runs.order(created_at: :desc).limit(5).each do |run| %>
             <%= render "nodes/benchmark_run_row", run: run %>
           <% end %>
         </tbody>
       </table>
     <% else %>
       <div class="p-4 text-center text-sm text-neutral-45">No benchmarks run yet.</div>
     <% end %>
  </div>
</div>
<% end %>
