<div class="grid grid-cols-12 gap-6 mb-6">
  <!-- Left Column: Info Panel -->
  <div class="col-span-12 lg:col-span-6">
        <div class="card-netbox">
      <div class="card-header">
        <h3 class="card-title text-xs font-bold text-slate-500 uppercase">Node Details</h3>
      </div>
      <div class="p-0">
        <table class="w-full text-sm text-left table-striped">
          <tbody class="divide-y divide-slate-100">
            <tr class="hover:bg-slate-50">
              <th class="px-4 py-2 font-bold text-slate-700 w-1/3 border-r border-slate-200">Status</th>
              <td class="px-4 py-2"><%= node_status_badge(node.status) %></td>
            </tr>
            <tr class="hover:bg-slate-50">
              <th class="px-4 py-2 font-bold text-slate-700 border-r border-slate-200">Role</th>
              <td class="px-4 py-2 text-slate-700"><%= node.role.humanize %></td>
            </tr>
            <tr class="hover:bg-slate-50">
              <th class="px-4 py-2 font-bold text-slate-700 border-r border-slate-200">IP Address</th>
              <td class="px-4 py-2 font-mono text-slate-700"><%= node.ip || "—" %></td>
            </tr>
            <tr class="hover:bg-slate-50">
              <th class="px-4 py-2 font-bold text-slate-700 border-r border-slate-200">Architecture</th>
              <td class="px-4 py-2 text-slate-700"><%= node.arch || "—" %></td>
            </tr>
            <tr class="hover:bg-slate-50">
              <th class="px-4 py-2 font-bold text-slate-700 border-r border-slate-200">Last Seen</th>
              <td class="px-4 py-2 text-slate-700"><%= node.last_seen_at ? time_ago_in_words(node.last_seen_at) + " ago" : "Never" %></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Right Column: Operating System -->
  <div class="col-span-12 lg:col-span-6">
    <div class="card-netbox h-full">
      <div class="card-header">
        <h3 class="card-title text-xs font-bold text-slate-500 uppercase">Operating System</h3>
      </div>
      <% state = node.current_state %>
      <% if state %>
        <div class="p-0">
          <table class="w-full text-sm text-left">
            <tbody class="divide-y divide-slate-100">
              <tr class="hover:bg-slate-50">
                <th class="px-4 py-2 font-bold text-slate-700 w-1/3 border-r border-slate-200">OS</th>
                <td class="px-4 py-2 text-slate-700"><%= state.host_info["os"] || "—" %></td>
              </tr>
              <tr class="hover:bg-slate-50">
                <th class="px-4 py-2 font-bold text-slate-700 border-r border-slate-200">Kernel</th>
                <td class="px-4 py-2 font-mono text-slate-700 text-xs"><%= state.host_info["kernel"] || "—" %></td>
              </tr>
              <tr class="hover:bg-slate-50">
                <th class="px-4 py-2 font-bold text-slate-700 border-r border-slate-200">Platform</th>
                <td class="px-4 py-2 text-slate-700"><%= state.host_info["platform"] %> <%= state.host_info["platform_version"] %></td>
              </tr>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="p-4 text-center text-sm text-slate-500">No system information available.</div>
      <% end %>
    </div>
  </div>
</div>

<!-- Bottom Section: Recent Benchmarks -->
    <div class="card-netbox">
  <div class="card-header">
    <h3 class="card-title text-xs font-bold text-slate-500 uppercase">Recent Benchmark Runs</h3>
    <%= link_to "View All", node_benchmark_runs_path(node), class: "text-xs font-bold text-teal-600 hover:underline" %>
  </div>
  <div class="overflow-x-auto">
     <% if node.benchmark_runs.any? %>
       <table class="min-w-full divide-y divide-slate-200 text-sm">
         <thead class="bg-slate-50">
           <tr>
             <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-slate-500 border-b">ID</th>
             <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-slate-500 border-b">Recipe</th>
             <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-slate-500 border-b">Status</th>
             <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-slate-500 border-b">Gflops</th>
             <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-slate-500 border-b">Duration</th>
             <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-slate-500 border-b">Created At</th>
             <th scope="col" class="relative px-3 py-2 border-b"><span class="sr-only">Actions</span></th>
           </tr>
         </thead>
         <tbody id="node_recent_runs_tbody" class="divide-y divide-slate-100">
           <% node.benchmark_runs.order(created_at: :desc).limit(5).each do |run| %>
             <%= render "nodes/benchmark_run_row", run: run %>
           <% end %>
         </tbody>
       </table>
     <% else %>
       <div class="p-4 text-center text-sm text-slate-500">No benchmarks run yet.</div>
     <% end %>
  </div>
</div>
