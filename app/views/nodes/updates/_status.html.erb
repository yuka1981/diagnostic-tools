<div class="px-2 py-8 text-center" id="agent_update_status_<%= node.id %>">
  <div class="flex flex-col items-center justify-center">
    <% if status == "success" %>
      <div class="h-12 w-12 rounded bg-emerald-100 flex items-center justify-center mb-4 border border-emerald-200 shadow-sm">
        <%= lucide_icon("check", class: "h-6 w-6 text-emerald-600") %>
      </div>
      <h4 class="text-sm font-black text-neutral-85 uppercase tracking-tight">Update Successful</h4>
      <p class="text-[10px] text-neutral-45 font-medium mt-2 italic"><%= message %></p>
      <div class="mt-6">
        <%= link_to "Done", node_path(node), class: "btn-secondary py-2 px-6", data: { turbo_frame: "_top" } %>
      </div>
    <% elsif status == "error" %>
      <div class="h-12 w-12 rounded bg-error-1 flex items-center justify-center mb-4 border border-error-2 shadow-sm">
        <%= lucide_icon("x", class: "h-6 w-6 text-error-6") %>
      </div>
      <h4 class="text-sm font-black text-neutral-85 uppercase tracking-tight">Update Failed</h4>
      <div class="mt-4 text-xs text-error-7 bg-error-1 p-3 rounded border border-error-1 text-left font-medium w-full max-w-lg break-words overflow-auto max-h-48">
        <%= message %>
      </div>
      <div class="mt-6 flex gap-3 justify-center">
        <%= link_to "Retry", new_node_update_path(node), class: "btn-primary", data: { turbo_frame: "update_modal" } %>
        <%= link_to "Close", node_path(node), class: "btn-secondary", data: { turbo_frame: "_top" } %>
      </div>
    <% else %>
      <%# Processing state %>
      <div class="h-10 w-10 rounded-full border-4 border-primary-5 border-t-transparent animate-spin mb-4"></div>
      <h4 class="text-sm font-black text-neutral-85 uppercase tracking-tight">Updating Agent...</h4>
      <p class="text-[10px] text-neutral-45 font-medium mt-2 italic"><%= message %></p>
    <% end %>
  </div>
</div>
