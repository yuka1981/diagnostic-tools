<div class="px-2 py-8 text-center" id="agent_update_status_<%= node.id %>">
  <div class="flex flex-col items-center justify-center">
    <% if status == "success" %>
      <div class="h-12 w-12 rounded bg-emerald-100 flex items-center justify-center mb-4 border border-emerald-200 shadow-sm">
        <svg class="h-6 w-6 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <h4 class="text-sm font-black text-slate-800 uppercase tracking-tight">Update Successful</h4>
      <p class="text-[10px] text-slate-500 font-medium mt-2 italic"><%= message %></p>
      <div class="mt-6">
        <%= link_to "Done", node_path(node), class: "btn-secondary py-2 px-6", data: { turbo_frame: "_top" } %>
      </div>
    <% elsif status == "error" %>
      <div class="h-12 w-12 rounded bg-red-100 flex items-center justify-center mb-4 border border-red-200 shadow-sm">
        <svg class="h-6 w-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </div>
      <h4 class="text-sm font-black text-slate-800 uppercase tracking-tight">Update Failed</h4>
      <div class="mt-4 text-xs text-red-700 bg-red-50 p-3 rounded border border-red-100 text-left font-medium w-full max-w-lg break-words overflow-auto max-h-48">
        <%= message %>
      </div>
      <div class="mt-6 flex gap-3 justify-center">
        <%= link_to "Retry", new_node_update_path(node), class: "btn-primary", data: { turbo_frame: "update_modal" } %>
        <%= link_to "Close", node_path(node), class: "btn-secondary", data: { turbo_frame: "_top" } %>
      </div>
    <% else %>
      <%# Processing state %>
      <div class="h-10 w-10 rounded-full border-4 border-teal-500 border-t-transparent animate-spin mb-4"></div>
      <h4 class="text-sm font-black text-slate-800 uppercase tracking-tight">Updating Agent...</h4>
      <p class="text-[10px] text-slate-500 font-medium mt-2 italic"><%= message %></p>
    <% end %>
  </div>
</div>
