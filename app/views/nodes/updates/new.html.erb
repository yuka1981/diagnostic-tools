<%= turbo_frame_tag "update_modal" do %>
  <%= render "shared/modal", title: "Update Agent: #{@node.hostname}" do %>
    <div class="px-2" id="update_modal_body">
      <% if @node.busy? %>
        <div class="rounded-md bg-error-1 p-4 border border-error-2 mb-6">
          <div class="flex">
            <div class="flex-shrink-0">
              <%= lucide_icon("circle-x", class: "h-5 w-5 text-error-5") %>
            </div>
            <div class="ml-3">
              <h3 class="text-sm font-bold text-error-8">Node is Busy</h3>
              <p class="mt-1 text-xs text-error-7">
                This node has pending or running benchmark tasks. Updating the agent now may cause data loss or corruption.
                You can force the update if necessary, but this is not recommended.
              </p>
            </div>
          </div>
        </div>
      <% elsif @required_fields.values.none? %>
        <div class="rounded-md bg-primary-1 p-4 border border-primary-2 mb-6">
          <div class="flex">
            <div class="flex-shrink-0">
              <%= lucide_icon("circle-check", class: "h-5 w-5 text-primary-5") %>
            </div>
            <div class="ml-3">
              <h3 class="text-sm font-bold text-primary-8">Credentials Configured</h3>
              <p class="mt-1 text-xs text-primary-7">
                All required credentials are already configured. Select a release version to deploy.
              </p>
            </div>
          </div>
        </div>
      <% else %>
        <div class="rounded-md bg-primary-1 p-4 border border-primary-2 mb-6">
          <div class="flex">
            <div class="flex-shrink-0">
              <%= lucide_icon("info", class: "h-5 w-5 text-primary-5") %>
            </div>
            <div class="ml-3">
              <h3 class="text-sm font-bold text-primary-8">Agent Update</h3>
              <p class="mt-1 text-xs text-primary-7">
                Select a release version to deploy to this node. The agent service will be stopped during the update.
              </p>
            </div>
          </div>
        </div>
      <% end %>

      <% is_localhost = @node.ip == "127.0.0.1" || @node.ip == "localhost" || @node.ip == "::1" ||
                        @node.hostname == "127.0.0.1" || @node.hostname == "localhost" || @node.hostname == "::1" %>

      <%= form_with(url: node_update_path(@node), method: :post, class: "space-y-6") do |f| %>
        <% if @required_fields[:ssh_password] && !is_localhost %>
          <%# SSH Password (for remote hosts - used for SSH authentication) %>
          <div>
            <%= f.label :ssh_password, "SSH Password", class: "block text-sm font-bold text-neutral-85 mb-1" %>
            <%= f.password_field :ssh_password,
                placeholder: "Enter SSH password (or leave blank for key auth)",
                class: "block w-full rounded-md border-neutral-15 shadow-sm focus:border-primary-5 focus:ring-primary-5 sm:text-sm" %>
            <p class="mt-1 text-[10px] text-neutral-45 italic">
              Required for password-based SSH authentication. Leave blank if using SSH keys.
            </p>
          </div>
        <% end %>

        <% if @required_fields[:sudo_password] %>
          <%# Sudo Password (required when not stored in node or global settings) %>
          <div>
            <%= f.label :sudo_password, "Sudo Password", class: "block text-sm font-bold text-neutral-85 mb-1" %>
            <%= f.password_field :sudo_password,
                placeholder: "Enter sudo password",
                class: "block w-full rounded-md border-neutral-15 shadow-sm focus:border-primary-5 focus:ring-primary-5 sm:text-sm" %>
            <p class="mt-1 text-[10px] text-neutral-45 italic">
              Required if the SSH user needs sudo for systemctl commands.
            </p>
          </div>
        <% end %>

        <div>
          <%= f.label :agent_release_id, "Agent Release", class: "block text-sm font-bold text-neutral-85 mb-1" %>
          <% if @agent_releases.any? %>
            <div class="space-y-2">
              <% @agent_releases.each do |release| %>
                <label class="flex items-center p-3 border rounded-md cursor-pointer hover:bg-neutral-2 <%= release == @latest_release ? 'border-primary-5 bg-primary-1' : 'border-neutral-8' %>">
                  <%= f.radio_button :agent_release_id, release.id,
                      checked: release == @latest_release,
                      class: "h-4 w-4 text-primary-6 border-neutral-15 focus:ring-primary-5" %>
                  <div class="ml-3 flex-1">
                    <div class="flex items-center gap-2">
                      <span class="text-sm font-medium text-neutral-85"><%= release.version %></span>
                      <% if release == @latest_release %>
                        <span class="inline-flex items-center rounded-sm px-1.5 py-0.5 text-xs font-medium bg-primary-1 text-primary-8">
                          Latest
                        </span>
                      <% end %>
                      <% if release.deprecated? %>
                        <span class="inline-flex items-center rounded-sm px-1.5 py-0.5 text-xs font-medium bg-warning-1 text-warning-8">
                          Deprecated
                        </span>
                      <% end %>
                    </div>
                    <p class="text-xs text-neutral-45 mt-0.5">
                      Uploaded <%= time_ago_in_words(release.created_at) %> ago
                      <span class="text-neutral-25">•</span>
                      <%= release.formatted_size %>
                    </p>
                  </div>
                </label>
              <% end %>
            </div>
          <% else %>
            <div class="text-sm text-neutral-45 italic">
              No agent releases available. <%= link_to "Upload a release", new_settings_agent_release_path, class: "text-primary-6 hover:text-primary-7", data: { turbo_frame: "_top" } %> first.
            </div>
          <% end %>
        </div>

        <% if @node.busy? %>
          <div class="flex items-center">
            <label class="flex items-center cursor-pointer">
              <%= f.check_box :force, { class: "h-4 w-4 text-error-6 border-neutral-15 rounded focus:ring-error-5" }, "true", "false" %>
              <span class="ml-2 text-sm text-error-7 font-medium">Force update (not recommended)</span>
            </label>
          </div>
        <% end %>

        <div class="flex items-center justify-end gap-3 pt-4 border-t border-neutral-4">
          <button type="button" class="btn-secondary" data-action="modal#close">Cancel</button>
          <%= f.submit "Update Agent",
              class: "btn-primary",
              disabled: @agent_releases.empty? %>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
