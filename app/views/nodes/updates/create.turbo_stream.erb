<%= turbo_stream.replace "update_modal_body" do %>
  <div class="space-y-6">
    <%# Subscription for status updates (Turbo Streams) %>
    <%= turbo_stream_from "agent_update_#{@node.id}" %>

    <%# High-level status summary %>
    <div id="agent_update_status_<%= @node.id %>">
      <%= render "nodes/updates/status",
          status: "processing",
          message: "Starting agent update...",
          node: @node %>
    </div>
  </div>
<% end %>
