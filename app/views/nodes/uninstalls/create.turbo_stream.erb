<%= turbo_stream.replace "uninstall_modal_body" do %>
  <%= turbo_stream_from "agent_uninstall_#{params[:uninstall][:hostname].parameterize}" %>
  <%= render "nodes/uninstalls/status", 
      status: "processing", 
      message: "Starting uninstallation process...", 
      target_host: params[:uninstall][:hostname],
      steps: Agent::RemoteUninstallService::STEPS,
      current_step: nil %>
<% end %>

<%= turbo_stream.update "modal_footer", "" %>
