<div class="px-2 py-8 text-center" id="agent_uninstall_status_<%= target_host.parameterize %>">
  <div class="flex flex-col items-center justify-center">
    <% if status == "success" %>
      <div class="h-12 w-12 rounded bg-emerald-100 flex items-center justify-center mb-4 border border-emerald-200 shadow-sm">
        <%= lucide_icon("check", class: "h-6 w-6 text-emerald-600") %>
      </div>
      <h4 class="text-sm font-black text-slate-800 uppercase tracking-tight">Uninstallation Successful</h4>

      <div class="mt-6 w-full max-w-sm mx-auto text-left card-netbox">
        <div class="card-header"><h3 class="card-title">Completed Steps</h3></div>
        <ul class="divide-y divide-slate-100">
          <% steps&.each do |key, label| %>
            <li class="flex items-center gap-3 p-3 text-xs font-bold text-slate-700">
              <%= lucide_icon("check", class: "h-4 w-4 text-emerald-500") %>
              <%= label %>
            </li>
          <% end %>
        </ul>
      </div>

      <div class="mt-8">
        <%= link_to "Done", nodes_path, class: "btn-secondary py-2 px-6", data: { turbo_frame: "_top" } %>
      </div>

    <% elsif status == "error" %>
      <div class="h-12 w-12 rounded bg-red-100 flex items-center justify-center mb-4 border border-red-200 shadow-sm">
        <%= lucide_icon("x", class: "h-6 w-6 text-red-600") %>
      </div>
      <h4 class="text-sm font-black text-slate-800 uppercase tracking-tight">Uninstallation Failed</h4>

      <div class="mt-6 w-full max-w-sm mx-auto text-left card-netbox">
        <div class="card-header"><h3 class="card-title">Process Progress</h3></div>
        <ul class="divide-y divide-slate-100">
          <%
             passed = true
             steps&.each do |key, label|
               is_current = (key == current_step)
               passed = false if is_current
          %>
            <li class="flex items-center gap-3 p-3 text-xs font-bold <%= is_current ? 'text-red-600 bg-red-50' : 'text-slate-500' %>">
              <% if passed %>
                <%= lucide_icon("check", class: "h-4 w-4 text-emerald-500") %>
              <% elsif is_current %>
                <%= lucide_icon("x", class: "h-4 w-4 text-red-500") %>
              <% else %>
                <div class="h-4 w-4 rounded-full border-2 border-slate-200"></div>
              <% end %>
              <%= label %>
            </li>
          <% end %>
        </ul>
      </div>

      <div class="mt-4 text-xs text-red-700 bg-red-50 p-3 rounded border border-red-100 text-left font-medium max-w-sm mx-auto">
        <%= message %>
      </div>
      <div class="mt-6 flex gap-3 justify-center">
        <%= link_to "Retry", new_node_uninstall_path(hostname: target_host), class: "btn-primary", data: { turbo_frame: "uninstall_modal" } %>
        <%= link_to "Close", nodes_path, class: "btn-secondary", data: { turbo_frame: "uninstall_modal" } %>
      </div>

    <% else %>
      <%# Processing state %>
      <div class="flex items-center justify-center gap-3 mb-6">
        <div class="h-8 w-8 rounded-full border-4 border-teal-500 border-t-transparent animate-spin"></div>
        <h4 class="text-sm font-black text-slate-800 uppercase tracking-tight">Uninstalling Agent...</h4>
      </div>

      <div class="w-full max-w-sm mx-auto text-left card-netbox">
        <div class="card-header"><h3 class="card-title">Process Progress</h3></div>
        <ul class="divide-y divide-slate-100">
          <%
             passed = true
             steps&.each do |key, label|
               is_current = (key == current_step)
               passed = false if is_current
          %>
            <li class="flex items-center gap-3 p-3 text-xs font-bold <%= is_current ? 'text-teal-600 bg-teal-50' : 'text-slate-500' %>">
              <% if passed %>
                <%= lucide_icon("check", class: "h-4 w-4 text-emerald-500") %>
              <% elsif is_current %>
                <div class="h-4 w-4 rounded-full border-2 border-teal-500 border-t-transparent animate-spin"></div>
              <% else %>
                <div class="h-4 w-4 rounded-full border-2 border-slate-200"></div>
              <% end %>
              <%= label %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </div>
</div>
