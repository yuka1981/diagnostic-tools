<%= turbo_frame_tag "uninstall_modal" do %>
  <%= render "shared/modal", title: "Remove Agent", max_width: "max-w-lg" do %>
    <div id="uninstall_modal_body">
      <div class="mb-6 rounded bg-red-50 p-4 border border-red-200">
        <div class="flex">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="ml-3">
            <h3 class="text-sm font-bold text-red-800 uppercase tracking-wider">Warning</h3>
            <div class="mt-2 text-sm text-red-700">
              <p>This will stop the agent service and permanently remove the binary and systemd configuration from the target server.</p>
            </div>
          </div>
        </div>
      </div>

      <%= form_with scope: :uninstall, url: node_uninstall_index_path, id: "uninstall_agent_form", method: :post do |f| %>
        <div class="space-y-4">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <%= f.label :hostname, "Hostname", class: "block text-sm font-bold text-slate-700 mb-1" %>
              <%= f.text_field :hostname, value: @target_host, readonly: true, class: "block w-full rounded-md border-slate-300 bg-slate-50 shadow-sm sm:text-sm cursor-not-allowed" %>
            </div>
            <div>
              <%= f.label :ip, "IP Address", class: "block text-sm font-bold text-slate-700 mb-1" %>
              <%= f.text_field :ip, value: @node&.ip, readonly: true, class: "block w-full rounded-md border-slate-300 bg-slate-50 shadow-sm sm:text-sm cursor-not-allowed font-mono" %>
            </div>
          </div>

          <div class="pt-4 border-t border-slate-200">
            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-3 text-center">Authentication Required</h4>
            
            <div class="space-y-3">
                          <div>
                            <%= f.label :bastion_host, "Bastion Host (Optional)", class: "block text-sm font-bold text-slate-700 mb-1" %>
                            <%= f.text_field :bastion_host, value: (@node&.custom_bastion? ? @node.jump_host : @ssh_setting.bastion_host), placeholder: "Leave blank for direct connection", class: "block w-full rounded-md border-slate-300 shadow-sm focus:border-red-500 focus:ring-red-500 sm:text-sm" %>
                          </div>
              
                          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                                          <div>
                                            <%= f.label :bastion_user, "SSH/Bastion User (Optional)", class: "block text-sm font-bold text-slate-700 mb-1" %>
                                            <%= f.text_field :bastion_user, value: (@node&.custom_bastion? ? @node.jump_user : (@ssh_setting.bastion_user.presence || @node&.ssh_user.presence || "root")), placeholder: "default: root", class: "block w-full rounded-md border-slate-300 shadow-sm focus:border-red-500 focus:ring-red-500 sm:text-sm" %>
                                          </div>
                            
                                          <div>
                                            <%= f.label :bastion_password, "SSH/Bastion Password (Optional)", class: "block text-sm font-bold text-slate-700 mb-1" %>
                                            <%= f.password_field :bastion_password, placeholder: "Optional", class: "block w-full rounded-md border-slate-300 shadow-sm focus:border-red-500 focus:ring-red-500 sm:text-sm" %>
                                          </div>
                            
                          </div>
                            <div>
                <%= f.label :sudo_password, "Sudo Password (Required)", class: "block text-sm font-bold text-slate-700 mb-1" %>
                <%= f.password_field :sudo_password, required: true, class: "block w-full rounded-md border-slate-300 shadow-sm focus:border-red-500 focus:ring-red-500 sm:text-sm" %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <% content_for :modal_footer do %>
      <button type="button" class="btn-secondary" data-action="click->modal#close">Cancel</button>
      <button type="submit" form="uninstall_agent_form" class="btn-danger">
        <svg class="h-4 w-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h14" />
        </svg>
        Confirm Removal
      </button>
    <% end %>
  <% end %>
<% end %>