<%= turbo_frame_tag "uninstall_modal" do %>
  <div class="fixed inset-0 z-50 overflow-y-auto" data-controller="modal" data-action="keydown.esc->modal#close">
    <%# Backdrop %>
    <div class="fixed inset-0 bg-gray-900/60 backdrop-blur-sm" data-action="click->modal#close"></div>

    <%# Modal container %>
    <div class="flex min-h-full items-center justify-center p-4">
      <div class="relative w-full max-w-lg transform rounded-2xl bg-white shadow-2xl transition-all dark:bg-slate-800">
        <%# Header %>
        <div class="flex items-center justify-between border-b border-gray-200 px-6 py-4 dark:border-white/10">
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-red-500 to-rose-600 shadow-lg shadow-red-500/20">
              <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h14" />
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Remove Agent</h3>
              <p class="text-sm text-gray-500 dark:text-slate-400">Uninstall agent from a remote node</p>
            </div>
          </div>
          <%= link_to nodes_path, class: "rounded-lg p-2 text-gray-400 hover:bg-gray-100 hover:text-gray-500 dark:hover:bg-white/5 dark:hover:text-white", data: { turbo_frame: "uninstall_modal" } do %>
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          <% end %>
        </div>

        <%# Body %>
        <div class="px-6 py-4" id="uninstall_modal_body">
          <div class="mb-6 rounded-lg bg-red-50 p-4 dark:bg-red-900/20">
            <div class="flex">
              <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                </svg>
              </div>
              <div class="ml-3">
                <h3 class="text-sm font-medium text-red-800 dark:text-red-200">Warning</h3>
                <div class="mt-2 text-sm text-red-700 dark:text-red-300">
                  <p>This will stop the agent service and permanently remove the binary and systemd configuration from the target server.</p>
                </div>
              </div>
            </div>
          </div>

          <%= form_with scope: :uninstall, url: node_uninstall_index_path, method: :post do |f| %>
            <div class="space-y-4">
              <div>
                <%= f.label :hostname, "Target Hostname/IP", class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
                <%= f.text_field :hostname, value: @target_host, readonly: true, class: "mt-1 block w-full rounded-none border-gray-300 bg-gray-50 shadow-sm focus:border-red-500 focus:ring-red-500 dark:bg-slate-700 dark:border-white/10 dark:text-gray-400 sm:text-sm" %>
              </div>

              <div class="pt-4 border-t border-gray-100 dark:border-white/5">
                <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-3">Authentication (Sudo required)</h4>
                
                <div>
                  <%= f.label :bastion_host, "Bastion Host (Optional)", class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
                  <%= f.text_field :bastion_host, value: (@node&.custom_bastion? ? @node.jump_host : @ssh_setting.bastion_host), placeholder: "Leave blank for direct connection", class: "mt-1 block w-full rounded-none border-gray-300 shadow-sm focus:border-red-500 focus:ring-red-500 dark:bg-slate-700 dark:border-white/10 dark:text-white sm:text-sm" %>
                </div>

                <div class="mt-3">
                  <%= f.label :bastion_user, "SSH/Bastion User (Optional)", class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
                  <%= f.text_field :bastion_user, value: (@node&.custom_bastion? ? @node.jump_user : (@ssh_setting.bastion_user.presence || @node&.ssh_user.presence || "root")), placeholder: "default: root", class: "mt-1 block w-full rounded-none border-gray-300 shadow-sm focus:border-red-500 focus:ring-red-500 dark:bg-slate-700 dark:border-white/10 dark:text-white sm:text-sm" %>
                </div>

                <div class="mt-3">
                  <%= f.label :bastion_password, "SSH/Bastion Password (Optional)", class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
                  <%= f.password_field :bastion_password, placeholder: "Leave blank if using SSH Key", class: "mt-1 block w-full rounded-none border-gray-300 shadow-sm focus:border-red-500 focus:ring-red-500 dark:bg-slate-700 dark:border-white/10 dark:text-white sm:text-sm" %>
                </div>

                <div class="mt-3">
                  <%= f.label :sudo_password, "Sudo Password (Required)", class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
                  <%= f.password_field :sudo_password, required: true, class: "mt-1 block w-full rounded-none border-gray-300 shadow-sm focus:border-red-500 focus:ring-red-500 dark:bg-slate-700 dark:border-white/10 dark:text-white sm:text-sm" %>
                </div>
              </div>
            </div>

            <%# Actions %>
            <div class="mt-6 flex items-center justify-end gap-3">
              <%= link_to "Cancel", nodes_path, 
                  class: "rounded-none px-4 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:text-slate-300 dark:hover:bg-white/5",
                  data: { turbo_frame: "uninstall_modal" } %>
              <button type="submit" 
                      class="inline-flex items-center gap-2 rounded-none bg-gradient-to-r from-red-500 to-rose-600 px-4 py-2.5 text-sm font-medium text-white shadow-lg shadow-red-500/20 transition-all hover:from-red-600 hover:to-rose-700">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h14" />
                </svg>
                Confirm Removal
              </button>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>
