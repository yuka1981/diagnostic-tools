<%= turbo_frame_tag "uninstall_modal" do %>
  <%= render "shared/modal", title: "Uninstall Agent: #{params[:hostname]}" do %>
    <div class="px-2" id="uninstall_modal_body">
      <% # Default to showing all credential fields if @required_fields is not set %>
      <% required_fields = @required_fields || { ssh_password: true, sudo_password: true } %>

      <div class="rounded-md bg-error-1 p-4 border border-error-2 mb-6">
        <div class="flex">
          <div class="flex-shrink-0">
            <%= lucide_icon("circle-x", class: "h-5 w-5 text-error-4") %>
          </div>
          <div class="ml-3">
            <h3 class="text-sm font-bold text-error-8">Uninstall Confirmation</h3>
            <p class="mt-1 text-xs text-error-7">
              This will stop the agent service and remove all related files from the target node.
            </p>
          </div>
        </div>
      </div>

      <% if required_fields.values.none? %>
        <div class="rounded-md bg-primary-1 p-4 border border-primary-2 mb-6">
          <div class="flex">
            <div class="flex-shrink-0">
              <%= lucide_icon("circle-check", class: "h-5 w-5 text-primary-4") %>
            </div>
            <div class="ml-3">
              <p class="text-sm text-primary-7">
                Using stored credentials. Click below to confirm uninstallation.
              </p>
            </div>
          </div>
        </div>
      <% end %>

      <%= form_with(url: node_uninstall_index_path, method: :post, class: "space-y-6", scope: :uninstall) do |f| %>
        <%= f.hidden_field :hostname, value: params[:hostname] %>
        <%# Bastion settings are now only global - use SshSetting %>
        <%= f.hidden_field :bastion_host, value: @ssh_setting.bastion_host %>
        <%= f.hidden_field :bastion_user, value: @ssh_setting.bastion_user.presence || @node&.effective_ssh_user %>

        <% if required_fields[:sudo_password] || required_fields[:ssh_password] %>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            <% if required_fields[:sudo_password] %>
              <div>
                <%= f.label :sudo_password, "Remote Sudo Password", class: "block text-sm font-bold text-neutral-85 mb-1" %>
                <%= f.password_field :sudo_password, required: true,
                    placeholder: "••••••••",
                    class: "block w-full rounded-md border-neutral-15 shadow-sm focus:border-primary-5 focus:ring-primary-5 sm:text-sm" %>
              </div>
            <% end %>

            <% if required_fields[:ssh_password] %>
              <div>
                <%= f.label :bastion_password, "SSH Password / Key Passphrase", class: "block text-sm font-bold text-neutral-85 mb-1" %>
                <%= f.password_field :bastion_password, required: false,
                    placeholder: "•••••••• (optional)",
                    class: "block w-full rounded-md border-neutral-15 shadow-sm focus:border-primary-5 focus:ring-primary-5 sm:text-sm" %>
              </div>
            <% end %>
          </div>
        <% end %>

        <div class="flex items-center justify-end gap-3 pt-4 border-t border-neutral-4">
          <button type="button" class="btn-secondary" data-action="modal#close">Cancel</button>
          <%= f.submit "Begin Uninstallation", class: "btn-danger" %>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>