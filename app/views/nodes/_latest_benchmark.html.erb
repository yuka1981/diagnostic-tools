<div id="<%= dom_id(node, :latest_benchmark) %>">
  <% run = node.benchmark_runs.recent.first %>

  <% if run %>
    <div class="flex items-center gap-2">
      <%= render StatusBadgeComponent.new(status: run.status, size: :small) %>
      <span class="text-[10px] text-neutral-45">
        <%= time_ago_in_words(run.created_at) %> ago
      </span>
    </div>
  <% else %>
    <p class="text-sm font-semibold text-neutral-85">—</p>
  <% end %>
</div>
