<div class="card-netbox" data-controller="slide-over">
  <div class="card-header">
    <h3 class="card-title text-xs font-bold text-neutral-45 uppercase">Network Interfaces</h3>
  </div>
  <div class="overflow-x-auto">
    <table class="w-full text-sm text-left">
      <thead class="bg-neutral-2 border-b border-neutral-8">
        <tr>
          <th class="px-4 py-2 font-bold text-neutral-45 uppercase text-[10px]">Name</th>
          <th class="px-4 py-2 font-bold text-neutral-45 uppercase text-[10px]">Status</th>
          <th class="px-4 py-2 font-bold text-neutral-45 uppercase text-[10px]">Type</th>
          <th class="px-4 py-2 font-bold text-neutral-45 uppercase text-[10px]">IP Addresses</th>
          <th class="px-4 py-2 font-bold text-neutral-45 uppercase text-[10px]">Speed</th>
          <th class="px-4 py-2 font-bold text-neutral-45 uppercase text-[10px]">PCI Address</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-neutral-4 bg-white">
        <% if state.network_inventory.present? && state.network_inventory["devices"].present? %>
          <% state.network_inventory["devices"].each do |iface| %>
            <tr class="hover:bg-neutral-2 transition-colors">
              <td class="px-4 py-2 font-bold">
                <div class="flex items-center gap-2">
                  <% if iface["master"].present? %>
                    <span class="text-neutral-25 font-normal ml-4">↳</span>
                  <% end %>
                  
                  <% if iface["type"] == "infiniband" %>
                    <%= link_to ib_details_node_network_path(node_id: state.node_id, interface_name: iface["name"], state_id: state.id),
                                class: "text-primary-6 hover:underline flex items-center gap-1",
                                data: { turbo_frame: "slide_over_content", action: "click->slide-over#open" } do %>
                      <%= lucide_icon("info", class: "w-3 h-3") %>
                      <%= iface["name"] %>
                    <% end %>
                  <% else %>
                    <span class="text-neutral-85"><%= iface["name"] %></span>
                  <% end %>
                </div>
              </td>
              <td class="px-4 py-2">
                <%= net_interface_status_badge(iface["oper_state"]) %>
              </td>
              <td class="px-4 py-2">
                <span class="px-1.5 py-0.5 rounded bg-neutral-4 text-neutral-45 border border-neutral-8 text-[10px] font-mono uppercase">
                  <%= iface["type"] %>
                </span>
              </td>
              <td class="px-4 py-2 font-mono text-xs text-neutral-45">
                <% if iface["ip_addresses"].present? %>
                  <div class="flex flex-col gap-1">
                    <% iface["ip_addresses"].each do |ip| %>
                      <span><%= ip %></span>
                    <% end %>
                  </div>
                <% else %>
                  <span class="text-neutral-15">—</span>
                <% end %>
              </td>
              <td class="px-4 py-2 text-neutral-85 font-medium">
                <% if iface["speed"].present? %>
                  <span class="<%= iface["type"] == "infiniband" ? "text-primary-6 font-bold" : "text-neutral-85 font-bold" %>">
                    <%= iface["speed"] %>
                  </span>
                <% else %>
                  <span class="text-neutral-15">—</span>
                <% end %>
              </td>
              <td class="px-4 py-2">
                <% if iface["pci_address"].present? %>
                  <div class="flex flex-col">
                    <span class="text-primary-6 font-mono text-[10px]"><%= iface["pci_address"] %></span>
                    <span class="text-[9px] text-neutral-25 truncate max-w-[150px]" title="<%= iface["vendor"] %> <%= iface["model"] %>">
                      <%= iface["vendor"] %> <%= iface["model"] %>
                    </span>
                  </div>
                <% else %>
                  <span class="text-neutral-15">—</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="6" class="px-4 py-8 text-center text-neutral-45 italic">
              No detailed network inventory available.
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# Slide-over Panel for IB Details %>
  <%# Backdrop %>
  <div data-slide-over-target="backdrop"
       data-action="click->slide-over#backdropClick"
       class="hidden fixed inset-0 z-40 bg-neutral-85/60 backdrop-blur-sm opacity-0 transition-opacity duration-300 ease-in-out">
  </div>

  <%# Centered Modal Panel %>
  <div data-slide-over-target="panel"
       data-action="click->slide-over#panelClick"
       role="dialog"
       aria-modal="true"
       aria-labelledby="slide-over-title"
       class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 opacity-0 scale-95 transition-all duration-300 ease-in-out">

    <div data-slide-over-target="modalContent" class="w-full max-w-2xl bg-white shadow-2xl ring-1 ring-neutral-8 rounded-lg overflow-hidden" style="height: 60vh;">
      <%# Header %>
      <div class="flex items-center justify-between border-b border-neutral-8 px-6 py-4 bg-neutral-2">
        <h2 id="slide-over-title" class="text-sm font-bold text-neutral-85 uppercase tracking-widest">
          Interface Details
        </h2>
        <button type="button"
                data-slide-over-target="closeButton"
                data-action="click->slide-over#close"
                class="rounded-lg p-2 text-neutral-25 hover:bg-neutral-4 hover:text-neutral-45 transition-colors">
          <%= lucide_icon("x", class: "h-5 w-5") %>
        </button>
      </div>

      <%# Content %>
      <div class="overflow-y-auto p-6" style="height: calc(60vh - 65px);">
        <%= turbo_frame_tag "slide_over_content", data: { slide_over_target: "content" } do %>
          <div class="flex flex-col items-center justify-center h-full py-12 text-center">
            <div class="animate-pulse flex flex-col items-center">
              <div class="h-8 w-8 bg-neutral-8 rounded-full mb-4"></div>
              <div class="h-4 w-32 bg-neutral-4 rounded"></div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
