<div class="space-y-4" data-controller="log-stream" data-log-stream-node-id-value="<%= node.id %>">
  <div class="rounded-lg bg-gray-900 p-4 font-mono text-sm text-gray-300 shadow-inner h-96 overflow-y-auto" data-log-stream-target="output">
    <div class="flex items-center gap-2 mb-4 text-indigo-400 border-b border-gray-700 pb-2">
      <svg class="h-4 w-4 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <span>Installation in progress...</span>
    </div>
    <%# Logs will be appended here %>
  </div>
  
  <div class="flex justify-end">
    <%= link_to "Close", nodes_path, 
        class: "rounded-lg px-4 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:text-slate-300 dark:hover:bg-white/5",
        data: { turbo_frame: "_top" } %>
  </div>
</div>
