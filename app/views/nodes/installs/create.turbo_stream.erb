<%= turbo_stream.replace "install_modal_body" do %>
  <div class="px-6 py-12 text-center" id="agent_install_status_<%= params[:install][:hostname].parameterize %>">
    <div class="flex flex-col items-center justify-center">
      <div class="h-12 w-12 rounded-full border-4 border-indigo-500 border-t-transparent animate-spin mb-4"></div>
      <h4 class="text-lg font-medium text-gray-900 dark:text-white">Installing Agent...</h4>
      <p class="text-sm text-gray-500 dark:text-slate-400 mt-2">Compiling and deploying to <%= params[:install][:hostname] %></p>
    </div>
    
    <%# Listen for progress updates %>
    <%= turbo_stream_from "agent_install_#{params[:install][:hostname].parameterize}" %>
  </div>
<% end %>
