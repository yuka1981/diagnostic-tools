<%= turbo_stream.replace "install_modal_body" do %>
  <div class="space-y-6">
    <%# Subscription for status updates (Turbo Streams) %>
    <%= turbo_stream_from "agent_install_#{params[:install][:hostname].parameterize}" %>

    <%# High-level status summary %>
    <div id="agent_install_status_<%= params[:install][:hostname].parameterize %>">
      <%= render "nodes/installs/status", 
          status: "processing", 
          message: "Starting installation process...", 
          target_host: params[:install][:hostname] %>
    </div>
  </div>
<% end %>
