<%= turbo_frame_tag "install_modal" do %>
  <%= render "shared/modal", title: "Cannot Install to Localhost" do %>
    <div class="px-2 py-6">
      <div class="flex flex-col items-center text-center">
        <div class="h-14 w-14 rounded-full bg-amber-100 flex items-center justify-center mb-4 border border-amber-200">
          <%= lucide_icon("alert-triangle", class: "h-7 w-7 text-amber-600") %>
        </div>

        <h3 class="text-lg font-bold text-neutral-85 mb-2">Localhost Installation Not Supported</h3>

        <p class="text-sm text-neutral-45 mb-4 max-w-md">
          Installing the agent to <code class="bg-neutral-4 px-1.5 py-0.5 rounded text-xs font-mono"><%= @target_host %></code> via the web interface is not supported.
          The agent should be installed on remote nodes, not on the server itself.
        </p>

        <div class="bg-neutral-2 rounded-lg p-4 w-full max-w-md border border-neutral-8 text-left mb-6">
          <h4 class="text-xs font-bold text-neutral-85 uppercase mb-3">Manual Installation Options</h4>

          <div class="space-y-3">
            <div class="flex items-start gap-3">
              <div class="flex-shrink-0 h-5 w-5 rounded bg-primary-1 flex items-center justify-center mt-0.5">
                <span class="text-xs font-bold text-primary-7">1</span>
              </div>
              <div>
                <p class="text-xs font-medium text-neutral-85">Download and run the agent binary directly</p>
                <code class="text-[10px] text-neutral-45 font-mono">./hpc-agent inventory push --server URL --token TOKEN</code>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="flex-shrink-0 h-5 w-5 rounded bg-primary-1 flex items-center justify-center mt-0.5">
                <span class="text-xs font-bold text-primary-7">2</span>
              </div>
              <div>
                <p class="text-xs font-medium text-neutral-85">Use the uninstall script to remove existing installation</p>
                <a href="/uninstall-hpc-agent.sh" download class="text-[10px] text-primary-6 hover:text-primary-7 font-mono underline">
                  Download uninstall-hpc-agent.sh
                </a>
              </div>
            </div>
          </div>
        </div>

        <div class="flex gap-3">
          <%= link_to "Back to Nodes", nodes_path, class: "btn-secondary", data: { turbo_frame: "_top" } %>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
