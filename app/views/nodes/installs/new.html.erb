<%= turbo_frame_tag "install_modal" do %>
  <%= render "shared/modal", title: "Install Agent: #{params[:hostname]}" do %>
    <div class="px-2" id="install_modal_body">
      <% # Default to showing all fields if @required_fields is not set (e.g., new nodes) %>
      <% required_fields = @required_fields || { ssh_password: true, sudo_password: true, api_key: true, server_url: true } %>
      <% required_count = required_fields.values.count(true) %>
      <% if required_count > 0 %>
        <div class="rounded-md bg-primary-1 p-4 border border-primary-2 mb-4">
          <div class="flex">
            <div class="flex-shrink-0">
              <%= lucide_icon("info", class: "h-5 w-5 text-primary-5") %>
            </div>
            <div class="ml-3">
              <p class="text-sm text-primary-7">
                <%= required_count == 1 ? "One field is needed" : "Some fields are needed" %> for this installation.
                <span class="text-primary-6">Configure in node or global settings to enable one-click installs.</span>
              </p>
            </div>
          </div>
        </div>
      <% end %>

      <div class="rounded-md bg-warning-1 p-4 border border-warning-2 mb-6">
        <div class="flex">
          <div class="flex-shrink-0">
            <%= lucide_icon("alert-triangle", class: "h-5 w-5 text-warning-5") %>
          </div>
          <div class="ml-3">
            <h3 class="text-sm font-bold text-warning-8">Security Requirement</h3>
            <p class="mt-1 text-xs text-warning-7">
              Credentials are never stored and are only used for this installation session.
            </p>
          </div>
        </div>
      </div>

      <%= form_with(url: node_install_index_path, method: :post, class: "space-y-6", scope: :install) do |f| %>
        <%= f.hidden_field :hostname, value: params[:hostname] %>
        <%= f.hidden_field :arch, value: @arch, id: "install_arch" %>
        <%# Bastion settings are now only global - use SshSetting %>
        <%= f.hidden_field :bastion_host, value: @ssh_setting.bastion_host %>
        <%= f.hidden_field :bastion_user, value: @ssh_setting.bastion_user.presence || @node&.effective_ssh_user %>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
          <% if required_fields[:sudo_password] %>
            <div>
              <%= f.label :sudo_password, "Remote Sudo Password", class: "block text-sm font-bold text-neutral-85 mb-1" %>
              <%= f.password_field :sudo_password, required: true,
                  placeholder: "••••••••",
                  class: "block w-full rounded-md border-neutral-15 shadow-sm focus:border-primary-5 focus:ring-primary-5 sm:text-sm" %>
            </div>
          <% end %>

          <% if required_fields[:ssh_password] %>
            <div>
              <%= f.label :bastion_password, "SSH Password / Key Passphrase", class: "block text-sm font-bold text-neutral-85 mb-1" %>
              <%= f.password_field :bastion_password, required: false,
                  placeholder: "•••••••• (optional)",
                  class: "block w-full rounded-md border-neutral-15 shadow-sm focus:border-primary-5 focus:ring-primary-5 sm:text-sm" %>
            </div>
          <% end %>

          <% if required_fields[:api_key] %>
            <div class="sm:col-span-2">
              <%= f.label :api_key_id, "Agent API Key", class: "block text-sm font-bold text-neutral-85 mb-1" %>
              <%= f.collection_select :api_key_id, @api_keys, :id, :name, { prompt: "Select an API key for the agent" },
                  class: "block w-full rounded-md border-neutral-15 shadow-sm focus:border-primary-5 focus:ring-primary-5 sm:text-sm" %>
            </div>
          <% end %>

          <% if required_fields[:server_url] %>
            <div class="sm:col-span-2">
              <%= f.label :server_url, "Server URL (Callback)", class: "block text-sm font-bold text-neutral-85 mb-1" %>
              <%= f.text_field :server_url, value: @server_url,
                  placeholder: "http://10.0.0.1:3000",
                  class: "block w-full rounded-md border-neutral-15 shadow-sm focus:border-primary-5 focus:ring-primary-5 sm:text-sm font-mono" %>
              <p class="mt-1 text-[10px] text-neutral-45 italic">The URL the agent will use to push data back to this server.</p>
            </div>
          <% end %>
        </div>

        <div class="flex items-center justify-end gap-3 pt-4 border-t border-neutral-4">
          <button type="button" class="btn-secondary" data-action="modal#close">Cancel</button>
          <%= f.submit "Begin Installation", class: "btn-primary" %>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
