<%= turbo_frame_tag "install_modal" do %>
  <%= render "shared/modal", title: "Install Agent", max_width: "max-w-lg" do %>
    <div id="install_modal_body">
      <%= form_with scope: :install, url: node_install_index_path, id: "install_agent_form", method: :post do |f| %>
      <div class="space-y-4">
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <%= f.label :hostname, "Hostname", class: "block text-sm font-bold text-slate-700 mb-1" %>
            <%= f.text_field :hostname, value: @target_host, readonly: true, class: "block w-full rounded-md border-slate-300 bg-slate-50 shadow-sm sm:text-sm cursor-not-allowed" %>
          </div>
          <div>
            <%= f.label :ip, "IP Address", class: "block text-sm font-bold text-slate-700 mb-1" %>
            <input type="text" value="<%= @node&.ip %>" readonly class="block w-full rounded-md border-slate-300 bg-slate-50 shadow-sm sm:text-sm cursor-not-allowed font-mono">
          </div>
        </div>

        <div>
          <%= f.label :arch, "Target Architecture", class: "block text-sm font-bold text-slate-700 mb-1" %>
          <%= f.select :arch, [["arm64", "arm64"], ["x86_64", "x86_64"]], { selected: @arch }, class: "block w-full rounded-md border-slate-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 sm:text-sm" %>
        </div>

        <div class="pt-4 border-t border-slate-200">
          <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-3">Agent Configuration</h4>
          
          <div>
            <%= f.label :server_url, "Server URL", class: "block text-sm font-bold text-slate-700 mb-1" %>
            <%= f.text_field :server_url, value: (@ssh_setting.server_url.presence || request.base_url), placeholder: "e.g. https://hpc-portal.com", class: "block w-full rounded-md border-slate-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 sm:text-sm" %>
            <p class="mt-1 text-xs text-slate-500">The URL agent will use to send data back to this server.</p>
          </div>

          <div class="mt-3">
            <%= f.label :api_key_id, "API Key", class: "block text-sm font-bold text-slate-700 mb-1" %>
            <%= f.select :api_key_id, 
                options_from_collection_for_select(@api_keys, :id, :name), 
                { include_blank: "Use system default token" }, 
                class: "block w-full rounded-md border-slate-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 sm:text-sm" %>
          </div>
        </div>

        <div class="pt-4 border-t border-slate-200">
          <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-3">Bastion Server Configuration</h4>
          
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div class="col-span-2">
              <%= f.label :bastion_host, "Bastion Host (Optional)", class: "block text-sm font-bold text-slate-700 mb-1" %>
              <%= f.text_field :bastion_host, value: (@node&.custom_bastion? ? @node.jump_host : @ssh_setting.bastion_host), placeholder: "Leave blank for direct connection", class: "block w-full rounded-md border-slate-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 sm:text-sm" %>
            </div>

            <div>
              <%= f.label :bastion_user, "SSH/Bastion User (Optional)", class: "block text-sm font-bold text-slate-700 mb-1" %>
              <%= f.text_field :bastion_user, value: (@node&.custom_bastion? ? @node.jump_user : (@ssh_setting.bastion_user.presence || @node&.ssh_user.presence || "root")), placeholder: "default: root", class: "block w-full rounded-md border-slate-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 sm:text-sm" %>
            </div>

            <div>
              <%= f.label :bastion_password, "SSH/Bastion Password (Optional)", class: "block text-sm font-bold text-slate-700 mb-1" %>
              <%= f.password_field :bastion_password, placeholder: "Optional", class: "block w-full rounded-md border-slate-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 sm:text-sm" %>
            </div>

            <div class="col-span-2">
              <%= f.label :sudo_password, "Sudo Password (Required)", class: "block text-sm font-bold text-slate-700 mb-1" %>
              <%= f.password_field :sudo_password, required: true, class: "block w-full rounded-md border-slate-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 sm:text-sm" %>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <% content_for :modal_footer do %>
      <button type="button" class="btn-secondary" data-action="click->modal#close">Cancel</button>
      <button type="submit" form="install_agent_form" class="btn-primary">
        <svg class="h-4 w-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        Start Installation
      </button>
    <% end %>
  <% end %>
<% end %>