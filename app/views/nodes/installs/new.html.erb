<%= turbo_frame_tag "install_modal" do %>
  <div class="fixed inset-0 z-50 overflow-y-auto" data-controller="modal" data-action="keydown.esc->modal#close">
    <%# Backdrop %>
    <div class="fixed inset-0 bg-gray-900/60 backdrop-blur-sm" data-action="click->modal#close"></div>

    <%# Modal container %>
    <div class="flex min-h-full items-center justify-center p-4">
      <div class="relative w-full max-w-lg transform rounded-2xl bg-white shadow-2xl transition-all dark:bg-slate-800">
        <%# Header %>
        <div class="flex items-center justify-between border-b border-gray-200 px-6 py-4 dark:border-white/10">
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-indigo-500 to-blue-600 shadow-lg shadow-indigo-500/20">
              <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Install Agent</h3>
              <p class="text-sm text-gray-500 dark:text-slate-400">Deploy agent to a remote node</p>
            </div>
          </div>
          <%= link_to nodes_path, class: "rounded-lg p-2 text-gray-400 hover:bg-gray-100 hover:text-gray-500 dark:hover:bg-white/5 dark:hover:text-white", data: { turbo_frame: "install_modal" } do %>
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          <% end %>
        </div>

        <%# Body %>
        <div class="px-6 py-4" id="install_modal_body">
          <%= form_with scope: :install, url: node_install_index_path, method: :post do |f| %>
            <div class="space-y-4">
              <div>
                <%= f.label :hostname, "Target Hostname/IP", class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
                <%= f.text_field :hostname, value: @target_host, required: true, placeholder: "e.g. compute-001", class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 dark:bg-slate-700 dark:border-white/10 dark:text-white sm:text-sm" %>
              </div>

              <div>
                <%= f.label :arch, "Target Architecture", class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
                <%= f.select :arch, [["x86_64", "x86_64"], ["arm64", "arm64"]], {}, class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 dark:bg-slate-700 dark:border-white/10 dark:text-white sm:text-sm" %>
              </div>

              <div>
                <%= f.label :server_url, "Server URL (Reporting Endpoint)", class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
                <%= f.text_field :server_url, value: request.base_url, placeholder: "e.g. https://hpc-portal.com", class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 dark:bg-slate-700 dark:border-white/10 dark:text-white sm:text-sm" %>
                <p class="mt-1 text-xs text-gray-500 dark:text-slate-400">The URL agent will use to send data back to this server.</p>
              </div>

              <div class="pt-4 border-t border-gray-100 dark:border-white/5">
                <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-3">Bastion Credentials (Sudo required)</h4>
                
                <div>
                  <%= f.label :bastion_user, "Bastion User", class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
                  <%= f.text_field :bastion_user, value: SshConfig.jump_user, required: true, class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 dark:bg-slate-700 dark:border-white/10 dark:text-white sm:text-sm" %>
                </div>

                <div class="mt-3">
                  <%= f.label :bastion_password, "Bastion Password (Optional)", class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
                  <%= f.password_field :bastion_password, placeholder: "Leave blank if using SSH Key", class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 dark:bg-slate-700 dark:border-white/10 dark:text-white sm:text-sm" %>
                </div>

                <div class="mt-3">
                  <%= f.label :sudo_password, "Bastion Sudo Password", class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
                  <%= f.password_field :sudo_password, required: true, class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 dark:bg-slate-700 dark:border-white/10 dark:text-white sm:text-sm" %>
                </div>
              </div>
            </div>

            <%# Actions %>
            <div class="mt-6 flex items-center justify-end gap-3">
              <%= link_to "Cancel", nodes_path, 
                  class: "rounded-lg px-4 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:text-slate-300 dark:hover:bg-white/5",
                  data: { turbo_frame: "install_modal" } %>
              <button type="submit" 
                      class="inline-flex items-center gap-2 rounded-lg bg-gradient-to-r from-indigo-500 to-blue-600 px-4 py-2.5 text-sm font-medium text-white shadow-lg shadow-indigo-500/20 transition-all hover:from-indigo-600 hover:to-blue-700">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
                Start Installation
              </button>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>
