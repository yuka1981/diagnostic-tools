<%= turbo_frame_tag "install_modal" do %>
  <%= render "shared/modal", title: "Install Agent: #{@node.hostname}" do %>
    <div class="px-2" id="install_modal_body">
      <div class="space-y-6">
        <%# Subscription for status updates (Turbo Streams) %>
        <%= turbo_stream_from "agent_install_#{@node.hostname.parameterize}" %>

        <%# High-level status summary %>
        <div id="agent_install_status_<%= @node.hostname.parameterize %>">
          <%= render "nodes/installs/status",
              status: "processing",
              message: "Starting installation using stored credentials...",
              target_host: @node.hostname %>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
