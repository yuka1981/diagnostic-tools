<%= turbo_frame_tag "slide_over_content" do %>
  <% if interface %>
    <div class="space-y-6">
      <div class="flex items-center gap-3 pb-4 border-b border-neutral-4">
        <div class="p-2 rounded bg-primary-1 text-primary-6">
          <%= lucide_icon("zap", class: "w-6 h-6") %>
        </div>
        <div>
          <h3 class="text-lg font-black text-neutral-85"><%= interface["name"] %></h3>
          <p class="text-xs text-neutral-45 font-bold uppercase tracking-tighter"><%= interface["type"] %> Interface</p>
        </div>
      </div>

      <% if interface["type"] == "infiniband" && interface["infiniband"].present? %>
        <% ib = interface["infiniband"] %>
        <div class="card-netbox">
          <div class="card-header bg-neutral-2/50 py-2">
            <h4 class="text-[10px] font-black text-neutral-45 uppercase tracking-widest">HCA Details</h4>
          </div>
          <table class="w-full text-sm">
            <tbody class="divide-y divide-neutral-4">
              <tr>
                <th class="px-4 py-3 text-left font-bold text-neutral-45 w-1/3">HCA Name</th>
                <td class="px-4 py-3 text-neutral-85 font-mono"><%= ib["hca_name"] %></td>
              </tr>
              <tr>
                <th class="px-4 py-3 text-left font-bold text-neutral-45">Port</th>
                <td class="px-4 py-3 text-neutral-85"><%= ib["port"] %></td>
              </tr>
              <tr>
                <th class="px-4 py-3 text-left font-bold text-neutral-45">LID</th>
                <td class="px-4 py-3">
                  <span class="px-2 py-1 rounded bg-primary-1 text-primary-7 font-bold font-mono">
                    <%= ib["lid"] %>
                  </span>
                </td>
              </tr>
              <tr>
                <th class="px-4 py-3 text-left font-bold text-neutral-45">GUID</th>
                <td class="px-4 py-3 text-neutral-85 font-mono text-xs break-all"><%= ib["guid"] %></td>
              </tr>
              <tr>
                <th class="px-4 py-3 text-left font-bold text-neutral-45">Speed</th>
                <td class="px-4 py-3">
                  <% if interface["speed"].present? %>
                    <span class="px-2 py-1 rounded bg-primary-1 text-primary-7 font-bold">
                      <%= interface["speed"] %>
                    </span>
                  <% else %>
                    <span class="text-neutral-15">—</span>
                  <% end %>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      <% end %>

      <div class="card-netbox">
        <div class="card-header bg-neutral-2/50 py-2">
          <h4 class="text-[10px] font-black text-neutral-45 uppercase tracking-widest">Hardware Context</h4>
        </div>
        <table class="w-full text-sm">
          <tbody class="divide-y divide-neutral-4">
            <tr>
              <th class="px-4 py-3 text-left font-bold text-neutral-45 w-1/3">PCI Address</th>
              <td class="px-4 py-3 text-primary-6 font-mono"><%= interface["pci_address"] || "—" %></td>
            </tr>
            <tr>
              <th class="px-4 py-3 text-left font-bold text-neutral-45">Vendor</th>
              <td class="px-4 py-3 text-neutral-85"><%= interface["vendor"] || "—" %></td>
            </tr>
            <tr>
              <th class="px-4 py-3 text-left font-bold text-neutral-45">Model</th>
              <td class="px-4 py-3 text-neutral-85"><%= interface["model"] || "—" %></td>
            </tr>
            <tr>
              <th class="px-4 py-3 text-left font-bold text-neutral-45">NUMA Node</th>
              <td class="px-4 py-3">
                <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-neutral-4 text-neutral-85 font-bold text-xs">
                  <%= interface["numa_node"] || "—" %>
                </span>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="card-netbox">
        <div class="card-header bg-neutral-2/50 py-2">
          <h4 class="text-[10px] font-black text-neutral-45 uppercase tracking-widest">Logical Configuration</h4>
        </div>
        <table class="w-full text-sm">
          <tbody class="divide-y divide-neutral-4">
            <tr>
              <th class="px-4 py-3 text-left font-bold text-neutral-45 w-1/3">MTU</th>
              <td class="px-4 py-3 text-neutral-85"><%= interface["mtu"] %></td>
            </tr>
            <tr>
              <th class="px-4 py-3 text-left font-bold text-neutral-45">Speed</th>
              <td class="px-4 py-3 text-neutral-85 font-bold">
                <% if interface["speed"].present? %>
                  <%= interface["speed"] %>
                <% else %>
                  <span class="text-neutral-15">—</span>
                <% end %>
              </td>
            </tr>
            <tr>
              <th class="px-4 py-3 text-left font-bold text-neutral-45">MAC Address</th>
              <td class="px-4 py-3 text-neutral-45 font-mono text-xs break-all"><%= interface["mac_address"] %></td>
            </tr>
            <% if interface["master"].present? %>
              <tr>
                <th class="px-4 py-3 text-left font-bold text-neutral-45">Master</th>
                <td class="px-4 py-3 text-neutral-85 font-bold"><%= interface["master"] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="flex flex-col items-center justify-center h-full py-12 text-center text-neutral-45">
      <p>Interface information not found.</p>
    </div>
  <% end %>
<% end %>
