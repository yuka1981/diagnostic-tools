<tr id="<%= dom_id(node) %>" class="bg-white hover:bg-teal-50 border-b border-slate-200 transition-colors group">
  <td class="whitespace-nowrap px-3 py-2">
    <div class="flex items-center gap-3">
      <div>
        <p class="text-sm font-bold text-teal-600 hover:underline"><%= link_to node.hostname, node_path(node) %></p>
        <% if node.ip.present? %>
          <p class="text-xs text-slate-500 font-mono"><%= node.ip %></p>
        <% end %>
      </div>
    </div>
  </td>
  <td class="whitespace-nowrap px-3 py-2">
    <span class="inline-flex items-center rounded-sm px-2 py-0.5 text-xs font-bold <%= role_badge_class(node.role) %>">
      <%= node.role.humanize %>
    </span>
  </td>
  <td class="whitespace-nowrap px-3 py-2 text-sm text-slate-700">
    <%= node.arch.presence || "—" %>
  </td>
  <td class="whitespace-nowrap px-3 py-2">
    <%= node_status_badge(node.status) %>
  </td>
  <td class="whitespace-nowrap px-3 py-2 text-sm text-slate-500">
    <%= node.last_seen_at ? time_ago_in_words(node.last_seen_at) + " ago" : "Never" %>
  </td>
  <td class="whitespace-nowrap px-3 py-2 text-right text-sm font-medium">
    <div class="flex items-center justify-end gap-2">
      <% if current_user.approver? %>
        <%# Install Action %>
        <% if node.agent_push? %>
           <span class="text-slate-300 cursor-not-allowed" title="hpc-agent is already installed">
             <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
               <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
             </svg>
           </span>
        <% else %>
           <%= link_to new_node_install_path(hostname: node.hostname, arch: node.arch),
               class: "text-slate-400 hover:text-blue-600 transition-colors",
               title: "Install Agent",
               data: { turbo_frame: "install_modal" } do %>
             <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
               <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
             </svg>
           <% end %>
        <% end %>

        <%# Uninstall Action %>
        <% if node.agent_push? %>
          <%= link_to new_node_uninstall_path(hostname: node.hostname),
              class: "text-slate-400 hover:text-red-600 transition-colors",
              title: "Uninstall Agent",
              data: { turbo_frame: "uninstall_modal" } do %>
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          <% end %>
        <% else %>
           <span class="text-slate-300 cursor-not-allowed" title="hpc-agent is not installed">
             <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
               <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
             </svg>
           </span>
        <% end %>

        <%# Collect Action %>
        <%= button_to collect_node_path(node), 
            method: :post,
            class: "text-slate-400 hover:text-blue-600 transition-colors",
            title: "Collect Info",
            data: { turbo_submits_with: "..." } do %>
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
        <% end %>
      <% end %>

      <%= link_to edit_node_path(node), 
          class: "text-slate-400 hover:text-blue-600 transition-colors",
          title: "Edit",
          data: { turbo_frame: "node_modal" } do %>
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
        </svg>
      <% end %>

      <% if current_user.approver? %>
        <%= button_to node_path(node),
            method: :delete,
            class: "text-slate-400 hover:text-blue-600 transition-colors",
            title: "Delete",
            data: { turbo_confirm: "Are you sure you want to delete this node?" } do %>
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h14" />
          </svg>
        <% end %>
      <% end %>
    </div>
  </td>
</tr>
