<tr id="<%= dom_id(node) %>" class="bg-white hover:bg-primary-1 border-b border-neutral-8 transition-colors group">
  <% if current_user.approver? %>
    <td class="whitespace-nowrap">
      <div class="flex items-center justify-center h-full py-2">
        <input type="checkbox"
               value="<%= node.id %>"
               data-bulk-select-target="checkbox"
               data-action="change->bulk-select#toggle"
               class="rounded border-neutral-15 text-primary-6 focus:ring-primary-5">
      </div>
    </td>
  <% end %>
  <td class="whitespace-nowrap px-3 py-2">
    <div class="flex items-center gap-3">
      <div>
        <p class="text-sm font-bold text-primary-6 hover:underline"><%= link_to node.hostname, node_path(node) %></p>
        <% if node.ip.present? %>
          <p class="text-xs text-neutral-45 font-mono"><%= node.ip %></p>
        <% end %>
      </div>
    </div>
  </td>
  <td class="whitespace-nowrap px-3 py-2">
    <span class="inline-flex items-center rounded-sm px-2 py-0.5 text-xs font-bold <%= role_badge_class(node.role) %>">
      <%= node.role.humanize %>
    </span>
  </td>
  <td class="whitespace-nowrap px-3 py-2 text-sm text-neutral-85">
    <%= node.arch.presence || "—" %>
  </td>
  <td class="whitespace-nowrap px-3 py-2">
    <%= node_status_badge(node.status) %>
  </td>
  <td class="whitespace-nowrap px-3 py-2 text-sm text-neutral-45">
    <%= node.last_seen_at ? time_ago_in_words(node.last_seen_at) + " ago" : "Never" %>
  </td>
  <td class="whitespace-nowrap px-3 py-2 text-right text-sm font-medium">
    <div class="flex items-center justify-end gap-2">
      <% if current_user.approver? %>
        <%# Install Action %>
        <% if node.agent_push? %>
           <span class="text-neutral-15 cursor-not-allowed" title="hpc-agent is already installed">
             <%= lucide_icon("download", class: "h-4 w-4") %>
           </span>
        <% else %>
           <%= link_to new_node_install_path(hostname: node.hostname, arch: node.arch),
               class: "text-neutral-25 hover:text-primary-6 transition-colors",
               title: "Install Agent",
               data: { turbo_frame: "install_modal" } do %>
             <%= lucide_icon("download", class: "h-4 w-4") %>
           <% end %>
        <% end %>

        <%# Update Agent Action %>
        <% if node.agent_push? %>
          <%= link_to new_node_update_path(node),
              class: "text-neutral-25 hover:text-success-6 transition-colors",
              title: "Update Agent",
              data: { turbo_frame: "update_modal" } do %>
            <%= lucide_icon("upload", class: "h-4 w-4") %>
          <% end %>
        <% else %>
           <span class="text-neutral-15 cursor-not-allowed" title="hpc-agent is not installed">
             <%= lucide_icon("upload", class: "h-4 w-4") %>
           </span>
        <% end %>

        <%# Uninstall Action %>
        <% if node.agent_push? %>
          <%= link_to new_node_uninstall_path(hostname: node.hostname),
              class: "text-neutral-25 hover:text-error-6 transition-colors",
              title: "Uninstall Agent",
              data: { turbo_frame: "uninstall_modal" } do %>
            <%= lucide_icon("circle-x", class: "h-4 w-4") %>
          <% end %>
        <% else %>
           <span class="text-neutral-15 cursor-not-allowed" title="hpc-agent is not installed">
             <%= lucide_icon("circle-x", class: "h-4 w-4") %>
           </span>
        <% end %>

        <%# Collect Action %>
        <%= button_to collect_node_path(node),
            method: :post,
            form: { class: "inline-flex" },
            class: "text-neutral-25 hover:text-primary-6 transition-colors",
            title: "Collect Info",
            data: { turbo_submits_with: "..." } do %>
          <%= lucide_icon("refresh-cw", class: "h-4 w-4") %>
        <% end %>
      <% end %>

      <%= link_to edit_node_path(node),
          class: "text-neutral-25 hover:text-primary-6 transition-colors",
          title: "Edit",
          data: { turbo_frame: "node_modal" } do %>
        <%= lucide_icon("pencil", class: "h-4 w-4") %>
      <% end %>

      <% if current_user.approver? %>
        <%= button_to node_path(node),
            method: :delete,
            form: { class: "inline-flex" },
            class: "text-neutral-25 hover:text-primary-6 transition-colors",
            title: "Delete",
            data: { turbo_confirm: "Are you sure you want to delete this node?" } do %>
          <%= lucide_icon("trash-2", class: "h-4 w-4") %>
        <% end %>
      <% end %>
    </div>
  </td>
</tr>
