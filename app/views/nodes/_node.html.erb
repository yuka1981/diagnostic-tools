<tr id="<%= dom_id(node) %>" class="hover:bg-gray-50 dark:hover:bg-white/5 transition-colors">
  <td class="whitespace-nowrap px-6 py-4">
    <div class="flex items-center gap-3">
      <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-slate-100 dark:bg-white/10">
        <svg class="h-4 w-4 text-slate-600 dark:text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2" />
        </svg>
      </div>
      <div>
        <p class="text-sm font-medium text-gray-900 dark:text-white"><%= node.hostname %></p>
        <% if node.ip.present? %>
          <p class="text-xs text-gray-500 dark:text-slate-400"><%= node.ip %></p>
        <% end %>
      </div>
    </div>
  </td>
  <td class="whitespace-nowrap px-6 py-4">
    <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= role_badge_class(node.role) %>">
      <%= node.role.humanize %>
    </span>
  </td>
  <td class="whitespace-nowrap px-6 py-4">
    <% if node.online? %>
      <span class="inline-flex items-center gap-1.5 text-sm text-emerald-600 dark:text-emerald-400">
        <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Online
      </span>
    <% else %>
      <span class="inline-flex items-center gap-1.5 text-sm text-gray-500 dark:text-slate-400">
        <span class="h-2 w-2 rounded-full bg-gray-400"></span>
        Offline
      </span>
    <% end %>
  </td>
  <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500 dark:text-slate-400">
    <%= node.last_seen_at ? time_ago_in_words(node.last_seen_at) + " ago" : "Never" %>
  </td>
  <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-medium">
    <div class="flex items-center justify-end gap-2">
      <%= link_to node_path(node),
          class: "inline-flex items-center rounded-md bg-white px-2.5 py-1.5 text-xs font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 dark:bg-white/5 dark:text-white dark:ring-white/10 dark:hover:bg-white/10 transition-all" do %>
        View
      <% end %>

            <% if current_user.approver? %>
              <% if node.agent_push? %>
                <span class="inline-flex items-center rounded-md bg-gray-50 px-2.5 py-1.5 text-xs font-semibold text-gray-400 ring-1 ring-inset ring-gray-200 cursor-not-allowed dark:bg-gray-800/50 dark:text-gray-500 dark:ring-white/5" title="hpc-agent is already installed">
                  Install
                </span>
              <% else %>
                <%= link_to new_node_install_path(hostname: node.hostname, arch: node.arch),
                    class: "inline-flex items-center rounded-md bg-indigo-50 px-2.5 py-1.5 text-xs font-semibold text-indigo-700 shadow-sm ring-1 ring-inset ring-indigo-700/10 hover:bg-indigo-100 dark:bg-indigo-500/10 dark:text-indigo-400 dark:ring-indigo-500/20 dark:hover:bg-indigo-500/20 transition-all",
                    data: { turbo_frame: "install_modal" } do %>
                  Install
                <% end %>
              <% end %>

              <%= link_to new_node_uninstall_path(hostname: node.hostname),
                  class: "inline-flex items-center rounded-md bg-white px-2.5 py-1.5 text-xs font-semibold text-red-600 shadow-sm ring-1 ring-inset ring-red-200 hover:bg-red-50 transition-all",
                  data: { turbo_frame: "uninstall_modal" } do %>
                Uninstall
              <% end %>

              <%= button_to test_connection_node_path(node), 
                  method: :post,
                  class: "inline-flex items-center rounded-md bg-indigo-50 px-2.5 py-1.5 text-xs font-semibold text-indigo-700 shadow-sm ring-1 ring-inset ring-indigo-700/10 hover:bg-indigo-100 dark:bg-indigo-500/10 dark:text-indigo-400 dark:ring-indigo-500/20 dark:hover:bg-indigo-500/20 transition-all",
                  data: { turbo_submits_with: "..." } do %>
                Test
              <% end %>
      
              <%= button_to collect_node_path(node), 
                  method: :post,
                  class: "inline-flex items-center rounded-md bg-blue-50 px-2.5 py-1.5 text-xs font-semibold text-blue-700 shadow-sm ring-1 ring-inset ring-blue-700/10 hover:bg-blue-100 dark:bg-blue-500/10 dark:text-blue-400 dark:ring-blue-500/20 dark:hover:bg-blue-500/20 transition-all",
                  data: { turbo_submits_with: "..." } do %>
                Collect
              <% end %>
      
              <%= link_to edit_node_path(node), 
                  class: "inline-flex items-center rounded-md bg-amber-50 px-2.5 py-1.5 text-xs font-semibold text-amber-700 shadow-sm ring-1 ring-inset ring-amber-700/10 hover:bg-amber-100 dark:bg-amber-500/10 dark:text-amber-400 dark:ring-amber-500/20 dark:hover:bg-amber-500/20 transition-all",
                  data: { turbo_frame: "node_modal" } do %>
                Edit
              <% end %>
        <%= button_to node_path(node),
            method: :delete,
            class: "inline-flex items-center rounded-md bg-red-50 px-2.5 py-1.5 text-xs font-semibold text-red-700 shadow-sm ring-1 ring-inset ring-red-700/10 hover:bg-red-100 dark:bg-red-500/10 dark:text-red-400 dark:ring-red-500/20 dark:hover:bg-red-500/20 transition-all",
            data: { turbo_confirm: "Are you sure you want to delete this node?" } do %>
          Delete
        <% end %>
      <% end %>
    </div>
  </td>
</tr>
