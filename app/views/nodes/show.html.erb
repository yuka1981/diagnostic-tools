<% content_for(:page_title) { @node.hostname } %>
<% content_for(:breadcrumbs) do %>
  <span class="mx-2">/</span>
  <%= link_to "Nodes", nodes_path, class: "hover:text-teal-600 font-bold" %>
  <span class="mx-2">/</span>
  <span class="font-medium text-slate-700"><%= @node.hostname %></span>
<% end %>

<%= turbo_stream_from @node %>

<div data-controller="slide-over">
<%# Header %>
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
  <div>
    <div class="flex items-center gap-3">
      <h1 class="text-2xl font-bold text-slate-900"><%= @node.hostname %></h1>
      <%= node_status_badge(@node.status) %>
    </div>
    <div class="mt-1 flex items-center gap-4 text-sm text-slate-500">
      <span class="font-mono">UUID: <%= @node.id %></span>
      <span>•</span>
      <span>Added <%= time_ago_in_words(@node.created_at) %> ago</span>
    </div>
  </div>

  <div class="flex items-center gap-2">
    <% if current_user.approver? %>
      <%= button_to collect_node_path(@node), 
          method: :post,
          class: "btn-primary",
          data: { turbo_submits_with: "Collecting..." } do %>
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        Collect
      <% end %>

      <% if @node.agent_push? %>
        <%= link_to new_node_benchmark_run_path(@node),
            class: "btn-secondary",
            data: { turbo_frame: "modal" } do %>
          <svg class="h-4 w-4 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          Benchmark
        <% end %>
      <% end %>

      <%= link_to edit_node_path(@node), 
          class: "btn-secondary",
          data: { turbo_frame: "node_modal" } do %>
        <svg class="h-4 w-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
        </svg>
        Edit
      <% end %>

      <%= button_to node_path(@node),
          method: :delete,
          class: "btn-danger",
          data: { turbo_confirm: "Are you sure you want to delete this node?" } do %>
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h14" />
        </svg>
        Delete
      <% end %>
    <% end %>
  </div>
</div>

<%# Tabs & Content %>
<div data-controller="tabs" data-tabs-active-index-value="0">
  <%# Tab Navigation %>
  <div class="mb-6 border-b border-slate-200">
    <nav class="-mb-px flex gap-6 tabs nav-tabs" aria-label="Tabs">
      <a href="#" 
         data-tabs-target="tab" 
         data-action="click->tabs#select"
         class="border-transparent text-slate-500 hover:border-slate-300 hover:text-slate-700 whitespace-nowrap border-b-2 py-4 px-1 text-sm font-bold uppercase transition-colors"
         aria-current="page">
        Overview
      </a>
      <a href="#" 
         data-tabs-target="tab" 
         data-action="click->tabs#select"
         class="border-transparent text-slate-500 hover:border-slate-300 hover:text-slate-700 whitespace-nowrap border-b-2 py-4 px-1 text-sm font-bold uppercase transition-colors">
        Hardware
      </a>
      <a href="#" 
         data-tabs-target="tab" 
         data-action="click->tabs#select"
         class="border-transparent text-slate-500 hover:border-slate-300 hover:text-slate-700 whitespace-nowrap border-b-2 py-4 px-1 text-sm font-bold uppercase transition-colors">
        Benchmark History
      </a>
      <a href="#" 
         data-tabs-target="tab" 
         data-action="click->tabs#select"
         class="border-transparent text-slate-500 hover:border-slate-300 hover:text-slate-700 whitespace-nowrap border-b-2 py-4 px-1 text-sm font-bold uppercase transition-colors">
        Logs
      </a>
    </nav>
  </div>

  <%# Tab Panels %>
  <div class="grid grid-cols-12 gap-6">
    <%# Panel 1: Overview %>
    <div data-tabs-target="panel" class="col-span-12 outline-none" role="tabpanel" tabindex="0">
      <%= render "nodes/overview", node: @node %>
    </div>

    <%# Panel 2: Hardware %>
    <div data-tabs-target="panel" class="hidden col-span-12 outline-none" role="tabpanel" tabindex="0">
      <%= render "nodes/hardware", node: @node %>
    </div>

    <%# Panel 3: Benchmark History %>
    <div data-tabs-target="panel" class="hidden col-span-12 outline-none" role="tabpanel" tabindex="0">
      <div class="card-netbox">
         <div class="card-header">
           <h3 class="card-title text-xs font-bold text-slate-500 uppercase">Benchmark History</h3>
         </div>
         <div class="overflow-x-auto">
            <% if @node.benchmark_runs.any? %>
              <%= render "nodes/benchmark_runs/table", benchmark_runs: @node.benchmark_runs.order(created_at: :desc) rescue render partial: "shared/simple_benchmark_table", locals: { runs: @node.benchmark_runs } %>
            <% else %>
              <div class="p-8 text-center text-slate-500">No benchmarks recorded.</div>
            <% end %>
         </div>
      </div>
    </div>

    <%# Panel 4: Logs %>
    <div data-tabs-target="panel" class="hidden col-span-12 outline-none" role="tabpanel" tabindex="0">
      <%= render "nodes/logs", node: @node %>
    </div>
  </div>
</div>

<%= turbo_frame_tag "modal" %>
<%= turbo_frame_tag "node_modal" %>

<%# Slide-over Panel for Benchmark Run Details %>
<%= render "benchmark_runs/slide_over" %>
</div>
