<% content_for(:page_title) { @node.hostname } %>
<% content_for(:breadcrumbs) do %>
  <span class="mx-2">/</span>
  <%= link_to "Nodes", nodes_path, class: "hover:text-primary-6 font-bold" %>
  <span class="mx-2">/</span>
  <span class="font-medium text-neutral-85"><%= @node.hostname %></span>
<% end %>

<%= turbo_stream_from @node %>

<div data-controller="slide-over">
<%# Header %>
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
  <div>
    <div class="flex items-center gap-3">
      <h1 class="text-2xl font-bold text-neutral-85"><%= @node.hostname %></h1>
      <%= node_status_badge(@node.status) %>
    </div>
    <div class="mt-1 flex items-center gap-4 text-sm text-neutral-45">
      <span class="font-mono">UUID: <%= @node.id %></span>
      <% if @node.agent_version.present? %>
        <span class="font-mono text-primary-6">Agent <%= @node.agent_version %></span>
      <% end %>
      <span>•</span>
      <span>Added <%= time_ago_in_words(@node.created_at) %> ago</span>
      <% if @node.agent_push? && current_user.approver? %>
        <span>•</span>
        <%= link_to "/uninstall-hpc-agent.sh",
            class: "text-neutral-25 hover:text-error-6 transition-colors",
            title: "Download manual uninstall script",
            download: "uninstall-hpc-agent.sh" do %>
          <span class="flex items-center gap-1">
            <%= lucide_icon("download", class: "h-3 w-3") %>
            Uninstall Script
          </span>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="flex items-center gap-2">
    <% if current_user.approver? %>
      <%= button_to collect_node_path(@node),
          method: :post,
          class: "btn-primary",
          data: { turbo_submits_with: "Collecting..." } do %>
        <%= lucide_icon("refresh-cw", class: "h-4 w-4") %>
        Collect
      <% end %>

      <% if @node.agent_push? %>
        <%= link_to new_node_benchmark_run_path(@node),
            class: "btn-secondary",
            data: { turbo_frame: "modal" } do %>
          <%= lucide_icon("zap", class: "h-4 w-4 text-login-5") %>
          Benchmark
        <% end %>

        <%= link_to new_node_update_path(@node),
            class: "btn-secondary",
            data: { turbo_frame: "update_modal" } do %>
          <%= lucide_icon("upload", class: "h-4 w-4 text-success-5") %>
          Update Agent
        <% end %>
      <% end %>

      <%= link_to edit_node_path(@node),
          class: "btn-secondary",
          data: { turbo_frame: "node_modal" } do %>
        <%= lucide_icon("square-pen", class: "h-4 w-4 text-warning-5") %>
        Edit
      <% end %>

      <%= button_to node_path(@node),
          method: :delete,
          class: "btn-danger",
          data: { turbo_confirm: "Are you sure you want to delete this node?" } do %>
        <%= lucide_icon("trash-2", class: "h-4 w-4") %>
        Delete
      <% end %>
    <% end %>
  </div>
</div>

<%# Tabs & Content %>
<div data-controller="tabs" data-tabs-active-index-value="0">
  <%# Tab Navigation %>
  <div class="mb-6 border-b border-neutral-8">
    <nav class="-mb-px flex gap-6 tabs nav-tabs" aria-label="Tabs">
      <a href="#" 
         data-tabs-target="tab" 
         data-action="click->tabs#select"
         class="border-transparent text-neutral-45 hover:border-neutral-15 hover:text-neutral-85 whitespace-nowrap border-b-2 py-4 px-1 text-sm font-bold uppercase transition-colors"
         aria-current="page">
        Overview
      </a>
      <a href="#" 
         data-tabs-target="tab" 
         data-action="click->tabs#select"
         class="border-transparent text-neutral-45 hover:border-neutral-15 hover:text-neutral-85 whitespace-nowrap border-b-2 py-4 px-1 text-sm font-bold uppercase transition-colors">
        Hardware
      </a>
      <a href="#" 
         data-tabs-target="tab" 
         data-action="click->tabs#select"
         class="border-transparent text-neutral-45 hover:border-neutral-15 hover:text-neutral-85 whitespace-nowrap border-b-2 py-4 px-1 text-sm font-bold uppercase transition-colors">
        Benchmark History
      </a>
      <a href="#"
         data-tabs-target="tab"
         data-action="click->tabs#select"
         class="border-transparent text-neutral-45 hover:border-neutral-15 hover:text-neutral-85 whitespace-nowrap border-b-2 py-4 px-1 text-sm font-bold uppercase transition-colors">
        Logs
      </a>
      <a href="#"
         data-tabs-target="tab"
         data-action="click->tabs#select"
         class="border-transparent text-neutral-45 hover:border-neutral-15 hover:text-neutral-85 whitespace-nowrap border-b-2 py-4 px-1 text-sm font-bold uppercase transition-colors">
        Profiling
      </a>
    </nav>
  </div>

  <%# Tab Panels %>
  <div class="grid grid-cols-12 gap-6">
    <%# Panel 1: Overview %>
    <div data-tabs-target="panel" class="col-span-12 outline-none" role="tabpanel" tabindex="0">
      <%= render "nodes/overview", node: @node %>
    </div>

    <%# Panel 2: Hardware %>
    <div data-tabs-target="panel" class="hidden col-span-12 outline-none" role="tabpanel" tabindex="0">
      <%= render "nodes/hardware", node: @node %>
    </div>

    <%# Panel 3: Benchmark History %>
    <div data-tabs-target="panel" class="hidden col-span-12 outline-none" role="tabpanel" tabindex="0">
      <div class="card-netbox">
         <div class="card-header">
           <h3 class="card-title text-xs font-bold text-neutral-45 uppercase">Benchmark History</h3>
         </div>
         <div class="overflow-x-auto">
            <% if @node.benchmark_runs.any? %>
              <%= render "nodes/benchmark_runs/table", benchmark_runs: @node.benchmark_runs.order(created_at: :desc) rescue render partial: "shared/simple_benchmark_table", locals: { runs: @node.benchmark_runs } %>
            <% else %>
              <div class="p-8 text-center text-neutral-45">No benchmarks recorded.</div>
            <% end %>
         </div>
      </div>
    </div>

    <%# Panel 4: Logs %>
    <div data-tabs-target="panel" class="hidden col-span-12 outline-none" role="tabpanel" tabindex="0">
      <%= render "nodes/logs", node: @node %>
    </div>

    <%# Panel 5: Profiling %>
    <div data-tabs-target="panel" class="hidden col-span-12 outline-none" role="tabpanel" tabindex="0">
      <%= render "nodes/profiling", node: @node %>
    </div>
  </div>
</div>

<%= turbo_frame_tag "modal" %>
<%= turbo_frame_tag "node_modal" %>
<%= turbo_frame_tag "update_modal" %>
<%= turbo_frame_tag "profiling_modal" %>

<%# Slide-over Panel for Benchmark Run Details %>
<%= render "benchmark_runs/slide_over" %>
</div>
