<% content_for(:page_title) { @node.hostname } %>

<div class="mb-6">
  <%= link_to nodes_path, class: "inline-flex items-center gap-2 text-sm text-gray-500 hover:text-gray-700 dark:text-slate-400 dark:hover:text-slate-300" do %>
    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
    </svg>
    Back to Nodes
  <% end %>
</div>

<div id="<%= dom_id(@node, :details) %>">
  <%= render "nodes/details", node: @node %>
</div>