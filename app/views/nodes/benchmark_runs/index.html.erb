<% breadcrumb_trail([
  { title: "Nodes", path: nodes_path },
  { title: @node.hostname, path: node_path(@node) },
  { title: "Benchmark Runs" }
]) %>

<div class="mb-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-neutral-85">Benchmark Runs for <%= @node.hostname %></h1>
    <% if current_user.approver? %>
      <%= link_to "Run Benchmark", new_node_benchmark_run_path(@node), class: "btn-primary" %>
    <% end %>
  </div>
</div>

<div class="card-netbox">
  <% if @benchmark_runs.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-neutral-8 text-sm">
        <thead class="bg-neutral-2">
          <tr>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Recipe</th>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Status</th>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Gflops</th>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Duration</th>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Created At</th>
            <th scope="col" class="relative px-3 py-2 border-b">
              <span class="sr-only">Actions</span>
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-neutral-8 bg-white">
          <% @benchmark_runs.each do |run| %>
            <tr class="hover:bg-neutral-2">
              <td class="whitespace-nowrap px-3 py-2">
                <p class="text-sm font-medium text-neutral-85"><%= run.benchmark_recipe&.name || "N/A" %></p>
                <p class="text-xs text-neutral-45"><%= run.benchmark_recipe&.version %></p>
              </td>
              <td class="whitespace-nowrap px-3 py-2">
                <%= render StatusBadgeComponent.new(status: run.status) %>
              </td>
              <td class="whitespace-nowrap px-3 py-2 text-sm text-neutral-45 font-mono">
                <%= run.metrics&.dig("gflops") ? number_with_precision(run.metrics["gflops"], precision: 2, strip_insignificant_zeros: true) : "-" %>
              </td>
              <td class="whitespace-nowrap px-3 py-2 text-sm text-neutral-45">
                <%= run.duration ? distance_of_time_in_words(run.duration) : "-" %>
              </td>
              <td class="whitespace-nowrap px-3 py-2 text-sm text-neutral-45">
                <%= l(run.created_at, format: :short) %>
              </td>
              <td class="whitespace-nowrap px-3 py-2 text-right text-sm">
                <%= link_to "View", benchmark_run_path(run), class: "text-primary-6 hover:text-primary-7 font-medium" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @benchmark_runs.total_pages > 1 %>
      <div class="border-t border-neutral-8 bg-neutral-2 px-6 py-4">
        <nav class="flex items-center justify-between" aria-label="Pagination">
          <div class="hidden sm:block">
            <p class="text-xs font-bold text-neutral-45 uppercase">
              Showing
              <span class="text-neutral-85"><%= @benchmark_runs.offset_value + 1 %></span>
              to
              <span class="text-neutral-85"><%= [@benchmark_runs.offset_value + @benchmark_runs.limit_value, @benchmark_runs.total_count].min %></span>
              of
              <span class="text-neutral-85"><%= @benchmark_runs.total_count %></span>
              results
            </p>
          </div>
          <div class="flex flex-1 justify-between sm:justify-end gap-2">
            <% if @benchmark_runs.prev_page %>
              <%= link_to "Previous", node_benchmark_runs_path(@node, page: @benchmark_runs.prev_page), class: "btn-secondary" %>
            <% end %>
            <% if @benchmark_runs.next_page %>
              <%= link_to "Next", node_benchmark_runs_path(@node, page: @benchmark_runs.next_page), class: "btn-secondary" %>
            <% end %>
          </div>
        </nav>
      </div>
    <% end %>
  <% else %>
    <div class="flex flex-col items-center justify-center py-12 text-center">
      <div class="h-12 w-12 rounded-full bg-neutral-4 flex items-center justify-center mb-4">
        <%= lucide_icon("bar-chart-3", class: "h-6 w-6 text-neutral-25") %>
      </div>
      <p class="text-sm font-medium text-neutral-85">No benchmark runs for this node yet</p>
      <% if current_user.approver? %>
        <%= link_to "Run Benchmark", new_node_benchmark_run_path(@node), class: "mt-4 btn-primary" %>
      <% end %>
    </div>
  <% end %>
</div>
