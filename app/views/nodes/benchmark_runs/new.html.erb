<%= turbo_frame_tag "modal" do %>
  <%= render "shared/modal", title: "Run Benchmark: #{@node.hostname}", max_width: 'max-w-xl', testid: 'nodes-benchmark-modal' do %>
    <div class="space-y-4">
      <%# Build recipe data for Stimulus controller %>
      <% recipes_data = @benchmark_recipes.each_with_object({}) do |recipe, hash|
        hash[recipe.id.to_s] = { default_profile: recipe.default_profile }
      end %>

      <%= form_with model: @form, url: node_benchmark_runs_path(@node), method: :post,
          data: {
            turbo_frame: "_top",
            controller: "benchmark-recipe",
            benchmark_recipe_recipes_value: recipes_data.to_json,
            testid: "nodes-benchmark-form"
          },
          class: "space-y-4" do |f| %>
        <% if @form.errors.any? %>
          <div class="rounded-md bg-error-1 p-4 border border-error-2">
            <h3 class="text-sm font-bold text-error-8">Please correct the errors below</h3>
            <div class="mt-2 text-xs text-error-7">
              <ul role="list" class="list-disc pl-5 space-y-1">
                <% @form.errors.full_messages.each do |msg| %>
                  <li><%= msg %></li>
                <% end %>
              </ul>
            </div>
          </div>
        <% end %>

        <div>
          <%= f.label :benchmark_recipe_id, "Benchmark Recipe", class: "block text-sm font-bold text-neutral-85 mb-1" %>
          <%= f.select :benchmark_recipe_id,
              options_from_collection_for_select(@benchmark_recipes, :id, :display_name, @form.benchmark_recipe_id),
              { prompt: "Select a recipe..." },
              { class: "block w-full rounded-md border-neutral-15 shadow-sm focus:border-primary-5 focus:ring-primary-5 sm:text-sm",
                data: {
                  benchmark_recipe_target: "select",
                  action: "change->benchmark-recipe#showDefaults",
                  testid: "nodes-benchmark-recipe"
                } } %>
          <p class="mt-1 text-[10px] text-neutral-45 italic">
            Select the benchmark recipe to run on this node.
          </p>
        </div>

        <div data-benchmark-recipe-target="defaults" class="hidden" data-testid="nodes-benchmark-defaults">
          <div class="rounded-md bg-neutral-2 p-3 border border-neutral-8">
            <div class="flex items-center justify-between mb-2">
              <h4 class="text-xs font-bold text-neutral-45">Recipe Default Profile</h4>
              <button type="button"
                      class="text-[10px] text-primary-6 hover:text-primary-8 font-medium"
                      data-action="click->benchmark-recipe#populateOverrides"
                      data-testid="nodes-benchmark-copy-defaults">
                Copy to overrides
              </button>
            </div>
            <pre data-benchmark-recipe-target="defaultsContent" class="text-xs text-neutral-85 font-mono whitespace-pre-wrap"></pre>
          </div>
        </div>

        <div>
          <%= f.label :argument_overrides, "Argument Overrides (Optional)", class: "block text-sm font-bold text-neutral-85 mb-1" %>
          <%= f.text_area :argument_overrides,
              rows: 3,
              class: "block w-full rounded-md border-neutral-15 shadow-sm focus:border-primary-5 focus:ring-primary-5 sm:text-sm font-mono",
              placeholder: '{"nx": 128, "ny": 128}',
              data: { benchmark_recipe_target: "overrides", testid: "nodes-benchmark-overrides" } %>
          <p class="mt-1 text-[10px] text-neutral-45 italic">
            Optional JSON to override recipe defaults. Leave blank to use recipe defaults.
          </p>
        </div>

        <div>
          <%= f.label :log_path, "Log File Path (Optional)", class: "block text-sm font-bold text-neutral-85 mb-1" %>
          <%= f.text_field :log_path,
              class: "block w-full rounded-md border-neutral-15 shadow-sm focus:border-primary-5 focus:ring-primary-5 sm:text-sm font-mono",
              placeholder: "/tmp/hpcg.log",
              data: { testid: "nodes-benchmark-logpath" } %>
          <p class="mt-1 text-[10px] text-neutral-45 italic">
            Leave blank to use the default generated log file.
          </p>
        </div>

        <div class="flex items-center justify-end gap-3 pt-4 border-t border-neutral-4">
          <button type="button" class="btn-secondary" data-action="modal#close" data-testid="nodes-benchmark-cancel">Cancel</button>
          <%= f.submit "Start Benchmark", class: "btn-primary", data: { testid: "nodes-benchmark-submit" } %>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
