<%= turbo_frame_tag "modal" do %>
  <%= render "shared/modal", title: "Run Benchmark: #{@node.hostname}", max_width: 'max-w-xl' do %>
    <div class="space-y-4">
      <%# Configuration Summary %>
      <div class="card-netbox">
        <div class="card-header bg-slate-50">
          <h4 class="text-xs font-bold uppercase text-slate-600">Configuration</h4>
        </div>
        <table class="w-full text-sm">
          <tbody class="divide-y divide-slate-100">
            <tr>
              <td class="px-3 py-2 text-slate-500 font-medium w-1/3">Working Directory</td>
              <td class="px-3 py-2 font-mono text-slate-700"><%= @preflight.config[:work_dir] %></td>
              <td class="px-3 py-1 text-right">
                <% case @preflight.config[:work_dir_source] %>
                <% when :node %>
                  <span class="inline-flex items-center rounded-full bg-blue-50 px-2 py-0.5 text-[10px] font-medium text-blue-700">Node</span>
                <% when :global %>
                  <span class="inline-flex items-center rounded-full bg-purple-50 px-2 py-0.5 text-[10px] font-medium text-purple-700">Global</span>
                <% else %>
                  <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-medium text-slate-600">Default</span>
                <% end %>
              </td>
            </tr>
            <tr>
              <td class="px-3 py-2 text-slate-500 font-medium">Agent Path</td>
              <td class="px-3 py-2 font-mono text-slate-700" colspan="2"><%= @preflight.config[:agent_path] %></td>
            </tr>
            <% if @preflight.config[:server_url].present? %>
            <tr>
              <td class="px-3 py-2 text-slate-500 font-medium">Callback URL</td>
              <td class="px-3 py-2 font-mono text-slate-700 text-xs" colspan="2"><%= @preflight.config[:server_url] %></td>
            </tr>
            <% end %>
            <tr>
              <td class="px-3 py-2 text-slate-500 font-medium">API Token</td>
              <td class="px-3 py-2 text-slate-700">
                <% case @preflight.config[:token_source] %>
                <% when :node %>
                  <span class="text-green-600">Configured</span>
                <% when :global %>
                  <span class="text-green-600">Using global</span>
                <% else %>
                  <span class="text-amber-600">Not configured</span>
                <% end %>
              </td>
              <td class="px-3 py-1 text-right">
                <% case @preflight.config[:token_source] %>
                <% when :node %>
                  <span class="inline-flex items-center rounded-full bg-blue-50 px-2 py-0.5 text-[10px] font-medium text-blue-700">Node</span>
                <% when :global %>
                  <span class="inline-flex items-center rounded-full bg-purple-50 px-2 py-0.5 text-[10px] font-medium text-purple-700">Global</span>
                <% end %>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <%# Preflight Checks %>
      <div class="card-netbox">
        <div class="card-header bg-slate-50">
          <h4 class="text-xs font-bold uppercase text-slate-600">Pre-flight Checks</h4>
        </div>
        <div class="divide-y divide-slate-100">
          <% @preflight.checks.each do |check| %>
            <div class="px-3 py-2 flex items-start gap-3">
              <% if check.passed %>
                <%= lucide_icon("circle-check", class: "h-5 w-5 text-green-500 flex-shrink-0") %>
              <% else %>
                <%= lucide_icon("circle-x", class: "h-5 w-5 text-red-500 flex-shrink-0") %>
              <% end %>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-slate-700"><%= check.name %></p>
                <p class="text-xs text-slate-500"><%= check.message %></p>
                <% if check.details.present? && !check.passed %>
                  <div class="mt-1 text-xs text-slate-600 bg-slate-50 rounded p-2 whitespace-pre-wrap font-mono"><%= check.details %></div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <%# Error with Quick Fix Links %>
      <% if @preflight.failed_checks.any? %>
        <div class="rounded-md bg-amber-50 p-4 border border-amber-200">
          <div class="flex">
            <%= lucide_icon("alert-triangle", class: "h-5 w-5 text-amber-400 flex-shrink-0") %>
            <div class="ml-3">
              <h3 class="text-sm font-bold text-amber-800">Configuration issues detected</h3>
              <div class="mt-2 text-xs text-amber-700">
                <p>Please fix the issues above before running the benchmark.</p>
              </div>
              <div class="mt-3 flex flex-wrap gap-2">
                <%= link_to "Edit Node Settings", edit_node_path(@node),
                    class: "inline-flex items-center rounded-md bg-amber-100 px-2.5 py-1.5 text-xs font-semibold text-amber-800 hover:bg-amber-200",
                    data: { turbo_frame: "_top" } %>
                <%= link_to "Global Settings", settings_agent_path,
                    class: "inline-flex items-center rounded-md bg-amber-100 px-2.5 py-1.5 text-xs font-semibold text-amber-800 hover:bg-amber-200",
                    data: { turbo_frame: "_top" } %>
                <%= link_to "API Keys", api_keys_path,
                    class: "inline-flex items-center rounded-md bg-amber-100 px-2.5 py-1.5 text-xs font-semibold text-amber-800 hover:bg-amber-200",
                    data: { turbo_frame: "_top" } %>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <%# Form - only show if preflight passed %>
      <% if @preflight.success? %>
        <%# Build recipe data for Stimulus controller %>
        <% recipes_data = @benchmark_recipes.each_with_object({}) do |recipe, hash|
          hash[recipe.id.to_s] = { default_profile: recipe.default_profile }
        end %>

        <%= form_with model: @form, url: node_benchmark_runs_path(@node), method: :post,
            data: {
              turbo_frame: "_top",
              controller: "benchmark-recipe",
              benchmark_recipe_recipes_value: recipes_data.to_json
            },
            class: "space-y-4" do |f| %>
          <% if @form.errors.any? %>
            <div class="rounded-md bg-red-50 p-4 border border-red-200">
              <h3 class="text-sm font-bold text-red-800">Please correct the errors below</h3>
              <div class="mt-2 text-xs text-red-700">
                <ul role="list" class="list-disc pl-5 space-y-1">
                  <% @form.errors.full_messages.each do |msg| %>
                    <li><%= msg %></li>
                  <% end %>
                </ul>
              </div>
            </div>
          <% end %>

          <div>
            <%= f.label :benchmark_recipe_id, "Benchmark Recipe", class: "block text-sm font-bold text-slate-700 mb-1" %>
            <%= f.select :benchmark_recipe_id,
                options_from_collection_for_select(@benchmark_recipes, :id, :display_name, @form.benchmark_recipe_id),
                { prompt: "Select a recipe..." },
                { class: "block w-full rounded-md border-slate-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 sm:text-sm",
                  data: {
                    benchmark_recipe_target: "select",
                    action: "change->benchmark-recipe#showDefaults"
                  } } %>
            <p class="mt-1 text-[10px] text-slate-500 italic">
              Select the benchmark recipe to run on this node.
            </p>
          </div>

          <div data-benchmark-recipe-target="defaults" class="hidden">
            <div class="rounded-md bg-slate-50 p-3 border border-slate-200">
              <div class="flex items-center justify-between mb-2">
                <h4 class="text-xs font-bold text-slate-600">Recipe Default Profile</h4>
                <button type="button"
                        class="text-[10px] text-teal-600 hover:text-teal-800 font-medium"
                        data-action="click->benchmark-recipe#populateOverrides">
                  Copy to overrides
                </button>
              </div>
              <pre data-benchmark-recipe-target="defaultsContent" class="text-xs text-slate-700 font-mono whitespace-pre-wrap"></pre>
            </div>
          </div>

          <div>
            <%= f.label :argument_overrides, "Argument Overrides (Optional)", class: "block text-sm font-bold text-slate-700 mb-1" %>
            <%= f.text_area :argument_overrides,
                rows: 3,
                class: "block w-full rounded-md border-slate-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 sm:text-sm font-mono",
                placeholder: '{"nx": 128, "ny": 128}',
                data: { benchmark_recipe_target: "overrides" } %>
            <p class="mt-1 text-[10px] text-slate-500 italic">
              Optional JSON to override recipe defaults. Leave blank to use recipe defaults.
            </p>
          </div>

          <div>
            <%= f.label :log_path, "Log File Path (Optional)", class: "block text-sm font-bold text-slate-700 mb-1" %>
            <%= f.text_field :log_path,
                class: "block w-full rounded-md border-slate-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 sm:text-sm font-mono",
                placeholder: "/tmp/hpcg.log" %>
            <p class="mt-1 text-[10px] text-slate-500 italic">
              Leave blank to use the default generated log file.
            </p>
          </div>

          <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
            <button type="button" class="btn-secondary" data-action="modal#close">Cancel</button>
            <%= f.submit "Start Benchmark", class: "btn-primary" %>
          </div>
        <% end %>
      <% else %>
        <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
          <button type="button" class="btn-secondary" data-action="modal#close">Close</button>
          <button type="button" class="btn-primary opacity-50 cursor-not-allowed" disabled>Start Benchmark</button>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>