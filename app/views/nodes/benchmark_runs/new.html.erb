<%= turbo_frame_tag "modal" do %>
  <%= render "shared/modal", title: "Run Benchmark", max_width: "max-w-lg" do %>
    <p class="text-sm text-slate-500 mb-4">
      Configure and start a new HPCG benchmark run on <strong><%= @node.hostname %></strong>.
    </p>

    <%= form_with model: @form, url: node_benchmark_runs_path(@node), method: :post, id: "run_benchmark_form", data: { turbo_frame: "_top" }, class: "space-y-4" do |f| %>
      <% if @form.errors.any? %>
        <div class="rounded bg-red-50 p-4 border border-red-200">
          <div class="flex">
            <div class="ml-3">
              <h3 class="text-sm font-bold text-red-800 uppercase tracking-wider">Validation Errors</h3>
              <div class="mt-2 text-sm text-red-700">
                <ul role="list" class="list-disc pl-5 space-y-1">
                  <% @form.errors.full_messages.each do |msg| %>
                    <li><%= msg %></li>
                  <% end %>
                </ul>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <div>
        <%= f.label :log_path, "Log File Path (Optional)", class: "block text-sm font-bold text-slate-700 mb-1" %>
        <%= f.text_field :log_path, class: "block w-full rounded-md border-slate-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 sm:text-sm font-mono", placeholder: "/tmp/hpcg.log" %>
        <p class="mt-1 text-xs text-slate-500">
          Leave blank to use the default generated log file.
        </p>
      </div>
    <% end %>

    <% content_for :modal_footer do %>
      <button type="button" class="btn-secondary" data-action="click->modal#close">Cancel</button>
      <button type="submit" form="run_benchmark_form" class="btn-primary">
        <svg class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
        </svg>
        Start Benchmark
      </button>
    <% end %>
  <% end %>
<% end %>