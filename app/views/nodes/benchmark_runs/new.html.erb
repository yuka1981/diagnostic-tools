<%= turbo_frame_tag "modal" do %>
  <%= render "shared/modal", title: "Run Benchmark: #{@node.hostname}", max_width: 'max-w-lg' do %>
    <div class="space-y-4">
      <p class="text-sm text-gray-500">
        Configure and start a new HPCG benchmark run on <strong><%= @node.hostname %></strong>.
      </p>
      
      <%= form_with model: @form, url: node_benchmark_runs_path(@node), method: :post, data: { turbo_frame: "_top" }, class: "mt-4 space-y-4" do |f| %>
        <% if @form.errors.any? %>
          <div class="rounded-md bg-red-50 p-4 border border-red-200">
            <h3 class="text-sm font-bold text-red-800">Please correct the errors below</h3>
            <div class="mt-2 text-xs text-red-700">
              <ul role="list" class="list-disc pl-5 space-y-1">
                <% @form.errors.full_messages.each do |msg| %>
                  <li><%= msg %></li>
                <% end %>
              </ul>
            </div>
          </div>
        <% end %>

        <div>
          <%= f.label :log_path, "Log File Path (Optional)", class: "block text-sm font-bold text-slate-700 mb-1" %>
          <%= f.text_field :log_path, 
              class: "block w-full rounded-md border-slate-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 sm:text-sm font-mono", 
              placeholder: "/tmp/hpcg.log" %>
          <p class="mt-1 text-[10px] text-slate-500 italic">
            Leave blank to use the default generated log file.
          </p>
        </div>

        <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
          <button type="button" class="btn-secondary" data-action="modal#close">Cancel</button>
          <%= f.submit "Start Benchmark", class: "btn-primary" %>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>