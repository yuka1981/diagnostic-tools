<% state = local_assigns[:selected_state] || node.current_state %>
<% if state %>
  <% dmi = state.dmi_info || {} %>
  <div class="space-y-6">
    <div class="grid grid-cols-12 gap-6">
      <%# System Information (DMI) %>
      <div class="col-span-12 lg:col-span-6">
        <div class="card-netbox h-full">
          <div class="card-header">
            <h3 class="card-title">System</h3>
          </div>
          <div class="p-0">
            <table class="w-full text-sm text-left">
              <tbody class="divide-y divide-neutral-4">
                <% system = dmi["system"] || {} %>
                <tr class="hover:bg-neutral-2">
                  <th class="px-4 py-2 font-bold text-neutral-85 w-1/3 border-r border-neutral-8">Manufacturer</th>
                  <td class="px-4 py-2 text-neutral-85"><%= system["manufacturer"] || "—" %></td>
                </tr>
                <tr class="hover:bg-neutral-2">
                  <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Product Name</th>
                  <td class="px-4 py-2 text-neutral-85 font-bold"><%= system["product_name"] || "—" %></td>
                </tr>
                <tr class="hover:bg-neutral-2">
                  <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Serial Number</th>
                  <td class="px-4 py-2 text-neutral-85 font-mono text-xs"><%= system["serial_number"] || "—" %></td>
                </tr>
                <tr class="hover:bg-neutral-2">
                  <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">UUID</th>
                  <td class="px-4 py-2 text-neutral-45 font-mono text-[10px] break-all"><%= system["uuid"] || "—" %></td>
                </tr>
                <tr class="hover:bg-neutral-2">
                  <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">SKU Number</th>
                  <td class="px-4 py-2 text-neutral-85"><%= system["sku_number"] || "—" %></td>
                </tr>
                <tr class="hover:bg-neutral-2">
                  <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Family</th>
                  <td class="px-4 py-2 text-neutral-85"><%= system["family"] || "—" %></td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <%# BIOS Information (DMI) %>
      <div class="col-span-12 lg:col-span-6">
        <div class="card-netbox h-full">
          <div class="card-header">
            <h3 class="card-title">BIOS</h3>
          </div>
          <div class="p-0">
            <table class="w-full text-sm text-left">
              <tbody class="divide-y divide-neutral-4">
                <% bios = dmi["bios"] || {} %>
                <tr class="hover:bg-neutral-2">
                  <th class="px-4 py-2 font-bold text-neutral-85 w-1/3 border-r border-neutral-8">Vendor</th>
                  <td class="px-4 py-2 text-neutral-85"><%= bios["vendor"] || "—" %></td>
                </tr>
                <tr class="hover:bg-neutral-2">
                  <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Version</th>
                  <td class="px-4 py-2 text-neutral-85 font-bold"><%= bios["version"] || "—" %></td>
                </tr>
                <tr class="hover:bg-neutral-2">
                  <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Release Date</th>
                  <td class="px-4 py-2 text-neutral-85"><%= bios["release_date"] || "—" %></td>
                </tr>
                <tr class="hover:bg-neutral-2">
                  <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">ROM Size</th>
                  <td class="px-4 py-2 text-neutral-85"><%= bios["rom_size"] || "—" %></td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-12 gap-6">
      <%# CPU Information %>
      <div class="col-span-12">
        <div class="card-netbox h-full">
          <div class="card-header">
            <h3 class="card-title text-xs font-bold text-neutral-45 uppercase">CPU Detail</h3>
          </div>
          <div class="p-0">
            <table class="w-full text-sm text-left">
              <tbody class="divide-y divide-neutral-4">
                <tr class="hover:bg-neutral-2">
                  <th class="px-4 py-2 font-bold text-neutral-85 w-1/3 border-r border-neutral-8">Architecture</th>
                  <td class="px-4 py-2 text-neutral-85"><%= state.host_info["arch"] || state.cpu_info["architecture"] || "—" %></td>
                </tr>
                <tr class="hover:bg-neutral-2">
                  <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Model Name</th>
                  <td class="px-4 py-2 text-neutral-85"><%= state.cpu_info["model_name"] || "—" %></td>
                </tr>
                <tr class="hover:bg-neutral-2">
                  <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">CPUs / Sockets</th>
                  <td class="px-4 py-2 text-neutral-85"><%= state.cpu_info["cpus"] || state.cpu_info["threads"] %> / <%= state.cpu_info["sockets"] %></td>
                </tr>
                <tr class="hover:bg-neutral-2">
                  <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">NUMA Nodes</th>
                  <td class="px-4 py-2 text-neutral-85"><%= state.cpu_info["numa_nodes"] || "—" %></td>
                </tr>
                <% if state.cpu_info["numa_info"].present? %>
                  <tr class="hover:bg-neutral-2">
                    <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">NUMA Topology</th>
                    <td class="px-4 py-2 text-neutral-85">
                      <div class="flex flex-wrap gap-1">
                        <% state.cpu_info["numa_info"].sort.each do |node_id, cpu_list| %>
                          <div class="inline-flex items-center gap-1.5 px-1.5 py-0.5 rounded bg-neutral-4 border border-neutral-8 text-[10px]">
                            <span class="font-black text-neutral-45">NODE <%= node_id %>:</span>
                            <span class="font-mono text-neutral-85"><%= cpu_list %></span>
                          </div>
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
                <% if state.cpu_info["flags"].present? %>
                  <tr class="hover:bg-neutral-2">
                    <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8 text-xs">Flags</th>
                    <td class="px-4 py-2">
                      <div class="flex flex-wrap gap-1 max-w-4xl">
                        <% state.cpu_info["flags"].each do |flag| %>
                          <% 
                            f_down = flag.downcase
                            is_highlighted = f_down.start_with?("avx") || f_down.start_with?("amx") || f_down.start_with?("sse")
                          %>
                          <span class="inline-flex items-center px-1.5 py-0.5 rounded-sm font-mono text-[9px] border uppercase tracking-tighter <%= is_highlighted ? "bg-primary-1 text-primary-7 border-primary-2 font-bold shadow-sm" : "bg-neutral-4 text-neutral-45 border-neutral-8" %>">
                            <%= flag %>
                          </span>
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <%# Memory Information (OS View) %>
      <div class="col-span-12">
        <div class="card-netbox h-full">
          <div class="card-header">
            <h3 class="card-title text-xs font-bold text-neutral-45 uppercase">Memory (OS View)</h3>
          </div>
          <div class="p-0">
            <table class="w-full text-sm text-left">
              <tbody class="divide-y divide-neutral-4">
                <tr class="hover:bg-neutral-2">
                  <th class="px-4 py-2 font-bold text-neutral-85 w-1/3 border-r border-neutral-8">Total Usable</th>
                  <td class="px-4 py-2 text-neutral-85 font-bold"><%= format_bytes(state.mem_info["total"]) %></td>
                </tr>
                <tr class="hover:bg-neutral-2">
                  <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Available</th>
                  <td class="px-4 py-2 text-success-7 font-bold"><%= format_bytes(state.mem_info["available"]) %></td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <%# Memory Topology (Visual Map) %>
    <div class="card-netbox !overflow-visible" data-controller="disclosure" data-disclosure-visible-value="false">
      <div class="card-header">
        <h3 class="card-title text-xs font-bold text-neutral-45 uppercase">Memory Topology</h3>
        <div class="flex items-center gap-2">
          <span class="text-[10px] font-bold text-neutral-45 uppercase tracking-tight">Show Map</span>
          <button type="button" 
                  data-action="click->disclosure#toggle"
                  class="relative inline-flex h-5 w-9 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-primary-5 focus:ring-offset-2 bg-neutral-8"
                  role="switch" 
                  aria-checked="false"
                  data-disclosure-target="button">
            <span aria-hidden="true" 
                  class="pointer-events-none inline-block h-4 w-4 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out translate-x-0"></span>
          </button>
        </div>
      </div>
      <div class="p-6 bg-neutral-2" data-disclosure-target="content" style="display: none;">
        <% grouped_topology = group_memory_topology(dmi["memory"]) %>

        <% if grouped_topology.any? %>
          <div class="space-y-6">
            <% grouped_topology.sort.each do |socket, channels| %>
              <div class="card-netbox !overflow-visible">
                <div class="card-header bg-neutral-2/80 py-1.5 px-4 border-b border-neutral-8">
                  <h4 class="card-title text-neutral-85 font-black">
                    <%= format_socket_name(socket) %>
                  </h4>
                </div>
                <div class="p-6 bg-white !overflow-visible">
                  <div class="flex flex-nowrap gap-x-10 gap-y-8 !overflow-visible">
                    <% channels.sort.each do |channel, slots| %>
                      <div class="flex flex-col min-w-max">
                        <h5 class="text-[9px] font-black text-neutral-25 uppercase mb-4 tracking-widest border-b border-neutral-4 pb-1">
                          <%= channel %>
                        </h5>
                        <div class="flex gap-2">
                          <% slots.each do |slot| %>
                            <% installed = slot["size"] && slot["size"] != "No Module Installed" %>
                            <div class="relative group">
                              <div class="w-10 h-24 rounded-sm flex flex-col items-center justify-between p-1 transition-all hover:-translate-y-1 cursor-default <%= memory_slot_status_classes(slot) %>">
                                <%# Top: Locator %>
                                <span class="text-[7px] font-bold leading-none truncate w-full text-center uppercase tracking-tighter">
                                  <%= slot["locator"].split('_').last %>
                                </span>
                                
                                <%# Middle: Size %>
                                <div class="flex flex-col items-center">
                                  <% if installed %>
                                    <span class="text-[10px] font-black leading-tight">
                                      <%= slot["size"].to_s.gsub(' GB', 'G') %>
                                    </span>
                                  <% else %>
                                    <span class="text-[7px] font-bold opacity-40">MT</span>
                                  <% end %>
                                </div>

                                <%# Bottom: Type %>
                                <span class="text-[6px] font-black uppercase opacity-80 tracking-widest">
                                  <%= slot["type"].presence || "—" %>
                                </span>
                              </div>
                              
                              <%# Tooltip %>
                              <div class="absolute z-50 hidden group-hover:block w-56 p-3 mt-2 text-xs bg-neutral-85/95 text-white rounded-lg shadow-2xl -left-2 top-full pointer-events-none border border-neutral-85 backdrop-blur-sm">
                                <div class="flex items-center justify-between border-b border-neutral-85 mb-2 pb-1.5">
                                  <span class="font-black text-primary-4 tracking-wider"><%= slot["locator"] %></span>
                                  <span class="text-[9px] px-1.5 py-0.5 rounded bg-neutral-85 border border-neutral-85 font-black tracking-widest"><%= installed ? 'ACTIVE' : 'EMPTY' %></span>
                                </div>
                                <% if installed %>
                                  <div class="grid grid-cols-2 gap-y-1.5 text-[10px]">
                                    <span class="text-neutral-25">Manufacturer</span><span class="text-right font-bold"><%= slot["manufacturer"] %></span>
                                    <span class="text-neutral-25">Part Number</span><span class="text-right font-mono text-[9px]"><%= slot["part_number"] %></span>
                                    <span class="text-neutral-25">Speed (Config)</span><span class="text-right font-bold text-primary-4"><%= slot["configured_speed"] %></span>
                                    <span class="text-neutral-25">Speed (Spec)</span><span class="text-right font-medium"><%= slot["speed"] %></span>
                                    <span class="text-neutral-25">Serial</span><span class="text-right font-mono text-[9px]"><%= slot["serial_number"] %></span>
                                  </div>
                                <% else %>
                                  <div class="italic text-neutral-45 py-1 text-center">No module detected in this slot</div>
                                <% end %>
                              </div>
                            </div>
                          <% end %>
                        </div>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="text-center py-12 text-neutral-25 italic bg-white rounded-lg border-2 border-dashed border-neutral-8">
            No detailed topology data available for this hardware.
          </div>
        <% end %>
      </div>
    </div>

    <%# Memory Detailed Table %>
    <div class="card-netbox" data-controller="disclosure" data-disclosure-visible-value="false">
      <div class="card-header">
        <h3 class="card-title">Memory Devices</h3>
        <div class="flex items-center gap-2">
          <span class="text-[10px] font-bold text-neutral-45 uppercase tracking-tight">Show Details</span>
          <button type="button" 
                  data-action="click->disclosure#toggle"
                  class="relative inline-flex h-5 w-9 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-primary-5 focus:ring-offset-2 bg-neutral-8"
                  role="switch" 
                  aria-checked="false"
                  data-disclosure-target="button">
            <span aria-hidden="true" 
                  class="pointer-events-none inline-block h-4 w-4 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out translate-x-0"></span>
          </button>
        </div>
      </div>
      <div class="overflow-x-auto" data-disclosure-target="content" style="display: none;">
        <table class="w-full text-sm text-left">
          <thead class="bg-neutral-2 border-b border-neutral-8">
            <tr>
              <th class="px-4 py-2 font-bold text-neutral-45 uppercase text-[10px]">Slot</th>
              <th class="px-4 py-2 font-bold text-neutral-45 uppercase text-[10px]">Bank</th>
              <th class="px-4 py-2 font-bold text-neutral-45 uppercase text-[10px]">Status</th>
              <th class="px-4 py-2 font-bold text-neutral-45 uppercase text-[10px]">Size</th>
              <th class="px-4 py-2 font-bold text-neutral-45 uppercase text-[10px]">Type</th>
              <th class="px-4 py-2 font-bold text-neutral-45 uppercase text-[10px]">Speed</th>
              <th class="px-4 py-2 font-bold text-neutral-45 uppercase text-[10px]">Manufacturer / Part Number</th>
              <th class="px-4 py-2 font-bold text-neutral-45 uppercase text-[10px]">Serial Number</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-4">
            <% (dmi["memory"] || []).each do |slot| %>
              <% installed = slot["size"] && slot["size"] != "No Module Installed" %>
              <tr class="hover:bg-blue-50 transition-colors">
                <td class="px-4 py-2 font-bold text-blue-600 font-mono text-xs"><%= slot["locator"] %></td>
                <td class="px-4 py-2 text-neutral-45 text-xs"><%= slot["bank_locator"] %></td>
                <td class="px-4 py-2">
                  <% if installed %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-success-2 text-success-8 border border-success-2">Active</span>
                  <% else %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-neutral-4 text-neutral-85 border border-neutral-8">Empty</span>
                  <% end %>
                </td>
                <td class="px-4 py-2 font-bold text-neutral-85"><%= slot["size"] %></td>
                <td class="px-4 py-2 text-neutral-45"><%= slot["type"] %></td>
                <td class="px-4 py-2">
                  <% if slot["configured_speed"] == slot["speed"] || !installed %>
                    <span class="text-neutral-85"><%= slot["configured_speed"] %></span>
                  <% else %>
                    <div class="flex flex-col">
                      <span class="text-amber-700 font-bold"><%= slot["configured_speed"] %></span>
                      <span class="text-[10px] text-neutral-25 line-through"><%= slot["speed"] %></span>
                    </div>
                  <% end %>
                </td>
                <td class="px-4 py-2">
                  <div class="flex flex-col">
                    <span class="text-neutral-85 font-medium"><%= slot["manufacturer"] %></span>
                    <span class="text-neutral-45 font-mono text-[10px]"><%= slot["part_number"] %></span>
                  </div>
                </td>
                <td class="px-4 py-2 font-mono text-[10px] text-neutral-45"><%= slot["serial_number"] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <%# Network Interfaces (New) %>
    <%= render "nodes/network_v2", state: state %>

    <%# Storage Information %>
    <div class="card-netbox">
      <div class="card-header">
        <h3 class="card-title text-xs font-bold text-neutral-45 uppercase">Storage</h3>
      </div>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-neutral-8 text-sm">
          <thead class="bg-neutral-2">
            <tr>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase text-neutral-45 border-b">Device</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase text-neutral-45 border-b">Mount</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase text-neutral-45 border-b">Type</th>
              <th class="px-3 py-2 text-right text-xs font-bold uppercase text-neutral-45 border-b">Total</th>
              <th class="px-3 py-2 text-right text-xs font-bold uppercase text-neutral-45 border-b">Used</th>
              <th class="px-3 py-2 text-center text-xs font-bold uppercase text-neutral-45 border-b">Usage</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-4 bg-white">
            <% state.disk_info.each do |disk| %>
              <% 
                usage_pct = disk_usage_percentage(disk)
                bar_color = disk_usage_bar_color(usage_pct)
              %>
              <tr class="hover:bg-primary-1 border-b border-neutral-8">
                <td class="px-3 py-2 font-bold text-neutral-85"><%= disk["device"] %></td>
                <td class="px-3 py-2 text-neutral-45"><%= disk["mountpoint"] %></td>
                <td class="px-3 py-2 text-neutral-45 font-mono text-xs"><%= disk["fstype"] %></td>
                <td class="px-3 py-2 text-right text-neutral-85"><%= format_bytes(disk["total"]) %></td>
                <td class="px-3 py-2 text-right text-neutral-85"><%= format_bytes(disk["used"]) %></td>
                <td class="px-3 py-2 w-32">
                  <div class="flex items-center gap-2">
                    <div class="flex-1 h-2 rounded-full bg-neutral-8 overflow-hidden shadow-inner">
                      <div class="h-full <%= bar_color %>" style="width: <%= usage_pct %>%"></div>
                    </div>
                    <span class="text-[10px] font-bold text-neutral-45"><%= usage_pct %>%</span>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% else %>
  <div class="text-center py-12 card-netbox bg-neutral-2 border-dashed">
    <p class="text-neutral-45 font-bold uppercase text-xs">No detailed hardware information available.</p>
  </div>
<% end %>