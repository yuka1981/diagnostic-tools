<%= turbo_stream.update "flash_messages", partial: "shared/flash" %>
<%= turbo_stream.replace dom_id(@node), partial: "nodes/node", locals: { node: @node } %>
<% unless @is_async %>
  <%= turbo_stream.replace dom_id(@node, :details), partial: "nodes/details", locals: { node: @node, selected_state: @selected_state, current_user: current_user } %>
<% end %>
