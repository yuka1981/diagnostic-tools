<% content_for(:page_title) { "Nodes" } %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold text-slate-900">Nodes</h1>
  </div>
  <div class="flex items-center gap-3">
    <% if current_user.approver? %>
      <%= link_to new_node_path,
          class: "btn-primary",
          data: { turbo_frame: "node_modal" } do %>
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        Add Node
      <% end %>
    <% end %>

    <%= link_to new_node_import_path,
        class: "btn-secondary",
        data: { turbo_frame: "import_modal" } do %>
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
      </svg>
      Import CSV
    <% end %>
  </div>
</div>

<%# Filter Controls %>
<div class="mb-6 card-netbox p-4">
  <%= form_with url: nodes_path, method: :get, 
      data: { 
        controller: "autosubmit filter-form", 
        turbo_frame: "nodes_list", 
        turbo_action: "advance",
        filter_form_clear_url_value: nodes_path
      }, 
      class: "flex flex-wrap items-end gap-4" do |f| %>
    <%# Search Field %>
    <div class="flex-1 min-w-[200px]">
      <label for="q" class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Search</label>
      <div class="relative">
        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
          <svg class="h-4 w-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <%= f.text_field :q, 
            value: @filter.search_query,
            placeholder: "Search by hostname or IP...",
            class: "block w-full rounded border-slate-300 bg-white py-1.5 pl-10 pr-3 text-sm text-slate-900 placeholder:text-slate-400 focus:ring-2 focus:ring-teal-500 transition-all",
            data: { 
              filter_form_target: "input", 
              action: "input->filter-form#updateClearButton" 
            } %>
      </div>
    </div>

    <%# Role Filter %>
    <div class="w-48">
      <label for="role" class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Role</label>
      <%= f.select :role, 
          options_for_select([["All Roles", ""]] + Node.roles.keys.map { |r| [r.humanize, r] }, @filter.role),
          {},
          class: "block w-full rounded border-slate-300 bg-white py-1.5 pl-3 pr-10 text-sm text-slate-900 focus:ring-2 focus:ring-teal-500 transition-all",
          data: { 
            action: "change->autosubmit#submit change->filter-form#updateClearButton",
            filter_form_target: "input"
          } %>
    </div>

    <%# Status Filter %>
    <div class="w-48">
      <label for="status" class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Status</label>
      <%= f.select :status,
          options_for_select([["All Statuses", ""]] + Nodes::FilterQuery::VALID_STATUSES.map { |s| [s.humanize, s] }, @filter.status),
          {},
          class: "block w-full rounded border-slate-300 bg-white py-1.5 pl-3 pr-10 text-sm text-slate-900 focus:ring-2 focus:ring-teal-500 transition-all",
          data: { 
            action: "change->autosubmit#submit change->filter-form#updateClearButton",
            filter_form_target: "input"
          } %>
    </div>

    <%# Actions %>
    <div class="flex items-center gap-2">
      <%= f.submit "Search", class: "btn-primary cursor-pointer" %>
      
      <% 
         # Initial classes based on state
         if @filter.filtered?
           button_classes = "btn-secondary"
         else
           button_classes = "btn-secondary opacity-50 cursor-not-allowed pointer-events-none"
         end
      %>
      <%= content_tag :a, "Clear",
          href: (@filter.filtered? ? nodes_path : nil),
          data: { 
            turbo_frame: "_top",
            filter_form_target: "clearButton" 
          },
          class: button_classes %>
    </div>
  <% end %>
</div>

<%# Nodes table %>
<%= turbo_frame_tag "nodes_list", data: { turbo_action: "advance" } do %>
  <%= render "nodes/table", nodes: @nodes, filter: @filter %>
<% end %>

<%# Modals turbo frames %>
<%= turbo_frame_tag "node_modal" %>
<%= turbo_frame_tag "import_modal" %>
<%= turbo_frame_tag "install_modal" %>
<%= turbo_frame_tag "uninstall_modal" %>
