<% content_for(:page_title) { "Nodes" } %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold text-slate-900">Nodes</h1>
  </div>
  <div class="flex items-center gap-3">
    <% if current_user.approver? %>
      <%= link_to new_node_path,
          class: "btn-primary",
          data: { turbo_frame: "node_modal" } do %>
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        Add Node
      <% end %>
    <% end %>

    <%= link_to new_node_import_path,
        class: "btn-secondary",
        data: { turbo_frame: "import_modal" } do %>
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
      </svg>
      Import CSV
    <% end %>
  </div>
</div>

<%# Filter Controls %>
<div class="mb-6 rounded-2xl bg-white p-4 shadow-sm ring-1 ring-gray-200 dark:bg-slate-800/50 dark:ring-white/10">
  <%= form_with url: nodes_path, method: :get, 
      data: { 
        controller: "autosubmit filter-form", 
        turbo_frame: "nodes_list", 
        turbo_action: "advance",
        filter_form_clear_url_value: nodes_path
      }, 
      class: "flex flex-wrap items-end gap-4" do |f| %>
    <%# Search Field %>
    <div class="flex-1 min-w-[200px]">
      <label for="q" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Search</label>
      <div class="relative">
        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
          <svg class="h-4 w-4 text-gray-400 dark:text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <%= f.text_field :q, 
            value: @filter.search_query,
            placeholder: "Search by hostname or IP...",
            class: "block w-full rounded-none border-0 bg-gray-50 py-2 pl-10 pr-3 text-sm text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-blue-600 dark:bg-slate-700 dark:text-white dark:ring-white/10 dark:placeholder:text-slate-500",
            data: { 
              filter_form_target: "input", 
              action: "input->filter-form#updateClearButton" 
            } %>
      </div>
    </div>

    <%# Role Filter %>
    <div class="w-40">
      <label for="role" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Role</label>
      <%= f.select :role, 
          options_for_select([["All Roles", ""]] + Node.roles.keys.map { |r| [r.humanize, r] }, @filter.role),
          {},
          class: "block w-full rounded-none border-0 bg-gray-50 py-2 pl-3 pr-10 text-sm text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-blue-600 dark:bg-slate-700 dark:text-white dark:ring-white/10",
          data: { 
            action: "change->autosubmit#submit change->filter-form#updateClearButton",
            filter_form_target: "input"
          } %>
    </div>

    <%# Status Filter %>
    <div class="w-40">
      <label for="status" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1">Status</label>
      <%= f.select :status,
          options_for_select([["All Statuses", ""]] + Nodes::FilterQuery::VALID_STATUSES.map { |s| [s.humanize, s] }, @filter.status),
          {},
          class: "block w-full rounded-none border-0 bg-gray-50 py-2 pl-3 pr-10 text-sm text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-blue-600 dark:bg-slate-700 dark:text-white dark:ring-white/10",
          data: { 
            action: "change->autosubmit#submit change->filter-form#updateClearButton",
            filter_form_target: "input"
          } %>
    </div>

    <%# Actions %>
    <div class="flex items-center gap-2">
      <%= f.submit "Search",
          class: "inline-flex items-center rounded-none bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-slate-900 transition-colors cursor-pointer" %>
      
      <% 
         # Initial classes based on state
         base_classes = "inline-flex items-center rounded-none px-3 py-2 text-sm font-medium transition-colors"
         if @filter.filtered?
           button_classes = "#{base_classes} text-gray-600 hover:text-gray-900 hover:bg-gray-100 dark:text-slate-400 dark:hover:text-white dark:hover:bg-white/10"
         else
           button_classes = "#{base_classes} text-gray-400 cursor-not-allowed pointer-events-none"
         end
      %>
      <%= content_tag :a, "Clear filters",
          href: (@filter.filtered? ? nodes_path : nil),
          data: { 
            turbo_frame: "_top",
            filter_form_target: "clearButton" 
          },
          class: button_classes %>
    </div>
  <% end %>
</div>

<%# Nodes table %>
<%= turbo_frame_tag "nodes_list", data: { turbo_action: "advance" } do %>
  <%= render "nodes/table", nodes: @nodes, filter: @filter %>
<% end %>

<%# Modals turbo frames %>
<%= turbo_frame_tag "node_modal" %>
<%= turbo_frame_tag "import_modal" %>
<%= turbo_frame_tag "install_modal" %>
<%= turbo_frame_tag "uninstall_modal" %>
