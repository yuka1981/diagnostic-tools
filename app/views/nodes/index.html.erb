<% content_for(:page_title) { "Nodes" } %>

<div class="flex items-center justify-between mb-6" data-testid="nodes-page-container">
  <div>
    <h1 class="text-2xl font-bold text-neutral-85">Nodes</h1>
  </div>
  <div class="flex items-center gap-3">
    <% if current_user.approver? %>
      <%= link_to new_node_path,
          class: "btn-primary",
          data: { turbo_frame: "node_modal", testid: "nodes-button-new" } do %>
        <%= lucide_icon("plus", class: "h-4 w-4") %>
        Add Node
      <% end %>
    <% end %>

    <%= link_to new_node_import_path,
        class: "btn-secondary",
        data: { turbo_frame: "import_modal", testid: "nodes-button-import" } do %>
      <%= lucide_icon("upload", class: "h-4 w-4") %>
      Import CSV
    <% end %>
  </div>
</div>

<%# Nodes table %>
<div id="nodes_table" data-testid="nodes-table-frame">
  <%= render "nodes/table", nodes: @nodes %>
</div>

<%# Modals turbo frames %>
<%= turbo_frame_tag "node_modal" %>
<%= turbo_frame_tag "import_modal" %>
<%= turbo_frame_tag "install_modal" %>
<%= turbo_frame_tag "uninstall_modal" %>
<%= turbo_frame_tag "update_modal" %>
