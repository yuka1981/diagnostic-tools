<div class="card-netbox">
  <div class="p-4 flex items-start gap-6">
    <div class="flex h-12 w-12 items-center justify-center rounded bg-teal-600 text-white shadow-sm">
      <%= lucide_icon("server", class: "h-6 w-6") %>
    </div>
    <div class="flex-1 min-w-0">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <h2 class="text-lg font-black text-slate-800 uppercase tracking-tight"><%= node.hostname %></h2>
          <%= node_status_badge(node.status) %>
        </div>
      </div>
      <div class="mt-4 grid grid-cols-2 gap-x-6 gap-y-4 sm:grid-cols-4 border-t border-slate-100 pt-4">
        <div>
          <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Role</p>
          <p class="text-xs font-bold text-slate-700"><%= node.role.humanize %></p>
        </div>
        <div>
          <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">IP Address</p>
          <p class="text-xs font-mono text-slate-700"><%= node.ip || "—" %></p>
        </div>
        <div>
          <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Architecture</p>
          <p class="text-xs font-bold text-slate-700"><%= node.arch || "—" %></p>
        </div>
        <div>
          <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Latest Benchmark</p>
          <div class="mt-1">
            <%= render "nodes/latest_benchmark", node: node %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<% state = local_assigns[:selected_state] || node.current_state %>
<% if state %>
  <div class="mt-6 flex flex-col gap-6">
    <%# Host Information %>
    <div class="card-netbox">
      <div class="card-header">
        <h3 class="card-title">Host Information</h3>
      </div>
      <div class="p-0">
        <div class="grid grid-cols-1 lg:grid-cols-2 divide-y lg:divide-y-0 lg:divide-x divide-slate-100">
          <table class="w-full text-sm text-left">
            <tbody class="divide-y divide-slate-100">
              <tr class="hover:bg-slate-50">
                <th class="px-4 py-2 font-bold text-slate-700 w-1/3 border-r border-slate-200">OS</th>
                <td class="px-4 py-2 text-slate-700"><%= state.host_info["os"] || "—" %></td>
              </tr>
              <tr class="hover:bg-slate-50">
                <th class="px-4 py-2 font-bold text-slate-700 border-r border-slate-200">Kernel</th>
                <td class="px-4 py-2 font-mono text-slate-700 text-xs"><%= state.host_info["kernel"] || "—" %></td>
              </tr>
              <tr class="hover:bg-slate-50">
                <th class="px-4 py-2 font-bold text-slate-700 border-r border-slate-200">Platform</th>
                <td class="px-4 py-2 text-slate-700 font-bold"><%= state.host_info["platform"] %> <%= state.host_info["platform_version"] %></td>
              </tr>
            </tbody>
          </table>

          <% if state.dmi_info.present? && state.dmi_info["system"].present? %>
            <table class="w-full text-sm text-left">
              <tbody class="divide-y divide-slate-100">
                <tr class="hover:bg-slate-50">
                  <th class="px-4 py-2 font-bold text-slate-700 w-1/3 border-r border-slate-200">Manufacturer</th>
                  <td class="px-4 py-2 text-slate-700"><%= state.dmi_info.dig("system", "manufacturer") %></td>
                </tr>
                <tr class="hover:bg-slate-50">
                  <th class="px-4 py-2 font-bold text-slate-700 border-r border-slate-200 text-xs text-slate-500 uppercase">Serial Number</th>
                  <td class="px-4 py-2 text-slate-700 font-mono text-[10px]"><%= state.dmi_info.dig("system", "serial_number") %></td>
                </tr>
                <tr class="hover:bg-slate-50">
                  <th class="px-4 py-2 font-bold text-slate-700 border-r border-slate-200 text-xs text-slate-500 uppercase">UUID</th>
                  <td class="px-4 py-2 text-slate-600 font-mono text-[9px] break-all"><%= state.dmi_info.dig("system", "uuid") %></td>
                </tr>
              </tbody>
            </table>
          <% end %>
        </div>
      </div>
    </div>

    <%# CPU Information %>
    <div class="card-netbox">
      <div class="card-header">
        <h3 class="card-title">CPU Information</h3>
      </div>
      <div class="p-0">
        <table class="w-full text-sm text-left">
          <tbody class="divide-y divide-slate-100">
            <tr class="hover:bg-slate-50">
              <th class="px-4 py-2 font-bold text-slate-700 w-1/3 border-r border-slate-200">Model Name</th>
              <td class="px-4 py-2 text-slate-700 font-bold"><%= state.cpu_info["model_name"] || "—" %></td>
            </tr>
            <tr class="hover:bg-slate-50">
              <th class="px-4 py-2 font-bold text-slate-700 border-r border-slate-200">Topology</th>
              <td class="px-4 py-2 text-slate-700">
                <%= state.cpu_info["cpus"] || state.cpu_info["threads"] %> CPUs / <%= state.cpu_info["sockets"] %> Sockets / 
                <%= state.cpu_info["cores_per_socket"] || "—" %> Cores per Socket
              </td>
            </tr>
            <% if state.cpu_info["numa_info"].present? %>
              <tr class="hover:bg-slate-50">
                <th class="px-4 py-2 font-bold text-slate-700 border-r border-slate-200">NUMA Topology</th>
                <td class="px-4 py-2 text-slate-700">
                  <div class="flex flex-wrap gap-1">
                    <% state.cpu_info["numa_info"].sort.each do |node_id, cpu_list| %>
                      <div class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-sm bg-slate-100 border border-slate-200 text-[9px]">
                        <span class="font-black text-slate-500">NODE <%= node_id %>:</span>
                        <span class="font-mono text-slate-700"><%= cpu_list %></span>
                      </div>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <%# Memory Information %>
    <div class="card-netbox">
      <div class="card-header">
        <h3 class="card-title">Memory</h3>
      </div>
      <div class="p-0">
        <table class="w-full text-sm text-left">
          <tbody class="divide-y divide-slate-100">
            <tr class="hover:bg-slate-50">
              <th class="px-4 py-2 font-bold text-slate-700 w-1/3 border-r border-slate-200">Total Usable</th>
              <td class="px-4 py-2 text-slate-700 font-bold"><%= format_bytes(state.mem_info["total"]) %></td>
            </tr>
            <tr class="hover:bg-slate-50">
              <th class="px-4 py-2 font-bold text-slate-700 border-r border-slate-200">Available</th>
              <td class="px-4 py-2 text-green-700 font-bold"><%= format_bytes(state.mem_info["available"]) %></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <%# Storage Information %>
    <div class="card-netbox">
      <div class="card-header">
        <h3 class="card-title">Storage</h3>
      </div>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200 text-sm">
          <thead class="bg-slate-50">
            <tr>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase text-slate-500 border-b">Device</th>
              <th class="px-3 py-2 text-left text-xs font-bold uppercase text-slate-500 border-b">Mount</th>
              <th class="px-3 py-2 text-right text-xs font-bold uppercase text-slate-500 border-b">Total</th>
              <th class="px-3 py-2 text-center text-xs font-bold uppercase text-slate-500 border-b">Usage</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 bg-white">
            <% state.disk_info.each do |disk| %>
              <% 
                usage_pct = disk_usage_percentage(disk)
                bar_color = disk_usage_bar_color(usage_pct)
              %>
              <tr class="hover:bg-slate-50 border-b border-slate-200">
                <td class="px-3 py-2 font-bold text-slate-700 text-xs"><%= disk["device"] %></td>
                <td class="px-3 py-2 text-slate-600 text-xs"><%= disk["mountpoint"] %></td>
                <td class="px-3 py-2 text-right text-slate-700 text-xs"><%= format_bytes(disk["total"]) %></td>
                <td class="px-3 py-2 w-32">
                  <div class="flex items-center gap-2">
                    <div class="flex-1 h-1.5 rounded-full bg-slate-100 overflow-hidden">
                      <div class="h-full <%= bar_color %>" style="width: <%= usage_pct %>%"></div>
                    </div>
                    <span class="text-[9px] font-bold text-slate-500"><%= usage_pct %>%</span>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% else %>
  <div class="mt-6 card-netbox bg-slate-50 border-dashed border-2 p-12 text-center">
<%= lucide_icon("info", class: "mx-auto h-12 w-12 text-slate-300") %>
    <h3 class="mt-2 text-xs font-black text-slate-500 uppercase tracking-widest">No data collected</h3>
    <p class="mt-1 text-[10px] text-slate-400 italic">Trigger a collection to see detailed system information.</p>
    <% if current_user&.approver? %>
      <div class="mt-6">
        <%= button_to collect_node_path(node), 
            method: :post,
            class: "btn-primary",
            data: { turbo_submits_with: "Collecting..." } do %>
<%= lucide_icon("zap", class: "h-4 w-4") %>
          Collect Now
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>