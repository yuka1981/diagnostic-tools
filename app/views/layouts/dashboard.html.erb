<!DOCTYPE html>
<html class="h-full bg-slate-100">
  <head>
    <title><%= content_for(:title) || "HPC Diagnostics" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full font-sans antialiased text-slate-600">
    <div class="min-h-full" data-controller="sidebar">
      <%# Mobile sidebar overlay %>
      <div data-sidebar-target="overlay" 
           data-action="click->sidebar#close"
           class="hidden fixed inset-0 z-40 bg-slate-900/50 backdrop-blur-sm lg:hidden transition-opacity"></div>

      <%= render "shared/sidebar" %>

      <%# Main content wrapper %>
      <div class="lg:pl-64 flex flex-col min-h-screen">
        <%= render "shared/navbar" %>

        <%# Main content %>
        <main class="flex-1 py-8 px-6">
          <%# Breadcrumbs %>
          <nav class="breadcrumb flex items-center text-xs text-slate-500 mb-4" aria-label="Breadcrumb">
             <%= link_to "Home", dashboard_path, class: "hover:text-teal-600 font-bold" %>
             <% if content_for?(:breadcrumbs) %>
               <%= yield :breadcrumbs %>
             <% else %>
               <span class="mx-2">/</span>
               <span class="font-medium text-slate-700"><%= content_for(:page_title) || "Dashboard" %></span>
             <% end %>
          </nav>

          <%# Flash messages %>
          <div id="flash_messages" class="mb-6">
            <%= render "shared/flash", notice: notice, alert: alert %>
          </div>

          <%= yield %>
        </main>
        
        <%# Footer %>
        <footer class="mt-auto border-t border-slate-200 bg-white py-4 px-6 text-xs text-slate-400">
          <div class="flex items-center justify-between">
            <p>&copy; <%= Time.current.year %> HPC Diagnostics. All rights reserved.</p>
            <p>v1.0.0</p>
          </div>
        </footer>
      </div>
    </div>

    <%# Toast notifications container %>
    <div id="toast-container" class="fixed bottom-4 right-4 z-50 flex flex-col gap-2"></div>

    <script>
      window.showToast = function(message, type = "info") {
        const container = document.getElementById("toast-container");
        if (!container) return;

        const colors = {
          success: "bg-emerald-50 text-emerald-800 border-emerald-200",
          info: "bg-blue-50 text-blue-800 border-blue-200",
          warning: "bg-amber-50 text-amber-800 border-amber-200",
          error: "bg-red-50 text-red-800 border-red-200"
        };

        const icons = {
          success: '<svg class="h-5 w-5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>',
          info: '<svg class="h-5 w-5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>',
          warning: '<svg class="h-5 w-5 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>',
          error: '<svg class="h-5 w-5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>'
        };

        const toast = document.createElement("div");
        toast.className = `flex items-center gap-3 px-4 py-3 rounded-md shadow-lg border transform transition-all duration-150 ${colors[type] || colors.info}`;
        toast.innerHTML = `
          ${icons[type] || icons.info}
          <p class="text-sm font-medium">${message}</p>
          <button type="button" class="ml-auto -mr-1 p-1 rounded hover:bg-black/10" onclick="this.parentElement.remove()">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        `;

        container.appendChild(toast);
        setTimeout(() => toast.remove(), 3000);
      };
    </script>
  </body>
</html>