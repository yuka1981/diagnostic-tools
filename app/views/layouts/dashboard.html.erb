<!DOCTYPE html>
<html class="h-full bg-slate-100">
  <head>
    <title><%= content_for(:title) || "HPC Diagnostics" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full font-sans antialiased text-slate-600">
    <div class="min-h-full" data-controller="sidebar">
      <%# Mobile sidebar overlay %>
      <div data-sidebar-target="overlay" 
           data-action="click->sidebar#close"
           class="hidden fixed inset-0 z-40 bg-slate-900/50 backdrop-blur-sm lg:hidden transition-opacity"></div>

      <%= render "shared/sidebar" %>

      <%# Main content wrapper %>
      <div class="lg:pl-64 flex flex-col min-h-screen">
        <%= render "shared/navbar" %>

        <%# Main content %>
        <main class="flex-1 py-8 px-6">
          <%# Breadcrumbs %>
          <nav class="breadcrumb flex items-center text-xs text-slate-500 mb-4" aria-label="Breadcrumb">
             <%= link_to "Home", dashboard_path, class: "hover:text-teal-600 font-bold" %>
             <% if content_for?(:breadcrumbs) %>
               <%= yield :breadcrumbs %>
             <% else %>
               <span class="mx-2">/</span>
               <span class="font-medium text-slate-700"><%= content_for(:page_title) || "Dashboard" %></span>
             <% end %>
          </nav>

          <%# Flash messages %>
          <div id="flash_messages" class="mb-6">
            <%= render "shared/flash", notice: notice, alert: alert %>
          </div>

          <%= yield %>
        </main>
        
        <%# Footer %>
        <footer class="mt-auto border-t border-slate-200 bg-white py-4 px-6 text-xs text-slate-400">
          <div class="flex items-center justify-between">
            <p>&copy; <%= Time.current.year %> HPC Diagnostics. All rights reserved.</p>
            <p>v1.0.0</p>
          </div>
        </footer>
      </div>
    </div>

    <%# Toast notifications container %>
    <div id="toast-container" class="fixed bottom-4 right-4 z-50 flex flex-col gap-2"></div>

    <script>
      window.showToast = function(message, type = "info") {
        const container = document.getElementById("toast-container");
        if (!container) return;

        const styles = {
          success: { bg: "#ecfdf5", text: "#065f46", border: "#a7f3d0", icon: "#10b981" },
          info: { bg: "#eff6ff", text: "#1e40af", border: "#bfdbfe", icon: "#3b82f6" },
          warning: { bg: "#fffbeb", text: "#92400e", border: "#fde68a", icon: "#f59e0b" },
          error: { bg: "#fef2f2", text: "#991b1b", border: "#fecaca", icon: "#ef4444" }
        };

        const s = styles[type] || styles.info;
        const toast = document.createElement("div");
        toast.style.cssText = `
          display: flex;
          align-items: center;
          gap: 12px;
          padding: 12px 16px;
          border-radius: 6px;
          box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1), 0 4px 6px -2px rgba(0,0,0,0.05);
          border: 1px solid ${s.border};
          background-color: ${s.bg};
          color: ${s.text};
        `;
        toast.innerHTML = `
          <svg style="width:20px;height:20px;color:${s.icon};flex-shrink:0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <p style="font-size:14px;font-weight:500;margin:0">${message}</p>
          <button type="button" style="margin-left:auto;padding:4px;border-radius:4px;border:none;background:transparent;cursor:pointer" onclick="this.parentElement.remove()">
            <svg style="width:16px;height:16px;color:${s.text}" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        `;

        container.appendChild(toast);
        setTimeout(() => toast.remove(), 3000);
      };
    </script>
  </body>
</html>