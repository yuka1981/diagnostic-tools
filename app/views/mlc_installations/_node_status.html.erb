<div class="flex items-center justify-between p-3 border rounded <%= installation_node.failed? ? 'border-red-200 bg-red-50' : '' %>">
  <div class="flex items-center gap-3">
    <span class="inline-flex items-center justify-center w-8 h-8 rounded-full
      <%= case installation_node.status
          when 'pending' then 'bg-gray-100 text-gray-600'
          when 'running' then 'bg-blue-100 text-blue-600'
          when 'success' then 'bg-green-100 text-green-600'
          when 'failed' then 'bg-red-100 text-red-600'
          when 'skipped' then 'bg-yellow-100 text-yellow-600'
          when 'cancelled' then 'bg-yellow-100 text-yellow-600'
          end %>">
      <% if installation_node.running? %>
        <svg class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
      <% elsif installation_node.success? %>
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
        </svg>
      <% elsif installation_node.failed? %>
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      <% else %>
        <span class="h-2 w-2 rounded-full bg-current"></span>
      <% end %>
    </span>

    <div>
      <p class="font-medium"><%= installation_node.node.hostname %></p>
      <% if installation_node.running? && installation_node.step_name.present? %>
        <p class="text-sm text-gray-500">Step <%= installation_node.step_current %>/<%= installation_node.step_total %>: <%= installation_node.step_name %></p>
      <% elsif installation_node.failed? && installation_node.error_message.present? %>
        <p class="text-sm text-red-600"><%= installation_node.error_message.truncate(100) %></p>
      <% elsif installation_node.success? %>
        <p class="text-sm text-green-600">Completed in <%= installation_node.duration&.round(1) || 0 %>s</p>
      <% end %>
    </div>
  </div>

  <span class="text-sm text-gray-500"><%= installation_node.status.humanize %></span>
</div>
