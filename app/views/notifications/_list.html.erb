<%= turbo_frame_tag "notifications_list", data: { testid: "notifications-list-frame" } do %>
  <div id="notifications_list" data-testid="notifications-list-container">
    <% if notifications.any? %>
      <ul class="divide-y divide-neutral-8">
        <% notifications.each do |notification| %>
          <%= render partial: "notifications/notification", locals: { notification: notification } %>
        <% end %>
      </ul>
    <% else %>
      <div class="p-4 text-center text-neutral-45 text-sm">
        No notifications
      </div>
    <% end %>
  </div>
<% end %>
