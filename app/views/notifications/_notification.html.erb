<%= turbo_frame_tag dom_id(notification) do %>
  <li id="<%= dom_id(notification) %>" data-testid="notifications-item-<%= notification.id %>" class="px-4 py-4 hover:bg-neutral-2 <%= notification.read? ? 'bg-neutral-2' : 'bg-white' %>">
    <div class="flex items-start justify-between">
      <div class="flex-1 min-w-0">
        <div class="flex items-center space-x-2">
          <% unless notification.read? %>
            <span class="inline-block w-2 h-2 bg-primary-5 rounded-full" data-testid="notifications-icon-<%= notification.id %>"></span>
          <% end %>
          <p class="text-sm font-medium text-neutral-85 truncate" data-testid="notifications-message-<%= notification.id %>">
            <%= notification.title %>
          </p>
          <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium <%= notification_status_badge_class(notification.status) %>" data-testid="notifications-link-<%= notification.id %>">
            <%= render_status_icon(notification.status) %>
            <%= notification.status.capitalize %>
          </span>
        </div>
        <% if notification.message.present? %>
          <p class="mt-1 text-sm text-neutral-45">
            <%= notification.message %>
          </p>
        <% end %>
        <p class="mt-1 text-xs text-neutral-35" data-testid="notifications-time-<%= notification.id %>">
          <%= time_ago_in_words(notification.created_at) %> ago
        </p>
      </div>
      <div class="ml-4 flex-shrink-0 flex space-x-2">
        <% unless notification.read? %>
          <%= button_to "Mark Read", mark_read_notification_path(notification), method: :post, class: "text-sm text-primary-6 hover:text-primary-8", data: { turbo_stream: true, testid: "notifications-button-dismiss-#{notification.id}" } %>
        <% end %>
      </div>
    </div>
  </li>
<% end %>
