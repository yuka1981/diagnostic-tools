<%= turbo_frame_tag "notification_badge" do %>
  <% if count > 0 %>
    <span class="absolute -top-1 -right-1 inline-flex items-center justify-center min-w-[18px] h-[18px] px-1 text-xs font-bold leading-none text-white bg-red-600 rounded-full">
      <%= count > 99 ? "99+" : count %>
    </span>
  <% end %>
<% end %>
