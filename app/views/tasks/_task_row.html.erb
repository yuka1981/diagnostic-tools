<tr id="<%= task.dom_id %>"
    class="hover:bg-neutral-2 transition-colors cursor-pointer"
    data-testid="tasks-row-<%= task.to_param %>"
    data-accordion-target="row"
    data-action="click->accordion#toggle">
  <td class="px-3 py-2" data-testid="tasks-expand-<%= task.to_param %>">
    <%= lucide_icon("chevron-right", class: "h-4 w-4 text-neutral-25 transition-transform", data: { accordion_target: "chevron" }) %>
  </td>
  <td class="whitespace-nowrap px-3 py-2">
    <% if task.benchmark? %>
      <span class="inline-flex items-center rounded-sm px-2 py-0.5 text-xs font-medium bg-primary-1 text-primary-8" data-testid="tasks-type-<%= task.to_param %>">
        Benchmark
      </span>
    <% else %>
      <span class="inline-flex items-center rounded-sm px-2 py-0.5 text-xs font-medium bg-login-1 text-login-8" data-testid="tasks-type-<%= task.to_param %>">
        Profiling
      </span>
    <% end %>
  </td>
  <td class="whitespace-nowrap px-3 py-2 text-sm text-neutral-45">
    <%= link_to task.node.hostname, node_path(task.node), class: "hover:text-primary-6", data: { turbo_frame: "_top", no_toggle: true, testid: "tasks-hostname-#{task.to_param}" } %>
  </td>
  <td class="whitespace-nowrap px-3 py-2">
    <p class="text-sm font-medium text-neutral-85" data-testid="tasks-recipe-<%= task.to_param %>"><%= task.recipe_name %></p>
  </td>
  <td class="whitespace-nowrap px-3 py-2">
    <span class="inline-flex items-center rounded-sm px-2 py-0.5 text-xs font-medium <%= task_status_badge_class(task.status) %>" data-testid="tasks-status-<%= task.to_param %>">
      <% if task.running? %>
        <%= lucide_icon("loader-2", class: "h-3 w-3 mr-1 animate-spin") %>
      <% end %>
      <%= task.status.humanize %>
    </span>
  </td>
  <td class="whitespace-nowrap px-3 py-2 text-sm text-neutral-45" title="<%= task.started_at&.strftime('%Y-%m-%d %H:%M:%S') %>" data-testid="tasks-started-<%= task.to_param %>">
    <%= task.started_at ? time_ago_in_words(task.started_at) + " ago" : "Pending" %>
  </td>
  <td class="whitespace-nowrap px-3 py-2 text-sm text-neutral-45" data-testid="tasks-duration-<%= task.to_param %>">
    <%= task.duration ? distance_of_time_in_words(task.duration) : "-" %>
  </td>
  <td class="whitespace-nowrap px-3 py-2" data-no-toggle>
    <div class="flex items-center justify-end gap-2">
      <%# Re-run Action %>
      <%= button_to rerun_task_path(task.to_param),
          method: :post,
          form: { class: "inline-flex" },
          class: "inline-flex items-center text-primary-6 hover:text-primary-7",
          title: "Re-run",
          data: { turbo_confirm: "Re-run this task with the same configuration?", no_toggle: true, testid: "tasks-button-rerun-#{task.to_param}" } do %>
        <%= lucide_icon("refresh-cw", class: "h-4 w-4") %>
      <% end %>

      <%# View Node Action %>
      <%= link_to node_path(task.node),
          class: "inline-flex items-center text-neutral-45 hover:text-neutral-85",
          title: "View Node",
          data: { turbo_frame: "_top", no_toggle: true, testid: "tasks-button-view-node-#{task.to_param}" } do %>
        <%= lucide_icon("server", class: "h-4 w-4") %>
      <% end %>

      <%# Cancel Action (pending/running only) %>
      <% if task.pending? || task.running? %>
        <%= button_to cancel_task_path(task.to_param),
            method: :post,
            form: { class: "inline-flex" },
            class: "inline-flex items-center text-warning-6 hover:text-warning-7",
            title: "Cancel",
            data: { turbo_confirm: "Are you sure you want to cancel this task?", no_toggle: true, testid: "tasks-button-cancel-#{task.to_param}" } do %>
          <%= lucide_icon("circle-x", class: "h-4 w-4") %>
        <% end %>
      <% end %>

      <%# Delete Action %>
      <%= button_to task_path(task.to_param),
          method: :delete,
          form: { class: "inline-flex" },
          class: "inline-flex items-center text-error-6 hover:text-error-7",
          title: "Delete",
          data: { turbo_confirm: "Are you sure you want to delete this task?", no_toggle: true, testid: "tasks-button-delete-#{task.to_param}" } do %>
        <%= lucide_icon("trash-2", class: "h-4 w-4") %>
      <% end %>
    </div>
  </td>
</tr>
