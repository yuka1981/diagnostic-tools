<% content_for(:page_title) { "Racks" } %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold text-slate-900">Racks</h1>
  </div>
  <div class="flex items-center gap-3">
    <% if current_user.approver? %>
      <%= link_to new_equipment_rack_path,
          class: "btn-primary",
          data: { turbo_frame: "equipment_rack_modal" } do %>
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        Add Rack
      <% end %>
    <% end %>
  </div>
</div>

<%# Racks table %>
<div id="equipment_racks_table">
  <%= render "equipment_racks/table", equipment_racks: @equipment_racks %>
</div>

<%# Modal turbo frame %>
<%= turbo_frame_tag "equipment_rack_modal" %>
