<% content_for(:page_title) { @equipment_rack.name } %>
<% content_for(:breadcrumbs) do %>
  <span class="mx-2">/</span>
  <%= link_to "Racks", equipment_racks_path, class: "hover:text-teal-600 font-bold" %>
  <span class="mx-2">/</span>
  <span class="font-medium text-slate-700"><%= @equipment_rack.name %></span>
<% end %>

<%# Header %>
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
  <div>
    <div class="flex items-center gap-3">
      <h1 class="text-2xl font-bold text-slate-900"><%= @equipment_rack.name %></h1>
    </div>
    <div class="mt-1 flex items-center gap-4 text-sm text-slate-500">
      <span>Room: <span class="font-medium text-slate-700"><%= @equipment_rack.room&.name || "Unassigned" %></span></span>
      <span>UUID: <span class="font-mono"><%= @equipment_rack.id %></span></span>
    </div>
  </div>

  <div class="flex items-center gap-2">
    <% if current_user.approver? %>
      <%= link_to edit_equipment_rack_path(@equipment_rack),
          class: "btn-secondary",
          data: { turbo_frame: "equipment_rack_modal" } do %>
        <svg class="h-4 w-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
        </svg>
        Edit
      <% end %>

      <%= button_to equipment_rack_path(@equipment_rack),
          method: :delete,
          class: "btn-danger",
          data: { turbo_confirm: "Are you sure you want to delete this rack?" } do %>
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h14" />
        </svg>
        Delete
      <% end %>
    <% end %>
  </div>
</div>

<div class="grid grid-cols-12 gap-6">
  <%# Rack Elevation %>
  <div class="col-span-12 lg:col-span-3">
    <%= render RackElevationComponent.new(rack: @equipment_rack, face: @face || :front) %>
  </div>

  <%# Details Card %>
  <div class="col-span-12 lg:col-span-3">
    <div class="card-netbox">
      <div class="card-header">
        <h3 class="card-title text-xs font-bold text-slate-500 uppercase">Rack Details</h3>
      </div>
      <div class="p-4">
        <dl class="space-y-3">
          <div class="flex justify-between">
            <dt class="text-sm font-medium text-slate-500">Name</dt>
            <dd class="text-sm text-slate-900"><%= @equipment_rack.name %></dd>
          </div>
          <div class="flex justify-between">
            <dt class="text-sm font-medium text-slate-500">Room</dt>
            <dd class="text-sm text-slate-900"><%= @equipment_rack.room&.name || "Unassigned" %></dd>
          </div>
          <div class="flex justify-between">
            <dt class="text-sm font-medium text-slate-500">U Height</dt>
            <dd class="text-sm text-slate-900"><%= @equipment_rack.u_height %>U</dd>
          </div>
          <div class="flex justify-between">
            <dt class="text-sm font-medium text-slate-500">Width</dt>
            <dd class="text-sm text-slate-900"><%= @equipment_rack.width %>"</dd>
          </div>
          <div class="flex justify-between items-center">
            <dt class="text-sm font-medium text-slate-500">Utilization</dt>
            <dd class="text-sm text-slate-900">
              <% utilization = @equipment_rack.utilization_percentage %>
              <div class="flex items-center gap-2">
                <div class="w-16 h-2 bg-slate-200 rounded-full overflow-hidden">
                  <div class="h-full rounded-full <%= utilization > 80 ? 'bg-red-500' : utilization > 50 ? 'bg-amber-500' : 'bg-teal-500' %>"
                       style="width: <%= utilization %>%"></div>
                </div>
                <span><%= utilization %>%</span>
              </div>
            </dd>
          </div>
          <% if @equipment_rack.notes.present? %>
            <div class="pt-3 border-t border-slate-200">
              <dt class="text-sm font-medium text-slate-500 mb-1">Notes</dt>
              <dd class="text-sm text-slate-700"><%= @equipment_rack.notes %></dd>
            </div>
          <% end %>
        </dl>
      </div>
    </div>
  </div>

  <%# Nodes Card %>
  <div class="col-span-12 lg:col-span-6">
    <div class="card-netbox">
      <div class="card-header">
        <h3 class="card-title text-xs font-bold text-slate-500 uppercase">Nodes in Rack</h3>
      </div>
      <div class="overflow-x-auto">
        <% if @nodes.any? %>
          <table class="min-w-full divide-y divide-slate-200 text-sm">
            <thead class="bg-slate-50">
              <tr>
                <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-slate-500 border-b">Hostname</th>
                <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-slate-500 border-b">Position</th>
                <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-slate-500 border-b">Height</th>
                <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-slate-500 border-b">Face</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 bg-white">
              <% @nodes.each do |node| %>
                <tr class="hover:bg-slate-50">
                  <td class="px-3 py-3 whitespace-nowrap">
                    <%= link_to node.hostname, node_path(node), class: "font-medium text-teal-600 hover:text-teal-800" %>
                  </td>
                  <td class="px-3 py-3 whitespace-nowrap text-slate-600">
                    <% if node.rack_position %>
                      U<%= node.rack_position %>
                    <% else %>
                      <span class="text-slate-400">Unpositioned</span>
                    <% end %>
                  </td>
                  <td class="px-3 py-3 whitespace-nowrap text-slate-600">
                    <%= node.rack_height %>U
                  </td>
                  <td class="px-3 py-3 whitespace-nowrap text-slate-600">
                    <%= node.rack_face.humanize %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <div class="p-8 text-center text-slate-500">No nodes assigned to this rack.</div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<%# Modal turbo frame %>
<%= turbo_frame_tag "equipment_rack_modal" %>
