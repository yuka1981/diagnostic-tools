<% content_for(:page_title) { @equipment_rack.name } %>
<% content_for(:breadcrumbs) do %>
  <span class="mx-2">/</span>
  <%= link_to "Racks", equipment_racks_path, class: "hover:text-teal-600 font-bold" %>
  <span class="mx-2">/</span>
  <span class="font-medium text-slate-700"><%= @equipment_rack.name %></span>
<% end %>

<%# Main container with rack-show controller %>
<div data-controller="rack-show">
  <%# Header %>
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="text-2xl font-bold text-slate-900"><%= @equipment_rack.name %></h1>
      </div>
      <div class="mt-1 flex items-center gap-4 text-sm text-slate-500">
        <span>Room: <span class="font-medium text-slate-700"><%= @equipment_rack.room&.name || "Unassigned" %></span></span>
        <% if @equipment_rack.row.present? %>
          <span>Row: <span class="font-medium text-slate-700"><%= @equipment_rack.row %></span></span>
        <% end %>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <% if current_user.approver? %>
        <%= link_to edit_equipment_rack_path(@equipment_rack),
            class: "btn-secondary",
            data: { turbo_frame: "equipment_rack_modal" } do %>
          <svg class="h-4 w-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
          Edit
        <% end %>

        <%= button_to equipment_rack_path(@equipment_rack),
            method: :delete,
            class: "btn-danger",
            data: { turbo_confirm: "Are you sure you want to delete this rack?" } do %>
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h14" />
          </svg>
          Delete
        <% end %>
      <% end %>
    </div>
  </div>

  <%# Summary Bar (shown on all sizes) %>
  <div class="flex flex-wrap items-center gap-4 p-4 bg-slate-50 rounded-lg mb-4 border border-slate-200">
    <div class="flex items-center gap-2">
      <span class="text-sm text-slate-500">U Height:</span>
      <span class="text-sm font-bold text-slate-700"><%= @equipment_rack.u_height %>U</span>
    </div>
    <div class="hidden sm:block w-px h-4 bg-slate-300"></div>
    <div class="flex items-center gap-2">
      <span class="text-sm text-slate-500">Width:</span>
      <span class="text-sm font-bold text-slate-700"><%= @equipment_rack.width %>"</span>
    </div>
    <div class="hidden sm:block w-px h-4 bg-slate-300"></div>
    <div class="flex items-center gap-2">
      <span class="text-sm text-slate-500">Utilization:</span>
      <% utilization = @equipment_rack.utilization_percentage %>
      <div class="flex items-center gap-2">
        <div class="w-20 h-2 bg-slate-200 rounded-full overflow-hidden">
          <div class="h-full rounded-full <%= utilization > 80 ? 'bg-red-500' : utilization > 50 ? 'bg-amber-500' : 'bg-teal-500' %>"
               style="width: <%= utilization %>%"></div>
        </div>
        <span class="text-sm font-bold text-slate-700"><%= utilization %>%</span>
      </div>
    </div>
  </div>

  <%# Mobile Swipe Layout (hidden on desktop) %>
  <div data-controller="swipe" class="lg:hidden">
    <%# Swipe Container %>
    <div data-swipe-target="container"
         class="swipe-container flex overflow-x-auto">
      <%# View 1: Elevation %>
      <div data-swipe-target="view"
           class="swipe-view w-full flex-shrink-0 px-1">
        <%= render RackElevationComponent.new(rack: @equipment_rack, face: @face || :front) %>
      </div>

      <%# View 2: Nodes List %>
      <div data-swipe-target="view"
           class="swipe-view w-full flex-shrink-0 px-1">
        <%= render "equipment_racks/nodes_list", nodes: @nodes, positioned_nodes: @nodes.where.not(rack_position: nil).order(rack_position: :desc), unpositioned_nodes: @nodes.where(rack_position: nil) %>
      </div>
    </div>

    <%# Dot Indicators %>
    <div class="flex justify-center gap-3 mt-4 pb-2">
      <button data-swipe-target="dot"
              data-action="click->swipe#goToView"
              data-index="0"
              class="w-3 h-3 rounded-full bg-teal-600 transition-colors focus:outline-none focus:ring-2 focus:ring-teal-500 focus:ring-offset-2"
              aria-label="View Elevation"
              aria-current="true">
      </button>
      <button data-swipe-target="dot"
              data-action="click->swipe#goToView"
              data-index="1"
              class="w-3 h-3 rounded-full bg-slate-300 transition-colors focus:outline-none focus:ring-2 focus:ring-teal-500 focus:ring-offset-2"
              aria-label="View Nodes"
              aria-current="false">
      </button>
    </div>

    <%# Notes section (mobile) %>
    <% if @equipment_rack.notes.present? %>
      <div class="card-netbox mt-4">
        <div class="card-header">
          <h3 class="card-title text-xs font-bold text-slate-500 uppercase">Notes</h3>
        </div>
        <div class="p-4">
          <p class="text-sm text-slate-700 whitespace-pre-wrap"><%= @equipment_rack.notes %></p>
        </div>
      </div>
    <% end %>
  </div>

  <%# Desktop Two-column layout (hidden on mobile) %>
  <div class="hidden lg:flex lg:flex-row gap-6">
    <%# Left Column: Rack Elevation (sticky on desktop) %>
    <div class="w-[320px] flex-shrink-0">
      <div class="sticky top-4">
        <%= render RackElevationComponent.new(rack: @equipment_rack, face: @face || :front) %>
      </div>
    </div>

    <%# Right Column: Nodes List %>
    <div class="flex-1 min-w-0">
      <%= render "equipment_racks/nodes_list", nodes: @nodes, positioned_nodes: @nodes.where.not(rack_position: nil).order(rack_position: :desc), unpositioned_nodes: @nodes.where(rack_position: nil) %>

      <%# Notes section if present %>
      <% if @equipment_rack.notes.present? %>
        <div class="card-netbox mt-4">
          <div class="card-header">
            <h3 class="card-title text-xs font-bold text-slate-500 uppercase">Notes</h3>
          </div>
          <div class="p-4">
            <p class="text-sm text-slate-700 whitespace-pre-wrap"><%= @equipment_rack.notes %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<%# Modal turbo frame %>
<%= turbo_frame_tag "equipment_rack_modal" %>
