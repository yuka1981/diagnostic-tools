<% breadcrumb_trail([
  { title: "Sites", path: sites_path },
  { title: @room.site.name, path: site_path(@room.site) },
  { title: @room.name }
]) %>

<div class="mb-6" data-testid="rooms-show-container">
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-4">
      <h1 class="text-2xl font-bold text-neutral-85" data-testid="rooms-show-name"><%= @room.name %></h1>
      <% if @room.at_capacity? %>
        <span class="inline-flex items-center rounded-sm px-2 py-0.5 text-xs font-medium bg-warning-1 text-warning-8 border border-warning-2" data-testid="rooms-show-capacity-badge">
          At Capacity
        </span>
      <% end %>
    </div>
    <% if current_user.approver? %>
      <div class="flex items-center gap-2">
        <%= link_to edit_room_path(@room), class: "btn-secondary", data: { testid: "rooms-show-button-edit" } do %>
          <%= lucide_icon("square-pen", class: "h-4 w-4 mr-1") %>
          Edit
        <% end %>
        <%= link_to new_server_rack_path(room_id: @room.id), class: "btn-primary", data: { testid: "rooms-show-button-add-rack" } do %>
          <%= lucide_icon("plus", class: "h-4 w-4 mr-1") %>
          Add Rack
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<div class="grid gap-6 lg:grid-cols-2">
  <%# Overview Card %>
  <div class="card-netbox" data-testid="rooms-show-overview">
    <div class="card-header">
      <h3 class="card-title">Overview</h3>
    </div>
    <div class="p-0">
      <table class="w-full text-sm text-left">
        <tbody class="divide-y divide-neutral-4">
          <tr class="hover:bg-neutral-2">
            <th class="px-4 py-2 font-bold text-neutral-85 w-1/3 border-r border-neutral-8">Name</th>
            <td class="px-4 py-2 text-neutral-85 font-bold"><%= @room.name %></td>
          </tr>
          <tr class="hover:bg-neutral-2">
            <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Site</th>
            <td class="px-4 py-2 text-neutral-85">
              <%= link_to @room.site.name, site_path(@room.site), class: "text-primary-6 hover:text-primary-7" %>
            </td>
          </tr>
          <tr class="hover:bg-neutral-2">
            <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Description</th>
            <td class="px-4 py-2 text-neutral-85"><%= @room.description.presence || "-" %></td>
          </tr>
          <tr class="hover:bg-neutral-2">
            <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Floor</th>
            <td class="px-4 py-2 text-neutral-85"><%= @room.floor_number.present? ? "Floor #{@room.floor_number}" : "-" %></td>
          </tr>
          <tr class="hover:bg-neutral-2">
            <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Building Wing</th>
            <td class="px-4 py-2 text-neutral-85"><%= @room.building_wing.presence || "-" %></td>
          </tr>
          <tr class="hover:bg-neutral-2">
            <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Grid Coordinates</th>
            <td class="px-4 py-2 text-neutral-85 font-mono"><%= @room.grid_coordinates.presence || "-" %></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <%# Capacity Card %>
  <div class="card-netbox" data-testid="rooms-show-capacity">
    <div class="card-header">
      <h3 class="card-title">Capacity</h3>
    </div>
    <div class="p-0">
      <table class="w-full text-sm text-left">
        <tbody class="divide-y divide-neutral-4">
          <tr class="hover:bg-neutral-2">
            <th class="px-4 py-2 font-bold text-neutral-85 w-1/3 border-r border-neutral-8">Racks</th>
            <td class="px-4 py-2 text-neutral-85">
              <%= @room.rack_count %><%= @room.max_rack_count.present? ? " / #{@room.max_rack_count}" : "" %>
            </td>
          </tr>
          <tr class="hover:bg-neutral-2">
            <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Total U Capacity</th>
            <td class="px-4 py-2 text-neutral-85"><%= @room.total_u_capacity %>U</td>
          </tr>
          <tr class="hover:bg-neutral-2">
            <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Total U Used</th>
            <td class="px-4 py-2 text-neutral-85"><%= @room.total_u_used %>U</td>
          </tr>
          <tr class="hover:bg-neutral-2">
            <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Utilization</th>
            <td class="px-4 py-2">
              <div class="flex items-center gap-2">
                <div class="w-32 h-3 bg-neutral-8 rounded-full overflow-hidden">
                  <div class="h-full bg-primary-5 rounded-full" style="width: <%= @room.utilization_percentage %>%"></div>
                </div>
                <span class="text-sm font-medium text-neutral-85"><%= @room.utilization_percentage %>%</span>
              </div>
            </td>
          </tr>
          <tr class="hover:bg-neutral-2">
            <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Floor Area</th>
            <td class="px-4 py-2 text-neutral-85"><%= @room.floor_area_sqm.present? ? "#{@room.floor_area_sqm} m²" : "-" %></td>
          </tr>
          <tr class="hover:bg-neutral-2">
            <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Power Capacity</th>
            <td class="px-4 py-2 text-neutral-85"><%= @room.power_capacity_kw.present? ? "#{@room.power_capacity_kw} kW" : "-" %></td>
          </tr>
          <tr class="hover:bg-neutral-2">
            <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Cooling Capacity</th>
            <td class="px-4 py-2 text-neutral-85"><%= @room.cooling_capacity_kw.present? ? "#{@room.cooling_capacity_kw} kW" : "-" %></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%# Racks List %>
<div class="card-netbox mt-6" data-testid="rooms-show-racks">
  <div class="card-header flex items-center justify-between">
    <h3 class="card-title">Racks</h3>
  </div>
  <% if @server_racks.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-neutral-8 text-sm" data-testid="rooms-show-racks-table">
        <thead class="bg-neutral-2">
          <tr>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Name</th>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Facility ID</th>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Status</th>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Height</th>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Utilization</th>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Nodes</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-neutral-8 bg-white" data-testid="rooms-show-racks-tbody">
          <% @server_racks.each do |rack| %>
            <tr class="hover:bg-neutral-2 transition-colors" data-testid="rooms-rack-row-<%= rack.name.parameterize %>">
              <td class="whitespace-nowrap px-3 py-2">
                <%= link_to server_rack_path(rack), class: "group", data: { testid: "rooms-rack-link-#{rack.name.parameterize}" } do %>
                  <p class="text-sm font-bold text-neutral-85 group-hover:text-primary-6"><%= rack.name %></p>
                <% end %>
              </td>
              <td class="whitespace-nowrap px-3 py-2 text-sm text-neutral-45 font-mono">
                <%= rack.facility_id.presence || "-" %>
              </td>
              <td class="whitespace-nowrap px-3 py-2">
                <% case rack.status %>
                <% when "active" %>
                  <span class="inline-flex items-center rounded-sm px-2 py-0.5 text-xs font-medium bg-success-1 text-success-8 border border-success-2">
                    Active
                  </span>
                <% when "planned" %>
                  <span class="inline-flex items-center rounded-sm px-2 py-0.5 text-xs font-medium bg-primary-1 text-primary-8 border border-primary-2">
                    Planned
                  </span>
                <% when "decommissioned" %>
                  <span class="inline-flex items-center rounded-sm px-2 py-0.5 text-xs font-medium bg-neutral-4 text-neutral-45 border border-neutral-8">
                    Decommissioned
                  </span>
                <% end %>
              </td>
              <td class="whitespace-nowrap px-3 py-2 text-sm text-neutral-45">
                <%= rack.u_height %>U
              </td>
              <td class="whitespace-nowrap px-3 py-2">
                <div class="flex items-center gap-2">
                  <div class="w-24 h-2 bg-neutral-8 rounded-full overflow-hidden">
                    <div class="h-full bg-primary-5 rounded-full" style="width: <%= rack.utilization_percentage %>%"></div>
                  </div>
                  <span class="text-xs text-neutral-45"><%= rack.utilization_percentage %>%</span>
                </div>
              </td>
              <td class="whitespace-nowrap px-3 py-2 text-sm text-neutral-45">
                <%= rack.nodes.count %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="flex flex-col items-center justify-center py-12 text-center" data-testid="rooms-show-racks-empty">
      <div class="h-12 w-12 rounded-full bg-neutral-4 flex items-center justify-center mb-4">
        <%= lucide_icon("server", class: "h-6 w-6 text-neutral-25") %>
      </div>
      <p class="text-sm font-medium text-neutral-85">No racks in this room</p>
      <p class="mt-1 text-xs text-neutral-45">Add racks to organize your servers</p>
      <% if current_user.approver? %>
        <%= link_to new_server_rack_path(room_id: @room.id), class: "mt-4 btn-primary" do %>
          Add Rack
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>

<%# Danger Zone %>
<% if current_user.approver? && @server_racks.empty? %>
  <div class="card-netbox mt-6 border-error-2" data-testid="rooms-show-danger-zone">
    <div class="card-header bg-error-1 border-error-2">
      <h3 class="card-title text-error-8">Danger Zone</h3>
    </div>
    <div class="p-4">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-neutral-85">Delete this room</p>
          <p class="text-xs text-neutral-45">Once deleted, this room cannot be recovered.</p>
        </div>
        <%= button_to room_path(@room),
            method: :delete,
            class: "btn-danger",
            data: { turbo_confirm: "Are you sure you want to delete this room? This action cannot be undone.", testid: "rooms-show-button-delete" } do %>
          Delete Room
        <% end %>
      </div>
    </div>
  </div>
<% end %>
