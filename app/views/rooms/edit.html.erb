<% breadcrumb_trail([
  { title: "Sites", path: sites_path },
  { title: @room.site.name, path: site_path(@room.site) },
  { title: @room.name, path: room_path(@room) },
  { title: "Edit" }
]) %>

<div class="mb-6" data-testid="rooms-edit-container">
  <h1 class="text-2xl font-bold text-neutral-85" data-testid="rooms-edit-title">Edit <%= @room.name %></h1>
  <p class="text-sm text-neutral-45 mt-1">Modify room information</p>
</div>

<%= render "form" %>
