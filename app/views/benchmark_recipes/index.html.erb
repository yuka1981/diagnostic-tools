<% content_for(:page_title) { "Benchmark Recipes" } %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold text-slate-900">Benchmark Recipes</h1>
    <p class="text-sm text-slate-500 mt-1">Manage benchmark test configurations</p>
  </div>
  <% if current_user.approver? %>
    <%= link_to new_benchmark_recipe_path, class: "btn-primary" do %>
<%= lucide_icon("plus", class: "h-4 w-4 mr-2") %>
      Add Recipe
    <% end %>
  <% end %>
</div>

<div class="card-netbox">
  <% if @benchmark_recipes.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200 text-sm">
        <thead class="bg-slate-50">
          <tr>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-slate-500 border-b">Name</th>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-slate-500 border-b">Command</th>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-slate-500 border-b">Timeout</th>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-slate-500 border-b">Status</th>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-slate-500 border-b">Runs</th>
            <th scope="col" class="relative px-3 py-2 border-b">
              <span class="sr-only">Actions</span>
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 bg-white">
          <% @benchmark_recipes.each do |recipe| %>
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="whitespace-nowrap px-3 py-2">
                <%= link_to benchmark_recipe_path(recipe), class: "group" do %>
                  <p class="text-sm font-bold text-slate-900 group-hover:text-teal-600"><%= recipe.name %></p>
                  <p class="text-xs text-slate-500">v<%= recipe.version %></p>
                <% end %>
              </td>
              <td class="whitespace-nowrap px-3 py-2 text-sm text-slate-600 font-mono">
                <%= recipe.command %>
              </td>
              <td class="whitespace-nowrap px-3 py-2 text-sm text-slate-500">
                <%= distance_of_time_in_words(recipe.timeout_seconds) %>
              </td>
              <td class="whitespace-nowrap px-3 py-2">
                <% if recipe.active? %>
                  <span class="inline-flex items-center rounded-sm px-2 py-0.5 text-xs font-medium bg-emerald-100 text-emerald-800 border border-emerald-200">
                    Active
                  </span>
                <% else %>
                  <span class="inline-flex items-center rounded-sm px-2 py-0.5 text-xs font-medium bg-slate-100 text-slate-600 border border-slate-200">
                    Archived
                  </span>
                <% end %>
              </td>
              <td class="whitespace-nowrap px-3 py-2 text-sm text-slate-500">
                <%= recipe.benchmark_runs.count %>
              </td>
              <td class="whitespace-nowrap px-3 py-2 text-right text-sm">
                <%= link_to "View", benchmark_recipe_path(recipe), class: "text-teal-600 hover:text-teal-700 font-medium" %>
                <% if current_user.approver? %>
                  <span class="text-slate-300 mx-1">|</span>
                  <%= link_to "Edit", edit_benchmark_recipe_path(recipe), class: "text-slate-600 hover:text-slate-700 font-medium" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="flex flex-col items-center justify-center py-12 text-center">
      <div class="h-12 w-12 rounded-full bg-slate-100 flex items-center justify-center mb-4">
        <%= lucide_icon("flask-conical", class: "h-6 w-6 text-slate-400") %>
      </div>
      <p class="text-sm font-medium text-slate-900">No benchmark recipes yet</p>
      <p class="mt-1 text-xs text-slate-500">Create a recipe to define benchmark configurations</p>
      <% if current_user.approver? %>
        <%= link_to new_benchmark_recipe_path, class: "mt-4 btn-primary" do %>
          Add Recipe
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
