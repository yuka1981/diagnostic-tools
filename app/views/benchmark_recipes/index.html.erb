<% content_for(:page_title) { "Benchmark Recipes" } %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold text-slate-900">Benchmark Recipes</h1>
  </div>
</div>

<% if @benchmark_recipes.any? %>
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    <% @benchmark_recipes.each do |recipe| %>
      <%= link_to benchmark_recipe_path(recipe), 
          class: "group block card-netbox transition-all hover:bg-teal-50" do %>
        <div class="p-4 flex items-center gap-4">
          <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-white border border-slate-300 shadow-sm">
            <svg class="h-6 w-6 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-bold text-slate-900 group-hover:text-teal-600 transition-colors">
              <%= recipe.name %>
            </p>
            <p class="text-xs text-slate-500 font-bold uppercase tracking-wider">Version <%= recipe.version %></p>
          </div>
          <svg class="h-5 w-5 text-slate-400 group-hover:text-teal-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="text-center py-12 card-netbox bg-slate-50 border-dashed">
    <p class="text-slate-500 font-bold uppercase text-xs">No recipes available.</p>
  </div>
<% end %>

