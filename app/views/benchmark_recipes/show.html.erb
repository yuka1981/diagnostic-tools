<% content_for(:page_title) { @benchmark_recipe.display_name } %>
<% content_for(:breadcrumbs) do %>
  <span class="mx-2">/</span>
  <%= link_to "Benchmark Recipes", benchmark_recipes_path, class: "hover:text-teal-600 font-bold" %>
  <span class="mx-2">/</span>
  <span class="font-medium text-slate-700"><%= @benchmark_recipe.name %></span>
<% end %>

<div class="card-netbox mb-6">
  <div class="card-header">
    <h3 class="card-title">Recipe Details</h3>
  </div>
  <div class="p-0">
    <table class="w-full text-sm text-left">
      <tbody class="divide-y divide-slate-100">
        <tr class="hover:bg-slate-50">
          <th class="px-4 py-2 font-bold text-slate-700 w-1/3 border-r border-slate-200">Name</th>
          <td class="px-4 py-2 text-slate-700 font-bold"><%= @benchmark_recipe.name %></td>
        </tr>
        <tr class="hover:bg-slate-50">
          <th class="px-4 py-2 font-bold text-slate-700 border-r border-slate-200">Version</th>
          <td class="px-4 py-2 text-slate-700"><%= @benchmark_recipe.version %></td>
        </tr>
        <tr class="hover:bg-slate-50">
          <th class="px-4 py-2 font-bold text-slate-700 border-r border-slate-200">Total Runs</th>
          <td class="px-4 py-2 text-slate-700"><%= @benchmark_recipe.benchmark_runs.count %></td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<% if @benchmark_recipe.default_profile.present? %>
  <div class="card-netbox">
    <div class="card-header">
      <h3 class="card-title">Default Profile</h3>
    </div>
    <div class="p-4 bg-slate-50">
      <pre class="text-xs text-slate-700 font-mono overflow-x-auto"><%= JSON.pretty_generate(@benchmark_recipe.default_profile) %></pre>
    </div>
  </div>
<% end %>

