<% breadcrumb_trail([
  { title: "Benchmark Recipes", path: benchmark_recipes_path },
  { title: @benchmark_recipe.name }
]) %>

<div class="mb-6">
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-4">
      <h1 class="text-2xl font-bold text-neutral-85"><%= @benchmark_recipe.display_name %></h1>
      <% if @benchmark_recipe.active? %>
        <span class="inline-flex items-center rounded-sm px-2 py-0.5 text-xs font-medium bg-emerald-100 text-emerald-800 border border-emerald-200">
          Active
        </span>
      <% else %>
        <span class="inline-flex items-center rounded-sm px-2 py-0.5 text-xs font-medium bg-neutral-4 text-neutral-45 border border-neutral-8">
          Archived
        </span>
      <% end %>
    </div>
    <% if current_user.approver? %>
      <div class="flex items-center gap-2">
        <%= link_to edit_benchmark_recipe_path(@benchmark_recipe), class: "btn-secondary" do %>
          <%= lucide_icon("square-pen", class: "h-4 w-4 mr-1") %>
          Edit
        <% end %>
        <% if @benchmark_recipe.active? %>
          <%= button_to archive_benchmark_recipe_path(@benchmark_recipe), method: :patch, class: "btn-secondary", data: { turbo_confirm: "Archive this recipe?" } do %>
            Archive
          <% end %>
        <% else %>
          <%= button_to activate_benchmark_recipe_path(@benchmark_recipe), method: :patch, class: "btn-primary" do %>
            Activate
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<div class="grid gap-6 lg:grid-cols-2">
  <%# Overview Card %>
  <div class="card-netbox">
    <div class="card-header">
      <h3 class="card-title">Overview</h3>
    </div>
    <div class="p-0">
      <table class="w-full text-sm text-left">
        <tbody class="divide-y divide-neutral-4">
          <tr class="hover:bg-neutral-2">
            <th class="px-4 py-2 font-bold text-neutral-85 w-1/3 border-r border-neutral-8">Name</th>
            <td class="px-4 py-2 text-neutral-85 font-bold"><%= @benchmark_recipe.name %></td>
          </tr>
          <tr class="hover:bg-neutral-2">
            <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Version</th>
            <td class="px-4 py-2 text-neutral-85"><%= @benchmark_recipe.version %></td>
          </tr>
          <tr class="hover:bg-neutral-2">
            <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Slug</th>
            <td class="px-4 py-2 text-neutral-45 font-mono text-xs"><%= @benchmark_recipe.slug %></td>
          </tr>
          <tr class="hover:bg-neutral-2">
            <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Description</th>
            <td class="px-4 py-2 text-neutral-85"><%= @benchmark_recipe.description.presence || "—" %></td>
          </tr>
          <tr class="hover:bg-neutral-2">
            <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Total Runs</th>
            <td class="px-4 py-2 text-neutral-85"><%= @benchmark_recipe.benchmark_runs.count %></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <%# Technical Details Card %>
  <div class="card-netbox">
    <div class="card-header">
      <h3 class="card-title">Technical Details</h3>
    </div>
    <div class="p-0">
      <table class="w-full text-sm text-left">
        <tbody class="divide-y divide-neutral-4">
          <tr class="hover:bg-neutral-2">
            <th class="px-4 py-2 font-bold text-neutral-85 w-1/3 border-r border-neutral-8">Command</th>
            <td class="px-4 py-2 text-neutral-85 font-mono"><%= @benchmark_recipe.command %></td>
          </tr>
          <tr class="hover:bg-neutral-2">
            <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Timeout</th>
            <td class="px-4 py-2 text-neutral-85">
              <%= @benchmark_recipe.timeout_seconds %> seconds
              <span class="text-neutral-25">(<%= distance_of_time_in_words(@benchmark_recipe.timeout_seconds) %>)</span>
            </td>
          </tr>
          <tr class="hover:bg-neutral-2">
            <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Status</th>
            <td class="px-4 py-2">
              <% if @benchmark_recipe.active? %>
                <span class="inline-flex items-center rounded-sm px-2 py-0.5 text-xs font-medium bg-emerald-100 text-emerald-800 border border-emerald-200">
                  Active
                </span>
              <% else %>
                <span class="inline-flex items-center rounded-sm px-2 py-0.5 text-xs font-medium bg-neutral-4 text-neutral-45 border border-neutral-8">
                  Archived
                </span>
              <% end %>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%# Default Profile Card %>
<div class="card-netbox mt-6">
  <div class="card-header">
    <h3 class="card-title">Default Profile</h3>
  </div>
  <% if @benchmark_recipe.default_profile.present? %>
    <div class="p-4 bg-neutral-2">
      <pre class="text-xs text-neutral-85 font-mono overflow-x-auto whitespace-pre-wrap"><%= JSON.pretty_generate(@benchmark_recipe.default_profile) %></pre>
    </div>
  <% else %>
    <div class="p-4 text-center text-neutral-45 text-sm">
      No default profile configured
    </div>
  <% end %>
</div>

<%# Danger Zone %>
<% if current_user.approver? && @benchmark_recipe.benchmark_runs.empty? %>
  <div class="card-netbox mt-6 border-error-2">
    <div class="card-header bg-error-1 border-error-2">
      <h3 class="card-title text-error-8">Danger Zone</h3>
    </div>
    <div class="p-4">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-neutral-85">Delete this recipe</p>
          <p class="text-xs text-neutral-45">Once deleted, this recipe cannot be recovered.</p>
        </div>
        <%= button_to benchmark_recipe_path(@benchmark_recipe),
            method: :delete,
            class: "btn-danger",
            data: { turbo_confirm: "Are you sure you want to delete this recipe? This action cannot be undone." } do %>
          Delete Recipe
        <% end %>
      </div>
    </div>
  </div>
<% end %>
