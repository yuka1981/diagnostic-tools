<%= turbo_frame_tag "api_key_modal" do %>
  <%= render "shared/modal", title: "Generate New API Key", max_width: "max-w-md" do %>
    <%= form_with model: @api_key, id: "new_api_key_form", class: "space-y-4" do |f| %>
      <% if @api_key.errors.any? %>
        <div class="rounded bg-red-50 p-4 border border-red-200">
          <div class="flex">
            <div class="ml-3">
              <h3 class="text-sm font-bold text-red-800 uppercase tracking-wider">Validation Errors</h3>
              <div class="mt-2 text-sm text-red-700">
                <ul role="list" class="list-disc pl-5 space-y-1">
                  <% @api_key.errors.full_messages.each do |msg| %>
                    <li><%= msg %></li>
                  <% end %>
                </ul>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <div>
        <%= f.label :name, "Key Name", class: "block text-sm font-bold text-slate-700 mb-1" %>
        <%= f.text_field :name, 
            class: "block w-full rounded-md border-slate-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 sm:text-sm", 
            placeholder: "e.g., Compute Cluster Alpha" %>
        <p class="mt-2 text-xs text-slate-500">Give this key a descriptive name to identify which agent/node will use it.</p>
      </div>
    <% end %>

    <% content_for :modal_footer do %>
      <button type="button" class="btn-secondary" data-action="click->modal#close">Cancel</button>
      <button type="submit" form="new_api_key_form" class="btn-primary">Generate API Key</button>
    <% end %>
  <% end %>
<% end %>