<% content_for(:page_title) { "API Key Management" } %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold text-neutral-85">API Key Management</h1>
  </div>
  <%= link_to new_api_key_path, class: "btn-primary" do %>
    <%= lucide_icon("plus", class: "h-4 w-4") %>
    Generate New Key
  <% end %>
</div>

<div class="card-netbox">
  <% if @api_keys.any? %>
    <table class="min-w-full divide-y divide-neutral-8 text-sm">
      <thead class="bg-neutral-2">
        <tr>
          <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Name</th>
          <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Token</th>
          <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Status</th>
          <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Last Used</th>
          <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Created</th>
          <th scope="col" class="relative px-3 py-2 border-b">
            <span class="sr-only">Actions</span>
          </th>
        </tr>
      </thead>
      <tbody class="divide-y divide-neutral-8 bg-white">
        <% @api_keys.each do |key| %>
          <tr class="hover:bg-primary-1 border-b border-neutral-8 transition-colors">
            <td class="whitespace-nowrap px-3 py-2 font-bold text-neutral-85">
              <%= key.name %>
            </td>
            <td class="whitespace-nowrap px-3 py-2 text-xs font-mono text-neutral-45">
              <% if key.active? %>
                <span class="blur-sm hover:blur-none transition-all cursor-pointer" title="Hover to reveal">
                  <%= key.token.truncate(12) %>...
                </span>
              <% else %>
                <span class="line-through text-neutral-25"><%= key.token.truncate(12) %>...</span>
              <% end %>
            </td>
            <td class="whitespace-nowrap px-3 py-2">
              <% if key.active? %>
                <span class="inline-flex items-center rounded-sm bg-success-2 px-2 py-0.5 text-xs font-bold text-success-8 border border-success-2">
                  Active
                </span>
              <% else %>
                <span class="inline-flex items-center rounded-sm bg-neutral-4 px-2 py-0.5 text-xs font-bold text-neutral-85 border border-neutral-8">
                  Revoked
                </span>
              <% end %>
            </td>
            <td class="whitespace-nowrap px-3 py-2 text-neutral-45">
              <%= key.last_used_at ? time_ago_in_words(key.last_used_at) + " ago" : "Never" %>
            </td>
            <td class="whitespace-nowrap px-3 py-2 text-neutral-45">
              <%= key.created_at.strftime("%Y-%m-%d") %>
            </td>
            <td class="whitespace-nowrap px-3 py-2">
              <div class="flex items-center justify-end gap-2">
                <% if key.active? %>
                  <%= button_to revoke_api_key_path(key),
                      method: :patch,
                      form: { class: "inline-flex" },
                      class: "inline-flex items-center text-error-6 hover:text-error-7",
                      title: "Revoke",
                      data: { confirm: "Are you sure you want to revoke this API key?" } do %>
                    <%= lucide_icon("ban", class: "h-5 w-5") %>
                  <% end %>
                <% else %>
                  <%= button_to api_key_path(key),
                      method: :delete,
                      form: { class: "inline-flex" },
                      class: "inline-flex items-center text-error-6 hover:text-error-7",
                      title: "Delete",
                      data: { confirm: "Are you sure you want to delete this API key?" } do %>
                    <%= lucide_icon("trash-2", class: "h-5 w-5") %>
                  <% end %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="flex flex-col items-center justify-center py-12 text-center">
      <%= lucide_icon("key", class: "h-12 w-12 text-neutral-15") %>
      <p class="mt-4 text-sm font-medium text-neutral-45">No API keys found</p>
      <p class="mt-1 text-xs text-neutral-25">Generate a key to allow agents to push benchmarking results</p>
    </div>
  <% end %>
</div>
