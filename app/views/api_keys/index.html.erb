<% content_for(:page_title) { "API Key Management" } %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold text-slate-900">API Key Management</h1>
  </div>
  <%= link_to new_api_key_path, class: "btn-primary" do %>
<%= lucide_icon("plus", class: "h-4 w-4") %>
    Generate New Key
  <% end %>
</div>

<div class="card-netbox">
  <% if @api_keys.any? %>
    <table class="min-w-full divide-y divide-slate-200 text-sm">
      <thead class="bg-slate-50">
        <tr>
          <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-slate-500 border-b">Name</th>
          <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-slate-500 border-b">Token</th>
          <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-slate-500 border-b">Status</th>
          <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-slate-500 border-b">Last Used</th>
          <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-slate-500 border-b">Created</th>
          <th scope="col" class="relative px-3 py-2 border-b">
            <span class="sr-only">Actions</span>
          </th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200 bg-white">
        <% @api_keys.each do |key| %>
          <tr class="hover:bg-teal-50 border-b border-slate-200 transition-colors">
            <td class="whitespace-nowrap px-3 py-2 font-bold text-slate-700">
              <%= key.name %>
            </td>
            <td class="whitespace-nowrap px-3 py-2 text-xs font-mono text-slate-500">
              <% if key.active? %>
                <span class="blur-sm hover:blur-none transition-all cursor-pointer" title="Hover to reveal">
                  <%= key.token.truncate(12) %>...
                </span>
              <% else %>
                <span class="line-through text-slate-400"><%= key.token.truncate(12) %>...</span>
              <% end %>
            </td>
            <td class="whitespace-nowrap px-3 py-2">
              <% if key.active? %>
                <span class="inline-flex items-center rounded-sm bg-green-100 px-2 py-0.5 text-xs font-bold text-green-800 border border-green-200">
                  Active
                </span>
              <% else %>
                <span class="inline-flex items-center rounded-sm bg-slate-100 px-2 py-0.5 text-xs font-bold text-slate-700 border border-slate-200">
                  Revoked
                </span>
              <% end %>
            </td>
            <td class="whitespace-nowrap px-3 py-2 text-slate-500">
              <%= key.last_used_at ? time_ago_in_words(key.last_used_at) + " ago" : "Never" %>
            </td>
            <td class="whitespace-nowrap px-3 py-2 text-slate-500">
              <%= key.created_at.strftime("%Y-%m-%d") %>
            </td>
            <td class="whitespace-nowrap px-3 py-2 text-right text-sm">
              <div class="flex items-center justify-end gap-2">
                <% if key.active? %>
                  <%= button_to revoke_api_key_path(key), 
                      method: :patch,
                      data: { confirm: "Are you sure you want to revoke this API key?" },
                      class: "text-slate-400 hover:text-red-600 transition-colors",
                      title: "Revoke" do %>
<%= lucide_icon("ban", class: "h-4 w-4") %>
                  <% end %>
                <% else %>
                  <%= button_to api_key_path(key), 
                      method: :delete,
                      data: { confirm: "Are you sure you want to delete this API key?" },
                      class: "text-slate-400 hover:text-red-600 transition-colors",
                      title: "Delete" do %>
<%= lucide_icon("trash-2", class: "h-4 w-4") %>
                  <% end %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="flex flex-col items-center justify-center py-12 text-center">
      <svg class="h-12 w-12 text-gray-300 dark:text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
      </svg>
      <p class="mt-4 text-sm font-medium text-gray-500 dark:text-slate-400">No API keys found</p>
      <p class="mt-1 text-xs text-gray-400 dark:text-slate-500">Generate a key to allow agents to push benchmarking results</p>
    </div>
  <% end %>
</div>
