<%# Node Heatmap Grid - Visual representation of cluster status %>
<div class="card-netbox !overflow-visible"
     data-controller="heatmap"
     data-heatmap-runs-frame-id-value="filtered_runs">
  
  <div class="card-header">
    <div>
      <h2 class="card-title">Node Heatmap</h2>
      <p class="text-[10px] text-neutral-45 lowercase font-normal italic">Click a node to filter benchmark runs</p>
    </div>
    
    <%# Selection indicator and clear button %>
    <div class="flex items-center gap-3">
      <span data-heatmap-target="selectedLabel" 
            class="hidden text-xs font-bold text-primary-6 uppercase tracking-tight"></span>
      <button type="button"
              data-heatmap-target="clearButton"
              data-action="click->heatmap#clearSelection"
              class="hidden items-center gap-1.5 rounded bg-neutral-4 px-2 py-1 text-[10px] font-bold text-neutral-85 hover:bg-neutral-8 border border-neutral-15 transition-colors uppercase">
        <%= lucide_icon("x", class: "h-3 w-3") %>
        Clear filter
      </button>
    </div>
  </div>

  <div class="p-4">
    <%# Legend %>
    <div class="flex items-center gap-4 mb-4 text-[10px] font-bold uppercase tracking-tight">
      <div class="flex items-center gap-1.5">
        <div class="h-3 w-3 rounded-full bg-success-5"></div>
        <span class="text-neutral-45">Online</span>
      </div>
      <div class="flex items-center gap-1.5">
        <div class="h-3 w-3 rounded-full bg-neutral-15"></div>
        <span class="text-neutral-45">Offline</span>
      </div>
    </div>

    <% if nodes.any? %>
      <%# Group nodes by role %>
      <% grouped_nodes = nodes.group_by(&:role) %>
      <% role_order = %w[admin login compute k8s_worker] %>
      <% role_labels = { "admin" => "Admin", "login" => "Login", "compute" => "Compute", "k8s_worker" => "K8s Worker" } %>

      <div class="space-y-4" role="grid" aria-label="Node heatmap">
        <% role_order.each do |role| %>
          <% role_nodes = grouped_nodes[role] %>
          <% next if role_nodes.blank? %>

          <%# Role Group %>
          <div class="flex items-center gap-3">
            <%# Role Label %>
            <div class="w-20 shrink-0">
              <span class="text-[10px] font-bold text-neutral-45 uppercase tracking-tight"><%= role_labels[role] || role.humanize %></span>
              <span class="text-[9px] text-neutral-25 ml-1">(<%= role_nodes.size %>)</span>
            </div>

            <%# Nodes in horizontal row %>
            <div class="flex flex-wrap items-center gap-1.5">
              <% role_nodes.each do |node| %>
                <button type="button"
                        data-heatmap-target="cell"
                        data-action="click->heatmap#filter"
                        data-node-id="<%= node.id %>"
                        data-hostname="<%= node.hostname %>"
                        class="group relative h-8 w-8 rounded-full transition-all duration-150 cursor-pointer hover:scale-105 focus:outline-none focus:ring-2 focus:ring-primary-5 focus:ring-offset-2 <%= node_heatmap_class(node) %> border border-black/5"
                        aria-label="<%= node.hostname %>, <%= node.role %>, <%= node.online? ? 'online' : 'offline' %>">
                  <%# Tooltip on hover %>
                  <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-3 hidden group-hover:block z-50 pointer-events-none">
                    <div class="whitespace-nowrap rounded-lg bg-white-8 px-3 py-2.5 shadow-[0_4px_20px_rgba(0,0,0,0.25)] ring-1 ring-white-12">
                      <%# Header with hostname and status indicator %>
                      <div class="flex items-center gap-2 mb-1.5">
                        <%# Status indicator dot %>
                        <div class="relative flex items-center justify-center">
                          <% if node.online? %>
                            <span class="absolute h-2.5 w-2.5 rounded-full bg-success-5 animate-ping opacity-75"></span>
                            <span class="relative h-2 w-2 rounded-full bg-success-5"></span>
                          <% else %>
                            <span class="relative h-2 w-2 rounded-full bg-neutral-25"></span>
                          <% end %>
                        </div>
                        <%# Hostname %>
                        <span class="text-[11px] font-bold text-white-100 tracking-wide"><%= node.hostname %></span>
                      </div>

                      <%# Role and status row %>
                      <div class="flex items-center gap-3 text-[10px]">
                        <%# Role badge %>
                        <div class="flex items-center gap-1">
                          <%= lucide_icon("server", class: "h-3 w-3 text-white-45") %>
                          <span class="font-medium <%= node.role == 'login' ? 'text-login-4' : node.role == 'admin' ? 'text-warning-4' : 'text-primary-4' %>"><%= node.role.humanize %></span>
                        </div>
                        <%# Status %>
                        <div class="flex items-center gap-1">
                          <% if node.online? %>
                            <%= lucide_icon("wifi", class: "h-3 w-3 text-success-4") %>
                            <span class="font-medium text-success-4">Online</span>
                          <% else %>
                            <%= lucide_icon("wifi", class: "h-3 w-3 text-neutral-45") %>
                            <span class="font-medium text-neutral-45">Offline</span>
                          <% end %>
                        </div>
                      </div>

                      <% if node.last_seen_at %>
                        <%# Divider %>
                        <div class="my-2 border-t border-white-12"></div>
                        <%# Last seen %>
                        <div class="flex items-center gap-1.5 text-[9px]">
                          <%= lucide_icon("clock", class: "h-3 w-3 text-white-45") %>
                          <span class="text-white-45 font-normal">Last seen <%= time_ago_in_words(node.last_seen_at) %> ago</span>
                        </div>
                      <% end %>
                    </div>
                    <%# Tooltip arrow with shadow %>
                    <div class="absolute left-1/2 -translate-x-1/2 top-full -mt-1.5">
                      <div class="h-3 w-3 rotate-45 bg-white-8 ring-1 ring-white-12 shadow-[2px_2px_4px_rgba(0,0,0,0.15)]"></div>
                    </div>
                  </div>
                </button>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <%# Node count summary %>
      <% online_count = nodes.count(&:online?) %>
      <div class="mt-4 flex items-center justify-between text-[10px] font-bold uppercase tracking-widest text-neutral-25">
        <span><%= nodes.size %> nodes total</span>
        <span><%= online_count %> online, <%= nodes.size - online_count %> offline</span>
      </div>
    <% else %>
      <%# Empty state %>
      <div class="flex flex-col items-center justify-center py-12 text-center border-2 border-dashed border-neutral-8 rounded-lg">
        <%= lucide_icon("server", class: "h-12 w-12 text-neutral-15") %>
        <p class="mt-4 text-xs font-bold text-neutral-45 uppercase">No nodes registered</p>
        <p class="mt-1 text-[10px] text-neutral-25 font-medium">Import nodes via CSV or API to see the heatmap</p>
      </div>
    <% end %>
  </div>
</div>

