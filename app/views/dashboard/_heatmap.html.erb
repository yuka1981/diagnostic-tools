<%# Node Heatmap Grid - Visual representation of cluster status %>
<div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-gray-200 dark:bg-slate-800/50 dark:ring-white/10"
     data-controller="heatmap"
     data-heatmap-runs-frame-id-value="filtered_runs">
  
  <div class="flex items-center justify-between mb-4">
    <div>
      <h2 class="text-lg font-semibold text-gray-900 dark:text-white">Node Heatmap</h2>
      <p class="text-sm text-gray-500 dark:text-slate-400">Click a node to filter benchmark runs</p>
    </div>
    
    <%# Selection indicator and clear button %>
    <div class="flex items-center gap-3">
      <span data-heatmap-target="selectedLabel" 
            class="hidden text-sm font-medium text-cyan-600 dark:text-cyan-400"></span>
      <button type="button"
              data-heatmap-target="clearButton"
              data-action="click->heatmap#clearSelection"
              class="hidden inline-flex items-center gap-1.5 rounded-lg bg-gray-100 px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-200 dark:bg-white/10 dark:text-slate-300 dark:hover:bg-white/20 transition-colors">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
        Clear filter
      </button>
    </div>
  </div>

  <%# Legend %>
  <div class="flex items-center gap-4 mb-4 text-xs font-medium">
    <div class="flex items-center gap-1.5">
      <div class="h-3 w-3 rounded-sm bg-emerald-500"></div>
      <span class="text-gray-600 dark:text-slate-400">Online</span>
    </div>
    <div class="flex items-center gap-1.5">
      <div class="h-3 w-3 rounded-sm bg-gray-300 dark:bg-slate-600"></div>
      <span class="text-gray-600 dark:text-slate-400">Offline</span>
    </div>
    <div class="flex items-center gap-1.5">
      <div class="h-3 w-3 rounded-sm bg-blue-500"></div>
      <span class="text-gray-600 dark:text-slate-400">Login</span>
    </div>
    <div class="flex items-center gap-1.5">
      <div class="h-3 w-3 rounded-sm bg-amber-500"></div>
      <span class="text-gray-600 dark:text-slate-400">Admin</span>
    </div>
  </div>

  <% if nodes.any? %>
    <%# Heatmap Grid %>
    <div class="grid grid-cols-8 sm:grid-cols-10 md:grid-cols-12 lg:grid-cols-16 gap-1.5" role="grid" aria-label="Node heatmap">
      <% nodes.each do |node| %>
        <button type="button"
                data-heatmap-target="cell"
                data-action="click->heatmap#filter"
                data-node-id="<%= node.id %>"
                data-hostname="<%= node.hostname %>"
                class="group relative aspect-square rounded-md transition-all duration-150 cursor-pointer hover:scale-105 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:ring-offset-2 dark:focus:ring-offset-slate-900 <%= node_heatmap_class(node) %>"
                title="<%= node.hostname %> (<%= node.role.humanize %>) - <%= node.online? ? 'Online' : 'Offline' %>"
                aria-label="<%= node.hostname %>, <%= node.role %>, <%= node.online? ? 'online' : 'offline' %>">
          <%# Tooltip on hover %>
          <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover:block z-10">
            <div class="whitespace-nowrap rounded-lg bg-gray-900 px-3 py-2 text-xs font-medium text-white shadow-lg dark:bg-slate-700">
              <p class="font-semibold"><%= node.hostname %></p>
              <p class="text-gray-400 dark:text-slate-400"><%= node.role.humanize %> · <%= node.online? ? 'Online' : 'Offline' %></p>
              <% if node.last_seen_at %>
                <p class="text-gray-400 dark:text-slate-400">Last seen: <%= time_ago_in_words(node.last_seen_at) %> ago</p>
              <% end %>
            </div>
            <%# Tooltip arrow %>
            <div class="absolute left-1/2 -translate-x-1/2 -top-1 h-2 w-2 rotate-45 bg-gray-900 dark:bg-slate-700"></div>
          </div>
        </button>
      <% end %>
    </div>
    
    <%# Node count summary %>
    <div class="mt-4 flex items-center justify-between text-sm text-gray-500 dark:text-slate-400">
      <span><%= nodes.count %> nodes total</span>
      <span><%= nodes.count(&:online?) %> online, <%= nodes.count { |n| !n.online? } %> offline</span>
    </div>
  <% else %>
    <%# Empty state %>
    <div class="flex flex-col items-center justify-center py-12 text-center">
      <svg class="h-12 w-12 text-gray-300 dark:text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" 
          d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2" />
      </svg>
      <p class="mt-4 text-sm font-medium text-gray-500 dark:text-slate-400">No nodes registered</p>
      <p class="mt-1 text-xs text-gray-400 dark:text-slate-500">Import nodes via CSV or API to see the heatmap</p>
    </div>
  <% end %>
</div>

