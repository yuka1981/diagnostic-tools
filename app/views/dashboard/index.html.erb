<% content_for(:page_title) { "Dashboard" } %>

<%# Hero Metrics Cards %>
<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4" data-testid="dashboard-page-container">
  <%# Node Availability %>
  <div class="card-netbox group transition-all hover:border-success-3" data-testid="dashboard-stat-availability">
    <div class="card-header border-success-1 bg-success-1/50">
      <h3 class="card-title text-success-7">Node Availability</h3>
      <div class="flex h-6 w-6 items-center justify-center rounded bg-success-5 text-white shadow-sm">
        <%= lucide_icon("wifi", class: "h-4 w-4") %>
      </div>
    </div>
    <div class="p-4">
      <div class="flex items-baseline justify-between">
        <p class="text-2xl font-black text-neutral-85" data-testid="dashboard-stat-availability-value"><%= @availability_percentage %>%</p>
        <span class="text-[10px] font-bold text-success-6 uppercase">
          <%= @online_nodes %> / <%= @total_nodes %> UP
        </span>
      </div>
      <div class="mt-3 h-1 rounded-full bg-neutral-4 overflow-hidden" data-testid="dashboard-stat-availability-bar">
        <div class="h-full bg-success-5" style="width: <%= @availability_percentage %>%"></div>
      </div>
    </div>
  </div>

  <%# Benchmark Health (Success Rate) %>
  <div class="card-netbox group transition-all hover:border-login-3" data-testid="dashboard-stat-health">
    <div class="card-header border-login-1 bg-login-1/50">
      <h3 class="card-title text-login-7">Benchmark Health</h3>
      <div class="flex h-6 w-6 items-center justify-center rounded bg-login-5 text-white shadow-sm">
        <%= lucide_icon("circle-check", class: "h-4 w-4") %>
      </div>
    </div>
    <div class="p-4">
      <div class="flex items-baseline justify-between">
        <p class="text-2xl font-black text-neutral-85" data-testid="dashboard-stat-health-value"><%= @success_rate_24h %>%</p>
        <span class="text-[10px] font-bold text-neutral-25 uppercase">24H SUCCESS</span>
      </div>
      <div class="mt-3 h-1 rounded-full bg-neutral-4 overflow-hidden" data-testid="dashboard-stat-health-bar">
        <div class="h-full bg-login-5" style="width: <%= @success_rate_24h %>%"></div>
      </div>
    </div>
  </div>

  <%# Queue Status %>
  <div class="card-netbox group transition-all hover:border-primary-3" data-testid="dashboard-stat-queue">
    <div class="card-header border-primary-1 bg-primary-1/50">
      <h3 class="card-title text-primary-7">Queue Status</h3>
      <div class="flex h-6 w-6 items-center justify-center rounded bg-primary-5 text-white shadow-sm">
        <%= lucide_icon("clock", class: "h-4 w-4") %>
      </div>
    </div>
    <div class="p-4">
      <div class="flex items-baseline justify-between mb-2">
        <p class="text-2xl font-black text-neutral-85" data-testid="dashboard-stat-queue-total"><%= @queue_running + @queue_pending %></p>
        <span class="text-[10px] font-bold text-neutral-25 uppercase tracking-tighter">Total Tasks</span>
      </div>
      <div class="flex gap-2">
        <span class="inline-flex items-center rounded-sm bg-primary-1 px-1.5 py-0.5 text-[9px] font-black text-primary-7 border border-primary-2 uppercase" data-testid="dashboard-stat-queue-active">
          <%= @queue_running %> Active
        </span>
        <span class="inline-flex items-center rounded-sm bg-neutral-4 px-1.5 py-0.5 text-[9px] font-black text-neutral-45 border border-neutral-8 uppercase" data-testid="dashboard-stat-queue-pending">
          <%= @queue_pending %> Pending
        </span>
      </div>
    </div>
  </div>

  <%# Storage Usage %>
  <div class="card-netbox group transition-all hover:border-warning-3" data-testid="dashboard-stat-storage">
    <div class="card-header border-warning-1 bg-warning-1/50">
      <h3 class="card-title text-warning-7">Cluster Storage</h3>
      <div class="flex h-6 w-6 items-center justify-center rounded bg-warning-5 text-white shadow-sm">
        <%= lucide_icon("inbox", class: "h-4 w-4") %>
      </div>
    </div>
    <div class="p-4">
      <% usage_pct = @total_storage > 0 ? ((@used_storage.to_f / @total_storage) * 100).round(1) : 0 %>
      <div class="flex items-baseline justify-between">
        <p class="text-2xl font-black text-neutral-85" data-testid="dashboard-stat-storage-value"><%= usage_pct %>%</p>
        <span class="text-[9px] font-bold text-neutral-45 tabular-nums">
          <%= format_bytes(@used_storage) %> / <%= format_bytes(@total_storage) %>
        </span>
      </div>
      <div class="mt-3 h-1 rounded-full bg-neutral-4 overflow-hidden" data-testid="dashboard-stat-storage-bar">
        <div class="h-full bg-warning-5" style="width: <%= usage_pct %>%"></div>
      </div>
    </div>
  </div>
</div>

<%# Node Heatmap Section %>
<div class="mt-6">
  <%= render "dashboard/heatmap", nodes: @nodes %>
</div>

<%# Recent Activity Section %>
<div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-2">
  <%# Filtered Benchmark Runs (Turbo Frame) %>
  <%= render "dashboard/filtered_runs", runs: @filtered_runs, selected_node: @selected_node %>

  <%# Quick Actions %>
  <div class="card-netbox" data-testid="dashboard-quick-actions">
    <div class="card-header">
      <h2 class="card-title">Quick Actions</h2>
    </div>
    <div class="p-4">
      <div class="grid grid-cols-2 gap-4">
        <%= link_to nodes_path,
            class: "group flex flex-col items-center gap-2 rounded border border-neutral-8 bg-neutral-2 p-4 text-center transition-all hover:bg-white hover:border-primary-3 hover:shadow-sm",
            data: { testid: "dashboard-action-nodes" } do %>
          <div class="flex h-10 w-10 items-center justify-center rounded bg-primary-1 text-primary-6 transition-transform group-hover:scale-110 shadow-sm border border-primary-2">
            <%= lucide_icon("server", class: "h-5 w-5") %>
          </div>
          <span class="text-xs font-bold text-neutral-85 uppercase tracking-tight">View Nodes</span>
        <% end %>

        <%= link_to benchmark_runs_path,
            class: "group flex flex-col items-center gap-2 rounded border border-neutral-8 bg-neutral-2 p-4 text-center transition-all hover:bg-white hover:border-login-3 hover:shadow-sm",
            data: { testid: "dashboard-action-runs" } do %>
          <div class="flex h-10 w-10 items-center justify-center rounded bg-login-1 text-login-6 transition-transform group-hover:scale-110 shadow-sm border border-login-2">
            <%= lucide_icon("bar-chart-3", class: "h-5 w-5") %>
          </div>
          <span class="text-xs font-bold text-neutral-85 uppercase tracking-tight">View Runs</span>
        <% end %>

        <%= link_to benchmark_recipes_path,
            class: "group flex flex-col items-center gap-2 rounded border border-neutral-8 bg-neutral-2 p-4 text-center transition-all hover:bg-white hover:border-warning-3 hover:shadow-sm",
            data: { testid: "dashboard-action-recipes" } do %>
          <div class="flex h-10 w-10 items-center justify-center rounded bg-warning-1 text-warning-6 transition-transform group-hover:scale-110 shadow-sm border border-warning-2">
            <%= lucide_icon("flask-conical", class: "h-5 w-5") %>
          </div>
          <span class="text-xs font-bold text-neutral-85 uppercase tracking-tight">Recipes</span>
        <% end %>

        <button type="button"
                class="group flex flex-col items-center gap-2 rounded border border-neutral-4 bg-neutral-2/50 p-4 text-center opacity-50 cursor-not-allowed"
                data-testid="dashboard-action-import"
                disabled>
          <div class="flex h-10 w-10 items-center justify-center rounded bg-success-1 text-success-6 shadow-none border border-success-1">
            <%= lucide_icon("upload", class: "h-5 w-5") %>
          </div>
          <span class="text-xs font-bold text-neutral-25 uppercase tracking-tight">Import CSV</span>
        </button>
      </div>
    </div>
  </div>
</div>

