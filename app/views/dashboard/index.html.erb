<% content_for(:page_title) { "Dashboard" } %>

<%# Hero Metrics Cards %>
<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
  <%# Total Nodes %>
  <div class="group relative overflow-hidden rounded-2xl bg-white p-6 shadow-sm ring-1 ring-gray-200 transition-all hover:shadow-md dark:bg-slate-800/50 dark:ring-white/10">
    <div class="absolute inset-0 bg-gradient-to-br from-blue-500/5 to-cyan-500/5 dark:from-blue-500/10 dark:to-cyan-500/10"></div>
    <div class="relative">
      <div class="flex items-center justify-between">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-blue-500 to-cyan-500 shadow-lg shadow-blue-500/20">
          <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
              d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2" />
          </svg>
        </div>
      </div>
      <div class="mt-4">
        <p class="text-3xl font-bold text-gray-900 dark:text-white"><%= @total_nodes %></p>
        <p class="mt-1 text-sm font-medium text-gray-500 dark:text-slate-400">Total Nodes</p>
      </div>
    </div>
  </div>

  <%# Online Nodes %>
  <div class="group relative overflow-hidden rounded-2xl bg-white p-6 shadow-sm ring-1 ring-gray-200 transition-all hover:shadow-md dark:bg-slate-800/50 dark:ring-white/10">
    <div class="absolute inset-0 bg-gradient-to-br from-emerald-500/5 to-green-500/5 dark:from-emerald-500/10 dark:to-green-500/10"></div>
    <div class="relative">
      <div class="flex items-center justify-between">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-emerald-500 to-green-500 shadow-lg shadow-emerald-500/20">
          <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
              d="M5.636 18.364a9 9 0 010-12.728m12.728 0a9 9 0 010 12.728m-9.9-2.829a5 5 0 010-7.07m7.072 0a5 5 0 010 7.07M13 12a1 1 0 11-2 0 1 1 0 012 0z" />
          </svg>
        </div>
        <% if @total_nodes > 0 %>
          <span class="text-sm font-medium text-emerald-600 dark:text-emerald-400">
            <%= ((@online_nodes.to_f / @total_nodes) * 100).round %>%
          </span>
        <% end %>
      </div>
      <div class="mt-4">
        <p class="text-3xl font-bold text-gray-900 dark:text-white"><%= @online_nodes %></p>
        <p class="mt-1 text-sm font-medium text-gray-500 dark:text-slate-400">Online Nodes</p>
      </div>
    </div>
  </div>

  <%# Success Rate %>
  <div class="group relative overflow-hidden rounded-2xl bg-white p-6 shadow-sm ring-1 ring-gray-200 transition-all hover:shadow-md dark:bg-slate-800/50 dark:ring-white/10">
    <div class="absolute inset-0 bg-gradient-to-br from-violet-500/5 to-purple-500/5 dark:from-violet-500/10 dark:to-purple-500/10"></div>
    <div class="relative">
      <div class="flex items-center justify-between">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-violet-500 to-purple-500 shadow-lg shadow-violet-500/20">
          <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
              d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
      </div>
      <div class="mt-4">
        <p class="text-3xl font-bold text-gray-900 dark:text-white"><%= @success_rate_24h %>%</p>
        <p class="mt-1 text-sm font-medium text-gray-500 dark:text-slate-400">Success Rate (24h)</p>
      </div>
    </div>
  </div>

  <%# Recent Runs %>
  <div class="group relative overflow-hidden rounded-2xl bg-white p-6 shadow-sm ring-1 ring-gray-200 transition-all hover:shadow-md dark:bg-slate-800/50 dark:ring-white/10">
    <div class="absolute inset-0 bg-gradient-to-br from-amber-500/5 to-orange-500/5 dark:from-amber-500/10 dark:to-orange-500/10"></div>
    <div class="relative">
      <div class="flex items-center justify-between">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-amber-500 to-orange-500 shadow-lg shadow-amber-500/20">
          <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
              d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
      </div>
      <div class="mt-4">
        <p class="text-3xl font-bold text-gray-900 dark:text-white"><%= BenchmarkRun.in_last_24_hours.count %></p>
        <p class="mt-1 text-sm font-medium text-gray-500 dark:text-slate-400">Runs Today</p>
      </div>
    </div>
  </div>
</div>

<%# Node Heatmap Section %>
<div class="mt-8">
  <%= render "dashboard/heatmap", nodes: @nodes %>
</div>

<%# Recent Activity Section %>
<div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-2">
  <%# Filtered Benchmark Runs (Turbo Frame) %>
  <%= render "dashboard/filtered_runs", runs: @filtered_runs, selected_node: @selected_node %>

  <%# Quick Actions %>
  <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-gray-200 dark:bg-slate-800/50 dark:ring-white/10">
    <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Quick Actions</h2>

    <div class="grid grid-cols-2 gap-4">
      <%= link_to nodes_path,
          class: "group flex flex-col items-center gap-3 rounded-xl bg-gray-50 p-6 text-center transition-all hover:bg-gray-100 dark:bg-white/5 dark:hover:bg-white/10" do %>
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-blue-100 text-blue-600 transition-transform group-hover:scale-110 dark:bg-blue-500/20 dark:text-blue-400">
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
              d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2" />
          </svg>
        </div>
        <span class="text-sm font-medium text-gray-700 dark:text-slate-300">View Nodes</span>
      <% end %>

      <%= link_to benchmark_runs_path,
          class: "group flex flex-col items-center gap-3 rounded-xl bg-gray-50 p-6 text-center transition-all hover:bg-gray-100 dark:bg-white/5 dark:hover:bg-white/10" do %>
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-purple-100 text-purple-600 transition-transform group-hover:scale-110 dark:bg-purple-500/20 dark:text-purple-400">
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
              d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>
        </div>
        <span class="text-sm font-medium text-gray-700 dark:text-slate-300">View Runs</span>
      <% end %>

      <%= link_to benchmark_recipes_path,
          class: "group flex flex-col items-center gap-3 rounded-xl bg-gray-50 p-6 text-center transition-all hover:bg-gray-100 dark:bg-white/5 dark:hover:bg-white/10" do %>
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-amber-100 text-amber-600 transition-transform group-hover:scale-110 dark:bg-amber-500/20 dark:text-amber-400">
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
              d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
          </svg>
        </div>
        <span class="text-sm font-medium text-gray-700 dark:text-slate-300">Recipes</span>
      <% end %>

      <button type="button"
              class="group flex flex-col items-center gap-3 rounded-xl bg-gray-50 p-6 text-center transition-all hover:bg-gray-100 dark:bg-white/5 dark:hover:bg-white/10 opacity-50 cursor-not-allowed"
              disabled>
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-100 text-emerald-600 dark:bg-emerald-500/20 dark:text-emerald-400">
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
              d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
          </svg>
        </div>
        <span class="text-sm font-medium text-gray-700 dark:text-slate-300">Import CSV</span>
      </button>
    </div>
  </div>
</div>

