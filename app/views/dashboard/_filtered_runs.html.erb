<%# Filtered Benchmark Runs - Turbo Frame for heatmap filtering %>
<%= turbo_frame_tag "filtered_runs" do %>
  <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-gray-200 dark:bg-slate-800/50 dark:ring-white/10">
    <div class="flex items-center justify-between mb-4">
      <div>
        <h2 class="text-lg font-semibold text-gray-900 dark:text-white">
          <% if selected_node %>
            Benchmark Runs for <%= selected_node.hostname %>
          <% else %>
            Recent Benchmark Runs
          <% end %>
        </h2>
        <% if selected_node %>
          <p class="text-sm text-gray-500 dark:text-slate-400">
            <%= selected_node.role.humanize %> node · <%= selected_node.online? ? 'Online' : 'Offline' %>
          </p>
        <% end %>
      </div>
      <%= link_to "View all", benchmark_runs_path(node_id: selected_node&.id), 
          class: "text-sm font-medium text-blue-600 hover:text-blue-500 dark:text-blue-400 dark:hover:text-blue-300" %>
    </div>

    <% if runs.any? %>
      <div class="space-y-3">
        <% runs.each do |run| %>
          <div class="flex items-center gap-4 rounded-xl bg-gray-50 p-4 dark:bg-white/5 transition-colors hover:bg-gray-100 dark:hover:bg-white/10">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg <%= status_bg_class(run.status) %>">
              <%= status_icon(run.status) %>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium text-gray-900 truncate dark:text-white">
                <%= run.benchmark_recipe.display_name %>
              </p>
              <p class="text-xs text-gray-500 dark:text-slate-400">
                <%= run.node.hostname %> · 
                <% if run.started_at %>
                  <%= time_ago_in_words(run.started_at) %> ago
                <% else %>
                  Queued
                <% end %>
                <% if run.duration %>
                  · Duration: <%= number_with_precision(run.duration, precision: 1) %>s
                <% end %>
              </p>
            </div>
            <%= benchmark_status_badge(run.status, size: :small) %>
          </div>
        <% end %>
      </div>

      <% if runs.count >= 10 %>
        <div class="mt-4 text-center">
          <%= link_to "Load more...", benchmark_runs_path(node_id: selected_node&.id),
              class: "text-sm font-medium text-gray-500 hover:text-gray-700 dark:text-slate-400 dark:hover:text-slate-200" %>
        </div>
      <% end %>
    <% else %>
      <div class="flex flex-col items-center justify-center py-12 text-center">
        <svg class="h-12 w-12 text-gray-300 dark:text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" 
            d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
        </svg>
        <p class="mt-4 text-sm font-medium text-gray-500 dark:text-slate-400">
          <% if selected_node %>
            No benchmark runs for <%= selected_node.hostname %>
          <% else %>
            No benchmark runs yet
          <% end %>
        </p>
        <p class="mt-1 text-xs text-gray-400 dark:text-slate-500">
          <% if selected_node %>
            Run a benchmark on this node to see results
          <% else %>
            Start a benchmark to see results here
          <% end %>
        </p>
      </div>
    <% end %>
  </div>
<% end %>
