<%# Filtered Benchmark Runs - Turbo Frame for heatmap filtering %>
<%= turbo_frame_tag "filtered_runs" do %>
  <div class="card-netbox h-full">
    <div class="card-header">
      <div>
        <h2 class="card-title">
          <% if selected_node %>
            Benchmark Runs: <%= selected_node.hostname %>
          <% else %>
            Recent Benchmark Runs
          <% end %>
        </h2>
        <% if selected_node %>
          <p class="text-[10px] text-slate-500 lowercase font-normal italic">
            <%= selected_node.role.humanize %> node · <%= selected_node.online? ? 'Online' : 'Offline' %>
          </p>
        <% end %>
      </div>
      <%= link_to "View all", benchmark_runs_path(node_id: selected_node&.id),
          data: { turbo_frame: "_top" },
          class: "text-[10px] font-bold uppercase tracking-widest text-blue-600 hover:text-blue-700 transition-colors bg-blue-50 px-2 py-1 rounded border border-blue-100 shadow-sm" %>
    </div>

    <div class="p-0">
      <% if runs.any? %>
        <div class="divide-y divide-slate-100">
          <% runs.each do |run| %>
            <div class="flex items-center gap-4 p-3 transition-colors hover:bg-slate-50">
              <div class="flex h-8 w-8 items-center justify-center rounded border <%= status_bg_class(run.status) %> shadow-sm">
                <%= status_icon(run.status) %>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-xs font-bold text-slate-700 truncate uppercase tracking-tight">
                  <%= run.benchmark_recipe.display_name %>
                </p>
                <p class="text-[10px] text-slate-500 font-medium">
                  <span class="text-slate-400">Node:</span> <span class="font-bold text-slate-600"><%= run.node.hostname %></span>
                  <span class="mx-1 text-slate-300">|</span>
                  <% if run.started_at %>
                    <%= time_ago_in_words(run.started_at) %> ago
                  <% else %>
                    Queued
                  <% end %>
                  <% if run.duration %>
                    · <%= number_with_precision(run.duration, precision: 1) %>s
                  <% end %>
                </p>
              </div>
              <span class="inline-flex items-center rounded px-1.5 py-0.5 text-[9px] font-black uppercase border <%= status_badge_class(run.status) %>">
                <%= run.status %>
              </span>
            </div>
          <% end %>
        </div>

        <% if runs.count >= 10 %>
          <div class="p-3 bg-slate-50 border-t border-slate-100 text-center">
            <%= link_to "View all results", benchmark_runs_path(node_id: selected_node&.id),
                data: { turbo_frame: "_top" },
                class: "text-[10px] font-black uppercase tracking-widest text-slate-500 hover:text-slate-700 transition-colors" %>
          </div>
        <% end %>
      <% else %>
        <div class="flex flex-col items-center justify-center py-12 text-center bg-slate-50/50">
          <svg class="h-12 w-12 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" 
              d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>
          <p class="mt-4 text-xs font-bold text-slate-500 uppercase">
            <% if selected_node %>
              No runs for <%= selected_node.hostname %>
            <% else %>
              No benchmark runs yet
            <% end %>
          </p>
          <p class="mt-1 text-[10px] text-slate-400 font-medium">
            <% if selected_node %>
              Run a benchmark on this node to see results
            <% else %>
              Start a benchmark to see results here
            <% end %>
          </p>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

