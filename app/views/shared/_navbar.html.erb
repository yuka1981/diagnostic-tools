<header class="sticky top-0 z-30 flex h-14 items-center gap-4 border-b border-neutral-8 bg-white px-4 shadow-sm">
  <%# Mobile menu button %>
  <button type="button"
          data-action="click->sidebar#toggle"
          class="lg:hidden -ml-2 rounded p-2 text-neutral-45 hover:bg-neutral-4">
    <%= lucide_icon("menu", class: "h-6 w-6") %>
  </button>

  <%# Search Bar %>
  <div class="flex-1">
    <div class="relative max-w-sm">
      <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-2">
        <%= lucide_icon("search", class: "h-4 w-4 text-neutral-25") %>
      </div>
      <input type="text" 
             name="search" 
             id="search" 
             class="block w-full rounded border-neutral-15 pl-8 py-1.5 focus:border-primary-5 focus:ring-primary-5 sm:text-sm" 
             placeholder="Search...">
    </div>
  </div>

  <%# Header Actions %>
  <div class="flex items-center gap-3">
    <%# Notifications Dropdown %>
    <div data-controller="notifications"
         data-notifications-user-id-value="<%= current_user&.id %>"
         class="relative">
      <button type="button"
              data-action="click->notifications#toggle"
              class="relative text-neutral-25 hover:text-neutral-45 p-2 rounded-lg hover:bg-neutral-4">
        <%= lucide_icon("bell", class: "h-5 w-5") %>
        <%= render "notifications/badge", count: current_user&.notifications&.unread&.count || 0 %>
      </button>

      <div data-notifications-target="dropdown"
           class="hidden absolute right-0 mt-2 w-96 bg-white
                  rounded-lg shadow-lg border border-neutral-8 z-50">
        <div class="p-3 border-b border-neutral-8 flex justify-between items-center">
          <span class="font-semibold text-neutral-85">Notifications</span>
          <button data-action="click->notifications#markAllRead"
                  class="text-sm text-primary-6 hover:text-primary-7">
            Mark all read
          </button>
        </div>

        <div class="max-h-96 overflow-y-auto">
          <% if current_user %>
            <%= turbo_stream_from "notifications_user_#{current_user.id}" %>
            <%= turbo_frame_tag "notifications_list",
                data: { notifications_target: "frame" } do %>
              <div class="p-4 text-center text-neutral-45 text-sm">
                <%= lucide_icon("loader-2", class: "h-5 w-5 animate-spin inline-block mr-2") %>
                Loading...
              </div>
            <% end %>
          <% end %>
        </div>

        <div class="p-3 border-t border-neutral-8 text-center">
          <%= link_to "View all notifications", notifications_path,
              class: "text-sm text-primary-6 hover:text-primary-7" %>
        </div>
      </div>
    </div>
    
    <div class="h-6 w-px bg-neutral-8"></div>

    <div class="flex items-center gap-2">
      <span class="text-sm font-bold text-neutral-85"><%= current_user&.name || current_user&.email || "Guest" %></span>
    </div>
  </div>
</header>
