<aside class="fixed inset-y-0 left-0 z-50 w-60 bg-white text-neutral-85 flex flex-col transition-transform duration-300 ease-in-out lg:translate-x-0 border-r border-neutral-8"
       data-sidebar-target="menu">

  <%# Brand %>
  <div class="flex h-14 items-center px-5 border-b border-neutral-8 bg-white">
    <div class="flex items-center gap-3">
      <%= image_tag "qct_logo.png", alt: "QCT", class: "h-8 w-auto" %>
      <span class="text-base font-bold text-neutral-85 tracking-tight">InfraScope</span>
    </div>
  </div>

  <%# Navigation %>
  <nav class="flex-1 overflow-y-auto py-4 space-y-6 text-neutral-45">
    
    <%# Organization %>
    <div>
      <h3 class="px-5 text-xs font-bold text-neutral-45 uppercase tracking-wider mb-1">Organization</h3>
      <div class="space-y-0.5">
        <%= link_to dashboard_path,
            data: { turbo_prefetch: false },
            class: "flex items-center gap-3 px-5 py-2 text-sm font-bold rounded transition-colors #{current_page?(dashboard_path) ? 'bg-primary-1 text-primary-6' : 'hover:bg-neutral-4 hover:text-primary-6'}" do %>
          <%= lucide_icon("layout-dashboard", class: "h-5 w-5 opacity-75") %>
          Dashboard
        <% end %>

        <%# Inventory collapsible section %>
        <% inventory_paths = %w[/sites /rooms /racks /nodes] %>
        <% inventory_expanded = inventory_paths.any? { |p| request.path.start_with?(p) } %>
        <% inventory_active = inventory_expanded %>

        <div data-controller="collapsible"
             data-collapsible-open-value="<%= inventory_expanded %>"
             data-collapsible-rotate-class-value="rotate-90">

          <%# Inventory toggle button %>
          <button type="button"
                  data-action="click->collapsible#toggle"
                  class="w-full flex items-center gap-3 px-5 py-2 text-sm font-bold rounded transition-colors <%= inventory_active ? 'text-primary-6' : 'hover:bg-neutral-4 hover:text-primary-6' %>">
            <%= lucide_icon("archive", class: "h-5 w-5 opacity-75") %>
            <span class="flex-1 text-left">Inventory</span>
            <%= lucide_icon("chevron-right",
                class: "h-4 w-4 opacity-75 transition-transform duration-200",
                data: { collapsible_target: "icon" }) %>
          </button>

          <%# Inventory child items %>
          <div data-collapsible-target="content" class="space-y-0.5">
            <%= link_to sites_path,
                data: { turbo_prefetch: false },
                class: "flex items-center gap-3 pl-12 pr-5 py-2 text-sm font-bold rounded transition-colors #{request.path.start_with?('/sites') ? 'bg-primary-1 text-primary-6' : 'hover:bg-neutral-4 hover:text-primary-6'}" do %>
              <%= lucide_icon("building-2", class: "h-5 w-5 opacity-75") %>
              Sites
            <% end %>

            <%= link_to rooms_path,
                data: { turbo_prefetch: false },
                class: "flex items-center gap-3 pl-12 pr-5 py-2 text-sm font-bold rounded transition-colors #{request.path.start_with?('/rooms') ? 'bg-primary-1 text-primary-6' : 'hover:bg-neutral-4 hover:text-primary-6'}" do %>
              <%= lucide_icon("warehouse", class: "h-5 w-5 opacity-75") %>
              Rooms
            <% end %>

            <%= link_to server_racks_path,
                data: { turbo_prefetch: false },
                class: "flex items-center gap-3 pl-12 pr-5 py-2 text-sm font-bold rounded transition-colors #{request.path.start_with?('/racks') ? 'bg-primary-1 text-primary-6' : 'hover:bg-neutral-4 hover:text-primary-6'}" do %>
              <%= lucide_icon("server", class: "h-5 w-5 opacity-75") %>
              Racks
            <% end %>

            <%= link_to nodes_path,
                data: { turbo_prefetch: false },
                class: "flex items-center gap-3 pl-12 pr-5 py-2 text-sm font-bold rounded transition-colors #{request.path.start_with?('/nodes') ? 'bg-primary-1 text-primary-6' : 'hover:bg-neutral-4 hover:text-primary-6'}" do %>
              <%= lucide_icon("hard-drive", class: "h-5 w-5 opacity-75") %>
              Nodes
            <% end %>
          </div>
        </div>

        <%= link_to tasks_path,
            data: { turbo_prefetch: false },
            class: "flex items-center gap-3 px-5 py-2 text-sm font-bold rounded transition-colors #{request.path.start_with?('/tasks') ? 'bg-primary-1 text-primary-6' : 'hover:bg-neutral-4 hover:text-primary-6'}" do %>
          <%= lucide_icon("list-checks", class: "h-5 w-5 opacity-75") %>
          Tasks
        <% end %>
      </div>
    </div>

    <%# Benchmarks %>
    <div>
      <h3 class="px-5 text-xs font-bold text-neutral-45 uppercase tracking-wider mb-1">Benchmarks</h3>
      <div class="space-y-0.5">
        <%= link_to benchmark_runs_path,
            data: { turbo_prefetch: false },
            class: "flex items-center gap-3 px-5 py-2 text-sm font-bold rounded transition-colors #{request.path.start_with?('/benchmark_runs') ? 'bg-primary-1 text-primary-6' : 'hover:bg-neutral-4 hover:text-primary-6'}" do %>
          <%= lucide_icon("bar-chart-3", class: "h-5 w-5 opacity-75") %>
          Benchmark Runs
        <% end %>

        <%= link_to benchmark_recipes_path,
            data: { turbo_prefetch: false },
            class: "flex items-center gap-3 px-5 py-2 text-sm font-bold rounded transition-colors #{request.path.start_with?('/benchmark_recipes') ? 'bg-primary-1 text-primary-6' : 'hover:bg-neutral-4 hover:text-primary-6'}" do %>
          <%= lucide_icon("flask-conical", class: "h-5 w-5 opacity-75") %>
          Recipes
        <% end %>

        <%= link_to new_mlc_benchmark_path,
            data: { turbo_prefetch: false },
            class: "flex items-center gap-3 px-5 py-2 text-sm font-bold rounded transition-colors #{request.path.start_with?('/mlc_benchmarks') ? 'bg-primary-1 text-primary-6' : 'hover:bg-neutral-4 hover:text-primary-6'}" do %>
          <%= lucide_icon("cpu", class: "h-5 w-5 opacity-75") %>
          MLC Benchmark
        <% end %>

        <%= link_to new_mlc_installation_path,
            data: { turbo_prefetch: false },
            class: "flex items-center gap-3 px-5 py-2 text-sm font-bold rounded transition-colors #{request.path.start_with?('/mlc_installations') ? 'bg-primary-1 text-primary-6' : 'hover:bg-neutral-4 hover:text-primary-6'}" do %>
          <%= lucide_icon("download", class: "h-5 w-5 opacity-75") %>
          MLC Installation
        <% end %>
      </div>
    </div>

    <%# Admin %>
    <% if current_user&.approver? %>
      <div>
        <h3 class="px-5 text-xs font-bold text-neutral-45 uppercase tracking-wider mb-1">Admin</h3>
        <div class="space-y-0.5">
          <%= link_to api_keys_path,
              data: { turbo_prefetch: false },
              class: "flex items-center gap-3 px-5 py-2 text-sm font-bold rounded transition-colors #{request.path.start_with?('/api_keys') ? 'bg-primary-1 text-primary-6' : 'hover:bg-neutral-4 hover:text-primary-6'}" do %>
            <%= lucide_icon("key", class: "h-5 w-5 opacity-75") %>
            API Keys
          <% end %>

          <%= link_to settings_ssh_defaults_path,
              data: { turbo_prefetch: false },
              class: "flex items-center gap-3 px-5 py-2 text-sm font-bold rounded transition-colors #{request.path.start_with?('/settings/ssh_defaults') ? 'bg-primary-1 text-primary-6' : 'hover:bg-neutral-4 hover:text-primary-6'}" do %>
            <%= lucide_icon("lock", class: "h-5 w-5 opacity-75") %>
            SSH Defaults
          <% end %>

          <%= link_to settings_salt_api_path,
              data: { turbo_prefetch: false },
              class: "flex items-center gap-3 px-5 py-2 text-sm font-bold rounded transition-colors #{request.path.start_with?('/settings/salt_api') ? 'bg-primary-1 text-primary-6' : 'hover:bg-neutral-4 hover:text-primary-6'}" do %>
            <%= lucide_icon("cloud-cog", class: "h-5 w-5 opacity-75") %>
            Salt API
          <% end %>

          <%= link_to settings_server_products_path,
              data: { turbo_prefetch: false },
              class: "flex items-center gap-3 px-5 py-2 text-sm font-bold rounded transition-colors #{request.path.start_with?('/settings/server_products') ? 'bg-primary-1 text-primary-6' : 'hover:bg-neutral-4 hover:text-primary-6'}" do %>
            <%= lucide_icon("server", class: "h-5 w-5 opacity-75") %>
            Server Products
          <% end %>
        </div>
      </div>
    <% end %>
  </nav>

  <%# Footer %>
  <% if current_user %>
    <div class="border-t border-neutral-8 px-5 py-4">
      <div class="flex items-center gap-3">
        <div class="h-8 w-8 rounded-full bg-primary-1 flex items-center justify-center text-sm font-medium text-primary-6">
          <%= current_user.name&.first&.upcase || current_user.email.first.upcase %>
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-sm font-medium text-neutral-85 truncate"><%= current_user.name || current_user.email %></p>
          <p class="text-xs text-neutral-45 truncate"><%= current_user.role.humanize %></p>
        </div>
      </div>
      <%= link_to destroy_user_session_path,
          data: { turbo_method: :delete, turbo_prefetch: false },
          class: "mt-3 flex items-center gap-2 text-xs text-neutral-45 hover:text-error-6 transition-colors" do %>
        <%= lucide_icon("log-out", class: "h-4 w-4") %>
        Sign out
      <% end %>
    </div>
  <% else %>
    <div class="border-t border-neutral-8 px-5 py-4">
      <%= link_to new_user_session_path,
          data: { turbo_prefetch: false },
          class: "flex items-center gap-2 text-sm text-neutral-45 hover:text-primary-6 transition-colors" do %>
        <%= lucide_icon("log-in", class: "h-5 w-5") %>
        Sign in
      <% end %>
    </div>
  <% end %>
</aside>
