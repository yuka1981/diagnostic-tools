<% if notice.present? %>
  <div class="rounded-none bg-emerald-50 p-4 dark:bg-emerald-500/10">
    <div class="flex items-center gap-3">
      <%= lucide_icon("circle-check", class: "h-5 w-5 text-emerald-500") %>
      <p class="text-sm font-medium text-emerald-800 dark:text-emerald-200"><%= notice %></p>
    </div>
  </div>
<% end %>

<% if alert.present? %>
  <div class="rounded-none bg-red-50 p-4 dark:bg-red-500/10">
    <div class="flex items-center gap-3">
      <%= lucide_icon("alert-circle", class: "h-5 w-5 text-red-500") %>
      <p class="text-sm font-medium text-red-800 dark:text-red-200"><%= alert %></p>
    </div>
  </div>
<% end %>

