<% if notice.present? %>
  <div class="rounded-lg bg-emerald-50 p-4 dark:bg-emerald-500/10">
    <div class="flex items-center gap-3">
      <svg class="h-5 w-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <p class="text-sm font-medium text-emerald-800 dark:text-emerald-200"><%= notice %></p>
    </div>
  </div>
<% end %>

<% if alert.present? %>
  <div class="rounded-lg bg-red-50 p-4 dark:bg-red-500/10">
    <div class="flex items-center gap-3">
      <svg class="h-5 w-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <p class="text-sm font-medium text-red-800 dark:text-red-200"><%= alert %></p>
    </div>
  </div>
<% end %>

