<% content_for(:page_title) { "BMC Credentials" } %>

<div class="space-y-6">
  <div class="card-netbox">
    <div class="card-header">
      <h2 class="card-title">Global BMC Default Credentials</h2>
    </div>

    <%= form_with(model: @credential, url: settings_bmc_credentials_path, method: :patch) do |f| %>
      <div class="p-4 space-y-6">
        <div>
          <h3 class="text-sm font-bold text-neutral-85 border-b border-neutral-8 pb-2 mb-4">BMC Connection</h3>
          <p class="text-[10px] text-neutral-45 italic mb-4">Default BMC credentials used for nodes without node-specific overrides.</p>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-6">
            <div class="sm:col-span-3">
              <%= f.label :bmc_address, "BMC Address", class: "block text-xs font-bold text-neutral-85 mb-1" %>
              <%= f.text_field :bmc_address, placeholder: "e.g. 192.168.1.100", class: "block w-full rounded border border-neutral-15 py-1.5 px-3 text-neutral-85 shadow-sm focus:ring-2 focus:ring-primary-5 focus:border-primary-5 sm:text-sm" %>
              <p class="text-[10px] text-neutral-45 mt-1">Default BMC IP address or hostname pattern.</p>
            </div>

            <div class="sm:col-span-3">
              <%= f.label :protocol, "Protocol", class: "block text-xs font-bold text-neutral-85 mb-1" %>
              <%= f.select :protocol, BmcCredential.protocols.keys.map { |p| [p.titleize, p] }, {}, class: "block w-full rounded border border-neutral-15 py-1.5 px-3 text-neutral-85 shadow-sm focus:ring-2 focus:ring-primary-5 focus:border-primary-5 sm:text-sm" %>
              <p class="text-[10px] text-neutral-45 mt-1">Auto will try Redfish first, then IPMI.</p>
            </div>
          </div>
        </div>

        <div>
          <h3 class="text-sm font-bold text-neutral-85 border-b border-neutral-8 pb-2 mb-4">Authentication</h3>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-6">
            <div class="sm:col-span-3">
              <%= f.label :username, "Username", class: "block text-xs font-bold text-neutral-85 mb-1" %>
              <%= f.text_field :username, placeholder: "e.g. admin", autocomplete: "off", class: "block w-full rounded border border-neutral-15 py-1.5 px-3 text-neutral-85 shadow-sm focus:ring-2 focus:ring-primary-5 focus:border-primary-5 sm:text-sm" %>
            </div>

            <div class="sm:col-span-3">
              <%= f.label :password, "Password", class: "block text-xs font-bold text-neutral-85 mb-1" %>
              <%= f.password_field :password, placeholder: @credential.persisted? ? "••••••••" : "Enter password", autocomplete: "off", class: "block w-full rounded border border-neutral-15 py-1.5 px-3 text-neutral-85 shadow-sm focus:ring-2 focus:ring-primary-5 focus:border-primary-5 sm:text-sm" %>
              <p class="text-[10px] text-neutral-45 mt-1">Leave blank to keep current password.</p>
            </div>
          </div>
        </div>

        <div>
          <h3 class="text-sm font-bold text-neutral-85 border-b border-neutral-8 pb-2 mb-4">Connection Options</h3>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-6">
            <div class="sm:col-span-3">
              <%= f.label :port, "Port", class: "block text-xs font-bold text-neutral-85 mb-1" %>
              <%= f.number_field :port, placeholder: "443 (Redfish) / 623 (IPMI)", class: "block w-full rounded border border-neutral-15 py-1.5 px-3 text-neutral-85 shadow-sm focus:ring-2 focus:ring-primary-5 focus:border-primary-5 sm:text-sm" %>
              <p class="text-[10px] text-neutral-45 mt-1">Leave blank for protocol default.</p>
            </div>

            <div class="sm:col-span-3 flex items-end pb-1">
              <div class="flex items-center">
                <%= f.check_box :verify_ssl, class: "h-4 w-4 rounded border-neutral-15 text-primary-6 focus:ring-primary-5" %>
                <%= f.label :verify_ssl, "Verify SSL Certificate", class: "ml-2 text-sm text-neutral-85" %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <% if @credential.errors.any? %>
        <div class="px-4 pb-4">
          <div class="bg-error-1 border border-error-2 rounded p-3">
            <h4 class="text-sm font-bold text-error-8">Please correct the following errors:</h4>
            <ul class="mt-2 text-sm text-error-7 list-disc list-inside">
              <% @credential.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>

      <div class="flex items-center justify-end gap-3 bg-neutral-2 border-t border-neutral-8 px-4 py-3">
        <%= f.submit "Save Credentials", class: "btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
