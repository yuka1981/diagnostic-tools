<% content_for(:page_title) { "Agent Releases" } %>
<% content_for(:breadcrumbs) do %>
  <span class="mx-2">/</span>
  <%= link_to "Settings", settings_agent_path, class: "hover:text-primary-6 font-bold" %>
  <span class="mx-2">/</span>
  <span class="font-medium text-neutral-85">Agent Releases</span>
<% end %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold text-neutral-85">Agent Releases</h1>
    <p class="text-sm text-neutral-45 mt-1">Manage HPC agent binary versions</p>
  </div>
  <% if current_user.approver? %>
    <%= link_to new_settings_agent_release_path, class: "btn-primary" do %>
      <%= lucide_icon("plus", class: "h-4 w-4 mr-2") %>
      New Release
    <% end %>
  <% end %>
</div>

<div class="card-netbox">
  <%= render partial: "releases_table",
             locals: { agent_releases: @agent_releases, latest_release: @latest_release } %>
</div>
