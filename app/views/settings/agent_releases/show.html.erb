<% content_for(:page_title) { @agent_release.display_name } %>
<% content_for(:breadcrumbs) do %>
  <span class="mx-2">/</span>
  <%= link_to "Settings", settings_agent_path, class: "hover:text-teal-600 font-bold" %>
  <span class="mx-2">/</span>
  <%= link_to "Agent Config", settings_agent_path, class: "hover:text-teal-600 font-bold" %>
  <span class="mx-2">/</span>
  <span class="font-medium text-slate-700"><%= @agent_release.version %></span>
<% end %>

<div class="mb-6">
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-4">
      <h1 class="text-2xl font-bold text-slate-900"><%= @agent_release.display_name %></h1>
      <%= render partial: "status_badge", locals: { release: @agent_release } %>
      <% if @agent_release == AgentRelease.latest %>
        <span class="inline-flex items-center rounded-sm px-2 py-0.5 text-xs font-medium bg-teal-100 text-teal-800 border border-teal-200">
          Latest
        </span>
      <% end %>
    </div>
    <% if current_user.approver? %>
      <div class="flex items-center gap-2">
        <%= link_to edit_settings_agent_release_path(@agent_release), class: "btn-secondary" do %>
          <svg class="h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
          Edit
        <% end %>

        <% if @agent_release.active? %>
          <%= button_to deprecate_settings_agent_release_path(@agent_release),
              method: :patch,
              class: "btn-secondary",
              data: { turbo_confirm: "Mark this release as deprecated?" } do %>
            Deprecate
          <% end %>
        <% elsif @agent_release.deprecated? %>
          <%= button_to activate_settings_agent_release_path(@agent_release),
              method: :patch,
              class: "btn-primary" do %>
            Activate
          <% end %>
          <%= button_to recall_settings_agent_release_path(@agent_release),
              method: :patch,
              class: "btn-danger",
              data: { turbo_confirm: "Recall this release? This indicates a critical issue." } do %>
            Recall
          <% end %>
        <% elsif @agent_release.recalled? %>
          <%= button_to activate_settings_agent_release_path(@agent_release),
              method: :patch,
              class: "btn-primary" do %>
            Re-activate
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<div class="grid gap-6 lg:grid-cols-2">
  <%# Overview Card %>
  <div class="card-netbox">
    <div class="card-header">
      <h3 class="card-title">Overview</h3>
    </div>
    <div class="p-0">
      <table class="w-full text-sm text-left">
        <tbody class="divide-y divide-slate-100">
          <tr class="hover:bg-slate-50">
            <th class="px-4 py-2 font-bold text-slate-700 w-1/3 border-r border-slate-200">Version</th>
            <td class="px-4 py-2 text-slate-700 font-bold"><%= @agent_release.version %></td>
          </tr>
          <tr class="hover:bg-slate-50">
            <th class="px-4 py-2 font-bold text-slate-700 border-r border-slate-200">Status</th>
            <td class="px-4 py-2">
              <%= render partial: "status_badge", locals: { release: @agent_release } %>
            </td>
          </tr>
          <tr class="hover:bg-slate-50">
            <th class="px-4 py-2 font-bold text-slate-700 border-r border-slate-200">Uploaded</th>
            <td class="px-4 py-2 text-slate-700">
              <%= @agent_release.created_at.strftime("%Y-%m-%d %H:%M:%S") %>
              <span class="text-slate-400">(<%= time_ago_in_words(@agent_release.created_at) %> ago)</span>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <%# Binary Details Card %>
  <div class="card-netbox">
    <div class="card-header flex items-center justify-between">
      <h3 class="card-title">Binaries</h3>
      <% if current_user.approver? && @agent_release.agent_binaries.count < AgentBinary::SUPPORTED_ARCHITECTURES.size %>
        <%= link_to new_settings_agent_release_binary_path(@agent_release), class: "text-xs text-teal-600 hover:text-teal-700 font-medium" do %>
          + Add Architecture
        <% end %>
      <% end %>
    </div>
    <div class="p-0">
      <% if @agent_release.agent_binaries.any? %>
        <table class="w-full text-sm text-left">
          <thead class="bg-slate-50 border-b border-slate-200">
            <tr>
              <th class="px-4 py-2 font-bold text-slate-500 uppercase text-[10px]">Architecture</th>
              <th class="px-4 py-2 font-bold text-slate-500 uppercase text-[10px]">Size</th>
              <th class="px-4 py-2 font-bold text-slate-500 uppercase text-[10px]">Checksum</th>
              <th class="px-4 py-2 font-bold text-slate-500 uppercase text-[10px]">Download</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @agent_release.agent_binaries.order(:arch).each do |agent_binary| %>
              <tr class="hover:bg-slate-50">
                <td class="px-4 py-2 text-slate-700 font-bold">
                  <span class="inline-flex items-center rounded-sm px-2 py-0.5 text-xs font-mono bg-slate-100 text-slate-700 border border-slate-200">
                    <%= agent_binary.arch %>
                  </span>
                </td>
                <td class="px-4 py-2 text-slate-700"><%= agent_binary.formatted_size %></td>
                <td class="px-4 py-2 text-slate-600 font-mono text-[10px]">
                  <%= agent_binary.checksum.present? ? agent_binary.checksum[0..15] + "..." : "—" %>
                </td>
                <td class="px-4 py-2">
                  <% if agent_binary.binary.attached? %>
                    <%= link_to rails_blob_path(agent_binary.binary, disposition: "attachment"),
                        class: "inline-flex items-center text-teal-600 hover:text-teal-700 font-medium text-xs" do %>
                      <svg class="h-3 w-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                      </svg>
                      Download
                    <% end %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% elsif @agent_release.binary.attached? %>
        <%# Legacy single binary display %>
        <table class="w-full text-sm text-left">
          <tbody class="divide-y divide-slate-100">
            <tr class="hover:bg-slate-50">
              <th class="px-4 py-2 font-bold text-slate-700 w-1/3 border-r border-slate-200">Filename</th>
              <td class="px-4 py-2 text-slate-700 font-mono"><%= @agent_release.binary_filename || "—" %></td>
            </tr>
            <tr class="hover:bg-slate-50">
              <th class="px-4 py-2 font-bold text-slate-700 border-r border-slate-200">Size</th>
              <td class="px-4 py-2 text-slate-700"><%= @agent_release.formatted_size %></td>
            </tr>
            <tr class="hover:bg-slate-50">
              <th class="px-4 py-2 font-bold text-slate-700 border-r border-slate-200">SHA256 Checksum</th>
              <td class="px-4 py-2 text-slate-600 font-mono text-xs break-all">
                <%= @agent_release.checksum.presence || "—" %>
              </td>
            </tr>
            <tr class="hover:bg-slate-50">
              <th class="px-4 py-2 font-bold text-slate-700 border-r border-slate-200">Download</th>
              <td class="px-4 py-2">
                <%= link_to rails_blob_path(@agent_release.binary, disposition: "attachment"),
                    class: "inline-flex items-center text-teal-600 hover:text-teal-700 font-medium" do %>
                  <svg class="h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                  </svg>
                  Download Binary
                <% end %>
              </td>
            </tr>
          </tbody>
        </table>
      <% else %>
        <div class="p-4 text-center text-slate-500 text-sm">
          No binaries uploaded yet.
          <% if current_user.approver? %>
            <%= link_to "Add a binary", new_settings_agent_release_binary_path(@agent_release), class: "text-teal-600 hover:underline" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<%# Release Notes Card %>
<div class="card-netbox mt-6">
  <div class="card-header">
    <h3 class="card-title">Release Notes</h3>
  </div>
  <% if @agent_release.release_notes.present? %>
    <div class="p-4 prose prose-sm max-w-none">
      <%= simple_format(@agent_release.release_notes) %>
    </div>
  <% else %>
    <div class="p-4 text-center text-slate-500 text-sm">
      No release notes provided
    </div>
  <% end %>
</div>

<%# Danger Zone %>
<% if current_user.approver? %>
  <div class="card-netbox mt-6 border-red-200">
    <div class="card-header bg-red-50 border-red-200">
      <h3 class="card-title text-red-800">Danger Zone</h3>
    </div>
    <div class="p-4">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-slate-900">Delete this release</p>
          <p class="text-xs text-slate-500">Once deleted, this release cannot be recovered.</p>
        </div>
        <%= button_to settings_agent_release_path(@agent_release),
            method: :delete,
            class: "btn-danger",
            data: { turbo_confirm: "Are you sure you want to delete this release? This action cannot be undone." } do %>
          Delete Release
        <% end %>
      </div>
    </div>
  </div>
<% end %>
