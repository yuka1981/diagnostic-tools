<% if agent_releases.any? %>
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-neutral-8 text-sm" data-testid="agent-releases-table">
      <thead class="bg-neutral-2" data-testid="agent-releases-table-header">
        <tr>
          <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Version</th>
          <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Binary</th>
          <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Size</th>
          <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Status</th>
          <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Uploaded</th>
          <th scope="col" class="relative px-3 py-2 border-b">
            <span class="sr-only">Actions</span>
          </th>
        </tr>
      </thead>
      <tbody class="divide-y divide-neutral-8 bg-white" data-testid="agent-releases-table-body">
        <% agent_releases.each do |release| %>
          <tr class="hover:bg-neutral-2 transition-colors" data-testid="agent-releases-row-<%= release.version %>">
            <td class="whitespace-nowrap px-3 py-2">
              <%= link_to settings_agent_release_path(release), class: "group flex items-center gap-2", data: { testid: "agent-releases-version-#{release.version}" } do %>
                <p class="text-sm font-bold text-neutral-85 group-hover:text-primary-6"><%= release.version %></p>
                <% if release == latest_release %>
                  <span class="inline-flex items-center rounded-sm px-1.5 py-0.5 text-xs font-medium bg-primary-1 text-primary-8 border border-primary-2">
                    Latest
                  </span>
                <% end %>
              <% end %>
            </td>
            <td class="whitespace-nowrap px-3 py-2 text-sm text-neutral-45 font-mono">
              <%= release.binary_filename || "—" %>
            </td>
            <td class="whitespace-nowrap px-3 py-2 text-sm text-neutral-45">
              <%= release.formatted_size %>
            </td>
            <td class="whitespace-nowrap px-3 py-2">
              <%= render partial: "settings/agent_releases/status_badge", locals: { release: release, testid_suffix: release.version } %>
            </td>
            <td class="whitespace-nowrap px-3 py-2 text-sm text-neutral-45">
              <%= time_ago_in_words(release.created_at) %> ago
            </td>
            <td class="whitespace-nowrap px-3 py-2">
              <div class="flex items-center justify-end gap-2">
                <%= link_to settings_agent_release_path(release), class: "inline-flex items-center text-primary-6 hover:text-primary-7", title: "View", data: { testid: "agent-releases-button-view-#{release.version}" } do %>
                  <%= lucide_icon("eye", class: "h-4 w-4") %>
                  <span class="sr-only">View</span>
                <% end %>
                <% if current_user.approver? %>
                  <%= link_to edit_settings_agent_release_path(release), class: "inline-flex items-center text-neutral-45 hover:text-neutral-85", title: "Edit", data: { testid: "agent-releases-button-edit-#{release.version}" } do %>
                    <%= lucide_icon("square-pen", class: "h-4 w-4") %>
                    <span class="sr-only">Edit</span>
                  <% end %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="flex flex-col items-center justify-center py-12 text-center" data-testid="agent-releases-empty">
    <div class="h-12 w-12 rounded-full bg-neutral-4 flex items-center justify-center mb-4">
      <%= lucide_icon("cloud-upload", class: "h-6 w-6 text-neutral-25") %>
    </div>
    <p class="text-sm font-medium text-neutral-85">No agent releases yet</p>
    <p class="mt-1 text-xs text-neutral-45">Upload an agent binary to get started</p>
    <% if current_user.approver? %>
      <%= link_to new_settings_agent_release_path, class: "mt-4 btn-primary" do %>
        Upload Release
      <% end %>
    <% end %>
  </div>
<% end %>
