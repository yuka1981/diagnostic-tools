<% content_for(:page_title) { "Edit #{@agent_release.display_name}" } %>
<% content_for(:breadcrumbs) do %>
  <span class="mx-2">/</span>
  <%= link_to "Settings", settings_agent_path, class: "hover:text-primary-6 font-bold" %>
  <span class="mx-2">/</span>
  <%= link_to "Agent Config", settings_agent_path, class: "hover:text-primary-6 font-bold" %>
  <span class="mx-2">/</span>
  <%= link_to @agent_release.version, settings_agent_release_path(@agent_release), class: "hover:text-primary-6 font-bold" %>
  <span class="mx-2">/</span>
  <span class="font-medium text-neutral-85">Edit</span>
<% end %>

<div class="mb-6">
  <h1 class="text-2xl font-bold text-neutral-85">Edit <%= @agent_release.display_name %></h1>
  <p class="text-sm text-neutral-45 mt-1">Update release information or upload a new binary</p>
</div>

<%= render "form", agent_release: @agent_release %>
