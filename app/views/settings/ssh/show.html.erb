<% content_for(:page_title) { "SSH Settings" } %>

<div class="space-y-6">
  <div class="card-netbox">
    <div class="card-header">
      <h2 class="card-title">SSH Settings</h2>
    </div>

    <%= form_with(model: @ssh_setting, url: settings_ssh_path, method: :patch) do |f| %>
      <div class="p-4 space-y-6">
        <div>
          <h3 class="text-sm font-bold text-slate-700">Global Bastion Configuration</h3>
          <p class="text-[10px] text-slate-500 italic">This bastion host (jump host) will be used as the primary entry point for agent deployment.</p>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-6">
          <div class="sm:col-span-4">
            <%= f.label :bastion_host, "Bastion Hostname or IP", class: "block text-xs font-bold text-slate-700 mb-1" %>
            <%= f.text_field :bastion_host, placeholder: "e.g. bastion.hpc.cluster", class: "block w-full rounded border border-slate-300 py-1.5 px-3 text-slate-900 shadow-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 sm:text-sm" %>
          </div>

          <div class="sm:col-span-3">
            <%= f.label :bastion_user, "Bastion SSH User", class: "block text-xs font-bold text-slate-700 mb-1" %>
            <%= f.text_field :bastion_user, placeholder: "e.g. hpc-admin", class: "block w-full rounded border border-slate-300 py-1.5 px-3 text-slate-900 shadow-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 sm:text-sm" %>
          </div>

          <div class="sm:col-span-2">
            <%= f.label :bastion_port, "SSH Port", class: "block text-xs font-bold text-slate-700 mb-1" %>
            <%= f.number_field :bastion_port, min: 1, max: 65535, class: "block w-full rounded border border-slate-300 py-1.5 px-3 text-slate-900 shadow-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 sm:text-sm" %>
          </div>
        </div>
      </div>

      <div class="flex items-center justify-end gap-3 bg-slate-50 border-t border-slate-200 px-4 py-3">
        <%= f.submit "Save Settings", class: "btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
