<% content_for(:page_title) { "SSH Defaults" } %>

<div class="space-y-6">
  <div class="card-netbox">
    <div class="card-header">
      <h2 class="card-title">SSH Defaults</h2>
    </div>

    <%= form_with(model: @ssh_setting, url: settings_ssh_defaults_path, method: :patch) do |f| %>
      <div class="p-4 space-y-6">
        <%# Bastion / Jump Host Section %>
        <div>
          <h3 class="text-sm font-bold text-slate-700 border-b border-slate-200 pb-2 mb-4">Bastion / Jump Host</h3>
          <p class="text-[10px] text-slate-500 italic mb-4">Configure the bastion (jump host) used for SSH connections to nodes using global_bastion connection method.</p>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-6">
            <div class="sm:col-span-4">
              <%= f.label :bastion_host, "Host", class: "block text-xs font-bold text-slate-700 mb-1" %>
              <%= f.text_field :bastion_host, placeholder: "e.g. bastion.example.com", class: "block w-full rounded border border-slate-300 py-1.5 px-3 text-slate-900 shadow-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 sm:text-sm" %>
            </div>

            <div class="sm:col-span-3">
              <%= f.label :bastion_user, "User", class: "block text-xs font-bold text-slate-700 mb-1" %>
              <%= f.text_field :bastion_user, placeholder: "e.g. admin", class: "block w-full rounded border border-slate-300 py-1.5 px-3 text-slate-900 shadow-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 sm:text-sm" %>
            </div>

            <div class="sm:col-span-2">
              <%= f.label :bastion_port, "Port", class: "block text-xs font-bold text-slate-700 mb-1" %>
              <%= f.number_field :bastion_port, min: 1, max: 65535, class: "block w-full rounded border border-slate-300 py-1.5 px-3 text-slate-900 shadow-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 sm:text-sm" %>
            </div>
          </div>
        </div>

        <%# Default Authentication Section %>
        <div>
          <h3 class="text-sm font-bold text-slate-700 border-b border-slate-200 pb-2 mb-4">Default Authentication</h3>
          <p class="text-[10px] text-slate-500 italic mb-4">Default SSH credentials used for nodes that don't have overrides configured.</p>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-6">
            <div class="sm:col-span-4">
              <%= f.label :ssh_user, "SSH User", class: "block text-xs font-bold text-slate-700 mb-1" %>
              <%= f.text_field :ssh_user, placeholder: "e.g. hpc-admin", class: "block w-full rounded border border-slate-300 py-1.5 px-3 text-slate-900 shadow-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 sm:text-sm" %>
            </div>

            <div class="sm:col-span-2">
              <%= f.label :ssh_port, "SSH Port", class: "block text-xs font-bold text-slate-700 mb-1" %>
              <%= f.number_field :ssh_port, min: 1, max: 65535, class: "block w-full rounded border border-slate-300 py-1.5 px-3 text-slate-900 shadow-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 sm:text-sm" %>
            </div>

            <div class="sm:col-span-6" data-controller="credential-clear">
              <%= f.label :ssh_key, "SSH Private Key", class: "block text-xs font-bold text-slate-700 mb-1" %>
              <%= f.hidden_field :clear_ssh_key, value: "", data: { credential_clear_target: "clearFlag" } %>
              <div class="flex items-start gap-2">
                <%= f.text_area :ssh_key, rows: 6, placeholder: "Paste private key here...", class: "block w-full rounded border border-slate-300 py-1.5 px-3 text-slate-900 shadow-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 sm:text-sm font-mono text-xs", data: { credential_clear_target: "field" } %>
                <% if @ssh_setting.ssh_key.present? %>
                  <button type="button"
                          class="text-xs text-red-600 hover:text-red-800 font-medium whitespace-nowrap mt-1"
                          data-credential-clear-target="clearButton"
                          data-action="click->credential-clear#clear">
                    Clear
                  </button>
                <% end %>
              </div>
              <div class="hidden mt-1 text-xs text-amber-600 font-medium" data-credential-clear-target="clearedIndicator">
                Will be cleared on save.
                <a href="#" class="text-teal-600 hover:text-teal-800 ml-1" data-action="click->credential-clear#undo">Undo</a>
              </div>
              <p class="text-[10px] text-slate-500 mt-1">The private key used for SSH authentication. Keep this secure.</p>
            </div>

            <div class="sm:col-span-3" data-controller="credential-clear">
              <%= f.label :ssh_password, "SSH Password", class: "block text-xs font-bold text-slate-700 mb-1" %>
              <%= f.hidden_field :clear_ssh_password, value: "", data: { credential_clear_target: "clearFlag" } %>
              <div class="flex items-center gap-2">
                <%= f.password_field :ssh_password, placeholder: @ssh_setting.ssh_password.present? ? "••••••••" : "Optional", autocomplete: "off", class: "block w-full rounded border border-slate-300 py-1.5 px-3 text-slate-900 shadow-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 sm:text-sm", data: { credential_clear_target: "field" } %>
                <% if @ssh_setting.ssh_password.present? %>
                  <button type="button"
                          class="text-xs text-red-600 hover:text-red-800 font-medium whitespace-nowrap"
                          data-credential-clear-target="clearButton"
                          data-action="click->credential-clear#clear">
                    Clear
                  </button>
                <% end %>
              </div>
              <div class="hidden mt-1 text-xs text-amber-600 font-medium" data-credential-clear-target="clearedIndicator">
                Will be cleared on save.
                <a href="#" class="text-teal-600 hover:text-teal-800 ml-1" data-action="click->credential-clear#undo">Undo</a>
              </div>
              <p class="text-[10px] text-slate-500 mt-1">Used if key-based auth is not available.</p>
            </div>

            <div class="sm:col-span-3" data-controller="credential-clear">
              <%= f.label :sudo_credential, "Sudo Password", class: "block text-xs font-bold text-slate-700 mb-1" %>
              <%= f.hidden_field :clear_sudo_credential, value: "", data: { credential_clear_target: "clearFlag" } %>
              <div class="flex items-center gap-2">
                <%= f.password_field :sudo_credential, placeholder: @ssh_setting.sudo_credential.present? ? "••••••••" : "Optional", autocomplete: "off", class: "block w-full rounded border border-slate-300 py-1.5 px-3 text-slate-900 shadow-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 sm:text-sm", data: { credential_clear_target: "field" } %>
                <% if @ssh_setting.sudo_credential.present? %>
                  <button type="button"
                          class="text-xs text-red-600 hover:text-red-800 font-medium whitespace-nowrap"
                          data-credential-clear-target="clearButton"
                          data-action="click->credential-clear#clear">
                    Clear
                  </button>
                <% end %>
              </div>
              <div class="hidden mt-1 text-xs text-amber-600 font-medium" data-credential-clear-target="clearedIndicator">
                Will be cleared on save.
                <a href="#" class="text-teal-600 hover:text-teal-800 ml-1" data-action="click->credential-clear#undo">Undo</a>
              </div>
              <p class="text-[10px] text-slate-500 mt-1">Required for commands needing elevated privileges.</p>
            </div>
          </div>
        </div>

        <%# Connection Options Section %>
        <div>
          <h3 class="text-sm font-bold text-slate-700 border-b border-slate-200 pb-2 mb-4">Connection Options</h3>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-6">
            <div class="sm:col-span-2">
              <%= f.label :timeout, "Timeout (seconds)", class: "block text-xs font-bold text-slate-700 mb-1" %>
              <%= f.number_field :timeout, min: 1, max: 300, class: "block w-full rounded border border-slate-300 py-1.5 px-3 text-slate-900 shadow-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 sm:text-sm" %>
            </div>

            <div class="sm:col-span-4 flex items-center">
              <div class="flex items-center h-full pt-6">
                <%= f.check_box :verify_host_key, class: "h-4 w-4 rounded border-slate-300 text-teal-600 focus:ring-teal-500" %>
                <%= f.label :verify_host_key, "Verify Host Key", class: "ml-2 text-sm text-slate-700" %>
                <span class="ml-2 text-[10px] text-slate-500">(Recommended for production)</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <% if @ssh_setting.errors.any? %>
        <div class="px-4 pb-4">
          <div class="bg-red-50 border border-red-200 rounded p-3">
            <h4 class="text-sm font-bold text-red-800">Please correct the following errors:</h4>
            <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
              <% @ssh_setting.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>

      <div class="flex items-center justify-end gap-3 bg-slate-50 border-t border-slate-200 px-4 py-3">
        <%= f.submit "Save SSH Defaults", class: "btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
