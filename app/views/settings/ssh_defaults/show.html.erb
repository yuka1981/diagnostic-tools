<% content_for(:page_title) { "SSH Defaults" } %>

<div class="space-y-6" data-testid="ssh-settings-container">
  <div class="card-netbox">
    <div class="card-header">
      <h2 class="card-title">SSH Defaults</h2>
    </div>

    <%= form_with(model: @ssh_setting, url: settings_ssh_defaults_path, method: :patch, data: { testid: "ssh-settings-form" }) do |f| %>
      <div class="p-4 space-y-6">
        <%# Bastion / Jump Host Section %>
        <div>
          <h3 class="text-sm font-bold text-neutral-85 border-b border-neutral-8 pb-2 mb-4">Bastion / Jump Host</h3>
          <p class="text-[10px] text-neutral-45 italic mb-4">Configure the bastion (jump host) used for SSH connections to nodes using global_bastion connection method.</p>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-6">
            <div class="sm:col-span-4">
              <%= f.label :bastion_host, "Host", class: "block text-xs font-bold text-neutral-85 mb-1" %>
              <%= f.text_field :bastion_host, placeholder: "e.g. bastion.example.com", data: { testid: "ssh-settings-input-bastion-host" }, class: "block w-full rounded border border-neutral-15 py-1.5 px-3 text-neutral-85 shadow-sm focus:ring-2 focus:ring-primary-5 focus:border-primary-5 sm:text-sm" %>
            </div>

            <div class="sm:col-span-3">
              <%= f.label :bastion_user, "User", class: "block text-xs font-bold text-neutral-85 mb-1" %>
              <%= f.text_field :bastion_user, placeholder: "e.g. admin", data: { testid: "ssh-settings-input-bastion-user" }, class: "block w-full rounded border border-neutral-15 py-1.5 px-3 text-neutral-85 shadow-sm focus:ring-2 focus:ring-primary-5 focus:border-primary-5 sm:text-sm" %>
            </div>

            <div class="sm:col-span-2">
              <%= f.label :bastion_port, "Port", class: "block text-xs font-bold text-neutral-85 mb-1" %>
              <%= f.number_field :bastion_port, min: 1, max: 65535, data: { testid: "ssh-settings-input-bastion-port" }, class: "block w-full rounded border border-neutral-15 py-1.5 px-3 text-neutral-85 shadow-sm focus:ring-2 focus:ring-primary-5 focus:border-primary-5 sm:text-sm" %>
            </div>
          </div>
        </div>

        <%# Default Authentication Section %>
        <div>
          <h3 class="text-sm font-bold text-neutral-85 border-b border-neutral-8 pb-2 mb-4">Default Authentication</h3>
          <p class="text-[10px] text-neutral-45 italic mb-4">Default SSH credentials used for nodes that don't have overrides configured.</p>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-6">
            <div class="sm:col-span-4">
              <%= f.label :ssh_user, "SSH User", class: "block text-xs font-bold text-neutral-85 mb-1" %>
              <%= f.text_field :ssh_user, placeholder: "e.g. hpc-admin", data: { testid: "ssh-settings-input-user" }, class: "block w-full rounded border border-neutral-15 py-1.5 px-3 text-neutral-85 shadow-sm focus:ring-2 focus:ring-primary-5 focus:border-primary-5 sm:text-sm" %>
            </div>

            <div class="sm:col-span-2">
              <%= f.label :ssh_port, "SSH Port", class: "block text-xs font-bold text-neutral-85 mb-1" %>
              <%= f.number_field :ssh_port, min: 1, max: 65535, data: { testid: "ssh-settings-input-port" }, class: "block w-full rounded border border-neutral-15 py-1.5 px-3 text-neutral-85 shadow-sm focus:ring-2 focus:ring-primary-5 focus:border-primary-5 sm:text-sm" %>
            </div>

            <div class="sm:col-span-6">
              <%= f.label :ssh_key, "SSH Private Key", class: "block text-xs font-bold text-neutral-85 mb-1" %>
              <%= f.text_area :ssh_key, rows: 6, placeholder: "Paste private key here...", data: { testid: "ssh-settings-input-key" }, class: "block w-full rounded border border-neutral-15 py-1.5 px-3 text-neutral-85 shadow-sm focus:ring-2 focus:ring-primary-5 focus:border-primary-5 sm:text-sm font-mono text-xs" %>
              <p class="text-[10px] text-neutral-45 mt-1">The private key used for SSH authentication. Keep this secure.</p>
            </div>

            <div class="sm:col-span-3">
              <%= f.label :ssh_password, "SSH Password", class: "block text-xs font-bold text-neutral-85 mb-1" %>
              <%= f.password_field :ssh_password, placeholder: @ssh_setting.ssh_password.present? ? "••••••••" : "Optional", autocomplete: "off", data: { testid: "ssh-settings-input-password" }, class: "block w-full rounded border border-neutral-15 py-1.5 px-3 text-neutral-85 shadow-sm focus:ring-2 focus:ring-primary-5 focus:border-primary-5 sm:text-sm" %>
              <p class="text-[10px] text-neutral-45 mt-1">Used if key-based auth is not available.</p>
            </div>

            <div class="sm:col-span-3">
              <%= f.label :sudo_credential, "Sudo Password", class: "block text-xs font-bold text-neutral-85 mb-1" %>
              <%= f.password_field :sudo_credential, placeholder: @ssh_setting.sudo_credential.present? ? "••••••••" : "Optional", autocomplete: "off", data: { testid: "ssh-settings-input-sudo" }, class: "block w-full rounded border border-neutral-15 py-1.5 px-3 text-neutral-85 shadow-sm focus:ring-2 focus:ring-primary-5 focus:border-primary-5 sm:text-sm" %>
              <p class="text-[10px] text-neutral-45 mt-1">Required for commands needing elevated privileges.</p>
            </div>
          </div>
        </div>

        <%# Connection Options Section %>
        <div>
          <h3 class="text-sm font-bold text-neutral-85 border-b border-neutral-8 pb-2 mb-4">Connection Options</h3>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-6">
            <div class="sm:col-span-2">
              <%= f.label :timeout, "Timeout (seconds)", class: "block text-xs font-bold text-neutral-85 mb-1" %>
              <%= f.number_field :timeout, min: 1, max: 300, data: { testid: "ssh-settings-input-timeout" }, class: "block w-full rounded border border-neutral-15 py-1.5 px-3 text-neutral-85 shadow-sm focus:ring-2 focus:ring-primary-5 focus:border-primary-5 sm:text-sm" %>
            </div>

            <div class="sm:col-span-4 flex items-center">
              <div class="flex items-center h-full pt-6">
                <%= f.check_box :verify_host_key, { data: { testid: "ssh-settings-checkbox-verify" }, class: "h-4 w-4 rounded border-neutral-15 text-primary-6 focus:ring-primary-5" } %>
                <%= f.label :verify_host_key, "Verify Host Key", class: "ml-2 text-sm text-neutral-85" %>
                <span class="ml-2 text-[10px] text-neutral-45">(Recommended for production)</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <% if @ssh_setting.errors.any? %>
        <div class="px-4 pb-4">
          <div class="bg-error-1 border border-error-2 rounded p-3">
            <h4 class="text-sm font-bold text-error-8">Please correct the following errors:</h4>
            <ul class="mt-2 text-sm text-error-7 list-disc list-inside">
              <% @ssh_setting.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>

      <div class="flex items-center justify-end gap-3 bg-neutral-2 border-t border-neutral-8 px-4 py-3">
        <%= f.submit "Save SSH Defaults", data: { testid: "ssh-settings-button-submit" }, class: "btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
