<% content_for(:page_title) { "Agent Configuration" } %>

<div class="max-w-4xl mx-auto">
  <div class="mb-8">
    <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Agent Configuration</h2>
    <p class="mt-1 text-sm text-gray-500 dark:text-slate-400">Configure global settings used by hpc-agent during execution.</p>
  </div>

  <div class="bg-white shadow-sm ring-1 ring-gray-200 dark:bg-slate-800/50 dark:ring-white/10 rounded-2xl overflow-hidden">
    <%= form_with(model: @ssh_setting, url: settings_agent_path, method: :patch, class: "divide-y divide-gray-100 dark:divide-white/5") do |f| %>
      <div class="p-6 space-y-6">
        <div>
          <h3 class="text-base font-semibold leading-7 text-gray-900 dark:text-white">Reporting Settings</h3>
          <p class="mt-1 text-sm leading-6 text-gray-500 dark:text-slate-400">These settings define how agents communicate with the central server.</p>
        </div>

        <div class="grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
          <div class="sm:col-span-4">
            <%= f.label :server_url, "Server URL (Reporting Endpoint)", class: "block text-sm font-medium leading-6 text-gray-900 dark:text-white" %>
            <div class="mt-2">
              <%= f.text_field :server_url, placeholder: "e.g. https://hpc-portal.com", class: "block w-full rounded-none border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-blue-600 sm:text-sm sm:leading-6 dark:bg-slate-800 dark:text-white dark:ring-white/10" %>
            </div>
            <p class="mt-2 text-xs text-gray-500 dark:text-slate-400">The default URL agents will use to send data back to this server. Can be overridden per installation.</p>
          </div>
        </div>
      </div>

      <div class="flex items-center justify-end gap-x-6 border-t border-gray-900/10 px-4 py-4 sm:px-8">
        <%= f.submit "Save Configuration", class: "rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 transition-all" %>
      </div>
    <% end %>
  </div>
</div>
