<% content_for(:page_title) { "Agent Configuration" } %>

<div class="space-y-6">
  <div class="card-netbox">
    <div class="card-header">
      <h2 class="card-title">Agent Configuration</h2>
    </div>
    
    <%= form_with(model: @ssh_setting, url: settings_agent_path, method: :patch) do |f| %>
      <div class="p-4 space-y-6">
        <div>
          <h3 class="text-sm font-bold text-slate-700">Reporting Settings</h3>
          <p class="text-[10px] text-slate-500 italic">These settings define how agents communicate with the central server.</p>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-6">
          <div class="sm:col-span-4">
            <%= f.label :server_url, "Server URL (Reporting Endpoint)", class: "block text-xs font-bold text-slate-700 mb-1" %>
            <%= f.text_field :server_url, placeholder: "e.g. https://hpc-portal.com", class: "block w-full rounded border border-slate-300 py-1.5 px-3 text-slate-900 shadow-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 sm:text-sm" %>
            <p class="mt-1 text-[10px] text-slate-500">The default URL agents will use to send data back to this server. Can be overridden per installation.</p>
          </div>
        </div>
      </div>

      <div class="flex items-center justify-end gap-3 bg-slate-50 border-t border-slate-200 px-4 py-3">
        <%= f.submit "Save Configuration", class: "btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
