<% content_for(:page_title) { "SSH Profiles" } %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold text-slate-900">SSH Profiles</h1>
    <p class="text-sm text-slate-500 mt-1">Manage reusable SSH connection profiles for nodes</p>
  </div>
  <div class="flex items-center gap-3">
    <%= link_to new_settings_ssh_profile_path, class: "btn-primary" do %>
      <%= lucide_icon("plus", class: "h-4 w-4 mr-2") %>
      Add SSH Profile
    <% end %>
  </div>
</div>

<div class="card-netbox">
  <% if @ssh_profiles.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200 text-sm">
        <thead class="bg-slate-50">
          <tr>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-slate-500 border-b">Name</th>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-slate-500 border-b">Connection Method</th>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-slate-500 border-b">SSH User</th>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-slate-500 border-b">Port</th>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-slate-500 border-b">Nodes</th>
            <th scope="col" class="relative px-3 py-2 border-b">
              <span class="sr-only">Actions</span>
            </th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-slate-200">
          <% @ssh_profiles.each do |profile| %>
            <tr class="hover:bg-slate-50">
              <td class="px-3 py-3 whitespace-nowrap">
                <span class="font-medium text-slate-900"><%= profile.name %></span>
              </td>
              <td class="px-3 py-3 whitespace-nowrap">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                  <%= case profile.ssh_connect_method
                      when 'global_bastion' then 'bg-blue-100 text-blue-800'
                      when 'custom_bastion' then 'bg-purple-100 text-purple-800'
                      when 'direct' then 'bg-green-100 text-green-800'
                      end %>">
                  <%= profile.display_connection_method %>
                </span>
              </td>
              <td class="px-3 py-3 whitespace-nowrap text-slate-600">
                <%= profile.ssh_user.presence || "-" %>
              </td>
              <td class="px-3 py-3 whitespace-nowrap text-slate-600">
                <%= profile.ssh_port %>
              </td>
              <td class="px-3 py-3 whitespace-nowrap text-slate-600">
                <%= profile.nodes.count %>
              </td>
              <td class="px-3 py-3 whitespace-nowrap text-right text-sm font-medium">
                <div class="flex items-center justify-end gap-2">
                  <%= link_to edit_settings_ssh_profile_path(profile), class: "text-teal-600 hover:text-teal-900" do %>
                    <%= lucide_icon("square-pen", class: "h-4 w-4") %>
                  <% end %>
                  <%= button_to settings_ssh_profile_path(profile), method: :delete,
                      class: "text-red-600 hover:text-red-900",
                      data: { turbo_confirm: "Are you sure you want to delete this SSH profile? #{profile.nodes.count > 0 ? "#{profile.nodes.count} node(s) will have their SSH profile unassigned." : ""}" } do %>
                    <%= lucide_icon("trash-2", class: "h-4 w-4") %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="flex flex-col items-center justify-center py-12 text-center">
      <div class="h-12 w-12 rounded-full bg-slate-100 flex items-center justify-center mb-4">
        <%= lucide_icon("key", class: "h-6 w-6 text-slate-400") %>
      </div>
      <p class="text-sm font-medium text-slate-900">No SSH profiles yet</p>
      <p class="mt-1 text-xs text-slate-500">Create SSH profiles to share connection settings across nodes</p>
      <div class="mt-4">
        <%= link_to new_settings_ssh_profile_path, class: "btn-primary" do %>
          Add SSH Profile
        <% end %>
      </div>
    </div>
  <% end %>
</div>
