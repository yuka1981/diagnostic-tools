<% breadcrumb_trail([
  { title: "Server Products", path: settings_server_products_path },
  { title: @server_product.name }
]) %>

<div class="mb-6">
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-4">
      <h1 class="text-2xl font-bold text-slate-900"><%= @server_product.name %></h1>
      <% if @server_product.product_series.present? %>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-teal-100 text-teal-800">
          <%= @server_product.product_series %>
        </span>
      <% end %>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to edit_settings_server_product_path(@server_product), class: "btn-secondary" do %>
        <%= lucide_icon("square-pen", class: "h-4 w-4 mr-1") %>
        Edit
      <% end %>
      <%= button_to settings_server_product_path(@server_product),
          method: :delete,
          class: "btn-danger",
          data: { turbo_confirm: "Are you sure you want to delete this server product? This action cannot be undone." } do %>
        <%= lucide_icon("trash-2", class: "h-4 w-4 mr-1") %>
        Delete
      <% end %>
    </div>
  </div>
</div>

<div class="grid gap-6 lg:grid-cols-3">
  <%# Images Column %>
  <div class="lg:col-span-1">
    <div class="card-netbox">
      <div class="card-header">
        <h3 class="card-title">Product Images</h3>
      </div>
      <div class="p-4">
        <% if @server_product.images.attached? %>
          <div class="space-y-4">
            <% @server_product.images.each do |image| %>
              <%= image_tag image, class: "w-full rounded border border-slate-200" %>
            <% end %>
          </div>
        <% else %>
          <div class="flex flex-col items-center justify-center py-8 text-center">
            <div class="h-12 w-12 rounded-full bg-slate-100 flex items-center justify-center mb-4">
              <%= lucide_icon("image", class: "h-6 w-6 text-slate-400") %>
            </div>
            <p class="text-sm text-slate-500">No images available</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%# Specs Column %>
  <div class="lg:col-span-2 space-y-6">
    <%# Overview Card %>
    <div class="card-netbox">
      <div class="card-header">
        <h3 class="card-title">Overview</h3>
      </div>
      <div class="p-0">
        <table class="w-full text-sm text-left">
          <tbody class="divide-y divide-slate-100">
            <tr class="hover:bg-slate-50">
              <th class="px-4 py-2 font-bold text-slate-700 w-1/3 border-r border-slate-200">Model Name</th>
              <td class="px-4 py-2 text-slate-700 font-bold"><%= @server_product.name %></td>
            </tr>
            <tr class="hover:bg-slate-50">
              <th class="px-4 py-2 font-bold text-slate-700 border-r border-slate-200">Product Series</th>
              <td class="px-4 py-2 text-slate-700"><%= @server_product.product_series.presence || "-" %></td>
            </tr>
            <tr class="hover:bg-slate-50">
              <th class="px-4 py-2 font-bold text-slate-700 border-r border-slate-200">Form Factor</th>
              <td class="px-4 py-2 text-slate-700"><%= @server_product.form_factor.presence || "-" %></td>
            </tr>
            <tr class="hover:bg-slate-50">
              <th class="px-4 py-2 font-bold text-slate-700 border-r border-slate-200">Rack Height</th>
              <td class="px-4 py-2 text-slate-700"><%= @server_product.rack_height.present? ? "#{@server_product.rack_height}U" : "-" %></td>
            </tr>
            <tr class="hover:bg-slate-50">
              <th class="px-4 py-2 font-bold text-slate-700 border-r border-slate-200">QCT Product URL</th>
              <td class="px-4 py-2 text-slate-700">
                <% if @server_product.qct_product_url.present? && @server_product.qct_product_url.start_with?("https://") %>
                  <%= link_to @server_product.qct_product_url, @server_product.qct_product_url, target: "_blank", rel: "noopener noreferrer", class: "text-teal-600 hover:text-teal-700 hover:underline" %>
                <% elsif @server_product.qct_product_url.present? %>
                  <%= @server_product.qct_product_url %>
                <% else %>
                  -
                <% end %>
              </td>
            </tr>
            <tr class="hover:bg-slate-50">
              <th class="px-4 py-2 font-bold text-slate-700 border-r border-slate-200">Last Synced</th>
              <td class="px-4 py-2 text-slate-700"><%= @server_product.last_synced_at.present? ? time_ago_in_words(@server_product.last_synced_at) + " ago" : "Never" %></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <%# CPU & GPU Card %>
    <div class="card-netbox">
      <div class="card-header">
        <h3 class="card-title">CPU & GPU</h3>
      </div>
      <div class="p-0">
        <table class="w-full text-sm text-left">
          <tbody class="divide-y divide-slate-100">
            <tr class="hover:bg-slate-50">
              <th class="px-4 py-2 font-bold text-slate-700 w-1/3 border-r border-slate-200">CPU Generations</th>
              <td class="px-4 py-2 text-slate-700">
                <% if @server_product.cpu_generations.present? && @server_product.cpu_generations.any? %>
                  <div class="flex flex-wrap gap-1">
                    <% @server_product.cpu_generations.each do |gen| %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-slate-100 text-slate-700"><%= gen %></span>
                    <% end %>
                  </div>
                <% else %>
                  -
                <% end %>
              </td>
            </tr>
            <tr class="hover:bg-slate-50">
              <th class="px-4 py-2 font-bold text-slate-700 border-r border-slate-200">Socket Count</th>
              <td class="px-4 py-2 text-slate-700"><%= @server_product.socket_count.present? ? "#{@server_product.socket_count} Socket(s)" : "-" %></td>
            </tr>
            <tr class="hover:bg-slate-50">
              <th class="px-4 py-2 font-bold text-slate-700 border-r border-slate-200">Max TDP</th>
              <td class="px-4 py-2 text-slate-700"><%= @server_product.max_tdp_watts.present? ? "#{@server_product.max_tdp_watts}W" : "-" %></td>
            </tr>
            <tr class="hover:bg-slate-50">
              <th class="px-4 py-2 font-bold text-slate-700 border-r border-slate-200">GPU Support</th>
              <td class="px-4 py-2 text-slate-700">
                <% if @server_product.gpu_support %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">Yes</span>
                <% else %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-slate-100 text-slate-600">No</span>
                <% end %>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <%# Memory Card %>
    <div class="card-netbox">
      <div class="card-header">
        <h3 class="card-title">Memory</h3>
      </div>
      <div class="p-0">
        <table class="w-full text-sm text-left">
          <tbody class="divide-y divide-slate-100">
            <tr class="hover:bg-slate-50">
              <th class="px-4 py-2 font-bold text-slate-700 w-1/3 border-r border-slate-200">Max Memory</th>
              <td class="px-4 py-2 text-slate-700"><%= @server_product.max_memory_gb.present? ? "#{@server_product.max_memory_gb} GB" : "-" %></td>
            </tr>
            <tr class="hover:bg-slate-50">
              <th class="px-4 py-2 font-bold text-slate-700 border-r border-slate-200">DIMM Slots</th>
              <td class="px-4 py-2 text-slate-700"><%= @server_product.dimm_slots.presence || "-" %></td>
            </tr>
            <tr class="hover:bg-slate-50">
              <th class="px-4 py-2 font-bold text-slate-700 border-r border-slate-200">Memory Types</th>
              <td class="px-4 py-2 text-slate-700">
                <% if @server_product.memory_types.present? && @server_product.memory_types.any? %>
                  <div class="flex flex-wrap gap-1">
                    <% @server_product.memory_types.each do |type| %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-slate-100 text-slate-700"><%= type %></span>
                    <% end %>
                  </div>
                <% else %>
                  -
                <% end %>
              </td>
            </tr>
            <tr class="hover:bg-slate-50">
              <th class="px-4 py-2 font-bold text-slate-700 border-r border-slate-200">Max Memory Speed</th>
              <td class="px-4 py-2 text-slate-700"><%= @server_product.max_memory_speed_mhz.present? ? "#{@server_product.max_memory_speed_mhz} MHz" : "-" %></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <%# Storage Card %>
    <div class="card-netbox">
      <div class="card-header">
        <h3 class="card-title">Storage</h3>
      </div>
      <div class="p-0">
        <% if @server_product.drive_bays.present? && @server_product.drive_bays.any? %>
          <table class="w-full text-sm text-left">
            <thead class="bg-slate-50">
              <tr>
                <th class="px-4 py-2 text-xs font-bold uppercase text-slate-500 border-b">Count</th>
                <th class="px-4 py-2 text-xs font-bold uppercase text-slate-500 border-b">Type</th>
                <th class="px-4 py-2 text-xs font-bold uppercase text-slate-500 border-b">Form Factor</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% @server_product.drive_bays.each do |bay| %>
                <tr class="hover:bg-slate-50">
                  <td class="px-4 py-2 text-slate-700"><%= bay["count"] %></td>
                  <td class="px-4 py-2 text-slate-700"><%= bay["type"] %></td>
                  <td class="px-4 py-2 text-slate-700"><%= bay["form_factor"].present? ? "#{bay["form_factor"]}\"" : "-" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <div class="flex flex-col items-center justify-center py-8 text-center">
            <p class="text-sm text-slate-500">No storage configuration specified</p>
          </div>
        <% end %>
      </div>
    </div>

    <%# PCIe Card %>
    <div class="card-netbox">
      <div class="card-header">
        <h3 class="card-title">PCIe</h3>
      </div>
      <div class="p-0">
        <% if @server_product.pcie_slots.present? && @server_product.pcie_slots.any? %>
          <table class="w-full text-sm text-left">
            <thead class="bg-slate-50">
              <tr>
                <th class="px-4 py-2 text-xs font-bold uppercase text-slate-500 border-b">Count</th>
                <th class="px-4 py-2 text-xs font-bold uppercase text-slate-500 border-b">Generation</th>
                <th class="px-4 py-2 text-xs font-bold uppercase text-slate-500 border-b">Lanes</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% @server_product.pcie_slots.each do |slot| %>
                <tr class="hover:bg-slate-50">
                  <td class="px-4 py-2 text-slate-700"><%= slot["count"] %></td>
                  <td class="px-4 py-2 text-slate-700"><%= slot["generation"].present? ? "PCIe #{slot["generation"]}" : "-" %></td>
                  <td class="px-4 py-2 text-slate-700"><%= slot["lanes"].present? ? "x#{slot["lanes"]}" : "-" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <div class="flex flex-col items-center justify-center py-8 text-center">
            <p class="text-sm text-slate-500">No PCIe configuration specified</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
