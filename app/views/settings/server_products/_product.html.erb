<tr class="hover:bg-slate-50 transition-colors">
  <td class="whitespace-nowrap px-3 py-2">
    <% if product.images.attached? %>
      <%= image_tag product.thumbnail_variant,
            loading: "lazy",
            decoding: "async",
            class: "h-10 w-10 object-contain rounded bg-slate-100" %>
    <% else %>
      <div class="h-10 w-10 bg-slate-100 rounded flex items-center justify-center">
        <svg class="h-5 w-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" />
        </svg>
      </div>
    <% end %>
  </td>
  <td class="whitespace-nowrap px-3 py-2">
    <%= link_to settings_server_product_path(product), class: "group" do %>
      <p class="text-sm font-bold text-slate-900 group-hover:text-teal-600"><%= product.name %></p>
    <% end %>
  </td>
  <td class="px-3 py-2 text-sm text-slate-600">
    <%= product.product_series.presence || "—" %>
  </td>
  <td class="whitespace-nowrap px-3 py-2">
    <% if product.form_factor.present? %>
      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-slate-100 text-slate-700">
        <%= product.form_factor %>
      </span>
    <% else %>
      <span class="text-sm text-slate-400">—</span>
    <% end %>
  </td>
  <td class="px-3 py-2 text-sm text-slate-600">
    <% if product.cpu_generations.present? && product.cpu_generations.any? %>
      <%= product.cpu_generations.join(", ") %>
    <% else %>
      <span class="text-slate-400">—</span>
    <% end %>
  </td>
  <td class="whitespace-nowrap px-3 py-2 text-sm text-slate-600">
    <% if product.max_memory_gb.present? %>
      <%= number_to_human_size(product.max_memory_gb * 1.gigabyte, precision: 0) %>
    <% else %>
      <span class="text-slate-400">—</span>
    <% end %>
  </td>
  <td class="whitespace-nowrap px-3 py-2 text-sm text-slate-500">
    <% if product.last_synced_at.present? %>
      <%= time_ago_in_words(product.last_synced_at) %> ago
    <% else %>
      <span class="text-slate-400">Manual</span>
    <% end %>
  </td>
  <td class="whitespace-nowrap px-3 py-2">
    <div class="flex items-center justify-end gap-2">
      <%= link_to settings_server_product_path(product), class: "text-teal-600 hover:text-teal-700", title: "View" do %>
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <span class="sr-only">View</span>
      <% end %>
      <%= link_to edit_settings_server_product_path(product), class: "text-slate-600 hover:text-slate-700", title: "Edit" do %>
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
        </svg>
        <span class="sr-only">Edit</span>
      <% end %>
      <%= button_to settings_server_product_path(product), method: :delete, class: "text-red-600 hover:text-red-700", title: "Delete", data: { turbo_confirm: "Are you sure you want to delete this product?" } do %>
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
        </svg>
        <span class="sr-only">Delete</span>
      <% end %>
    </div>
  </td>
</tr>
