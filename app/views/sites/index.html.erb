<% content_for(:page_title) { "Sites" } %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold text-slate-900">Sites</h1>
    <p class="text-sm text-slate-500 mt-1">Manage data center locations and rooms</p>
  </div>
  <% if current_user.approver? %>
    <%= link_to new_site_path, class: "btn-primary" do %>
      <%= lucide_icon("plus", class: "h-4 w-4 mr-2") %>
      Add Site
    <% end %>
  <% end %>
</div>

<div class="card-netbox">
  <% if @sites.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200 text-sm">
        <thead class="bg-slate-50">
          <tr>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-slate-500 border-b">Name</th>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-slate-500 border-b">Description</th>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-slate-500 border-b">Rooms</th>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-slate-500 border-b">Racks</th>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-slate-500 border-b">Nodes</th>
            <th scope="col" class="relative px-3 py-2 border-b">
              <span class="sr-only">Actions</span>
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 bg-white">
          <% @sites.each do |site| %>
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="whitespace-nowrap px-3 py-2">
                <%= link_to site_path(site), class: "group" do %>
                  <p class="text-sm font-bold text-slate-900 group-hover:text-teal-600"><%= site.name %></p>
                <% end %>
              </td>
              <td class="px-3 py-2 text-sm text-slate-600">
                <%= site.description.presence || "—" %>
              </td>
              <td class="whitespace-nowrap px-3 py-2 text-sm text-slate-500">
                <%= site.rooms.count %>
              </td>
              <td class="whitespace-nowrap px-3 py-2 text-sm text-slate-500">
                <%= site.server_racks.count %>
              </td>
              <td class="whitespace-nowrap px-3 py-2 text-sm text-slate-500">
                <%= site.server_racks.sum { |r| r.nodes.count } %>
              </td>
              <td class="whitespace-nowrap px-3 py-2 text-right text-sm">
                <%= link_to "View", site_path(site), class: "text-teal-600 hover:text-teal-700 font-medium" %>
                <% if current_user.approver? %>
                  <span class="text-slate-300 mx-1">|</span>
                  <%= link_to "Edit", edit_site_path(site), class: "text-slate-600 hover:text-slate-700 font-medium" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="flex flex-col items-center justify-center py-12 text-center">
      <div class="h-12 w-12 rounded-full bg-slate-100 flex items-center justify-center mb-4">
        <%= lucide_icon("building-2", class: "h-6 w-6 text-slate-400") %>
      </div>
      <p class="text-sm font-medium text-slate-900">No sites yet</p>
      <p class="mt-1 text-xs text-slate-500">Create a site to organize your rack infrastructure</p>
      <% if current_user.approver? %>
        <%= link_to new_site_path, class: "mt-4 btn-primary" do %>
          Add Site
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
