<% content_for(:page_title) { "Sites" } %>

<div class="flex items-center justify-between mb-6" data-testid="sites-page-container">
  <div>
    <h1 class="text-2xl font-bold text-neutral-85">Sites</h1>
    <p class="text-sm text-neutral-45 mt-1">Manage data center locations and rooms</p>
  </div>
  <% if current_user.approver? %>
    <%= link_to new_site_path, class: "btn-primary", data: { testid: "sites-button-new" } do %>
      <%= lucide_icon("plus", class: "h-4 w-4 mr-2") %>
      Add Site
    <% end %>
  <% end %>
</div>

<div class="card-netbox">
  <% if @sites.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-neutral-8 text-sm" data-testid="sites-table">
        <thead class="bg-neutral-2" data-testid="sites-table-header">
          <tr>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Name</th>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Description</th>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Rooms</th>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Racks</th>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Nodes</th>
            <th scope="col" class="relative px-3 py-2 border-b">
              <span class="sr-only">Actions</span>
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-neutral-8 bg-white" data-testid="sites-table-body">
          <% @sites.each do |site| %>
            <tr class="hover:bg-neutral-2 transition-colors" data-testid="sites-row-<%= site.name.parameterize %>">
              <td class="whitespace-nowrap px-3 py-2">
                <%= link_to site_path(site), class: "group", data: { testid: "sites-link-#{site.name.parameterize}" } do %>
                  <p class="text-sm font-bold text-neutral-85 group-hover:text-primary-6"><%= site.name %></p>
                <% end %>
              </td>
              <td class="px-3 py-2 text-sm text-neutral-45">
                <%= site.description.presence || "—" %>
              </td>
              <td class="whitespace-nowrap px-3 py-2 text-sm text-neutral-45" data-testid="sites-rooms-<%= site.name.parameterize %>">
                <%= site.rooms.count %>
              </td>
              <td class="whitespace-nowrap px-3 py-2 text-sm text-neutral-45">
                <%= site.server_racks.count %>
              </td>
              <td class="whitespace-nowrap px-3 py-2 text-sm text-neutral-45" data-testid="sites-nodes-<%= site.name.parameterize %>">
                <%= site.server_racks.sum { |r| r.nodes.count } %>
              </td>
              <td class="whitespace-nowrap px-3 py-2">
                <div class="flex items-center justify-end gap-2">
                  <%= link_to site_path(site), class: "inline-flex items-center text-primary-6 hover:text-primary-7", title: "View", data: { testid: "sites-button-view-#{site.name.parameterize}" } do %>
                    <%= lucide_icon("eye", class: "h-4 w-4") %>
                    <span class="sr-only">View</span>
                  <% end %>
                  <% if current_user.approver? %>
                    <%= link_to edit_site_path(site), class: "inline-flex items-center text-neutral-45 hover:text-neutral-85", title: "Edit", data: { testid: "sites-button-edit-#{site.name.parameterize}" } do %>
                      <%= lucide_icon("square-pen", class: "h-4 w-4") %>
                      <span class="sr-only">Edit</span>
                    <% end %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="flex flex-col items-center justify-center py-12 text-center" data-testid="sites-table-empty">
      <div class="h-12 w-12 rounded-full bg-neutral-4 flex items-center justify-center mb-4">
        <%= lucide_icon("building-2", class: "h-6 w-6 text-neutral-25") %>
      </div>
      <p class="text-sm font-medium text-neutral-85">No sites yet</p>
      <p class="mt-1 text-xs text-neutral-45">Create a site to organize your rack infrastructure</p>
      <% if current_user.approver? %>
        <%= link_to new_site_path, class: "mt-4 btn-primary", data: { testid: "sites-empty-add" } do %>
          Add Site
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
