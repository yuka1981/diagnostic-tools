<% breadcrumb_trail([
  { title: "Sites", path: sites_path },
  { title: @site.name }
]) %>

<div class="mb-6">
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-4">
      <h1 class="text-2xl font-bold text-neutral-85"><%= @site.name %></h1>
    </div>
    <% if current_user.approver? %>
      <div class="flex items-center gap-2">
        <%= link_to edit_site_path(@site), class: "btn-secondary" do %>
          <%= lucide_icon("square-pen", class: "h-4 w-4 mr-1") %>
          Edit
        <% end %>
        <%= link_to new_room_path(site_id: @site.id), class: "btn-primary" do %>
          <%= lucide_icon("plus", class: "h-4 w-4 mr-1") %>
          Add Room
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<div class="grid gap-6 lg:grid-cols-2">
  <%# Overview Card %>
  <div class="card-netbox">
    <div class="card-header">
      <h3 class="card-title">Overview</h3>
    </div>
    <div class="p-0">
      <table class="w-full text-sm text-left">
        <tbody class="divide-y divide-neutral-4">
          <tr class="hover:bg-neutral-2">
            <th class="px-4 py-2 font-bold text-neutral-85 w-1/3 border-r border-neutral-8">Name</th>
            <td class="px-4 py-2 text-neutral-85 font-bold"><%= @site.name %></td>
          </tr>
          <tr class="hover:bg-neutral-2">
            <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Description</th>
            <td class="px-4 py-2 text-neutral-85"><%= @site.description.presence || "-" %></td>
          </tr>
          <tr class="hover:bg-neutral-2">
            <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Total Rooms</th>
            <td class="px-4 py-2 text-neutral-85"><%= @site.rooms.count %></td>
          </tr>
          <tr class="hover:bg-neutral-2">
            <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Total Racks</th>
            <td class="px-4 py-2 text-neutral-85"><%= @site.server_racks.count %></td>
          </tr>
          <tr class="hover:bg-neutral-2">
            <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Total Nodes</th>
            <td class="px-4 py-2 text-neutral-85"><%= @site.server_racks.sum { |r| r.nodes.count } %></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <%# Statistics Card %>
  <div class="card-netbox">
    <div class="card-header">
      <h3 class="card-title">Statistics</h3>
    </div>
    <div class="p-0">
      <table class="w-full text-sm text-left">
        <tbody class="divide-y divide-neutral-4">
          <tr class="hover:bg-neutral-2">
            <th class="px-4 py-2 font-bold text-neutral-85 w-1/3 border-r border-neutral-8">Active Racks</th>
            <td class="px-4 py-2 text-neutral-85"><%= @site.server_racks.active.count %></td>
          </tr>
          <tr class="hover:bg-neutral-2">
            <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Planned Racks</th>
            <td class="px-4 py-2 text-neutral-85"><%= @site.server_racks.planned.count %></td>
          </tr>
          <tr class="hover:bg-neutral-2">
            <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Total U Capacity</th>
            <td class="px-4 py-2 text-neutral-85"><%= @site.server_racks.sum(:u_height) %>U</td>
          </tr>
          <tr class="hover:bg-neutral-2">
            <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Total U Used</th>
            <td class="px-4 py-2 text-neutral-85"><%= @site.server_racks.sum { |r| r.utilization } %>U</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%# Rooms List %>
<div class="card-netbox mt-6">
  <div class="card-header flex items-center justify-between">
    <h3 class="card-title">Rooms</h3>
  </div>
  <% if @site.rooms.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-neutral-8 text-sm">
        <thead class="bg-neutral-2">
          <tr>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Name</th>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Floor</th>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Wing</th>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Racks</th>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Utilization</th>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Nodes</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-neutral-8 bg-white">
          <% @site.rooms.order(:name).each do |room| %>
            <tr class="hover:bg-neutral-2 transition-colors">
              <td class="whitespace-nowrap px-3 py-2">
                <%= link_to room_path(room), class: "group" do %>
                  <p class="text-sm font-bold text-neutral-85 group-hover:text-primary-6"><%= room.name %></p>
                <% end %>
              </td>
              <td class="whitespace-nowrap px-3 py-2 text-sm text-neutral-45">
                <%= room.floor_number.present? ? "Floor #{room.floor_number}" : "-" %>
              </td>
              <td class="whitespace-nowrap px-3 py-2 text-sm text-neutral-45">
                <%= room.building_wing.presence || "-" %>
              </td>
              <td class="whitespace-nowrap px-3 py-2 text-sm text-neutral-45">
                <%= room.rack_count %><%= room.max_rack_count.present? ? " / #{room.max_rack_count}" : "" %>
              </td>
              <td class="whitespace-nowrap px-3 py-2">
                <div class="flex items-center gap-2">
                  <div class="w-24 h-2 bg-neutral-8 rounded-full overflow-hidden">
                    <div class="h-full bg-primary-5 rounded-full" style="width: <%= room.utilization_percentage %>%"></div>
                  </div>
                  <span class="text-xs text-neutral-45"><%= room.utilization_percentage %>%</span>
                </div>
              </td>
              <td class="whitespace-nowrap px-3 py-2 text-sm text-neutral-45">
                <%= room.nodes.count %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="flex flex-col items-center justify-center py-12 text-center">
      <div class="h-12 w-12 rounded-full bg-neutral-4 flex items-center justify-center mb-4">
        <%= lucide_icon("building-2", class: "h-6 w-6 text-neutral-25") %>
      </div>
      <p class="text-sm font-medium text-neutral-85">No rooms in this site</p>
      <p class="mt-1 text-xs text-neutral-45">Add rooms to organize your racks</p>
      <% if current_user.approver? %>
        <%= link_to new_room_path(site_id: @site.id), class: "mt-4 btn-primary" do %>
          Add Room
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>

<%# Danger Zone %>
<% if current_user.approver? && @site.rooms.empty? %>
  <div class="card-netbox mt-6 border-error-2">
    <div class="card-header bg-error-1 border-error-2">
      <h3 class="card-title text-error-8">Danger Zone</h3>
    </div>
    <div class="p-4">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-neutral-85">Delete this site</p>
          <p class="text-xs text-neutral-45">Once deleted, this site cannot be recovered.</p>
        </div>
        <%= button_to site_path(@site),
            method: :delete,
            class: "btn-danger",
            data: { turbo_confirm: "Are you sure you want to delete this site? This action cannot be undone." } do %>
          Delete Site
        <% end %>
      </div>
    </div>
  </div>
<% end %>
