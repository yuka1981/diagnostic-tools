<% content_for(:page_title) { "Edit #{@site.name}" } %>

<div class="mb-6">
  <nav class="text-sm text-slate-500 mb-2">
    <%= link_to "Sites", sites_path, class: "hover:text-teal-600" %> /
    <%= link_to @site.name, site_path(@site), class: "hover:text-teal-600" %> /
    <span class="text-slate-700">Edit</span>
  </nav>
  <h1 class="text-2xl font-bold text-slate-900">Edit <%= @site.name %></h1>
  <p class="text-sm text-slate-500 mt-1">Modify site information</p>
</div>

<%= render "form" %>
