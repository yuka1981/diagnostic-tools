<div class="flex min-h-full flex-col justify-center px-6 py-12 lg:px-8">
  <div class="sm:mx-auto sm:w-full sm:max-w-md">
    <div class="card-netbox shadow-xl">
      <div class="card-header justify-center py-4">
        <h2 class="text-lg font-black text-neutral-85 uppercase tracking-tight">Sign in to your account</h2>
      </div>

      <div class="p-6">
        <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-5" }) do |f| %>
          <div>
            <%= f.label :email, class: "block text-xs font-bold text-neutral-85 uppercase mb-1" %>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", 
                class: "block w-full rounded border border-neutral-15 py-1.5 px-3 text-neutral-85 shadow-sm focus:ring-2 focus:ring-primary-5 focus:border-primary-5 sm:text-sm" %>
          </div>

          <div>
            <%= f.label :password, class: "block text-xs font-bold text-neutral-85 uppercase mb-1" %>
            <%= f.password_field :password, autocomplete: "current-password",
                class: "block w-full rounded border border-neutral-15 py-1.5 px-3 text-neutral-85 shadow-sm focus:ring-2 focus:ring-primary-5 focus:border-primary-5 sm:text-sm" %>
          </div>

          <div class="flex items-center justify-between">
            <% if devise_mapping.rememberable? %>
              <div class="flex items-center">
                <%= f.check_box :remember_me, class: "h-4 w-4 rounded border-neutral-15 text-primary-6 focus:ring-primary-5" %>
                <%= f.label :remember_me, class: "ml-2 block text-xs font-bold text-neutral-45 uppercase" %>
              </div>
            <% end %>

            <% if devise_mapping.recoverable? && controller_name != 'passwords' %>
              <div class="text-xs">
                <%= link_to "Forgot password?", new_password_path(resource_name), class: "font-bold text-primary-6 hover:text-primary-7" %>
              </div>
            <% end %>
          </div>

          <div class="pt-2">
            <%= f.submit "Sign in", class: "btn-primary w-full justify-center py-2 text-sm" %>
          </div>
        <% end %>

        <div class="mt-6 border-t border-neutral-4 pt-6 text-center">
          <p class="text-xs text-neutral-45">
            Not a member?
            <%= link_to "Create an account", new_registration_path(resource_name), class: "font-bold text-primary-6 hover:text-primary-7" %>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
