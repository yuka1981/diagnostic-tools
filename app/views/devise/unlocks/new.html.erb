<div class="flex min-h-full flex-col justify-center px-6 py-12 lg:px-8">
  <div class="sm:mx-auto sm:w-full sm:max-w-md">
    <div class="card-netbox shadow-xl">
      <div class="card-header justify-center py-4">
        <h2 class="text-lg font-black text-slate-800 uppercase tracking-tight">Resend unlock instructions</h2>
      </div>

      <div class="p-6">
        <%= form_for(resource, as: resource_name, url: unlock_path(resource_name), html: { method: :post, class: "space-y-5" }) do |f| %>
          <%= render "devise/shared/error_messages", resource: resource %>

          <div>
            <%= f.label :email, class: "block text-xs font-bold text-slate-700 uppercase mb-1" %>
            <%= f.email_field :email, autofocus: true, autocomplete: "email",
                class: "block w-full rounded border border-slate-300 py-1.5 px-3 text-slate-900 shadow-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 sm:text-sm" %>
          </div>

          <div class="pt-2">
            <%= f.submit "Resend instructions", class: "btn-primary w-full justify-center py-2 text-sm" %>
          </div>
        <% end %>

        <div class="mt-6 border-t border-slate-100 pt-6 text-center">
          <%= render "devise/shared/links" %>
        </div>
      </div>
    </div>
  </div>
</div>
