<% breadcrumb_trail([
  { title: "Sites", path: sites_path },
  { title: @server_rack.site.name, path: site_path(@server_rack.site) },
  { title: @server_rack.room.name, path: room_path(@server_rack.room) },
  { title: @server_rack.name }
]) %>

<div class="mb-6">
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-4">
      <h1 class="text-2xl font-bold text-neutral-85"><%= @server_rack.name %></h1>
      <% case @server_rack.status %>
      <% when "active" %>
        <span class="inline-flex items-center rounded-sm px-2 py-0.5 text-xs font-medium bg-emerald-100 text-emerald-800 border border-emerald-200">
          Active
        </span>
      <% when "planned" %>
        <span class="inline-flex items-center rounded-sm px-2 py-0.5 text-xs font-medium bg-blue-100 text-blue-800 border border-blue-200">
          Planned
        </span>
      <% when "decommissioned" %>
        <span class="inline-flex items-center rounded-sm px-2 py-0.5 text-xs font-medium bg-neutral-4 text-neutral-45 border border-neutral-8">
          Decommissioned
        </span>
      <% end %>
    </div>
    <% if current_user.approver? %>
      <div class="flex items-center gap-2">
        <%= link_to edit_server_rack_path(@server_rack), class: "btn-secondary" do %>
          <%= lucide_icon("square-pen", class: "h-4 w-4 mr-1") %>
          Edit
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<div class="grid gap-6 lg:grid-cols-2">
  <%# Overview Card %>
  <div class="card-netbox">
    <div class="card-header">
      <h3 class="card-title">Overview</h3>
    </div>
    <div class="p-0">
      <table class="w-full text-sm text-left">
        <tbody class="divide-y divide-neutral-4">
          <tr class="hover:bg-neutral-2">
            <th class="px-4 py-2 font-bold text-neutral-85 w-1/3 border-r border-neutral-8">Name</th>
            <td class="px-4 py-2 text-neutral-85 font-bold"><%= @server_rack.name %></td>
          </tr>
          <tr class="hover:bg-neutral-2">
            <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Site</th>
            <td class="px-4 py-2 text-neutral-85">
              <%= link_to @server_rack.site.name, site_path(@server_rack.site), class: "text-primary-6 hover:text-primary-7" %>
            </td>
          </tr>
          <tr class="hover:bg-neutral-2">
            <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Room</th>
            <td class="px-4 py-2 text-neutral-85">
              <%= link_to @server_rack.room.name, room_path(@server_rack.room), class: "text-primary-6 hover:text-primary-7" %>
            </td>
          </tr>
          <tr class="hover:bg-neutral-2">
            <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Facility ID</th>
            <td class="px-4 py-2 text-neutral-85 font-mono"><%= @server_rack.facility_id.presence || "-" %></td>
          </tr>
          <tr class="hover:bg-neutral-2">
            <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Asset Tag</th>
            <td class="px-4 py-2 text-neutral-85 font-mono"><%= @server_rack.asset_tag.presence || "-" %></td>
          </tr>
          <tr class="hover:bg-neutral-2">
            <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Status</th>
            <td class="px-4 py-2 text-neutral-85"><%= @server_rack.status.humanize %></td>
          </tr>
          <tr class="hover:bg-neutral-2">
            <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Descending Units</th>
            <td class="px-4 py-2 text-neutral-85"><%= @server_rack.desc_units ? "Yes" : "No" %></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <%# Utilization Card %>
  <div class="card-netbox">
    <div class="card-header">
      <h3 class="card-title">Utilization</h3>
    </div>
    <div class="p-0">
      <table class="w-full text-sm text-left">
        <tbody class="divide-y divide-neutral-4">
          <tr class="hover:bg-neutral-2">
            <th class="px-4 py-2 font-bold text-neutral-85 w-1/3 border-r border-neutral-8">Height</th>
            <td class="px-4 py-2 text-neutral-85"><%= @server_rack.u_height %>U</td>
          </tr>
          <tr class="hover:bg-neutral-2">
            <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Used</th>
            <td class="px-4 py-2 text-neutral-85"><%= @server_rack.utilization %>U</td>
          </tr>
          <tr class="hover:bg-neutral-2">
            <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Available</th>
            <td class="px-4 py-2 text-neutral-85"><%= @server_rack.u_height - @server_rack.utilization %>U</td>
          </tr>
          <tr class="hover:bg-neutral-2">
            <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Utilization</th>
            <td class="px-4 py-2">
              <div class="flex items-center gap-2">
                <div class="w-32 h-3 bg-neutral-8 rounded-full overflow-hidden">
                  <div class="h-full bg-primary-5 rounded-full" style="width: <%= @server_rack.utilization_percentage %>%"></div>
                </div>
                <span class="text-sm font-medium text-neutral-85"><%= @server_rack.utilization_percentage %>%</span>
              </div>
            </td>
          </tr>
          <tr class="hover:bg-neutral-2">
            <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Node Count</th>
            <td class="px-4 py-2 text-neutral-85"><%= @server_rack.nodes.count %></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%# Rack Diagram %>
<div class="card-netbox mt-6">
  <div class="card-header flex items-center justify-between">
    <h3 class="card-title">Rack Diagram</h3>
    <% if current_user&.approver? && @server_rack.nodes.any? %>
      <button id="save-layout-btn" class="hidden px-4 py-2 bg-primary-6 text-white text-sm rounded-lg hover:bg-primary-7 transition-colors">
        Save Layout
      </button>
    <% end %>
  </div>
  <div class="p-6">
    <% if @server_rack.nodes.any? %>
      <div data-controller="rack-diagram"
           data-rack-diagram-rack-id-value="<%= @server_rack.id %>"
           data-rack-diagram-rack-height-value="<%= @server_rack.u_height %>"
           data-rack-diagram-desc-units-value="<%= @server_rack.desc_units %>"
           data-rack-diagram-nodes-value="<%= @server_rack.nodes.map { |n| { id: n.id, hostname: n.hostname, position: n.rack_position, height: n.rack_height || 1, status: n.online? ? 'Online' : 'Offline' } }.to_json %>"
           data-rack-diagram-readonly-value="<%= !current_user&.approver? %>">
        <div data-rack-diagram-target="container" class="w-full"></div>
      </div>
    <% else %>
      <div class="text-center py-8">
        <div class="h-16 w-16 mx-auto rounded-full bg-neutral-4 flex items-center justify-center mb-4">
          <%= lucide_icon("server", class: "h-8 w-8 text-neutral-25") %>
        </div>
        <p class="text-sm font-medium text-neutral-85">No nodes in this rack</p>
        <p class="mt-1 text-xs text-neutral-45">Assign nodes to this rack to see them in the diagram</p>
      </div>
    <% end %>
  </div>
</div>

<%# Mounted Nodes List %>
<div class="card-netbox mt-6">
  <div class="card-header flex items-center justify-between">
    <h3 class="card-title">Mounted Nodes</h3>
  </div>
  <% if @server_rack.nodes.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-neutral-8 text-sm">
        <thead class="bg-neutral-2">
          <tr>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Position</th>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Hostname</th>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Role</th>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Height</th>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">IP Address</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-neutral-8 bg-white">
          <% @server_rack.nodes.order(:rack_position).each do |node| %>
            <tr class="hover:bg-neutral-2 transition-colors" data-node-id="<%= node.id %>">
              <td class="whitespace-nowrap px-3 py-2 text-sm text-neutral-85 font-mono" data-position>
                U<%= node.rack_position %>
              </td>
              <td class="whitespace-nowrap px-3 py-2">
                <%= link_to node_path(node), class: "group" do %>
                  <p class="text-sm font-bold text-neutral-85 group-hover:text-primary-6"><%= node.hostname %></p>
                <% end %>
              </td>
              <td class="whitespace-nowrap px-3 py-2 text-sm text-neutral-45">
                <%= node.role.humanize %>
              </td>
              <td class="whitespace-nowrap px-3 py-2 text-sm text-neutral-45">
                <%= node.rack_height || 1 %>U
              </td>
              <td class="whitespace-nowrap px-3 py-2 text-sm text-neutral-45 font-mono">
                <%= node.ip %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="flex flex-col items-center justify-center py-12 text-center">
      <div class="h-12 w-12 rounded-full bg-neutral-4 flex items-center justify-center mb-4">
        <%= lucide_icon("server", class: "h-6 w-6 text-neutral-25") %>
      </div>
      <p class="text-sm font-medium text-neutral-85">No nodes mounted in this rack</p>
      <p class="mt-1 text-xs text-neutral-45">Assign nodes to this rack to see them listed here</p>
    </div>
  <% end %>
</div>

<%# Danger Zone %>
<% if current_user.approver? && @server_rack.nodes.empty? %>
  <div class="card-netbox mt-6 border-error-2">
    <div class="card-header bg-error-1 border-error-2">
      <h3 class="card-title text-error-8">Danger Zone</h3>
    </div>
    <div class="p-4">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-neutral-85">Delete this rack</p>
          <p class="text-xs text-neutral-45">Once deleted, this rack cannot be recovered.</p>
        </div>
        <%= button_to server_rack_path(@server_rack),
            method: :delete,
            class: "btn-danger",
            data: { turbo_confirm: "Are you sure you want to delete this rack? This action cannot be undone." } do %>
          Delete Rack
        <% end %>
      </div>
    </div>
  </div>
<% end %>
