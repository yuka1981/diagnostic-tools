<% content_for(:page_title) { @server_rack.name } %>

<div class="mb-6">
  <nav class="text-sm text-slate-500 mb-2">
    <%= link_to "Sites", sites_path, class: "hover:text-teal-600" %> /
    <%= link_to @server_rack.site.name, site_path(@server_rack.site), class: "hover:text-teal-600" %> /
    <%= link_to @server_rack.room.name, room_path(@server_rack.room), class: "hover:text-teal-600" %> /
    <span class="text-slate-700"><%= @server_rack.name %></span>
  </nav>
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-4">
      <h1 class="text-2xl font-bold text-slate-900"><%= @server_rack.name %></h1>
      <% case @server_rack.status %>
      <% when "active" %>
        <span class="inline-flex items-center rounded-sm px-2 py-0.5 text-xs font-medium bg-emerald-100 text-emerald-800 border border-emerald-200">
          Active
        </span>
      <% when "planned" %>
        <span class="inline-flex items-center rounded-sm px-2 py-0.5 text-xs font-medium bg-blue-100 text-blue-800 border border-blue-200">
          Planned
        </span>
      <% when "decommissioned" %>
        <span class="inline-flex items-center rounded-sm px-2 py-0.5 text-xs font-medium bg-slate-100 text-slate-600 border border-slate-200">
          Decommissioned
        </span>
      <% end %>
    </div>
    <% if current_user.approver? %>
      <div class="flex items-center gap-2">
        <%= link_to edit_server_rack_path(@server_rack), class: "btn-secondary" do %>
          <svg class="h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
          Edit
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<div class="grid gap-6 lg:grid-cols-2">
  <%# Overview Card %>
  <div class="card-netbox">
    <div class="card-header">
      <h3 class="card-title">Overview</h3>
    </div>
    <div class="p-0">
      <table class="w-full text-sm text-left">
        <tbody class="divide-y divide-slate-100">
          <tr class="hover:bg-slate-50">
            <th class="px-4 py-2 font-bold text-slate-700 w-1/3 border-r border-slate-200">Name</th>
            <td class="px-4 py-2 text-slate-700 font-bold"><%= @server_rack.name %></td>
          </tr>
          <tr class="hover:bg-slate-50">
            <th class="px-4 py-2 font-bold text-slate-700 border-r border-slate-200">Site</th>
            <td class="px-4 py-2 text-slate-700">
              <%= link_to @server_rack.site.name, site_path(@server_rack.site), class: "text-teal-600 hover:text-teal-700" %>
            </td>
          </tr>
          <tr class="hover:bg-slate-50">
            <th class="px-4 py-2 font-bold text-slate-700 border-r border-slate-200">Room</th>
            <td class="px-4 py-2 text-slate-700">
              <%= link_to @server_rack.room.name, room_path(@server_rack.room), class: "text-teal-600 hover:text-teal-700" %>
            </td>
          </tr>
          <tr class="hover:bg-slate-50">
            <th class="px-4 py-2 font-bold text-slate-700 border-r border-slate-200">Facility ID</th>
            <td class="px-4 py-2 text-slate-700 font-mono"><%= @server_rack.facility_id.presence || "-" %></td>
          </tr>
          <tr class="hover:bg-slate-50">
            <th class="px-4 py-2 font-bold text-slate-700 border-r border-slate-200">Asset Tag</th>
            <td class="px-4 py-2 text-slate-700 font-mono"><%= @server_rack.asset_tag.presence || "-" %></td>
          </tr>
          <tr class="hover:bg-slate-50">
            <th class="px-4 py-2 font-bold text-slate-700 border-r border-slate-200">Status</th>
            <td class="px-4 py-2 text-slate-700"><%= @server_rack.status.humanize %></td>
          </tr>
          <tr class="hover:bg-slate-50">
            <th class="px-4 py-2 font-bold text-slate-700 border-r border-slate-200">Descending Units</th>
            <td class="px-4 py-2 text-slate-700"><%= @server_rack.desc_units ? "Yes" : "No" %></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <%# Utilization Card %>
  <div class="card-netbox">
    <div class="card-header">
      <h3 class="card-title">Utilization</h3>
    </div>
    <div class="p-0">
      <table class="w-full text-sm text-left">
        <tbody class="divide-y divide-slate-100">
          <tr class="hover:bg-slate-50">
            <th class="px-4 py-2 font-bold text-slate-700 w-1/3 border-r border-slate-200">Height</th>
            <td class="px-4 py-2 text-slate-700"><%= @server_rack.u_height %>U</td>
          </tr>
          <tr class="hover:bg-slate-50">
            <th class="px-4 py-2 font-bold text-slate-700 border-r border-slate-200">Used</th>
            <td class="px-4 py-2 text-slate-700"><%= @server_rack.utilization %>U</td>
          </tr>
          <tr class="hover:bg-slate-50">
            <th class="px-4 py-2 font-bold text-slate-700 border-r border-slate-200">Available</th>
            <td class="px-4 py-2 text-slate-700"><%= @server_rack.u_height - @server_rack.utilization %>U</td>
          </tr>
          <tr class="hover:bg-slate-50">
            <th class="px-4 py-2 font-bold text-slate-700 border-r border-slate-200">Utilization</th>
            <td class="px-4 py-2">
              <div class="flex items-center gap-2">
                <div class="w-32 h-3 bg-slate-200 rounded-full overflow-hidden">
                  <div class="h-full bg-teal-500 rounded-full" style="width: <%= @server_rack.utilization_percentage %>%"></div>
                </div>
                <span class="text-sm font-medium text-slate-700"><%= @server_rack.utilization_percentage %>%</span>
              </div>
            </td>
          </tr>
          <tr class="hover:bg-slate-50">
            <th class="px-4 py-2 font-bold text-slate-700 border-r border-slate-200">Node Count</th>
            <td class="px-4 py-2 text-slate-700"><%= @server_rack.nodes.count %></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%# Rack Diagram %>
<div class="card-netbox mt-6">
  <div class="card-header flex items-center justify-between">
    <h3 class="card-title">Rack Diagram</h3>
    <% if current_user&.approver? && @server_rack.nodes.any? %>
      <button id="save-layout-btn" class="hidden px-4 py-2 bg-teal-600 text-white text-sm rounded-lg hover:bg-teal-700 transition-colors">
        Save Layout
      </button>
    <% end %>
  </div>
  <div class="p-6">
    <% if @server_rack.nodes.any? %>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6"
           data-controller="rack-diagram"
           data-rack-diagram-rack-id-value="<%= @server_rack.id %>"
           data-rack-diagram-rack-height-value="<%= @server_rack.u_height %>"
           data-rack-diagram-desc-units-value="<%= @server_rack.desc_units %>"
           data-rack-diagram-nodes-value="<%= @server_rack.nodes.map { |n| { id: n.id, hostname: n.hostname, position: n.rack_position, height: n.rack_height || 1, status: n.online? ? 'Online' : 'Offline' } }.to_json %>"
           data-rack-diagram-readonly-value="<%= !current_user&.approver? %>">
        <%# Diagram container with isolation to prevent z-index issues %>
        <div class="lg:col-span-2 isolate overflow-hidden">
          <div data-rack-diagram-target="container" class="w-full"></div>
        </div>
        <%# Details panel - sticky on desktop for tall racks %>
        <div class="lg:col-span-1">
          <div class="lg:sticky lg:top-4">
            <h4 class="text-sm font-semibold text-slate-700 mb-3">Details</h4>
            <div data-rack-diagram-target="details">
              <%= render partial: "rack_details_panel", locals: { server_rack: @server_rack } %>
            </div>
          </div>
        </div>
      </div>
    <% else %>
      <div class="text-center py-8">
        <div class="h-16 w-16 mx-auto rounded-full bg-slate-100 flex items-center justify-center mb-4">
          <svg class="h-8 w-8 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" />
          </svg>
        </div>
        <p class="text-sm font-medium text-slate-900">No nodes in this rack</p>
        <p class="mt-1 text-xs text-slate-500">Assign nodes to this rack to see them in the diagram</p>
      </div>
    <% end %>
  </div>
</div>

<%# Mounted Nodes List %>
<div class="card-netbox mt-6">
  <div class="card-header flex items-center justify-between">
    <h3 class="card-title">Mounted Nodes</h3>
  </div>
  <% if @server_rack.nodes.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200 text-sm">
        <thead class="bg-slate-50">
          <tr>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-slate-500 border-b">Position</th>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-slate-500 border-b">Hostname</th>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-slate-500 border-b">Role</th>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-slate-500 border-b">Height</th>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-slate-500 border-b">IP Address</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 bg-white">
          <% @server_rack.nodes.order(:rack_position).each do |node| %>
            <tr class="hover:bg-slate-50 transition-colors" data-node-id="<%= node.id %>">
              <td class="whitespace-nowrap px-3 py-2 text-sm text-slate-700 font-mono" data-position>
                U<%= node.rack_position %>
              </td>
              <td class="whitespace-nowrap px-3 py-2">
                <%= link_to node_path(node), class: "group" do %>
                  <p class="text-sm font-bold text-slate-900 group-hover:text-teal-600"><%= node.hostname %></p>
                <% end %>
              </td>
              <td class="whitespace-nowrap px-3 py-2 text-sm text-slate-600">
                <%= node.role.humanize %>
              </td>
              <td class="whitespace-nowrap px-3 py-2 text-sm text-slate-500">
                <%= node.rack_height || 1 %>U
              </td>
              <td class="whitespace-nowrap px-3 py-2 text-sm text-slate-500 font-mono">
                <%= node.ip %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="flex flex-col items-center justify-center py-12 text-center">
      <div class="h-12 w-12 rounded-full bg-slate-100 flex items-center justify-center mb-4">
        <svg class="h-6 w-6 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" />
        </svg>
      </div>
      <p class="text-sm font-medium text-slate-900">No nodes mounted in this rack</p>
      <p class="mt-1 text-xs text-slate-500">Assign nodes to this rack to see them listed here</p>
    </div>
  <% end %>
</div>

<%# Danger Zone %>
<% if current_user.approver? && @server_rack.nodes.empty? %>
  <div class="card-netbox mt-6 border-red-200">
    <div class="card-header bg-red-50 border-red-200">
      <h3 class="card-title text-red-800">Danger Zone</h3>
    </div>
    <div class="p-4">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-slate-900">Delete this rack</p>
          <p class="text-xs text-slate-500">Once deleted, this rack cannot be recovered.</p>
        </div>
        <%= button_to server_rack_path(@server_rack),
            method: :delete,
            class: "btn-danger",
            data: { turbo_confirm: "Are you sure you want to delete this rack? This action cannot be undone." } do %>
          Delete Rack
        <% end %>
      </div>
    </div>
  </div>
<% end %>
