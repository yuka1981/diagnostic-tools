<dl class="space-y-3">
  <div>
    <dt class="text-sm text-slate-500">Name</dt>
    <dd class="text-sm font-medium text-slate-900"><%= server_rack.name %></dd>
  </div>
  <div>
    <dt class="text-sm text-slate-500">Site</dt>
    <dd class="text-sm font-medium text-slate-900">
      <%= link_to server_rack.site.name, site_path(server_rack.site), class: "text-teal-600 hover:text-teal-700" %>
    </dd>
  </div>
  <div>
    <dt class="text-sm text-slate-500">Height</dt>
    <dd class="text-sm font-medium text-slate-900"><%= server_rack.u_height %>U</dd>
  </div>
  <div>
    <dt class="text-sm text-slate-500">Utilization</dt>
    <dd class="text-sm font-medium text-slate-900">
      <div class="flex items-center gap-2">
        <div class="w-20 h-2 bg-slate-200 rounded-full overflow-hidden">
          <div class="h-full bg-teal-500 rounded-full" style="width: <%= server_rack.utilization_percentage %>%"></div>
        </div>
        <span><%= server_rack.utilization_percentage %>%</span>
      </div>
    </dd>
  </div>
  <div>
    <dt class="text-sm text-slate-500">Nodes</dt>
    <dd class="text-sm font-medium text-slate-900"><%= server_rack.nodes.count %></dd>
  </div>
</dl>
