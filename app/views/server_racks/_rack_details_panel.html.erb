<dl class="space-y-3">
  <div>
    <dt class="text-sm text-neutral-45">Name</dt>
    <dd class="text-sm font-medium text-neutral-85"><%= server_rack.name %></dd>
  </div>
  <div>
    <dt class="text-sm text-neutral-45">Site</dt>
    <dd class="text-sm font-medium text-neutral-85">
      <%= link_to server_rack.site.name, site_path(server_rack.site), class: "text-primary-6 hover:text-primary-7" %>
    </dd>
  </div>
  <div>
    <dt class="text-sm text-neutral-45">Height</dt>
    <dd class="text-sm font-medium text-neutral-85"><%= server_rack.u_height %>U</dd>
  </div>
  <div>
    <dt class="text-sm text-neutral-45">Utilization</dt>
    <dd class="text-sm font-medium text-neutral-85">
      <div class="flex items-center gap-2">
        <div class="w-20 h-2 bg-neutral-8 rounded-full overflow-hidden">
          <div class="h-full bg-primary-5 rounded-full" style="width: <%= server_rack.utilization_percentage %>%"></div>
        </div>
        <span><%= server_rack.utilization_percentage %>%</span>
      </div>
    </dd>
  </div>
  <div>
    <dt class="text-sm text-neutral-45">Nodes</dt>
    <dd class="text-sm font-medium text-neutral-85"><%= server_rack.nodes.count %></dd>
  </div>
</dl>
