<% content_for(:page_title) { "Racks" } %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold text-neutral-85">Racks</h1>
    <p class="text-sm text-neutral-45 mt-1">Manage server racks across your sites</p>
  </div>
  <% if current_user.approver? %>
    <%= link_to new_server_rack_path, class: "btn-primary" do %>
      <%= lucide_icon("plus", class: "h-4 w-4 mr-2") %>
      Add Rack
    <% end %>
  <% end %>
</div>

<%# Filters %>
<div class="mb-4">
  <%= form_with url: server_racks_path, method: :get, data: { turbo_frame: "_top", controller: "cascading-select" }, class: "flex items-center gap-4 flex-wrap" do |f| %>
    <div class="flex items-center gap-2">
      <%= f.label :site_id, "Site:", class: "text-sm font-medium text-neutral-85" %>
      <%= f.select :site_id,
          options_from_collection_for_select(@sites, :id, :name, params[:site_id]),
          { include_blank: "All Sites" },
          class: "rounded-md border-neutral-15 shadow-sm focus:border-primary-5 focus:ring-primary-5 sm:text-sm",
          data: { cascading_select_target: "parent", action: "change->cascading-select#parentChanged" } %>
    </div>
    <div class="flex items-center gap-2">
      <%= f.label :room_id, "Room:", class: "text-sm font-medium text-neutral-85" %>
      <%= f.select :room_id,
          options_from_collection_for_select(@rooms, :id, proc { |r| "#{r.site.name} / #{r.name}" }, params[:room_id]),
          { include_blank: "All Rooms" },
          class: "rounded-md border-neutral-15 shadow-sm focus:border-primary-5 focus:ring-primary-5 sm:text-sm",
          data: { cascading_select_target: "child" },
          onchange: "this.form.submit()" %>
    </div>
    <% if params[:site_id].present? || params[:room_id].present? %>
      <%= link_to "Clear Filters", server_racks_path, class: "text-sm text-primary-6 hover:text-primary-7" %>
    <% end %>
  <% end %>
</div>

<div class="card-netbox">
  <% if @server_racks.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-neutral-8 text-sm">
        <thead class="bg-neutral-2">
          <tr>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Name</th>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Site</th>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Room</th>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Height</th>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Utilization</th>
            <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Status</th>
            <th scope="col" class="relative px-3 py-2 border-b">
              <span class="sr-only">Actions</span>
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-neutral-8 bg-white">
          <% @server_racks.each do |rack| %>
            <tr class="hover:bg-neutral-2 transition-colors">
              <td class="whitespace-nowrap px-3 py-2">
                <%= link_to server_rack_path(rack), class: "group" do %>
                  <p class="text-sm font-bold text-neutral-85 group-hover:text-primary-6"><%= rack.name %></p>
                  <% if rack.facility_id.present? %>
                    <p class="text-xs text-neutral-45 font-mono"><%= rack.facility_id %></p>
                  <% end %>
                <% end %>
              </td>
              <td class="whitespace-nowrap px-3 py-2 text-sm text-neutral-45">
                <%= link_to rack.site.name, site_path(rack.site), class: "hover:text-primary-6" %>
              </td>
              <td class="whitespace-nowrap px-3 py-2 text-sm text-neutral-45">
                <%= link_to rack.room.name, room_path(rack.room), class: "hover:text-primary-6" %>
              </td>
              <td class="whitespace-nowrap px-3 py-2 text-sm text-neutral-45">
                <%= rack.u_height %>U
              </td>
              <td class="whitespace-nowrap px-3 py-2">
                <div class="flex items-center gap-2">
                  <div class="w-24 h-2 bg-neutral-8 rounded-full overflow-hidden">
                    <div class="h-full bg-primary-5 rounded-full" style="width: <%= rack.utilization_percentage %>%"></div>
                  </div>
                  <span class="text-xs text-neutral-45"><%= rack.utilization_percentage %>%</span>
                </div>
              </td>
              <td class="whitespace-nowrap px-3 py-2">
                <% case rack.status %>
                <% when "active" %>
                  <span class="inline-flex items-center rounded-sm px-2 py-0.5 text-xs font-medium bg-success-1 text-success-8 border border-success-2">
                    Active
                  </span>
                <% when "planned" %>
                  <span class="inline-flex items-center rounded-sm px-2 py-0.5 text-xs font-medium bg-primary-1 text-primary-8 border border-primary-2">
                    Planned
                  </span>
                <% when "decommissioned" %>
                  <span class="inline-flex items-center rounded-sm px-2 py-0.5 text-xs font-medium bg-neutral-4 text-neutral-45 border border-neutral-8">
                    Decommissioned
                  </span>
                <% end %>
              </td>
              <td class="whitespace-nowrap px-3 py-2">
                <div class="flex items-center justify-end gap-2">
                  <%= link_to server_rack_path(rack), class: "inline-flex items-center text-primary-6 hover:text-primary-7", title: "View" do %>
                    <%= lucide_icon("eye", class: "h-4 w-4") %>
                    <span class="sr-only">View</span>
                  <% end %>
                  <% if current_user.approver? %>
                    <%= link_to edit_server_rack_path(rack), class: "inline-flex items-center text-neutral-45 hover:text-neutral-85", title: "Edit" do %>
                      <%= lucide_icon("square-pen", class: "h-4 w-4") %>
                      <span class="sr-only">Edit</span>
                    <% end %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="flex flex-col items-center justify-center py-12 text-center">
      <div class="h-12 w-12 rounded-full bg-neutral-4 flex items-center justify-center mb-4">
        <%= lucide_icon("server", class: "h-6 w-6 text-neutral-25") %>
      </div>
      <p class="text-sm font-medium text-neutral-85">No racks yet</p>
      <p class="mt-1 text-xs text-neutral-45">Create a rack to organize your server infrastructure</p>
      <% if current_user.approver? %>
        <%= link_to new_server_rack_path, class: "mt-4 btn-primary" do %>
          Add Rack
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
