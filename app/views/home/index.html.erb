<div class="min-h-screen bg-slate-50">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <%# Navigation %>
    <nav class="flex items-center justify-between py-6 border-b border-slate-200">
      <div class="flex items-center gap-3">
        <div class="flex h-8 w-8 items-center justify-center rounded bg-teal-600 text-white shadow-sm">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
              d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
        </div>
        <span class="text-xl font-black text-slate-800 tracking-tight">
          HPC Diagnostic Tools
        </span>
      </div>
      <div class="flex items-center gap-4">
        <% if user_signed_in? %>
          <span class="text-sm font-bold text-slate-600">
            Hello, <%= current_user.name %>
          </span>
          <%= button_to "Sign out", destroy_user_session_path, method: :delete, 
              class: "btn-secondary" %>
        <% else %>
          <%= link_to "Sign in", new_user_session_path, 
              class: "text-sm font-bold text-slate-600 hover:text-teal-600 transition-colors uppercase tracking-wider" %>
          <%= link_to "Sign up", new_user_registration_path, 
              class: "btn-primary" %>
        <% end %>
      </div>
    </nav>

    <%# Hero Section %>
    <div class="py-24 sm:py-32 text-center">
      <div class="mx-auto max-w-3xl">
        <h1 class="text-4xl font-black tracking-tight text-slate-900 sm:text-6xl uppercase">
          HPC System Detection <span class="text-teal-600">&</span> Benchmark
        </h1>
        <p class="mt-6 text-lg leading-8 text-slate-600 font-medium">
          Monitor your HPC cluster nodes, manage benchmark runs, and track performance metrics in one unified, data-dense dashboard.
        </p>
        <div class="mt-10 flex items-center justify-center gap-x-6">
          <% if user_signed_in? %>
            <%= link_to "Go to Dashboard", dashboard_path, 
                class: "btn-primary py-3 px-6 text-base" %>
          <% else %>
            <%= link_to "Get started", new_user_registration_path, 
                class: "btn-primary py-3 px-6 text-base" %>
            <%= link_to "Learn more →", "#features", 
                class: "text-sm font-bold leading-6 text-slate-900 uppercase tracking-widest hover:text-teal-600 transition-colors" %>
          <% end %>
        </div>
      </div>
    </div>

    <%# Features Section %>
    <div id="features" class="py-16 border-t border-slate-200">
      <div class="mx-auto max-w-7xl">
        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
          <%# Feature 1 %>
          <div class="card-netbox p-8 hover:border-teal-300 transition-colors">
            <div class="flex h-10 w-10 items-center justify-center rounded bg-teal-600 text-white shadow-sm mb-6">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 0a3 3 0 0 1-3-3m3 3a3 3 0 1 0 0 6h13.5a3 3 0 1 0 0-6m-16.5-3a3 3 0 0 1 3-3h13.5a3 3 0 0 1 3 3m-19.5 0a4.5 4.5 0 0 1 .9-2.7L5.737 5.1a3.375 3.375 0 0 1 2.7-1.35h7.126c1.062 0 2.062.5 2.7 1.35l2.587 3.45a4.5 4.5 0 0 1 .9 2.7m0 0a3 3 0 0 1-3 3m0 3h.008v.008h-.008v-.008Zm0-6h.008v.008h-.008v-.008Zm-3 6h.008v.008h-.008v-.008Zm0-6h.008v.008h-.008v-.008Z" />
              </svg>
            </div>
            <h3 class="text-lg font-black text-slate-800 uppercase tracking-tight mb-2">Node Inventory</h3>
            <p class="text-sm text-slate-500 font-medium leading-relaxed">
              Track and manage all your HPC cluster nodes with versioned configuration history and hardware discovery.
            </p>
          </div>

          <%# Feature 2 %>
          <div class="card-netbox p-8 hover:border-teal-300 transition-colors">
            <div class="flex h-10 w-10 items-center justify-center rounded bg-teal-600 text-white shadow-sm mb-6">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" />
              </svg>
            </div>
            <h3 class="text-lg font-black text-slate-800 uppercase tracking-tight mb-2">Benchmark Runs</h3>
            <p class="text-sm text-slate-500 font-medium leading-relaxed">
              Execute and monitor HPCG benchmarks with detailed metrics, log streaming, and artifact management.
            </p>
          </div>

          <%# Feature 3 %>
          <div class="card-netbox p-8 hover:border-teal-300 transition-colors">
            <div class="flex h-10 w-10 items-center justify-center rounded bg-teal-600 text-white shadow-sm mb-6">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 14.25v2.25m3-4.5v4.5m3-6.75v6.75m3-9v9M6 20.25h12A2.25 2.25 0 0 0 20.25 18V6A2.25 2.25 0 0 0 18 3.75H6A2.25 2.25 0 0 0 3.75 6v12A2.25 2.25 0 0 0 6 20.25Z" />
              </svg>
            </div>
            <h3 class="text-lg font-black text-slate-800 uppercase tracking-tight mb-2">Cluster Dashboard</h3>
            <p class="text-sm text-slate-500 font-medium leading-relaxed">
              Visualize cluster health with real-time metrics, interactive node heatmaps, and performance insights.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
