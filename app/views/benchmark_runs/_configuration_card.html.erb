<%# Configuration Card - Shows recipe and effective arguments for a benchmark run %>
<% run = local_assigns[:run] || benchmark_run %>

<div class="card-netbox">
  <div class="card-header">
    <h3 class="card-title">Configuration</h3>
  </div>
  <div class="p-0">
    <table class="w-full text-sm text-left">
      <tbody class="divide-y divide-neutral-4">
        <tr class="hover:bg-neutral-2">
          <th class="px-4 py-2 font-bold text-neutral-85 w-1/3 border-r border-neutral-8">Recipe</th>
          <td class="px-4 py-2">
            <%= link_to run.benchmark_recipe.display_name,
                benchmark_recipe_path(run.benchmark_recipe),
                class: "text-primary-6 font-bold hover:underline" %>
          </td>
        </tr>
        <tr class="hover:bg-neutral-2">
          <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Command</th>
          <td class="px-4 py-2 font-mono text-neutral-85"><%= run.benchmark_recipe.command %></td>
        </tr>
        <tr class="hover:bg-neutral-2">
          <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Timeout</th>
          <td class="px-4 py-2 text-neutral-85">
            <% if run.benchmark_recipe.timeout_seconds.present? %>
              <%= distance_of_time_in_words(run.benchmark_recipe.timeout_seconds) %>
              <span class="text-neutral-25 text-xs">(<%= number_with_delimiter(run.benchmark_recipe.timeout_seconds) %> seconds)</span>
            <% else %>
              <span class="text-neutral-25">Default</span>
            <% end %>
          </td>
        </tr>
      </tbody>
    </table>

    <%# Effective Arguments Section %>
    <div class="border-t border-neutral-8">
      <div class="px-4 py-2 bg-neutral-2 border-b border-neutral-8">
        <h4 class="text-xs font-bold uppercase text-neutral-45">Effective Arguments</h4>
        <p class="text-[10px] text-neutral-45 mt-0.5">Arguments used for this specific run (recipe defaults + overrides)</p>
      </div>

      <% if run.arguments.present? && run.arguments.any? %>
        <div class="divide-y divide-neutral-4">
          <% run.arguments.each do |key, value| %>
            <div class="px-4 py-2 flex items-center hover:bg-neutral-2">
              <span class="font-mono text-xs text-neutral-45 w-1/3">--<%= key.to_s.tr("_", "-") %></span>
              <span class="font-mono text-sm text-neutral-85">
                <% if value.is_a?(Array) %>
                  <span class="text-neutral-25">[<%= value.join(", ") %>]</span>
                <% elsif value.is_a?(Hash) %>
                  <span class="text-neutral-25">{...}</span>
                <% elsif value == true %>
                  <span class="text-success-6">true</span>
                <% elsif value == false %>
                  <span class="text-error-6">false</span>
                <% else %>
                  <%= value %>
                <% end %>
              </span>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="px-4 py-6 text-center">
          <p class="text-neutral-25 text-sm italic">No arguments configured</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
