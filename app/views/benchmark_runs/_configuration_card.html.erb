<%# Configuration Card - Shows recipe and effective arguments for a benchmark run %>
<% run = local_assigns[:run] || benchmark_run %>

<div class="card-netbox">
  <div class="card-header">
    <h3 class="card-title">Configuration</h3>
  </div>
  <div class="p-0">
    <table class="w-full text-sm text-left">
      <tbody class="divide-y divide-slate-100">
        <tr class="hover:bg-slate-50">
          <th class="px-4 py-2 font-bold text-slate-700 w-1/3 border-r border-slate-200">Recipe</th>
          <td class="px-4 py-2">
            <%= link_to run.benchmark_recipe.display_name,
                benchmark_recipe_path(run.benchmark_recipe),
                class: "text-teal-600 font-bold hover:underline" %>
          </td>
        </tr>
        <tr class="hover:bg-slate-50">
          <th class="px-4 py-2 font-bold text-slate-700 border-r border-slate-200">Command</th>
          <td class="px-4 py-2 font-mono text-slate-700"><%= run.benchmark_recipe.command %></td>
        </tr>
        <tr class="hover:bg-slate-50">
          <th class="px-4 py-2 font-bold text-slate-700 border-r border-slate-200">Timeout</th>
          <td class="px-4 py-2 text-slate-700">
            <% if run.benchmark_recipe.timeout_seconds.present? %>
              <%= distance_of_time_in_words(run.benchmark_recipe.timeout_seconds) %>
              <span class="text-slate-400 text-xs">(<%= number_with_delimiter(run.benchmark_recipe.timeout_seconds) %> seconds)</span>
            <% else %>
              <span class="text-slate-400">Default</span>
            <% end %>
          </td>
        </tr>
      </tbody>
    </table>

    <%# Effective Arguments Section %>
    <div class="border-t border-slate-200">
      <div class="px-4 py-2 bg-slate-50 border-b border-slate-200">
        <h4 class="text-xs font-bold uppercase text-slate-600">Effective Arguments</h4>
        <p class="text-[10px] text-slate-500 mt-0.5">Arguments used for this specific run (recipe defaults + overrides)</p>
      </div>

      <% if run.arguments.present? && run.arguments.any? %>
        <div class="divide-y divide-slate-100">
          <% run.arguments.each do |key, value| %>
            <div class="px-4 py-2 flex items-center hover:bg-slate-50">
              <span class="font-mono text-xs text-slate-600 w-1/3">--<%= key.to_s.tr("_", "-") %></span>
              <span class="font-mono text-sm text-slate-800">
                <% if value.is_a?(Array) %>
                  <span class="text-slate-400">[<%= value.join(", ") %>]</span>
                <% elsif value.is_a?(Hash) %>
                  <span class="text-slate-400">{...}</span>
                <% elsif value == true %>
                  <span class="text-green-600">true</span>
                <% elsif value == false %>
                  <span class="text-red-600">false</span>
                <% else %>
                  <%= value %>
                <% end %>
              </span>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="px-4 py-6 text-center">
          <p class="text-slate-400 text-sm italic">No arguments configured</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
