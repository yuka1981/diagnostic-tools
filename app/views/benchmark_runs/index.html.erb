<% content_for(:page_title) { "Benchmark Runs" } %>

<div data-controller="slide-over">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Benchmark Runs</h2>
      <p class="mt-1 text-sm text-gray-500 dark:text-slate-400">View and manage benchmark execution history</p>
    </div>
  </div>

  <div class="rounded-2xl bg-white shadow-sm ring-1 ring-gray-200 dark:bg-slate-800/50 dark:ring-white/10 overflow-hidden">
    <% if @benchmark_runs.any? %>
      <table class="min-w-full divide-y divide-gray-200 dark:divide-white/5">
        <thead class="bg-gray-50 dark:bg-white/5">
          <tr>
            <th scope="col" class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-slate-400">Recipe</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-slate-400">Node</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-slate-400">Status</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-slate-400">Started</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-slate-400">Duration</th>
            <th scope="col" class="relative px-6 py-3">
              <span class="sr-only">Actions</span>
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 dark:divide-white/5">
          <% @benchmark_runs.each do |run| %>
            <tr class="hover:bg-gray-50 dark:hover:bg-white/5 transition-colors">
              <td class="whitespace-nowrap px-6 py-4">
                <p class="text-sm font-medium text-gray-900 dark:text-white"><%= run.benchmark_recipe.name %></p>
                <p class="text-xs text-gray-500 dark:text-slate-400"><%= run.benchmark_recipe.version %></p>
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-700 dark:text-slate-300">
                <%= run.node.hostname %>
              </td>
              <td class="whitespace-nowrap px-6 py-4">
                <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= status_badge_class(run.status) %>">
                  <%= run.status.humanize %>
                </span>
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500 dark:text-slate-400">
                <%= run.started_at ? time_ago_in_words(run.started_at) + " ago" : "Pending" %>
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500 dark:text-slate-400">
                <% if run.duration %>
                  <%= distance_of_time_in_words(run.duration) %>
                <% else %>
                  —
                <% end %>
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-right text-sm">
                <%= link_to "View", 
                    benchmark_run_path(run),
                    data: { 
                      action: "click->slide-over#open",
                      turbo_frame: "slide_over_content"
                    },
                    class: "text-blue-600 hover:text-blue-500 dark:text-blue-400 dark:hover:text-blue-300 font-medium" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="flex flex-col items-center justify-center py-12 text-center">
        <svg class="h-12 w-12 text-gray-300 dark:text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" 
            d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
        </svg>
        <p class="mt-4 text-sm font-medium text-gray-500 dark:text-slate-400">No benchmark runs yet</p>
        <p class="mt-1 text-xs text-gray-400 dark:text-slate-500">Start a benchmark to see results here</p>
      </div>
    <% end %>
  </div>

  <%# Slide-over Panel %>
  <%= render "benchmark_runs/slide_over" %>
</div>
