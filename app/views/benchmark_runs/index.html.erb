<% content_for(:page_title) { "Benchmark Runs" } %>

<div data-controller="slide-over" data-testid="benchmark-runs-page-container">
  <%= turbo_stream_from "benchmark_runs" %>
  
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-neutral-85">Benchmark Runs</h1>
  </div>

  <%# Filter Controls %>
  <div class="card-netbox mb-6">
    <div class="card-header">
      <h3 class="card-title">Filters</h3>
    </div>
    <div class="p-4">
      <%= form_with url: benchmark_runs_path, method: :get, data: { controller: "autosubmit", turbo_frame: "runs_list", turbo_action: "advance", testid: "benchmark-runs-filter-form" }, class: "flex flex-wrap items-end gap-4" do |f| %>
        <%# Search Field %>
        <div class="flex-1 min-w-[200px]">
          <label for="q" class="block text-xs font-bold text-neutral-45 uppercase mb-1">Search</label>
          <%= f.text_field :q,
              value: @filter.search_query,
              placeholder: "Search by node or recipe...",
              class: "block w-full rounded-md border-neutral-15 shadow-sm focus:border-primary-5 focus:ring-primary-5 sm:text-sm",
              data: { testid: "benchmark-runs-filter-search" } %>
        </div>

        <%# Status Filter %>
        <div class="w-40">
          <label for="status" class="block text-xs font-bold text-neutral-45 uppercase mb-1">Status</label>
          <%= f.select :status,
              options_for_select([["All Statuses", ""]] + BenchmarkRun.statuses.keys.map { |s| [s.humanize, s] }, @filter.status),
              {},
              class: "block w-full rounded-md border-neutral-15 shadow-sm focus:border-primary-5 focus:ring-primary-5 sm:text-sm",
              data: { action: "change->autosubmit#submit", testid: "benchmark-runs-filter-status" } %>
        </div>

        <%# Node Filter %>
        <div class="w-44">
          <label for="node_id" class="block text-xs font-bold text-neutral-45 uppercase mb-1">Node</label>
          <%= f.select :node_id,
              options_for_select([["All Nodes", ""]] + @nodes.map { |n| [n.hostname, n.id] }, @filter.node_id),
              {},
              class: "block w-full rounded-md border-neutral-15 shadow-sm focus:border-primary-5 focus:ring-primary-5 sm:text-sm",
              data: { action: "change->autosubmit#submit", testid: "benchmark-runs-filter-node" } %>
        </div>

        <%# Recipe Filter %>
        <div class="w-44">
          <label for="recipe_id" class="block text-xs font-bold text-neutral-45 uppercase mb-1">Recipe</label>
          <%= f.select :recipe_id,
              options_for_select([["All Recipes", ""]] + @recipes.map { |r| [r.name, r.id] }, @filter.recipe_id),
              {},
              class: "block w-full rounded-md border-neutral-15 shadow-sm focus:border-primary-5 focus:ring-primary-5 sm:text-sm",
              data: { action: "change->autosubmit#submit", testid: "benchmark-runs-filter-recipe" } %>
        </div>

        <%# Actions %>
        <div class="flex items-center gap-2">
          <%= f.submit "Search", class: "btn-primary cursor-pointer", data: { testid: "benchmark-runs-button-search" } %>
          
          <% if @filter.filtered? %>
            <%= link_to "Clear", benchmark_runs_path,
                data: { turbo_frame: "runs_list", testid: "benchmark-runs-button-clear" },
                class: "btn-secondary" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <%# Runs List (Turbo Frame) %>
  <%= turbo_frame_tag "runs_list", data: { turbo_action: "advance" } do %>
    <div class="card-netbox">
      <% if @benchmark_runs.any? %>
        <%# Filter Summary %>
        <% if @filter.filtered? %>
          <div class="border-b border-neutral-8 bg-neutral-2 px-6 py-3" data-testid="benchmark-runs-results-summary">
            <p class="text-sm text-neutral-45">
              Showing <%= pluralize(@benchmark_runs.total_count, "result") %>
              <% if @filter.search_query.present? %>
                matching <strong class="font-medium text-neutral-85">"<%= h(@filter.search_query) %>"</strong>
              <% end %>
            </p>
          </div>
        <% end %>

        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-neutral-8 text-sm" data-testid="benchmark-runs-table">
            <thead class="bg-neutral-2" data-testid="benchmark-runs-table-header">
              <tr>
                <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">ID</th>
                <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Recipe</th>
                <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Hostname</th>
                <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Status</th>
                <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Gflops</th>
                <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Duration</th>
                <th scope="col" class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider text-neutral-45 border-b">Created At</th>
                <th scope="col" class="relative px-3 py-2 border-b">
                  <span class="sr-only">Actions</span>
                </th>
              </tr>
            </thead>
            <tbody id="benchmark_runs_tbody" class="divide-y divide-neutral-8 bg-white" data-testid="benchmark-runs-table-body">
              <% @benchmark_runs.each do |run| %>
                <%= render "benchmark_runs/run_row", run: run %>
              <% end %>
            </tbody>
          </table>
        </div>

        <%# Pagination %>
        <% if @benchmark_runs.total_pages > 1 %>
          <div class="border-t border-neutral-8 bg-neutral-2 px-6 py-4" data-testid="benchmark-runs-pagination">
            <nav class="flex items-center justify-between" aria-label="Pagination">
              <div class="hidden sm:block">
                <p class="text-xs font-bold text-neutral-45 uppercase">
                  Showing
                  <span class="text-neutral-85"><%= @benchmark_runs.offset_value + 1 %></span>
                  to
                  <span class="text-neutral-85"><%= [@benchmark_runs.offset_value + @benchmark_runs.limit_value, @benchmark_runs.total_count].min %></span>
                  of
                  <span class="text-neutral-85"><%= @benchmark_runs.total_count %></span>
                  results
                </p>
              </div>
              <div class="flex flex-1 justify-between sm:justify-end gap-2">
                <% if @benchmark_runs.prev_page %>
                  <%= link_to "Previous",
                      benchmark_runs_path(filter_params.merge(page: @benchmark_runs.prev_page)),
                      data: { turbo_frame: "runs_list", testid: "benchmark-runs-pagination-prev" },
                      class: "btn-secondary" %>
                <% end %>
                <% if @benchmark_runs.next_page %>
                  <%= link_to "Next",
                      benchmark_runs_path(filter_params.merge(page: @benchmark_runs.next_page)),
                      data: { turbo_frame: "runs_list", testid: "benchmark-runs-pagination-next" },
                      class: "btn-secondary" %>
                <% end %>
              </div>
            </nav>
          </div>
        <% end %>
      <% else %>
        <div class="flex flex-col items-center justify-center py-12 text-center" data-testid="benchmark-runs-table-empty">
          <div class="h-12 w-12 rounded-full bg-neutral-4 flex items-center justify-center mb-4">
            <%= lucide_icon("bar-chart-3", class: "h-6 w-6 text-neutral-25") %>
          </div>
          <p class="text-sm font-medium text-neutral-85">
            <% if @filter.filtered? %>
              No benchmark runs match your filters
            <% else %>
              No benchmark runs yet
            <% end %>
          </p>
          <% if @filter.filtered? %>
            <%= link_to "Clear all filters", benchmark_runs_path,
                data: { turbo_frame: "runs_list" },
                class: "mt-4 btn-secondary" %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <%# Slide-over Panel %>
  <%= render "benchmark_runs/slide_over" %>
</div>