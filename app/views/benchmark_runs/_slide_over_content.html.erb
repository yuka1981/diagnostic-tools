<%# Slide-over Content - Loaded via Turbo Frame %>
<%= turbo_frame_tag "slide_over_content" do %>
  <div data-controller="tabs">
    <%# Run Header with Status %>
    <div class="border-b border-slate-200 px-6 py-4 bg-slate-50">
      <div class="flex items-start gap-4">
        <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-white border border-slate-300 shadow-sm">
          <%= status_icon(benchmark_run.status) %>
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2">
            <h3 class="text-base font-bold text-slate-900 truncate">
              <%= benchmark_run.benchmark_recipe.display_name %>
            </h3>
            <%= node_status_badge(benchmark_run.status) %>
          </div>
          <p class="mt-1 text-sm text-slate-500">
            Run #<%= benchmark_run.id %> on <span class="font-bold"><%= benchmark_run.node.hostname %></span>
          </p>
        </div>
      </div>
    </div>

    <%# Tabs Navigation %>
    <div class="border-b border-slate-200 bg-white">
      <nav class="flex px-6 tabs nav-tabs" aria-label="Tabs" role="tablist" data-action="keydown->tabs#handleKeydown">
        <button type="button"
                id="tab-summary"
                role="tab"
                aria-selected="true"
                aria-controls="tab-panel-summary"
                data-tabs-target="tab"
                data-action="click->tabs#select"
                class="border-b-2 border-teal-600 px-4 py-3 text-sm font-bold uppercase text-teal-600 focus:outline-none transition-colors">
          Summary
        </button>
        <button type="button"
                id="tab-metrics"
                role="tab"
                aria-selected="false"
                aria-controls="tab-panel-metrics"
                tabindex="-1"
                data-tabs-target="tab"
                data-action="click->tabs#select"
                class="border-b-2 border-transparent px-4 py-3 text-sm font-bold uppercase text-slate-500 hover:text-slate-700 hover:border-slate-300 focus:outline-none transition-colors">
          Metrics
        </button>
        <button type="button"
                id="tab-logs"
                role="tab"
                aria-selected="false"
                aria-controls="tab-panel-logs"
                tabindex="-1"
                data-tabs-target="tab"
                data-action="click->tabs#select"
                class="border-b-2 border-transparent px-4 py-3 text-sm font-bold uppercase text-slate-500 hover:text-slate-700 hover:border-slate-300 focus:outline-none transition-colors">
          Logs
        </button>
        <button type="button"
                id="tab-artifacts"
                role="tab"
                aria-selected="false"
                aria-controls="tab-panel-artifacts"
                tabindex="-1"
                data-tabs-target="tab"
                data-action="click->tabs#select"
                class="border-b-2 border-transparent px-4 py-3 text-sm font-bold uppercase text-slate-500 hover:text-slate-700 hover:border-slate-300 focus:outline-none transition-colors">
          Artifacts
        </button>
      </nav>
    </div>

    <%# Tab Panels %>
    <div class="p-6">
      <%# Summary Tab Panel %>
      <div id="tab-panel-summary"
           role="tabpanel"
           aria-labelledby="tab-summary"
           aria-hidden="false"
           data-tabs-target="panel">
        
        <%# Error Message (if any) %>
        <% if benchmark_run.error_message.present? %>
          <div class="mb-6 card-netbox border-red-300">
            <div class="card-header bg-red-50 border-red-300">
              <h3 class="card-title text-red-800">Error</h3>
            </div>
            <div class="p-4 text-sm text-red-700 italic">
              <%= benchmark_run.error_message %>
            </div>
          </div>
        <% end %>

        <%# Details List %>
        <div class="card-netbox">
          <table class="w-full text-sm text-left">
            <tbody class="divide-y divide-slate-100">
              <tr class="hover:bg-slate-50">
                <th class="px-4 py-2 font-bold text-slate-700 w-1/3 border-r border-slate-200">Node</th>
                <td class="px-4 py-2 text-teal-600 font-bold"><%= benchmark_run.node.hostname %></td>
              </tr>
              <tr class="hover:bg-slate-50">
                <th class="px-4 py-2 font-bold text-slate-700 border-r border-slate-200">Recipe</th>
                <td class="px-4 py-2 text-slate-700 font-bold"><%= benchmark_run.benchmark_recipe.name %></td>
              </tr>
              <tr class="hover:bg-slate-50">
                <th class="px-4 py-2 font-bold text-slate-700 border-r border-slate-200">Started</th>
                <td class="px-4 py-2 text-slate-700"><%= benchmark_run.started_at ? l(benchmark_run.started_at, format: :short) : "Pending" %></td>
              </tr>
              <tr class="hover:bg-slate-50">
                <th class="px-4 py-2 font-bold text-slate-700 border-r border-slate-200">Duration</th>
                <td class="px-4 py-2 text-slate-700"><%= benchmark_run.duration ? distance_of_time_in_words(benchmark_run.duration) : "—" %></td>
              </tr>
            </tbody>
          </table>
        </div>

        <%# Quick Actions %>
        <div class="mt-6">
          <%= link_to benchmark_run_path(benchmark_run), 
              class: "btn-primary w-full justify-center" do %>
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
            View Full Details
          <% end %>
        </div>
      </div>

      <%# Metrics Tab Panel %>
      <div id="tab-panel-metrics"
           role="tabpanel"
           aria-labelledby="tab-metrics"
           aria-hidden="true"
           class="hidden"
           data-tabs-target="panel">
        
        <% if benchmark_run.metrics.present? %>
          <div class="card-netbox">
            <table class="w-full text-sm text-left">
              <tbody class="divide-y divide-slate-100">
                <% benchmark_run.metrics.each do |key, value| %>
                  <tr class="hover:bg-slate-50">
                    <th class="px-4 py-2 font-bold text-slate-700 w-1/2 border-r border-slate-200"><%= key.humanize %></th>
                    <td class="px-4 py-2 text-slate-700 font-mono">
                      <%= value.is_a?(Numeric) ? number_with_precision(value, precision: 4, strip_insignificant_zeros: true) : value %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="text-center py-12 card-netbox bg-slate-50 border-dashed">
            <p class="text-slate-500 font-bold uppercase text-xs">No metrics available</p>
          </div>
        <% end %>
      </div>

      <%# Logs Tab Panel %>
      <div id="tab-panel-logs"
           role="tabpanel"
           aria-labelledby="tab-logs"
           aria-hidden="true"
           class="hidden"
           data-tabs-target="panel">

        <% if benchmark_run.log_content.present? %>
          <div class="card-netbox overflow-hidden">
            <pre class="p-4 text-xs font-mono text-slate-700 bg-slate-50 overflow-x-auto max-h-96 whitespace-pre-wrap break-words"><%= benchmark_run.log_content %></pre>
          </div>
        <% else %>
          <div class="text-center py-12 card-netbox bg-slate-50 border-dashed">
            <p class="text-slate-500 font-bold uppercase text-xs">No logs available</p>
          </div>
        <% end %>
      </div>

      <%# Artifacts Tab Panel %>
      <div id="tab-panel-artifacts"
           role="tabpanel"
           aria-labelledby="tab-artifacts"
           aria-hidden="true"
           class="hidden"
           data-tabs-target="panel">
        
        <% if benchmark_run.artifact_indices.any? %>
          <div class="card-netbox">
            <table class="min-w-full divide-y divide-slate-200 text-sm">
              <thead class="bg-slate-50">
                <tr>
                  <th class="px-3 py-2 text-left text-xs font-bold uppercase text-slate-500 border-b">Name</th>
                  <th class="px-3 py-2 text-left text-xs font-bold uppercase text-slate-500 border-b">Type</th>
                  <th class="px-3 py-2 text-right text-xs font-bold uppercase text-slate-500 border-b">Path</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 bg-white">
                <% benchmark_run.artifact_indices.each do |artifact| %>
                  <tr class="hover:bg-slate-50 border-b border-slate-200">
                    <td class="px-3 py-2 font-bold text-slate-700">
                      <%= File.basename(artifact.path) %>
                    </td>
                    <td class="px-3 py-2 text-slate-600 uppercase text-xs font-bold">
                      <%= artifact.file_type %>
                    </td>
                    <td class="px-3 py-2 text-right">
                      <span class="text-[10px] font-mono text-slate-500 bg-slate-50 px-2 py-1 rounded border border-slate-200">
                        <%= artifact.path %>
                      </span>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="text-center py-12 card-netbox bg-slate-50 border-dashed">
            <p class="text-slate-500 font-bold uppercase text-xs">No artifacts found</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

