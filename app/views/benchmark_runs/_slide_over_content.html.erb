<%# Slide-over Content - Loaded via Turbo Frame %>
<%= turbo_frame_tag "slide_over_content", data: { testid: "benchmark-runs-slideover-content-frame" } do %>
  <div data-controller="tabs">
    <%# Run Header with Status %>
    <div class="border-b border-neutral-8 px-6 py-4 bg-neutral-2" data-testid="benchmark-runs-slideover-header">
      <div class="flex items-start gap-4">
        <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-white border border-neutral-15 shadow-sm">
          <%= status_icon(benchmark_run.status) %>
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2">
            <h3 class="text-base font-bold text-neutral-85 truncate" data-testid="benchmark-runs-slideover-recipe">
              <%= benchmark_run.benchmark_recipe.display_name %>
            </h3>
            <%= node_status_badge(benchmark_run.status, data: { testid: "benchmark-runs-slideover-status" }) %>
            <% if benchmark_run.pending? || benchmark_run.running? %>
              <%= button_to cancel_benchmark_run_path(benchmark_run),
                  method: :post,
                  data: { turbo_confirm: "Are you sure you want to cancel this benchmark run?", testid: "benchmark-runs-slideover-cancel" },
                  class: "inline-flex items-center gap-1 px-2 py-1 text-xs font-bold text-error-6 bg-white border border-error-3 rounded hover:bg-error-1 hover:border-error-4 transition-colors" do %>
                <%= lucide_icon("x", class: "h-3 w-3") %>
                Cancel
              <% end %>
            <% end %>
          </div>
          <p class="mt-1 text-sm text-neutral-45">
            Run #<%= benchmark_run.id %> on <span class="font-bold"><%= benchmark_run.node.hostname %></span>
          </p>
        </div>
      </div>
    </div>

    <%# Tabs Navigation %>
    <div class="border-b border-neutral-8 bg-white" data-testid="benchmark-runs-slideover-tabs">
      <nav class="flex px-6 tabs nav-tabs" aria-label="Tabs" role="tablist" data-action="keydown->tabs#handleKeydown">
        <button type="button"
                id="tab-summary"
                role="tab"
                aria-selected="true"
                aria-controls="tab-panel-summary"
                data-tabs-target="tab"
                data-action="click->tabs#select"
                data-testid="benchmark-runs-tab-summary"
                class="border-b-2 border-primary-6 px-4 py-3 text-sm font-bold uppercase text-primary-6 focus:outline-none transition-colors">
          Summary
        </button>
        <button type="button"
                id="tab-metrics"
                role="tab"
                aria-selected="false"
                aria-controls="tab-panel-metrics"
                tabindex="-1"
                data-tabs-target="tab"
                data-action="click->tabs#select"
                data-testid="benchmark-runs-tab-metrics"
                class="border-b-2 border-transparent px-4 py-3 text-sm font-bold uppercase text-neutral-45 hover:text-neutral-85 hover:border-neutral-15 focus:outline-none transition-colors">
          Metrics
        </button>
        <button type="button"
                id="tab-logs"
                role="tab"
                aria-selected="false"
                aria-controls="tab-panel-logs"
                tabindex="-1"
                data-tabs-target="tab"
                data-action="click->tabs#select"
                data-testid="benchmark-runs-tab-logs"
                class="border-b-2 border-transparent px-4 py-3 text-sm font-bold uppercase text-neutral-45 hover:text-neutral-85 hover:border-neutral-15 focus:outline-none transition-colors">
          Logs
        </button>
        <button type="button"
                id="tab-artifacts"
                role="tab"
                aria-selected="false"
                aria-controls="tab-panel-artifacts"
                tabindex="-1"
                data-tabs-target="tab"
                data-action="click->tabs#select"
                data-testid="benchmark-runs-tab-artifacts"
                class="border-b-2 border-transparent px-4 py-3 text-sm font-bold uppercase text-neutral-45 hover:text-neutral-85 hover:border-neutral-15 focus:outline-none transition-colors">
          Artifacts
        </button>
      </nav>
    </div>

    <%# Tab Panels %>
    <div class="p-6">
      <%# Summary Tab Panel %>
      <div id="tab-panel-summary"
           role="tabpanel"
           aria-labelledby="tab-summary"
           aria-hidden="false"
           data-tabs-target="panel"
           data-testid="benchmark-runs-panel-summary">
        
        <%# Error Message (if any) %>
        <% if benchmark_run.error_message.present? %>
          <div class="mb-6 card-netbox border-error-3" data-testid="benchmark-runs-slideover-error">
            <div class="card-header bg-error-1 border-error-3">
              <h3 class="card-title text-error-8">Error</h3>
            </div>
            <div class="p-4 text-sm text-error-7 italic">
              <%= benchmark_run.error_message %>
            </div>
          </div>
        <% end %>

        <%# Details List %>
        <div class="card-netbox" data-testid="benchmark-runs-slideover-details">
          <table class="w-full text-sm text-left">
            <tbody class="divide-y divide-neutral-4">
              <tr class="hover:bg-neutral-2">
                <th class="px-4 py-2 font-bold text-neutral-85 w-1/3 border-r border-neutral-8">Node</th>
                <td class="px-4 py-2 text-primary-6 font-bold"><%= benchmark_run.node.hostname %></td>
              </tr>
              <tr class="hover:bg-neutral-2">
                <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Recipe</th>
                <td class="px-4 py-2 text-neutral-85 font-bold"><%= benchmark_run.benchmark_recipe.name %></td>
              </tr>
              <tr class="hover:bg-neutral-2">
                <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Started</th>
                <td class="px-4 py-2 text-neutral-85"><%= benchmark_run.started_at ? l(benchmark_run.started_at, format: :short) : "Pending" %></td>
              </tr>
              <tr class="hover:bg-neutral-2">
                <th class="px-4 py-2 font-bold text-neutral-85 border-r border-neutral-8">Duration</th>
                <td class="px-4 py-2 text-neutral-85"><%= benchmark_run.duration ? distance_of_time_in_words(benchmark_run.duration) : "—" %></td>
              </tr>
            </tbody>
          </table>
        </div>

        <%# Quick Actions %>
        <div class="mt-6">
          <%= link_to benchmark_run_path(benchmark_run),
              data: { turbo_frame: "_top", testid: "benchmark-runs-slideover-view-full" },
              class: "btn-primary w-full justify-center" do %>
            <%= lucide_icon("external-link", class: "h-4 w-4") %>
            View Full Details
          <% end %>
        </div>
      </div>

      <%# Metrics Tab Panel %>
      <div id="tab-panel-metrics"
           role="tabpanel"
           aria-labelledby="tab-metrics"
           aria-hidden="true"
           class="hidden"
           data-tabs-target="panel"
           data-testid="benchmark-runs-panel-metrics">
        
        <% if benchmark_run.metrics.present? %>
          <div class="card-netbox" data-testid="benchmark-runs-slideover-metrics">
            <table class="w-full text-sm text-left">
              <tbody class="divide-y divide-neutral-4">
                <% benchmark_run.metrics.each do |key, value| %>
                  <tr class="hover:bg-neutral-2">
                    <th class="px-4 py-2 font-bold text-neutral-85 w-1/2 border-r border-neutral-8"><%= key.humanize %></th>
                    <td class="px-4 py-2 text-neutral-85 font-mono">
                      <%= value.is_a?(Numeric) ? number_with_precision(value, precision: 4, strip_insignificant_zeros: true) : value %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="text-center py-12 card-netbox bg-neutral-2 border-dashed">
            <p class="text-neutral-45 font-bold uppercase text-xs">No metrics available</p>
          </div>
        <% end %>
      </div>

      <%# Logs Tab Panel %>
      <div id="tab-panel-logs"
           role="tabpanel"
           aria-labelledby="tab-logs"
           aria-hidden="true"
           class="hidden"
           data-tabs-target="panel"
           data-testid="benchmark-runs-panel-logs">

        <% if benchmark_run.log_content.present? %>
          <div class="card-netbox overflow-hidden" data-testid="benchmark-runs-slideover-logs">
            <pre class="p-4 text-xs font-mono text-neutral-85 bg-neutral-2 overflow-x-auto max-h-96 whitespace-pre-wrap break-words"><%= benchmark_run.log_content %></pre>
          </div>
        <% else %>
          <div class="text-center py-12 card-netbox bg-neutral-2 border-dashed">
            <p class="text-neutral-45 font-bold uppercase text-xs">No logs available</p>
          </div>
        <% end %>
      </div>

      <%# Artifacts Tab Panel %>
      <div id="tab-panel-artifacts"
           role="tabpanel"
           aria-labelledby="tab-artifacts"
           aria-hidden="true"
           class="hidden"
           data-tabs-target="panel"
           data-testid="benchmark-runs-panel-artifacts">
        
        <% if benchmark_run.artifact_indices.any? %>
          <div class="card-netbox" data-testid="benchmark-runs-slideover-artifacts">
            <table class="min-w-full divide-y divide-neutral-8 text-sm">
              <thead class="bg-neutral-2">
                <tr>
                  <th class="px-3 py-2 text-left text-xs font-bold uppercase text-neutral-45 border-b">Name</th>
                  <th class="px-3 py-2 text-left text-xs font-bold uppercase text-neutral-45 border-b">Type</th>
                  <th class="px-3 py-2 text-left text-xs font-bold uppercase text-neutral-45 border-b">Size</th>
                  <th class="px-3 py-2 text-right text-xs font-bold uppercase text-neutral-45 border-b">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-neutral-4 bg-white">
                <% benchmark_run.artifact_indices.each do |artifact| %>
                  <tr class="hover:bg-neutral-2 border-b border-neutral-8">
                    <td class="px-3 py-2">
                      <div class="font-bold text-neutral-85"><%= File.basename(artifact.path) %></div>
                      <div class="text-[10px] font-mono text-neutral-25 truncate max-w-[200px]"><%= artifact.path %></div>
                    </td>
                    <td class="px-3 py-2 text-neutral-45 uppercase text-xs font-bold">
                      <%= artifact.file_type %>
                    </td>
                    <td class="px-3 py-2 text-neutral-45 text-xs">
                      <%= artifact.size.present? ? number_to_human_size(artifact.size) : "—" %>
                    </td>
                    <td class="px-3 py-2 text-right">
                      <% if artifact.downloadable? %>
<%= link_to download_artifact_benchmark_run_path(benchmark_run, artifact_id: artifact.id),
                            class: "inline-flex items-center gap-1 text-primary-6 hover:text-primary-8 text-xs font-bold" do %>
                          <%= lucide_icon("download", class: "h-4 w-4") %>
                          Download
                        <% end %>
                      <% else %>
<span class="inline-flex items-center gap-1 text-neutral-25 text-xs font-bold cursor-not-allowed" title="File not found on server">
                          <%= lucide_icon("download", class: "h-4 w-4") %>
                          Unavailable
                        </span>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="text-center py-12 card-netbox bg-neutral-2 border-dashed">
            <p class="text-neutral-45 font-bold uppercase text-xs">No artifacts found</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

