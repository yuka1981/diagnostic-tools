<tr id="<%= dom_id(run) %>" class="hover:bg-slate-50 transition-colors">
  <td class="whitespace-nowrap px-3 py-2">
    <p class="text-sm font-medium text-slate-900"><%= run.benchmark_recipe.name %></p>
    <p class="text-xs text-slate-500"><%= run.benchmark_recipe.version %></p>
  </td>
  <td class="whitespace-nowrap px-3 py-2 text-sm text-slate-600">
    <%= link_to run.node.hostname, node_path(run.node), class: "hover:text-teal-600" %>
  </td>
  <td class="whitespace-nowrap px-3 py-2 text-sm text-slate-500 font-mono">
    <%= run.log_path.presence || "—" %>
  </td>
  <td class="whitespace-nowrap px-3 py-2">
    <%# Using inline styles for status just for this row, or reuse helper if updated for non-node objects. 
        Helper `status_badge_class` is in DashboardHelper. Let's rely on it but ensure it maps to our new design or inline it.
        Actually, let's reuse the helper but we might need to verify the helper classes. 
        DashboardHelper uses STATUS_BADGE_CLASSES which I haven't updated yet. 
        Wait, I updated `application_helper` with `node_status_badge`. 
        `DashboardHelper` still has old classes.
        I should update DashboardHelper to match new design system too.
    %>
    <span class="inline-flex items-center rounded-sm px-2 py-0.5 text-xs font-medium <%= status_badge_class(run.status) %>">
      <%= run.status.humanize %>
    </span>
  </td>
  <td class="whitespace-nowrap px-3 py-2 text-sm text-slate-500">
    <%= l(run.created_at, format: :short) %>
  </td>
  <td class="whitespace-nowrap px-3 py-2 text-sm text-slate-500">
    <%= run.started_at ? time_ago_in_words(run.started_at) + " ago" : "Pending" %>
  </td>
  <td class="whitespace-nowrap px-3 py-2 text-sm text-slate-500">
    <% if run.duration %>
      <%= distance_of_time_in_words(run.duration) %>
    <% else %>
      —
    <% end %>
  </td>
  <td class="whitespace-nowrap px-3 py-2 text-right text-sm">
    <%= link_to "View", 
        benchmark_run_path(run),
        data: { 
          action: "click->slide-over#open",
          turbo_frame: "slide_over_content"
        },
        class: "text-teal-600 hover:text-teal-700 font-medium" %>
  </td>
</tr>