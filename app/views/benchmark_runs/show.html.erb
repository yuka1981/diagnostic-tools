<% content_for(:page_title) { "Run ##{@benchmark_run.id}" } %>

<div class="mb-6">
  <%= link_to benchmark_runs_path, class: "inline-flex items-center gap-2 text-sm text-gray-500 hover:text-gray-700 dark:text-slate-400 dark:hover:text-slate-300" do %>
    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
    </svg>
    Back to Runs
  <% end %>
</div>

<div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-gray-200 dark:bg-slate-800/50 dark:ring-white/10">
  <div class="flex items-start gap-6">
    <div class="flex h-16 w-16 items-center justify-center rounded-2xl <%= status_bg_class(@benchmark_run.status) %>">
      <%= status_icon(@benchmark_run.status) %>
    </div>
    <div class="flex-1">
      <div class="flex items-center gap-3">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white"><%= @benchmark_run.benchmark_recipe.display_name %></h2>
        <%= benchmark_status_badge(@benchmark_run.status) %>
      </div>
      <div class="mt-4 grid grid-cols-2 gap-6 sm:grid-cols-4">
        <div>
          <p class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-slate-400">Node</p>
          <p class="mt-1 text-sm font-semibold text-gray-900 dark:text-white"><%= @benchmark_run.node.hostname %></p>
        </div>
        <div>
          <p class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-slate-400">Started</p>
          <p class="mt-1 text-sm font-semibold text-gray-900 dark:text-white">
            <%= @benchmark_run.started_at ? l(@benchmark_run.started_at, format: :short) : "Pending" %>
          </p>
        </div>
        <div>
          <p class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-slate-400">Duration</p>
          <p class="mt-1 text-sm font-semibold text-gray-900 dark:text-white">
            <%= @benchmark_run.duration ? distance_of_time_in_words(@benchmark_run.duration) : "—" %>
          </p>
        </div>
        <div>
          <p class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-slate-400">ID</p>
          <p class="mt-1 text-sm font-semibold text-gray-900 dark:text-white">#<%= @benchmark_run.id %></p>
        </div>
      </div>
    </div>
  </div>

  <% if @benchmark_run.error_message.present? %>
    <div class="mt-6 rounded-xl bg-red-50 p-4 dark:bg-red-500/10">
      <div class="flex items-start gap-3">
        <svg class="h-5 w-5 text-red-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <div>
          <p class="text-sm font-medium text-red-800 dark:text-red-300">Error Message</p>
          <p class="mt-1 text-sm text-red-700 dark:text-red-400"><%= @benchmark_run.error_message %></p>
        </div>
      </div>
    </div>
  <% end %>

  <% if @benchmark_run.metrics.present? %>
    <div class="mt-6">
      <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Metrics</h3>
      <div class="rounded-xl bg-gray-50 p-4 dark:bg-white/5">
        <pre class="text-sm text-gray-700 dark:text-slate-300 overflow-x-auto"><%= JSON.pretty_generate(@benchmark_run.metrics) %></pre>
      </div>
    </div>
  <% end %>
</div>
