<% if processors.any? %>
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-neutral-8 text-sm">
      <thead class="bg-neutral-2">
        <tr>
          <th class="px-3 py-2 text-left text-xs font-bold uppercase text-neutral-45">Socket</th>
          <th class="px-3 py-2 text-left text-xs font-bold uppercase text-neutral-45">Model</th>
          <th class="px-3 py-2 text-left text-xs font-bold uppercase text-neutral-45">Cores</th>
          <th class="px-3 py-2 text-left text-xs font-bold uppercase text-neutral-45">Base Freq</th>
          <th class="px-3 py-2 text-left text-xs font-bold uppercase text-neutral-45">Max Freq</th>
          <th class="px-3 py-2 text-left text-xs font-bold uppercase text-neutral-45">Serial</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-neutral-4 bg-white">
        <% processors.each do |proc| %>
          <tr class="hover:bg-neutral-2">
            <td class="px-3 py-2 font-medium text-neutral-85"><%= proc["socket"] %></td>
            <td class="px-3 py-2 text-neutral-85"><%= proc["model"] %></td>
            <td class="px-3 py-2 text-neutral-85"><%= proc["cores"] %></td>
            <td class="px-3 py-2 text-neutral-85"><%= proc["freq_base"] %></td>
            <td class="px-3 py-2 text-neutral-85"><%= proc["freq_max"] %></td>
            <td class="px-3 py-2 text-neutral-45 font-mono text-xs"><%= proc["serial"] %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="text-neutral-45 text-sm text-center py-4">No processor data available</p>
<% end %>
