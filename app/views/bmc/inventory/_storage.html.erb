<% if storage.any? %>
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-neutral-8 text-sm">
      <thead class="bg-neutral-2">
        <tr>
          <th class="px-3 py-2 text-left text-xs font-bold uppercase text-neutral-45">Name</th>
          <th class="px-3 py-2 text-left text-xs font-bold uppercase text-neutral-45">Capacity</th>
          <th class="px-3 py-2 text-left text-xs font-bold uppercase text-neutral-45">Model</th>
          <th class="px-3 py-2 text-left text-xs font-bold uppercase text-neutral-45">Interface</th>
          <th class="px-3 py-2 text-left text-xs font-bold uppercase text-neutral-45">Health</th>
          <th class="px-3 py-2 text-left text-xs font-bold uppercase text-neutral-45">Serial</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-neutral-4 bg-white">
        <% storage.each do |disk| %>
          <tr class="hover:bg-neutral-2">
            <td class="px-3 py-2 font-medium text-neutral-85"><%= disk["name"] %></td>
            <td class="px-3 py-2 text-neutral-85"><%= disk["capacity"] %></td>
            <td class="px-3 py-2 text-neutral-85"><%= disk["model"] %></td>
            <td class="px-3 py-2 text-neutral-85"><%= disk["interface"] %></td>
            <td class="px-3 py-2">
              <% health = disk["health"]&.downcase %>
              <span class="px-2 py-0.5 rounded text-xs font-bold <%= health == 'ok' ? 'bg-success-2 text-success-7' : 'bg-warning-1 text-warning-7' %>">
                <%= disk["health"] || "Unknown" %>
              </span>
            </td>
            <td class="px-3 py-2 text-neutral-45 font-mono text-xs"><%= disk["serial"] %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="text-neutral-45 text-sm text-center py-4">No storage data available</p>
<% end %>
