<% if memory.any? %>
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-neutral-8 text-sm">
      <thead class="bg-neutral-2">
        <tr>
          <th class="px-3 py-2 text-left text-xs font-bold uppercase text-neutral-45">Slot</th>
          <th class="px-3 py-2 text-left text-xs font-bold uppercase text-neutral-45">Size</th>
          <th class="px-3 py-2 text-left text-xs font-bold uppercase text-neutral-45">Speed</th>
          <th class="px-3 py-2 text-left text-xs font-bold uppercase text-neutral-45">Type</th>
          <th class="px-3 py-2 text-left text-xs font-bold uppercase text-neutral-45">Manufacturer</th>
          <th class="px-3 py-2 text-left text-xs font-bold uppercase text-neutral-45">Serial</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-neutral-4 bg-white">
        <% memory.each do |mem| %>
          <tr class="hover:bg-neutral-2">
            <td class="px-3 py-2 font-medium text-neutral-85"><%= mem["slot"] %></td>
            <td class="px-3 py-2 text-neutral-85"><%= mem["size_gb"] %> GB</td>
            <td class="px-3 py-2 text-neutral-85"><%= mem["speed_mhz"] %> MHz</td>
            <td class="px-3 py-2 text-neutral-85"><%= mem["type"] %></td>
            <td class="px-3 py-2 text-neutral-85"><%= mem["manufacturer"] %></td>
            <td class="px-3 py-2 text-neutral-45 font-mono text-xs"><%= mem["serial"] %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="text-neutral-45 text-sm text-center py-4">No memory data available</p>
<% end %>
