<% if bios.present? %>
  <table class="w-full text-sm">
    <tbody class="divide-y divide-neutral-4">
      <tr class="hover:bg-neutral-2">
        <th class="px-3 py-2 text-left font-medium text-neutral-45 w-1/3">Vendor</th>
        <td class="px-3 py-2 text-neutral-85"><%= bios["vendor"] %></td>
      </tr>
      <tr class="hover:bg-neutral-2">
        <th class="px-3 py-2 text-left font-medium text-neutral-45">Version</th>
        <td class="px-3 py-2 text-neutral-85"><%= bios["version"] %></td>
      </tr>
      <tr class="hover:bg-neutral-2">
        <th class="px-3 py-2 text-left font-medium text-neutral-45">Release Date</th>
        <td class="px-3 py-2 text-neutral-85"><%= bios["release_date"] %></td>
      </tr>
    </tbody>
  </table>
<% else %>
  <p class="text-neutral-45 text-sm text-center py-4">No BIOS data available</p>
<% end %>
