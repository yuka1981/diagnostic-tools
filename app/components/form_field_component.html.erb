<div<% if testid %> data-testid="<%= testid %>"<% end %>>
  <label for="<%= field_id %>" class="block text-sm font-bold text-neutral-85 mb-1">
    <%= label %>
    <% if required %>
      <span class="text-error-5">*</span>
    <% end %>
  </label>

  <% if input? %>
    <%= input %>
  <% else %>
    <%= form.text_field attribute,
        placeholder: placeholder,
        class: input_classes,
        "aria-describedby": aria_describedby %>
  <% end %>

  <% if errors? %>
    <div id="<%= error_id %>" role="alert"<% if testid %> data-testid="<%= testid %>-error"<% end %>>
      <% error_messages.each do |message| %>
        <p class="mt-1 text-xs text-error-6"><%= message %></p>
      <% end %>
    </div>
  <% elsif hint.present? %>
    <p id="<%= hint_id %>" class="mt-1 text-xs text-neutral-45"><%= hint %></p>
  <% end %>
</div>
