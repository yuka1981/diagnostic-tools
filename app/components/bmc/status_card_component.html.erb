<div class="card-netbox">
  <div class="card-header">
    <h3 class="card-title flex items-center gap-2">
      <%= helpers.lucide_icon("server", class: "h-4 w-4") %>
      BMC Status
    </h3>
    <% if bmc_configured? && latest_inventory %>
      <span class="<%= health_badge_classes %>">
        <%= health_status.to_s.humanize %>
      </span>
    <% end %>
  </div>

  <div class="p-4">
    <% if bmc_configured? %>
      <table class="w-full text-sm">
        <tbody class="divide-y divide-neutral-4">
          <tr>
            <th class="py-2 text-left font-medium text-neutral-45 w-1/3">Address</th>
            <td class="py-2 text-neutral-85"><%= @node.bmc_address %></td>
          </tr>
          <tr>
            <th class="py-2 text-left font-medium text-neutral-45">Protocol</th>
            <td class="py-2 text-neutral-85"><%= protocol_label %></td>
          </tr>
          <tr>
            <th class="py-2 text-left font-medium text-neutral-45">Last Collected</th>
            <td class="py-2 text-neutral-85">
              <% if last_collected_at %>
                <%= time_ago_in_words(last_collected_at) %> ago
              <% else %>
                <span class="text-neutral-35">Never</span>
              <% end %>
            </td>
          </tr>
          <% if has_discrepancies? %>
            <tr>
              <th class="py-2 text-left font-medium text-neutral-45">Discrepancies</th>
              <td class="py-2">
                <span class="px-2 py-0.5 rounded text-xs font-bold bg-warning-1 text-warning-7 border border-warning-2">
                  <%= unresolved_discrepancy_count %> unresolved
                </span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <div class="mt-4 pt-4 border-t border-neutral-8">
        <%= button_to "Collect Now",
            api_v1_bmc_collect_inventory_path(node_id: @node.id),
            method: :post,
            class: "btn-secondary w-full justify-center",
            data: { turbo: true, turbo_method: :post } %>
      </div>
    <% else %>
      <div class="text-center py-6 text-neutral-45">
        <%= helpers.lucide_icon("server-off", class: "h-8 w-8 mx-auto mb-2 opacity-50") %>
        <p class="text-sm">No BMC configured</p>
        <p class="text-xs mt-1">Add a BMC address to enable out-of-band management</p>
      </div>
    <% end %>
  </div>
</div>
