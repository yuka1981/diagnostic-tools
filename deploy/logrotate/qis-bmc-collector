/var/log/qis/bmc-collector/*.log {
    # Rotate daily
    daily

    # Keep 14 days of logs
    rotate 14

    # Compress old logs
    compress
    delaycompress

    # Don't error if log file is missing
    missingok

    # Don't rotate empty logs
    notifempty

    # Create new log file with correct permissions
    create 0640 root root

    # Add date extension to rotated files
    dateext
    dateformat -%Y%m%d

    # Rotate based on size as well (100MB max)
    maxsize 100M

    # Run postrotate script once for all logs
    sharedscripts

    postrotate
        # No signal needed - collector writes to new file on next run
        :
    endscript
}
