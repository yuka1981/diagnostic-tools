/var/log/qis/prometheus/*.log {
    # Rotate daily
    daily

    # Keep 30 days of logs
    rotate 30

    # Compress old logs
    compress
    delaycompress

    # Don't error if log file is missing
    missingok

    # Don't rotate empty logs
    notifempty

    # Create new log file with correct permissions
    create 0640 root root

    # Add date extension to rotated files
    dateext
    dateformat -%Y%m%d

    # Rotate based on size as well (500MB max)
    maxsize 500M

    # Run postrotate script once for all logs
    sharedscripts

    postrotate
        # Restart Prometheus stack to pick up new log file
        /usr/bin/systemctl reload-or-restart qis-prometheus.service 2>/dev/null || true
    endscript
}
