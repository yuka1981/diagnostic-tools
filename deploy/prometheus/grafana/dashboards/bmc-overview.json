      "pluginVersion": "10.2.2",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "qis_bmc:max_temperature:by_node{node=~\"$node\"} or max by (node) (qis_bmc_temperature_celsius{node=~\"$node\"})",
          "legendFormat": "{{node}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Max Temperature by Node",
      "type": "gauge"
    },
