          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Sensor Status Table",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "indexByName": {
              "Time": 0,
              "Value": 4,
              "__name__": 1,
              "instance": 2,
              "job": 3,
              "node": 5,
              "sensor": 6,
              "status": 7
            },
            "renameByName": {}
          }
        }
      ],
      "type": "table"
